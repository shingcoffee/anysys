{
  "title": "Keywords",
  "description": "Covers each mapped JSON Schema keyword.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "maxProperties": 8,
  "required": ["token"],
  "properties": {
    "token": {
      "type": "string",
      "description": "A formatted token.",
      "minLength": 3,
      "maxLength": 8,
      "pattern": "^[a-z]+$"
    },
    "host": {
      "type": "string",
      "description": "A hostname.",
      "format": "hostname"
    },
    "tags": {
      "type": "array",
      "description": "Unique tags.",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "description": "A tag." }
    },
    "size": {
      "type": "integer",
      "description": "A bounded size.",
      "minimum": 2,
      "maximum": 4
    }
  }
}
