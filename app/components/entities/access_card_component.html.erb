<div class="card overflow-hidden">
  <div class="px-5 py-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="min-w-0 flex flex-col gap-1">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-sm font-medium text-text-primary"><%= t("comp_misc.entity_access.header_title") %></h2>
        <%= render BadgeComponent.new(variant: :default, size: :sm) do %>
          <%= t("comp_misc.entity_access.entries_count", count: entries_count) %>
        <% end %>
      </div>
      <p class="text-caption text-text-muted"><%= t("comp_misc.entity_access.hint") %></p>
    </div>

    <%= link_to entries_path, class: "btn btn-primary flex-shrink-0" do %>
      <%= t("comp_misc.entity_access.open_entries") %>
    <% end %>
  </div>
</div>
