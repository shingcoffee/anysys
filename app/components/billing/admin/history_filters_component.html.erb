<%= form_with url: action, method: :get, scope: nil, class: "#{compact? ? '' : 'mb-4 '}flex min-w-0 flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end print:hidden" do |f| %>
  <%= hidden_field_tag :locale, I18n.locale %>
  <div class="relative min-w-0 flex-1">
    <%= f.label :q, t(query_key), class: label_class %>
    <% if compact? %>
      <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-text-muted"><%= render Billing::Admin::IconComponent.new(name: :search, class_name: "size-4") %></span>
      <%= f.search_field :q, value: filters[:q], placeholder: t(query_key), class: "input-field pl-9" %>
    <% else %>
      <%= f.search_field :q, value: filters[:q], class: "input-field" %>
    <% end %>
  </div>
  <div class="<%= 'sm:w-48' if compact? %>">
    <%= f.label :status, t("common.labels.status"), class: label_class %>
    <%= f.select :status, [[t(compact? ? "comp_billing.history.all_statuses" : "common.labels.all"), ""]] + statuses.map { |status| [t("#{status_prefix}.#{status}"), status] }, { selected: filters[:status] }, class: "input-field" %>
  </div>
  <% if tenant_filter %>
    <div><%= f.label :tenant_id, t("comp_billing.history.tenant_id"), class: label_class %><%= f.text_field :tenant_id, value: filters[:tenant_id], inputmode: "numeric", placeholder: (t("comp_billing.history.tenant_id") if compact?), class: "input-field" %></div>
  <% end %>
  <% if compact? %>
    <div class="flex gap-2">
      <%= f.submit t("common.actions.filter"), class: "btn btn-secondary flex-1 sm:flex-none" %>
      <%= link_to t("common.actions.reset"), action, class: "btn btn-ghost flex-1 sm:flex-none" %>
    </div>
  <% else %>
    <%= f.submit t("common.actions.filter"), class: "btn btn-secondary" %>
    <%= link_to t("common.actions.reset"), action, class: "btn btn-secondary" %>
  <% end %>
<% end %>
