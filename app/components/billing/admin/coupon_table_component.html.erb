<%= render ::Admin::Settings::SectionComponent.new(
      title: (t("comp_billing.coupon_table.heading") unless coupons.empty?),
      description: (t("comp_billing.coupon_table.count", count: coupons_count) unless coupons.empty?),
      flush: true) do %>
  <% if coupons.empty? %>
    <%= render Billing::Admin::EmptyStateComponent.new(
          icon: :tag,
          title: t("comp_billing.coupon_table.empty")) do |empty| %>
      <% empty.with_action do %>
        <%= link_to t("comp_billing.coupon_table.create_first"), new_coupon_path, class: "btn btn-primary btn-sm w-full sm:w-auto" %>
      <% end %>
    <% end %>
  <% else %>
    <ul class="divide-y divide-border-subtle lg:hidden" role="list">
      <% coupons.each do |coupon| %>
        <li class="min-w-0 px-4 py-4 sm:px-6">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-mono font-medium text-text-primary break-all"><%= coupon.code %></p>
              <p class="mt-0.5 text-caption"><%= coupon.name %></p>
            </div>
            <p class="shrink-0 font-semibold text-text-primary tabular-nums"><%= discount_summary(coupon) %></p>
          </div>
          <div class="mt-1.5 flex flex-wrap items-center gap-2">
            <%= render BadgeComponent.new(variant: coupon.active? ? :success : :default, size: :sm) do %>
              <%= coupon.active? ? t("common.status.active") : t("common.status.inactive") %>
            <% end %>
            <span class="text-caption"><%= t("maint_platform.billing.coupons.show.redeemable_now") %> <%= coupon.redeemable? ? t("common.labels.yes") : t("common.labels.no") %></span>
          </div>
          <dl class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-body-sm">
            <div class="flex gap-1.5">
              <dt class="text-text-tertiary"><%= t("comp_billing.coupon_table.duration") %></dt>
              <dd class="text-text-secondary"><%= duration_label(coupon) %></dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="text-text-tertiary"><%= t("comp_billing.coupon_table.redemptions") %></dt>
              <dd class="text-text-secondary tabular-nums"><%= redemption_label(coupon) %></dd>
            </div>
            <div class="flex gap-1.5">
              <dt class="text-text-tertiary"><%= t("comp_billing.coupon_table.expires") %></dt>
              <dd class="text-text-secondary tabular-nums"><%= expires_label(coupon) %></dd>
            </div>
          </dl>
          <div class="mt-3 flex flex-wrap gap-2">
            <%= link_to coupon_path(coupon), class: "btn btn-ghost btn-sm" do %>
              <%= render Billing::Admin::IconComponent.new(name: :eye, class_name: "h-4 w-4") %>
              <%= t("common.actions.view") %>
            <% end %>
            <%= link_to edit_coupon_path(coupon), class: "btn btn-ghost btn-sm" do %>
              <%= render Billing::Admin::IconComponent.new(name: :pencil, class_name: "h-4 w-4") %>
              <%= t("common.actions.edit") %>
            <% end %>
            <%= button_to t("comp_billing.catalog.archive"),
                coupon_path(coupon),
                method: :delete,
                data: { turbo_confirm: t("comp_billing.coupon_table.delete_confirm", code: coupon.code) },
                form: { class: "inline" },
                class: "btn btn-ghost btn-sm text-danger hover:bg-danger-subtle" %>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="hidden max-w-full overflow-x-auto lg:block" role="region" aria-label="<%= t('comp_billing.coupon_table.heading') %>" tabindex="0">
      <table class="min-w-full divide-y divide-border-subtle">
        <caption class="<%= visually_hidden_class %>"><%= t("comp_billing.coupon_table.heading") %></caption>
        <thead class="table-header">
          <tr>
            <th scope="col" class="px-5 py-3 text-left"><%= t("comp_billing.coupon_table.code") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t("comp_billing.coupon_table.discount") %></th>
            <th scope="col" class="px-4 py-3 text-left"><%= t("comp_billing.coupon_table.duration") %></th>
            <th scope="col" class="px-4 py-3 text-right"><%= t("comp_billing.coupon_table.redemptions") %></th>
            <th scope="col" class="px-4 py-3 text-left"><%= t("comp_billing.coupon_table.expires") %></th>
            <th scope="col" class="px-4 py-3 text-left"><%= t("common.labels.status") %></th>
            <th scope="col" class="px-5 py-3"><span class="<%= visually_hidden_class %>"><%= t("common.labels.actions") %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle">
          <% coupons.each do |coupon| %>
            <tr class="table-row">
              <th scope="row" class="px-5 py-3.5 text-left font-mono font-medium text-text-primary">
                <span class="break-all"><%= coupon.code %></span>
                <span class="mt-0.5 block font-sans text-caption font-normal"><%= coupon.name %></span>
              </th>
              <td class="whitespace-nowrap px-4 py-3.5 text-right text-body-sm text-text-secondary tabular-nums"><%= discount_summary(coupon) %></td>
              <td class="px-4 py-3.5 text-body-sm text-text-secondary"><%= duration_label(coupon) %></td>
              <td class="whitespace-nowrap px-4 py-3.5 text-right text-body-sm text-text-secondary tabular-nums"><%= redemption_label(coupon) %></td>
              <td class="whitespace-nowrap px-4 py-3.5 text-body-sm text-text-secondary tabular-nums"><%= expires_label(coupon) %></td>
              <td class="px-4 py-3.5">
                <div class="flex flex-col items-start gap-1">
                  <%= render BadgeComponent.new(variant: coupon.active? ? :success : :default, size: :sm) do %>
                    <%= coupon.active? ? t("common.status.active") : t("common.status.inactive") %>
                  <% end %>
                  <span class="text-caption"><%= t("maint_platform.billing.coupons.show.redeemable_now") %> <%= coupon.redeemable? ? t("common.labels.yes") : t("common.labels.no") %></span>
                </div>
              </td>
              <td class="px-5 py-3.5">
                <div class="flex justify-end gap-1">
                  <%= link_to coupon_path(coupon), class: "btn btn-ghost btn-sm" do %>
                    <%= render Billing::Admin::IconComponent.new(name: :eye, class_name: "h-4 w-4") %>
                    <%= t("common.actions.view") %>
                  <% end %>
                  <%= link_to edit_coupon_path(coupon), class: "btn btn-ghost btn-sm" do %>
                    <%= render Billing::Admin::IconComponent.new(name: :pencil, class_name: "h-4 w-4") %>
                    <%= t("common.actions.edit") %>
                  <% end %>
                  <%= button_to t("comp_billing.catalog.archive"),
                      coupon_path(coupon),
                      method: :delete,
                      data: { turbo_confirm: t("comp_billing.coupon_table.delete_confirm", code: coupon.code) },
                      class: "btn btn-ghost btn-sm text-danger hover:bg-danger-subtle" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if pagination %><%= render ::Admin::PaginationComponent.new(pagination: pagination, page_path: page_path) %><% end %>
<% end %>
