<div class="flex min-w-0 flex-col gap-6 text-body">
  <% if error_message.present? %>
    <div role="alert"><%= render AlertComponent.new(message: error_message, type: :error, auto_dismiss: false) %></div>
  <% end %>

  <div class="card overflow-hidden">
    <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div class="flex min-w-0 flex-wrap items-center gap-2">
        <h2 class="break-all text-subheading font-semibold"><%= t("comp_billing.invoice_detail.invoice_number", number: invoice.number.presence || t("comp_billing.invoice_detail.draft")) %></h2>
        <%= render BadgeComponent.new(variant: status_variant, size: :sm) do %><%= status_label %><% end %>
        <%= render BadgeComponent.new(variant: :primary, size: :sm) do %><%= t("settings_billing.one_time_payment.one_time_badge") %><% end %>
      </div>
      <%= link_to t("settings_billing.one_time_payment.back_to_invoice"), resolved_back_url, class: "btn btn-ghost btn-sm shrink-0 self-start sm:self-auto" %>
    </div>
    <dl class="grid grid-cols-1 divide-y divide-border-subtle border-t border-border-subtle sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      <div class="min-w-0 px-5 py-4 sm:px-6">
        <dt class="text-body-sm text-text-secondary"><%= t("settings_billing.one_time_payment.amount_due") %></dt>
        <dd class="mt-1 text-subtitle tabular-nums"><%= formatted_total %></dd>
      </div>
      <div class="min-w-0 px-5 py-4 sm:px-6">
        <dt class="text-body-sm text-text-secondary"><%= t("comp_billing.invoice_detail.billing_period") %></dt>
        <dd class="mt-1 font-medium text-text-primary tabular-nums">
          <% if invoice.period_start && invoice.period_end %>
            <%= t("comp_billing.period_range", start: date_label(invoice.period_start), end: date_label(invoice.period_end)) %>
          <% else %>
            <%= t("common.labels.em_dash") %>
          <% end %>
        </dd>
      </div>
      <div class="min-w-0 px-5 py-4 sm:px-6">
        <dt class="text-body-sm text-text-secondary"><%= t("comp_billing.invoice_detail.due_date") %></dt>
        <dd class="mt-1 font-medium text-text-primary tabular-nums"><%= date_label(invoice.due_at) %></dd>
      </div>
    </dl>
    <div class="border-t border-border-subtle bg-canvas-elevated px-5 py-3 sm:px-6">
      <p class="flex items-start gap-2 text-caption">
        <span class="text-success"><%= render Billing::Admin::IconComponent.new(name: :shield_check, class_name: "size-4") %></span>
        <span><%= t("settings_billing.one_time_payment.note_long") %></span>
      </p>
    </div>
  </div>

  <% if payment_action.blank? %>
    <div class="card overflow-hidden">
      <header class="card-header"><h3 class="section-header"><%= t("settings_billing.one_time_payment.preferred_provider") %></h3></header>
      <div class="p-5 sm:p-6">
        <%= render Billing::Admin::OneTimeProviderTilesComponent.new(
          providers: providers, currency: invoice.currency, post_url: resolved_post_url, columns: 3
        ) %>
      </div>
    </div>
  <% else %>
    <div class="card overflow-hidden">
      <header class="card-header">
        <div class="flex min-w-0 flex-wrap items-center gap-2">
          <h3 class="section-header"><%= t("settings_billing.one_time_payment.complete_payment") %> · <%= provider_label %></h3>
          <%= render BadgeComponent.new(variant: :primary, size: :sm) do %><%= t("settings_billing.one_time_payment.one_time_badge") %><% end %>
        </div>
      </header>
      <div class="flex flex-col gap-5 p-5 sm:p-6">
        <div class="max-w-xl rounded-xl border border-border-subtle bg-canvas-elevated p-4 sm:p-5">
          <% case action_kind %>
          <% when :stripe_card %>
            <%= tag.div data: stripe_data, class: "flex flex-col gap-3" do %>
              <div class="rounded-lg border border-border bg-surface p-3" data-payments--stripe-card-target="element"></div>
              <p data-payments--stripe-card-target="error" class="hidden text-body-sm text-danger" role="alert" aria-live="polite"></p>
              <button type="button" data-action="click->payments--stripe-card#submit" class="btn btn-primary w-full sm:w-auto"><%= t("comp_payments.widget_checkout.pay") %> <%= formatted_total %></button>
            <% end %>
          <% when :paypal_buttons %>
            <%= tag.div data: paypal_data, class: "flex flex-col gap-3" do %>
              <div data-payments--paypal-buttons-target="element"></div>
              <p data-payments--paypal-buttons-target="error" class="hidden text-body-sm text-danger" role="alert" aria-live="polite"></p>
              <p class="text-caption"><%= t("comp_payments.widget_checkout.secured_by", vendor: "PayPal") %></p>
            <% end %>
          <% when :qr %>
            <%= tag.div data: qr_data, class: "flex flex-col items-center gap-3 text-center" do %>
              <h4 class="font-medium text-text-primary"><%= t("comp_payments.qr.title") %></h4>
              <p class="text-body-sm text-text-secondary"><%= t("comp_payments.qr.instruction", provider: provider_label) %></p>
              <div class="inline-block rounded-xl border border-border-subtle bg-surface p-4 shadow-xs">
                <div class="size-56 [&>svg]:size-full"><%= qr_svg %></div>
              </div>
              <p class="text-caption" data-payments--qr-poll-target="status"><%= t("comp_payments.shared.waiting") %></p>
            <% end %>
          <% when :h5 %>
            <div data-controller="payments--h5-redirect" data-payments--h5-redirect-url-value="<%= h5_url %>" class="flex flex-col gap-3">
              <p class="text-text-primary"><%= t("comp_payments.h5_redirect.redirecting") %></p>
              <a href="<%= h5_url %>" class="btn btn-primary w-full sm:w-auto"><%= t("comp_payments.h5_redirect.tap_to_continue") %></a>
            </div>
          <% when :jsapi %>
            <%= tag.div data: jsapi_data, class: "flex items-center gap-2 text-body-sm text-text-secondary" do %>
              <span class="size-2.5 animate-pulse rounded-full bg-accent"></span>
              <span><%= t("comp_payments.jsapi.completing") %></span>
            <% end %>
          <% end %>
        </div>

        <div class="flex flex-col gap-2 rounded-lg border border-border-subtle bg-canvas-elevated px-4 py-3">
          <div class="flex flex-wrap items-center gap-2">
            <%= button_to t("settings_billing.one_time_payment.verify_payment"), resolved_confirm_url, method: :post, class: "btn btn-secondary btn-sm" %>
            <%= link_to resolved_post_url, class: "btn btn-ghost btn-sm" do %>
              <%= render Billing::Admin::IconComponent.new(name: :refresh, class_name: "size-4") %>
              <%= t("settings_billing.payment_methods.refresh_status") %>
            <% end %>
          </div>
          <p class="text-caption"><%= t("settings_billing.one_time_payment.pending_hint") %></p>
        </div>

        <div class="flex flex-col gap-3 border-t border-border-subtle pt-4">
          <h4 class="text-body-sm font-medium text-text-secondary"><%= t("settings_billing.one_time_payment.switch_provider") %></h4>
          <%= render Billing::Admin::OneTimeProviderTilesComponent.new(
            providers: providers, currency: invoice.currency, post_url: resolved_post_url,
            selected_key: fact(payment_action, :provider), columns: 3
          ) %>
        </div>
      </div>
    </div>
  <% end %>
</div>
