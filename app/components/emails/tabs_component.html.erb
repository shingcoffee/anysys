<div class="mb-6 border-b border-border-subtle">
  <nav class="-mb-px flex gap-6 overflow-x-auto" aria-label="Tabs">
    <% tabs.each do |tab| %>
      <a href="<%= tab[:path] %>"
         class="<%= tab[:active] ? 'border-accent text-accent' : 'border-transparent text-text-muted hover:border-border-subtle hover:text-text-primary' %> whitespace-nowrap border-b-2 py-3 px-1 text-sm font-medium"
         <%== tab[:active] ? 'aria-current="page"' : '' %>>
        <%= tab[:label] %>
      </a>
    <% end %>
  </nav>
</div>
