<div class="static sm:relative" data-controller="help-menu">
  <button type="button"
          aria-label="<%= t("chrome.help_menu.help") %>"
          aria-haspopup="menu"
          aria-expanded="false"
          class="icon-button"
          data-help-menu-target="trigger"
          data-action="click->help-menu#toggle">
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
      <line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
  </button>

  <div class="hidden absolute left-4 right-4 top-full mt-2 w-auto max-w-[calc(100vw-2rem)] sm:left-auto sm:right-0 sm:top-auto sm:w-80 dropdown-panel py-0 z-40 overflow-hidden"
       data-help-menu-target="panel"
       role="menu">
    <div class="flex items-center gap-2.5 border-b border-border-subtle bg-canvas px-4 py-3">
      <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-accent-subtle text-accent" aria-hidden="true">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </span>
      <div class="min-w-0">
        <span class="block text-sm font-semibold text-text-primary"><%= t("chrome.help_menu.help") %></span>
        <span class="block text-[11px] text-text-muted truncate"><%= t("chrome.help_menu.panel_hint") %></span>
      </div>
    </div>

    <div class="flex flex-col gap-0.5 p-1.5">
    <% if show_notify? %>
      <button type="button"
              role="menuitem"
              aria-haspopup="dialog"
              data-action="click->help-menu#openNotify"
              class="<%= HelpMenuComponent::ITEM_CLASSES %>">
        <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-accent-subtle text-accent">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
        </span>
        <span class="flex-1 min-w-0 text-left">
          <span class="block font-medium text-text-primary"><%= t("chrome.help_menu.notify.label") %></span>
          <span class="block text-xs text-text-muted"><%= t("chrome.help_menu.notify.sub") %></span>
        </span>
      </button>
    <% end %>

    <% if email_path.present? %>
      <button type="button"
              role="menuitem"
              aria-haspopup="dialog"
              data-action="click->help-menu#openEmail"
              class="<%= HelpMenuComponent::ITEM_CLASSES %>">
        <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-accent-subtle text-accent">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>
          </svg>
        </span>
        <span class="flex-1 min-w-0 text-left">
          <span class="block font-medium text-text-primary"><%= t("chrome.help_menu.email.label") %></span>
          <span class="block text-xs text-text-muted"><%= t("chrome.help_menu.email.sub") %></span>
        </span>
      </button>
    <% end %>

    <% if show_docs? %>
      <a href="<%= docs_url %>"
         role="menuitem"
         data-action="click->help-menu#close"
         class="<%= HelpMenuComponent::ITEM_CLASSES %>">
        <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-accent-subtle text-accent">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
        </span>
        <span class="flex-1 min-w-0">
          <span class="block font-medium text-text-primary"><%= t("chrome.help_menu.docs.label") %></span>
          <span class="block text-xs text-text-muted truncate"><%= t("chrome.help_menu.docs.sub") %></span>
        </span>
        <svg class="size-3.5 mt-0.5 text-text-muted shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 5 7 7-7 7"/>
        </svg>
      </a>
    <% end %>
    </div>
  </div>

  <% if show_notify? %>
    <%= render HelpComposeDialogComponent.new(kind: :notify, action: notify_path) %>
  <% end %>

  <% if email_path.present? %>
    <%= render HelpComposeDialogComponent.new(kind: :email, action: email_path) %>
  <% end %>
</div>
