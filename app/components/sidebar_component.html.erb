<aside class="<%= aside_classes %>">
  <% if collapsible? %>
    <div class="flex h-12 shrink-0 items-center gap-2 border-b border-border-subtle pl-3 pr-1.5">
      <span class="text-text-muted" aria-hidden="true"><%= render MenuIconComponent.new(key: menu_item) %></span>
      <span class="min-w-0 flex-1 truncate text-sm font-semibold tracking-tight text-text-primary"><%= section_label %></span>
      <button type="button"
              data-sidebar-collapsible-toggle
              data-sidebar-rail-label="<%= t("chrome.sidebar.collapse") %>"
              data-sidebar-rail-shortcut="<%= t("chrome.sidebar.shortcut") %>"
              data-action="click->sidebar-collapsible#collapse"
              aria-controls="app-sidebar"
              aria-expanded="true"
              aria-keyshortcuts="Meta+B Control+B"
              aria-label="<%= t("chrome.sidebar.collapse") %>"
              class="icon-button shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
        <%= render SidebarToggleIconComponent.new(expanded: true) %>
      </button>
    </div>
  <% end %>
  <div class="flex min-h-0 flex-1 flex-col" <% if searchable? %>data-controller="list-filter"<% end %>>
    <% if searchable? %>
      <div class="shrink-0 border-b border-border-subtle px-3 py-3">
        <form class="relative" data-action="submit->list-filter#search" role="search">
          <label class="sr-only" for="<%= search_id %>">
            <%= search_placeholder %>
          </label>
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-text-muted">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input type="search"
                 id="<%= search_id %>"
                 class="input-field w-full pl-8 pr-2 <%= mobile ? 'min-h-11' : 'h-9 text-sm' %>"
                 placeholder="<%= search_placeholder %>"
                 autocomplete="off"
                 data-list-filter-target="search"
                 data-action="input->list-filter#search">
        </form>
      </div>
    <% end %>

    <% if nodes.empty? %>
      <div class="flex flex-1 flex-col items-center justify-center px-6 py-16 text-center">
        <div class="mb-4 flex size-14 items-center justify-center rounded-2xl bg-surface-active">
          <svg class="size-6 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z"/>
          </svg>
        </div>
        <p class="mb-1 text-sm font-medium text-text-primary"><%= t("chrome.sidebar.empty_title") %></p>
        <p class="text-xs text-text-muted"><%= t("chrome.sidebar.empty_hint") %></p>
      </div>
    <% else %>
      <nav class="min-h-0 flex-1 overflow-y-auto px-2 py-3" aria-label="<%= nav_label %>"<% unless mobile %> data-controller="sidebar-scroll" data-sidebar-scroll-key-value="<%= menu_item %>"<% end %>>
        <ul class="flex flex-col <%= list_gap_class %>">
          <% categories.each do |category| %>
            <% groups = capture do %>
              <% category[:groups].each do |group| %>
                <%= render SidebarGroupComponent.new(
                      group: group,
                      sectioned: sectioned?,
                      current_path: current_path,
                      mobile: mobile,
                      filterable: searchable?,
                      selected_key: selected_key
                    ) %>
              <% end %>
            <% end %>
            <% if category[:label] %>
              <li data-list-filter-target="group" class="flex flex-col gap-1.5">
                <h3 id="<%= category_label_id(category) %>" class="px-2 text-[11px] font-semibold uppercase tracking-wider text-text-muted">
                  <%= category[:label].label %>
                </h3>
                <ul class="flex flex-col gap-0.5" aria-labelledby="<%= category_label_id(category) %>">
                  <%= groups %>
                </ul>
              </li>
            <% else %>
              <%= groups %>
            <% end %>
          <% end %>
        </ul>
        <% if searchable? %>
          <div data-list-filter-target="empty" class="hidden px-3 py-8 text-center" role="status">
            <p class="text-sm font-medium text-text-primary"><%= search_empty_title %></p>
            <p class="mt-1 text-xs text-text-muted"><%= t("chrome.sidebar.search_empty_hint") %></p>
          </div>
        <% end %>
      </nav>
    <% end %>
  </div>
</aside>
