<div id="<%= steps_id %>"
     class="w-full max-w-[min(92%,42rem)]"
     role="status"
     aria-live="polite"
     aria-label="<%= region_label %>">
  <ol class="flex flex-col gap-1">
    <% steps.each do |step| %>
      <li class="flex items-start gap-2 text-caption" data-progress-step="<%= step.key %>" data-state="<%= state_of(step) %>">
        <% if step.running? %>
          <span class="mt-1.5 size-1.5 shrink-0 animate-pulse rounded-full bg-accent motion-reduce:animate-none" aria-hidden="true"></span>
        <% elsif step.failed? %>
          <svg class="mt-0.5 size-3 shrink-0 text-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        <% else %>
          <svg class="mt-0.5 size-3 shrink-0 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        <% end %>
        <span class="min-w-0 flex-1 <%= label_classes(step) %>">
          <%= step.label %><% if detail_of(step) %><span class="text-text-muted"> · <%= detail_of(step) %></span><% end %>
        </span>
      </li>
    <% end %>
  </ol>
</div>
