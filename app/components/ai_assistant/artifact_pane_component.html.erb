<% pane_data = page_preview? ? { controller: "artifact-preview", artifact_preview_frame_width_value: AiAssistant::ArtifactPaneComponent::FRAME_WIDTH, artifact_preview_frame_height_value: AiAssistant::ArtifactPaneComponent::FRAME_HEIGHT } : {} %>
<%# A workspace target rather than plain markup: Turbo replaces this whole pane
    on every artifact broadcast, and the re-connect is what tells the mobile
    tablist — which no broadcast reaches — whether there is now something to
    look at behind the Preview tab. %>
<div id="<%= pane_id %>"
     class="flex h-full min-h-0 flex-1 flex-col bg-canvas-elevated"
     data-assistant-workspace-target="artifact"
     data-artifact-present="<%= artifact_present? %>"
     <%= tag.attributes(data: pane_data) %>>
  <%# No turbo_stream_from here: AssistantPanelComponent already subscribes to
      this conversation's stream, and ActionCable fans one message out to every
      local subscription sharing an identifier — so a second source here made
      each appended bubble render twice. %>
  <header class="shrink-0 border-b border-border-subtle bg-surface px-4 py-2 sm:px-5">
    <div class="flex min-h-10 items-center gap-3">
      <div class="min-w-0 flex-1">
        <div class="flex min-w-0 items-center gap-2">
          <h2 class="shrink-0 text-sm font-semibold tracking-tight text-text-primary"><%= t("ai_assistant.assistant.artifact.title") %></h2>
          <% if resolved %>
            <%= render BadgeComponent.new(size: :sm) do %>
              <%= kind_label %>
            <% end %>
          <% end %>
        </div>
        <% if resolved %>
          <p class="mt-0.5 flex min-w-0 items-center gap-2 text-caption text-text-muted" title="<%= resolved.label %>">
            <%# The name never gives up width to the status; only the status truncates
                until the name alone fills the row. %>
            <span class="max-w-full shrink-0 truncate font-medium text-text-secondary"><%= resolved.label %></span>
            <span class="flex min-w-0 items-center gap-1.5 overflow-hidden">
              <span class="size-1.5 shrink-0 rounded-full <%= status_dot_class %>" aria-hidden="true"></span>
              <span class="truncate" title="<%= subtitle %>"><%= subtitle %></span>
            </span>
          </p>
        <% end %>
      </div>

      <%# Without a preview the summary card below carries this link instead. %>
      <% if page_preview? %>
        <%= render ButtonComponent.new(
              variant: :secondary,
              size: :sm,
              tag: :a,
              href: open_url,
              target: "_blank",
              rel: "noopener noreferrer",
              class: "shrink-0"
            ) do %>
          <%= open_label %>
          <span class="sr-only"> (<%= t("ai_assistant.assistant.artifact.opens_new_tab") %>)</span>
        <% end %>
      <% end %>
    </div>
  </header>

  <div class="min-h-0 flex-1 <%= page_preview? ? "overflow-hidden" : "overflow-y-auto" %>" aria-live="polite">
    <% if resolved && page_preview? %>
      <div class="flex h-full min-h-0 flex-col gap-2.5 p-3 sm:p-4">
        <div class="relative flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl bg-surface shadow-xs ring-1 ring-border-subtle">
          <%# A sibling of the viewport, not inside it: the tools stay put while the
              miniature scrolls, and clicking them never also opens the dialog. %>
          <div class="absolute right-2 top-2 z-10 flex items-center gap-0.5 rounded-lg bg-surface/90 p-0.5 shadow-sm ring-1 ring-border-subtle backdrop-blur-sm">
            <button type="button"
                    class="inline-flex size-8 items-center justify-center rounded-md text-text-tertiary transition-base hover:bg-surface-active hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:size-10"
                    title="<%= t("ai_assistant.assistant.artifact.view_larger") %>"
                    aria-label="<%= t("ai_assistant.assistant.artifact.view_larger_label", name: resolved.label) %>"
                    data-artifact-preview-target="trigger"
                    data-action="artifact-preview#open">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
              </svg>
            </button>
            <a href="<%= preview_url %>"
               target="_blank"
               rel="noopener noreferrer"
               class="inline-flex size-8 items-center justify-center rounded-md text-text-tertiary transition-base hover:bg-surface-active hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:size-10"
               title="<%= t("ai_assistant.assistant.artifact.open_preview") %>">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
              <span class="sr-only"><%= t("ai_assistant.assistant.artifact.open_preview") %> (<%= t("ai_assistant.assistant.artifact.opens_new_tab") %>)</span>
            </a>
          </div>

          <%# Scrollable and keyboard focusable; clicking anywhere enlarges it, which the
              labelled button in the toolbar also does for assistive tech. %>
          <div class="custom-scrollbar min-h-0 flex-1 cursor-zoom-in overflow-y-auto overflow-x-hidden overscroll-contain bg-surface"
               tabindex="0"
               aria-label="<%= t("ai_assistant.assistant.artifact.preview", name: resolved.label) %>"
               aria-describedby="<%= scroll_hint_id %>"
               data-artifact-preview-target="viewport"
               data-action="click->artifact-preview#open scroll->artifact-preview#syncScroll">
            <%# No overflow clipping on the sheet: it would become the stage's
                scroll container and the stage would stop sticking. The stage
                clips the canvas's unscaled layout box instead. %>
            <div class="relative w-full"
                 style="height: <%= sheet_height %>px"
                 data-artifact-preview-target="sheet">
              <div class="sticky top-0 h-full overflow-hidden"
                   data-artifact-preview-target="stage">
                <div class="absolute left-0 top-0 origin-top-left"
                     style="<%= canvas_style %>"
                     data-artifact-preview-target="canvas">
                  <iframe src="<%= frame_url %>"
                          title="<%= t("ai_assistant.assistant.artifact.preview", name: resolved.label) %>"
                          class="pointer-events-none block size-full border-0 bg-surface"
                          sandbox="allow-same-origin"
                          tabindex="-1"
                          aria-hidden="true"
                          loading="lazy"
                          data-artifact-thumbnail
                          data-artifact-preview-target="thumbnail"
                          data-action="load->artifact-preview#thumbnailLoaded"></iframe>
                </div>
              </div>
            </div>
          </div>
        </div>

        <p id="<%= scroll_hint_id %>" class="shrink-0 text-center text-caption text-text-muted"><%= t("ai_assistant.assistant.artifact.scroll_hint") %></p>

        <%= render AiAssistant::ArtifactPreviewDialogComponent.new(
              name: resolved.label,
              frame_url: frame_url,
              preview_url: preview_url,
              details_url: open_url,
              details_label: open_label,
              subtitle: subtitle
            ) %>
      </div>
    <% elsif resolved %>
      <div class="flex min-h-full items-center justify-center p-4 sm:p-6">
        <div class="flex w-full max-w-sm flex-col items-center rounded-xl bg-surface px-6 py-8 text-center shadow-xs ring-1 ring-border-subtle">
          <span class="flex size-10 items-center justify-center rounded-lg bg-surface-active text-text-secondary" aria-hidden="true">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </span>
          <p class="mt-4 text-sm font-semibold tracking-tight text-text-primary"><%= resolved.label %></p>
          <p class="mt-1 max-w-xs text-caption text-text-muted"><%= no_visual_preview_body %></p>
          <%= render ButtonComponent.new(
                variant: :primary,
                size: :sm,
                tag: :a,
                href: open_url,
                target: "_blank",
                rel: "noopener noreferrer",
                class: "mt-5 gap-1.5"
              ) do %>
            <%= open_label %>
            <svg class="size-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
            <span class="sr-only"> (<%= t("ai_assistant.assistant.artifact.opens_new_tab") %>)</span>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="flex min-h-full p-4 sm:p-6">
        <div class="flex flex-1 flex-col items-center justify-center rounded-xl border border-dashed border-border px-6 py-12 text-center">
          <span class="flex size-10 items-center justify-center rounded-lg bg-surface text-text-tertiary shadow-xs ring-1 ring-border-subtle" aria-hidden="true">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8.25V18a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 18V8.25m-18 0V6a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 6v2.25m-18 0h18M5.25 6h.008v.008H5.25V6zM7.5 6h.008v.008H7.5V6zm2.25 0h.008v.008H9.75V6z" />
            </svg>
          </span>
          <h3 class="mt-4 text-sm font-semibold text-text-primary"><%= t("ai_assistant.assistant.artifact.empty_title") %></h3>
          <p class="mt-1 max-w-xs text-caption text-text-muted"><%= empty_body %></p>
          <p class="mt-5 text-caption text-text-tertiary" data-artifact-kinds>
            <% kind_labels.each_with_index do |label, index| %>
              <% if index.positive? %><span class="px-1 text-border-strong" aria-hidden="true">·</span><% end %><%= label %>
            <% end %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
</div>
