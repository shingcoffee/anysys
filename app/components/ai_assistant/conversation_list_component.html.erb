<%# One row, shared by the active list and the archived disclosure. %>
<% chat_row = ->(conversation) { capture do %>
  <li class="group/chat relative" data-ai-assistant-conversations-target="row" data-conversation-id="<%= conversation.id %>">
    <a href="<%= open_url(conversation) %>"
       class="<%= row_classes(conversation) %>"
       title="<%= title_of(conversation) %>"
       <%= tag.attributes(aria: { current: current?(conversation) ? "page" : nil }) %>>
      <span class="min-w-0 flex-1">
        <span class="block truncate text-sm font-medium"><%= title_of(conversation) %></span>
        <% if timestamp_of(conversation) %>
          <time class="mt-0.5 block text-caption" datetime="<%= iso_timestamp_of(conversation) %>"><%= timestamp_of(conversation) %></time>
        <% end %>
      </span>
      <% if current?(conversation) %>
        <span class="sr-only"><%= t("ai_assistant.assistant.conversations.current") %></span>
      <% end %>
    </a>

    <details class="absolute right-1 top-1.5">
      <summary class="flex size-8 cursor-pointer list-none items-center justify-center rounded-md text-text-muted transition-base hover:bg-surface-active hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:size-11 pointer-fine:opacity-0 pointer-fine:group-hover/chat:opacity-100 pointer-fine:group-focus-within/chat:opacity-100"
               role="button"
               aria-label="<%= t("ai_assistant.assistant.conversations.actions") %>">
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12h.008v.008H6.75V12zm5.25 0h.008v.008H12V12zm5.25 0h.008v.008h-.008V12z" />
        </svg>
      </summary>

      <div class="dropdown-panel absolute right-0 top-full z-20 mt-1 flex w-44 flex-col p-1">
        <button type="button"
                class="flex min-h-9 items-center rounded-md px-2.5 text-left text-sm text-text-secondary transition-base hover:bg-surface-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:min-h-11"
                data-action="ai-assistant-conversations#rename"
                data-ai-assistant-conversations-id-param="<%= conversation.id %>"
                data-ai-assistant-conversations-url-param="<%= member_url(conversation) %>"
                data-ai-assistant-conversations-title-param="<%= title_of(conversation) %>">
          <%= t("ai_assistant.assistant.conversations.rename") %>
        </button>

        <button type="button"
                class="flex min-h-9 items-center rounded-md px-2.5 text-left text-sm text-text-secondary transition-base hover:bg-surface-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:min-h-11"
                data-action="ai-assistant-conversations#archive"
                data-ai-assistant-conversations-id-param="<%= conversation.id %>"
                data-ai-assistant-conversations-url-param="<%= archive_url(conversation) %>"
                data-ai-assistant-conversations-archived-param="<%= conversation.archived? %>">
          <%= conversation.archived? ? t("ai_assistant.assistant.conversations.unarchive") : t("ai_assistant.assistant.conversations.archive") %>
        </button>

        <button type="button"
                class="flex min-h-9 items-center rounded-md px-2.5 text-left text-sm text-danger transition-base hover:bg-danger-subtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:min-h-11"
                data-action="ai-assistant-conversations#destroy"
                data-ai-assistant-conversations-id-param="<%= conversation.id %>"
                data-ai-assistant-conversations-url-param="<%= member_url(conversation) %>">
          <%= t("ai_assistant.assistant.conversations.delete") %>
        </button>
      </div>
    </details>
  </li>
<% end } %>

<div id="<%= list_id %>"
     class="flex w-full flex-col gap-2"
     <%= tag.attributes(data: stimulus_data) %>>
  <%# Rendered rather than built on demand: Turbo replaces this whole list after
      every write, so a slot created in JS would be thrown away with it. %>
  <p id="<%= alert_id %>"
     class="hidden px-2.5 text-caption text-danger"
     role="alert"
     aria-live="assertive"
     data-ai-assistant-conversations-target="alert"></p>

  <%# One toolbar row: history toggle, the open chat's name, and New chat.
      The standing heading lives in the slide-over; this one is sr-only so the
      toolbar does not name the list twice. %>
  <div class="relative z-20 flex items-center gap-2 bg-surface px-3 py-2 sm:px-4">
    <h2 class="sr-only"><%= t("ai_assistant.assistant.conversations.title") %></h2>

    <button id="<%= toggle_id %>"
            type="button"
            class="group flex min-h-10 shrink-0 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-base hover:bg-surface-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:min-h-11"
            aria-expanded="false"
            aria-controls="<%= panel_id %>"
            data-ai-assistant-conversations-target="toggle"
            data-action="ai-assistant-conversations#toggle">
      <svg class="size-4 shrink-0 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <span class="group-aria-expanded:hidden"><%= t("ai_assistant.assistant.conversations.toggle") %></span>
      <span class="hidden group-aria-expanded:inline"><%= t("ai_assistant.assistant.conversations.toggle_hide") %></span>
    </button>

    <p class="min-w-0 flex-1 truncate text-sm font-semibold tracking-tight text-text-primary" title="<%= current_heading %>">
      <%= current_heading %>
    </p>

    <%= render ButtonComponent.new(
          variant: :secondary,
          size: :sm,
          class: "shrink-0",
          disabled: new_disabled?,
          title: new_hint,
          "aria-describedby": new_hint && new_hint_id,
          data: { action: "ai-assistant-conversations#create" }
        ) do %>
      <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      <%= t("ai_assistant.assistant.conversations.new") %>
    <% end %>
  </div>

  <% if new_hint %>
    <p id="<%= new_hint_id %>" class="sr-only"><%= new_hint %></p>
  <% end %>

  <%# Positioned against the workspace host (relative, full pane), not this
      list's height: a static wrapper does not become the containing block. %>
  <div class="pointer-events-none absolute inset-0 z-30 bg-text-primary/40 opacity-0 transition-opacity duration-300"
       aria-hidden="true"
       data-ai-assistant-conversations-target="backdrop"
       data-action="click->ai-assistant-conversations#close"></div>

  <aside id="<%= panel_id %>"
         class="absolute inset-y-0 left-0 z-40 flex w-[min(18rem,88%)] -translate-x-full flex-col border-r border-border-subtle bg-surface shadow-float transition-transform duration-300 ease-out"
         data-ai-assistant-conversations-target="panel"
         role="dialog"
         aria-modal="true"
         aria-labelledby="<%= heading_id %>"
         aria-hidden="true"
         inert>
    <div class="flex shrink-0 items-center justify-between gap-2 border-b border-border-subtle px-3 py-2">
      <h2 id="<%= heading_id %>" class="text-sm font-semibold tracking-tight text-text-primary">
        <%= t("ai_assistant.assistant.conversations.title") %>
      </h2>
      <button type="button"
              class="flex size-9 shrink-0 items-center justify-center rounded-lg text-text-muted transition-base hover:bg-surface-hover hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:size-11"
              data-action="ai-assistant-conversations#close"
              aria-label="<%= t("ai_assistant.assistant.conversations.close") %>">
        <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto p-2">
      <% if any_active? %>
        <ul class="flex flex-col gap-0.5">
          <% active_conversations.each do |conversation| %>
            <%= chat_row.call(conversation) %>
          <% end %>
        </ul>
      <% else %>
        <p class="px-2.5 py-3 text-caption"><%= t("ai_assistant.assistant.conversations.empty") %></p>
      <% end %>

      <% if any_archived? %>
        <details class="mt-2 border-t border-border-subtle pt-2">
          <summary class="flex min-h-9 cursor-pointer list-none items-center gap-1.5 rounded-md px-2.5 text-label transition-base hover:text-text-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:min-h-11">
            <svg class="size-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
            <%= t("ai_assistant.assistant.conversations.archived_section") %>
          </summary>
          <ul class="mt-1 flex flex-col gap-0.5">
            <% archived_conversations.each do |conversation| %>
              <%= chat_row.call(conversation) %>
            <% end %>
          </ul>
        </details>
      <% end %>
    </div>
  </aside>

  <%# Deleting a chat takes its whole transcript with it, so it is confirmed in
      a dialog that names the action, opens on Cancel, and hands focus back to
      the row it was opened from. %>
  <dialog id="<%= delete_dialog_id %>"
          class="m-auto w-[min(92vw,26rem)] rounded-2xl bg-surface p-0 text-text-primary shadow-float backdrop:bg-text-primary/60 backdrop:backdrop-blur-sm"
          aria-modal="true"
          aria-labelledby="<%= delete_dialog_title_id %>"
          aria-describedby="<%= delete_dialog_body_id %>"
          data-ai-assistant-conversations-target="deleteDialog"
          data-action="cancel->ai-assistant-conversations#cancelDestroy">
    <div class="flex flex-col gap-4 p-5">
      <div class="flex flex-col gap-1.5">
        <h2 id="<%= delete_dialog_title_id %>" class="text-base font-semibold tracking-tight text-text-primary">
          <%= t("ai_assistant.assistant.conversations.delete_title") %>
        </h2>
        <p id="<%= delete_dialog_body_id %>" class="text-body-sm text-text-muted">
          <%= t("ai_assistant.assistant.conversations.delete_confirm") %>
        </p>
      </div>
      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <%= render ButtonComponent.new(
              variant: :secondary,
              size: :sm,
              type: :button,
              autofocus: true,
              data: { action: "click->ai-assistant-conversations#cancelDestroy" }
            ) do %>
          <%= t("ai_assistant.assistant.conversations.cancel") %>
        <% end %>
        <%= render ButtonComponent.new(
              variant: :danger,
              size: :sm,
              type: :button,
              data: { action: "click->ai-assistant-conversations#confirmDestroy" }
            ) do %>
          <%= t("ai_assistant.assistant.conversations.delete_action") %>
        <% end %>
      </div>
    </div>
  </dialog>
</div>
