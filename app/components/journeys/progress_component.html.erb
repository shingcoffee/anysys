<nav class="mb-6 border-b border-slate-200 pb-5" aria-label="<%= summary %>" data-role="journey-progress">
  <div class="flex items-baseline justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2">
      <p class="min-w-0 truncate text-sm font-semibold text-slate-900"><%= current_label.presence || summary %></p>
      <% if current_optional? %>
        <%= render BadgeComponent.new(size: :sm, aria: { hidden: true }) do %>
          <%= t("journeys.optional") %>
        <% end %>
      <% end %>
    </div>
    <% if current_label.present? %>
      <p class="shrink-0 text-xs font-medium tabular-nums text-slate-500"><%= summary %></p>
    <% end %>
  </div>
  <ol class="mt-3 flex items-center">
    <% steps.each_with_index do |step, index| %>
      <% last = index == steps.size - 1 %>
      <%= tag.li class: ["flex items-center", ("flex-1" unless last)], data: { state: state(index) },
                 aria: { current: ("step" if state(index) == :current) } do %>
        <span class="flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold tabular-nums <%= marker_classes(index) %>"
              title="<%= label_for(step) %>">
          <% if state(index) == :done %>
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= CHECK %>" /></svg>
          <% else %>
            <span aria-hidden="true"><%= index + 1 %></span>
          <% end %>
          <span class="sr-only"><%= [index + 1, label_for(step).presence].compact.join(". ") %></span>
        </span>
        <% unless last %>
          <span class="mx-2 h-0.5 flex-1 rounded-full <%= connector_classes(index) %>" aria-hidden="true"></span>
        <% end %>
      <% end %>
    <% end %>
  </ol>
</nav>
