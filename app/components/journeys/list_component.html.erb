<% if journeys.empty? %>
  <div class="px-4 py-8 text-center sm:px-6">
    <p class="text-sm font-medium text-text-primary"><%= t("journeys.admin.empty_title") %></p>
    <p class="mt-1 text-sm text-text-muted"><%= t("journeys.admin.empty_description") %></p>
  </div>
<% else %>
  <div data-role="journey-list">
    <ul class="divide-y divide-border-subtle md:hidden">
      <% journeys.each do |journey| %>
        <li>
          <%= link_to edit_path(journey), class: "flex flex-col gap-1.5 px-4 py-3.5 transition-base hover:bg-surface-hover", data: { turbo_frame: "_top" } do %>
            <span class="flex min-w-0 items-center justify-between gap-3">
              <span class="min-w-0 truncate font-medium text-text-primary"><%= journey.name %></span>
              <%= render BadgeComponent.new(variant: status_variant(journey), size: :sm) do %><%= status_label(journey) %><% end %>
            </span>
            <span class="flex flex-wrap items-center gap-x-2 text-xs text-text-muted">
              <span><%= step_count_label(journey) %></span>
              <span aria-hidden="true">·</span>
              <span><%= audience_labels(journey) %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <table class="hidden w-full text-sm md:table md:table-fixed">
      <caption class="sr-only"><%= t("journeys.admin.title") %></caption>
      <thead class="table-header">
        <tr>
          <th scope="col" class="px-4 py-3 text-left font-semibold"><%= t("journeys.admin.columns.name") %></th>
          <th scope="col" class="w-28 px-4 py-3 text-left font-semibold"><%= t("journeys.admin.columns.steps") %></th>
          <th scope="col" class="w-44 px-4 py-3 text-left font-semibold"><%= t("journeys.admin.columns.audiences") %></th>
          <th scope="col" class="w-28 px-4 py-3 text-left font-semibold"><%= t("journeys.admin.columns.status") %></th>
          <th scope="col" class="w-36 px-4 py-3 text-left font-semibold"><%= t("journeys.admin.columns.updated") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-border-subtle">
        <% journeys.each do |journey| %>
          <tr class="transition-base hover:bg-surface-hover/50">
            <td class="px-4 py-3">
              <%= link_to journey.name, edit_path(journey), class: "block truncate font-medium text-text-primary hover:underline", data: { turbo_frame: "_top" } %>
              <p class="mt-0.5 truncate font-mono text-xs text-text-muted"><%= journey.key %></p>
            </td>
            <td class="px-4 py-3 whitespace-nowrap tabular-nums text-text-secondary"><%= step_count_label(journey) %></td>
            <td class="truncate px-4 py-3 text-text-secondary"><%= audience_labels(journey) %></td>
            <td class="px-4 py-3">
              <%= render BadgeComponent.new(variant: status_variant(journey), size: :sm) do %><%= status_label(journey) %><% end %>
            </td>
            <td class="px-4 py-3 whitespace-nowrap tabular-nums text-text-secondary">
              <time datetime="<%= journey.updated_at.iso8601 %>"><%= updated_label(journey) %></time>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
