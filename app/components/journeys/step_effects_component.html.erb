<div data-step-effects class="mt-3 min-w-0 rounded-md border border-border-subtle bg-canvas px-3 py-2.5 text-xs"<% if hidden? %> hidden<% end %>>
  <p class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-0.5">
    <span class="font-medium uppercase tracking-wide text-text-muted"><%= t("journeys.admin.effects.heading") %></span>
    <a data-step-effects-link href="<%= path || "#" %>" target="_blank" rel="noopener" class="link min-w-0 break-words font-medium"<% if title.blank? %> hidden<% end %>><%= title %></a>
  </p>
  <ul data-step-effects-lines class="mt-1.5 list-disc space-y-0.5 pl-4 text-text-secondary">
    <% lines.each do |line| %>
      <li><%= line %></li>
    <% end %>
  </ul>
  <ul data-step-effects-next class="mt-2 space-y-0.5 border-t border-border-subtle pt-2 text-text-muted"<% if next_lines.empty? %> hidden<% end %>>
    <% next_lines.each do |line| %>
      <li><%= line %></li>
    <% end %>
  </ul>
</div>
