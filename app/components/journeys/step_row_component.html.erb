<li data-journey-builder-target="row" data-step-mode="<%= step_mode %>"<% if lead? %> data-step-lead<% end %> class="group/step flex gap-3 pb-4 [counter-increment:journey-step] sm:gap-4">
  <div class="flex flex-col items-center" aria-hidden="true">
    <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-border bg-surface text-sm font-semibold tabular-nums text-text-primary before:content-[counter(journey-step)] group-has-[[data-step-optional]:checked]/step:border-dashed group-has-[[data-step-optional]:checked]/step:text-text-muted group-has-[[data-step-conditional]:checked]/step:border-dashed group-has-[[data-step-conditional]:checked]/step:text-text-muted"></span>
    <span class="mt-2 w-px flex-1 bg-border-subtle"></span>
  </div>

  <div class="min-w-0 flex-1 rounded-lg border border-border-subtle bg-surface p-4 transition-base hover:border-border">
    <%= hidden_field_tag field(:key), key_value, id: nil, data: { step_key: true } %>

    <div class="flex min-h-8 items-center justify-between gap-2">
      <div class="flex min-w-0 items-center gap-2">
        <p class="text-xs font-medium uppercase tracking-wide text-text-muted">
          <span class="group-data-[step-lead]/step:hidden"><%= t("journeys.admin.step_then") %></span>
          <span class="hidden group-data-[step-lead]/step:inline"><%= t("journeys.admin.step_start") %></span>
        </p>
        <%= render BadgeComponent.new(size: :sm, class: "hidden group-has-[[data-step-optional]:checked]/step:inline-flex", aria: { hidden: true }) do %>
          <%= t("journeys.optional") %>
        <% end %>
        <%= render BadgeComponent.new(size: :sm, class: "hidden group-has-[[data-step-conditional]:checked]/step:inline-flex group-first/step:!hidden", aria: { hidden: true }) do %>
          <%= t("journeys.admin.step_conditional_badge") %>
        <% end %>
      </div>
      <div class="-mr-2 flex items-center">
        <% [[:move_up, "journey-builder#moveUp", "M5 15l7-7 7 7", "group-first/step:invisible"],
            [:move_down, "journey-builder#moveDown", "M19 9l-7 7-7-7", "group-last/step:invisible"],
            [:remove_step, "journey-builder#remove", AdminPageComponent::ICONS[:trash], "hover:bg-danger-subtle hover:text-danger"]].each do |label_key, action, icon, extra| %>
          <% label = t("journeys.admin.#{label_key}") %>
          <button type="button" data-action="<%= action %>" aria-label="<%= label %>" title="<%= label %>"
                  class="inline-flex size-10 items-center justify-center rounded-md text-text-muted transition-base hover:bg-surface-hover hover:text-text-primary sm:size-8 <%= extra %>">
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>" /></svg>
          </button>
        <% end %>
      </div>
    </div>

    <div class="mt-2 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <label class="block min-w-0 group-data-[step-lead]/step:hidden">
        <span class="form-label"><%= t("journeys.admin.step_type") %></span>
        <%= select_tag field(:kind), options_for_select(kind_options, kind_value), id: nil, class: "input-field min-h-10 w-full",
                       data: { step_kind: true, action: "change->journey-builder#kindChanged" } %>
      </label>
      <div class="min-w-0">
        <label class="block min-w-0">
          <span class="form-label"><%= t("journeys.admin.step_page") %></span>
          <%= select_tag field(:page_id), grouped_options_for_select(grouped_page_options, page_id), include_blank: t("journeys.admin.step_page_none"),
                         id: nil, class: "input-field min-h-10 w-full",
                         data: { step_page: true, action: "change->journey-builder#pageChanged" },
                         aria: { describedby: hint_id } %>
        </label>
        <p data-step-hint id="<%= hint_id %>" class="mt-1.5 text-xs text-text-muted"><%= hint_text %></p>
      </div>
      <label class="block min-w-0">
        <span class="form-label"><%= t("journeys.admin.step_label") %></span>
        <%= text_field_tag field(:label), label_value, id: nil, maxlength: 120, placeholder: t("journeys.admin.step_label_placeholder"),
                           class: "input-field min-h-10 w-full", data: { step_label: true, action: "input->journey-builder#refresh" } %>
      </label>
    </div>

    <div class="mt-3 space-y-3 border-t border-border-subtle pt-3 group-data-[step-lead]/step:hidden">
      <fieldset data-step-inputs-section class="hidden min-w-0 group-data-[step-mode=relate]/step:block">
        <legend class="form-label"><%= t("journeys.admin.step_fill") %></legend>
        <div data-step-inputs class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <% fill_inputs.each do |input| %>
            <label class="block min-w-0">
              <span class="form-label"><%= t("journeys.admin.step_fill_from", field: input.label) %></span>
              <%= select_tag input_field(input.field), options_for_select(input_choices(input.entity_id), selected_input(input.field, input.entity_id)),
                             include_blank: t("journeys.admin.step_fill_none"), id: nil, class: "input-field min-h-10 w-full",
                             data: { step_input: true, step_input_entity: input.entity_id.to_s } %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <p class="hidden text-sm text-text-muted group-data-[step-mode=create]/step:block"><%= t("journeys.admin.step_independent") %></p>

      <div class="hidden min-w-0 max-w-md group-data-[step-mode=update]/step:block">
        <label class="block min-w-0">
          <span class="form-label"><%= t("journeys.admin.step_record") %></span>
          <%= select_tag field(:record), options_for_select(record_choices, selected_record), include_blank: t("journeys.admin.step_fill_none"),
                         id: nil, class: "input-field min-h-10 w-full", aria: { describedby: "#{hint_id}-record" },
                         data: { step_record: true, step_input_entity: record_entity.to_s } %>
        </label>
        <p id="<%= hint_id %>-record" data-step-record-hint class="mt-1.5 text-xs text-text-muted"><%= t("journeys.admin.step_record_hint") %></p>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <label class="hidden min-w-0 cursor-pointer items-start gap-3 group-data-[step-mode=relate]/step:flex">
          <%= check_box_tag field(:repeat), "1", repeat?, id: nil, class: "mt-0.5 size-4 shrink-0 rounded border-border accent-accent" %>
          <span class="min-w-0">
            <span class="block text-sm font-medium text-text-primary"><%= t("journeys.admin.step_repeat") %></span>
            <span class="block text-xs text-text-muted"><%= t("journeys.admin.step_repeat_hint") %></span>
          </span>
        </label>
        <label class="hidden min-w-0 cursor-pointer items-start gap-3 group-data-[step-mode=create]/step:flex group-data-[step-mode=relate]/step:flex group-data-[step-mode=update]/step:flex">
          <%= check_box_tag field(:optional), "1", optional?, id: nil, class: "mt-0.5 size-4 shrink-0 rounded border-border accent-accent",
                            data: { step_optional: true, action: "change->journey-builder#refresh" } %>
          <span class="min-w-0">
            <span class="block text-sm font-medium text-text-primary"><%= t("journeys.admin.step_optional") %></span>
            <span class="block text-xs text-text-muted"><%= t("journeys.admin.step_optional_hint") %></span>
          </span>
        </label>
        <label class="hidden min-w-0 cursor-pointer items-start gap-3 group-first/step:!hidden group-data-[step-mode=create]/step:flex group-data-[step-mode=relate]/step:flex group-data-[step-mode=update]/step:flex">
          <%= check_box_tag field(:conditional), "1", conditional?, id: nil, class: "mt-0.5 size-4 shrink-0 rounded border-border accent-accent",
                            data: { step_conditional: true, action: "change->journey-builder#refresh" } %>
          <span class="min-w-0">
            <span class="block text-sm font-medium text-text-primary"><%= t("journeys.admin.step_conditional") %></span>
            <span class="block text-xs text-text-muted"><%= t("journeys.admin.step_conditional_hint") %></span>
            <span data-step-skipped-by class="mt-1 hidden text-xs font-medium text-text-secondary group-has-[[data-step-conditional]:checked]/step:block"><%= skipped_by_text %></span>
          </span>
        </label>
      </div>
    </div>

    <%= render effects_component %>
  </div>
</li>
