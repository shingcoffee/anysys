<% if compact? %>
  <div class="flex items-start gap-2.5 rounded-lg border border-border-subtle bg-canvas-elevated px-3 py-2.5">
    <% if icon %>
      <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-surface">
        <svg class="h-3.5 w-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/>
        </svg>
      </div>
    <% end %>
    <div class="min-w-0 flex-1">
      <div class="stat-label"><%= label %></div>
      <div class="mt-0.5 text-lg font-semibold tabular-nums tracking-tight text-text-primary"><%= value %></div>
      <% if sub_label %><div class="mt-0.5 truncate text-xs text-text-muted"><%= sub_label %></div><% end %>
    </div>
  </div>
<% else %>
  <div class="stat-card group">
    <div class="mb-3 flex items-center gap-2">
      <% if icon %>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface-active transition-base group-hover:bg-accent-subtle">
          <svg class="h-4 w-4 text-text-muted transition-base group-hover:text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/>
          </svg>
        </div>
      <% end %>
      <div class="stat-label"><%= label %></div>
    </div>
    <div class="stat-value"><%= value %></div>
    <% if sub_label %><div class="mt-2 text-xs text-text-muted"><%= sub_label %></div><% end %>
  </div>
<% end %>
