<% if compact? %>
  <%= link_to path, class: "group flex flex-1 items-center gap-3.5 px-4 py-3 no-underline transition-base hover:bg-canvas-elevated/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-inset" do %>
    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl transition-base <%= compact_icon_classes %>">
      <% if icon %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/>
        </svg>
      <% else %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      <% end %>
    </div>
    <div class="min-w-0 flex-1">
      <div class="truncate text-sm font-semibold text-text-primary transition-colors group-hover:text-accent"><%= label %></div>
      <div class="mt-0.5 line-clamp-1 text-xs leading-relaxed text-text-muted"><%= description %></div>
    </div>
    <span class="flex size-7 shrink-0 items-center justify-center rounded-lg text-text-muted transition-base group-hover:translate-x-0.5 group-hover:bg-accent-subtle group-hover:text-accent" aria-hidden="true">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
      </svg>
    </span>
  <% end %>
<% else %>
  <%= link_to path, class: "group block p-4 transition-base hover:bg-accent-subtle" do %>
    <div class="flex items-start gap-3">
      <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg border border-border-subtle bg-surface shadow-xs transition-base group-hover:border-accent-muted group-hover:bg-accent-subtle">
        <% if icon %>
          <svg class="h-4 w-4 text-text-muted transition-base group-hover:text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/>
          </svg>
        <% else %>
          <svg class="h-4 w-4 text-text-muted transition-base group-hover:text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
          </svg>
        <% end %>
      </div>
      <div class="min-w-0 flex-1">
        <div class="text-sm font-medium text-text-primary transition-base group-hover:text-accent"><%= label %></div>
        <div class="mt-0.5 text-xs leading-relaxed text-text-muted"><%= description %></div>
      </div>
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-border-strong transition-base group-hover:text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
      </svg>
    </div>
  <% end %>
<% end %>
