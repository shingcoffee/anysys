<div class="flex flex-col gap-1.5">
  <% if field_label.present? %>
    <span id="<%= input_id %>-label" class="text-sm font-medium text-text-primary"><%= field_label %></span>
  <% end %>
  <label class="<%= dropzone_classes %>" <%= tag.attributes(aria: dropzone_aria) %>>
    <input type="file" name="<%= name %>" id="<%= input_id %>" accept="<%= accept %>" multiple
           data-help-attachments-target="input"
           data-action="change->help-attachments#changed"
           class="absolute inset-0 size-full opacity-0 cursor-pointer">
    <svg class="<%= compact? ? "size-4" : "size-8" %> text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/>
    </svg>
    <span class="text-xs text-text-muted <%= "truncate" if compact? %>"><%= hint %></span>
  </label>
  <p class="hidden text-xs text-danger" data-help-attachments-target="error"></p>
  <ul class="flex flex-wrap gap-2" data-help-attachments-target="list"></ul>
</div>
