<div class="hidden fixed top-2 left-1/2 -translate-x-1/2 z-50 bg-white rounded-xl shadow-xl border border-gray-200 px-4 py-2 flex items-center gap-3 overflow-x-auto max-w-[calc(100vw-2rem)]"
     data-page-builder-target="floatingActionBar">

  <%# Selection count %>
  <span class="text-xs font-medium text-gray-600 whitespace-nowrap" data-page-builder-target="selectionCount">
    <%= t("comp_page_builder.floating_action_bar.selection_count", count: 0) %>
  </span>

  <div class="h-5 w-px bg-gray-200"></div>

  <%# Width buttons %>
  <div class="flex items-center gap-1">
    <% width_options.each do |opt| %>
      <button type="button"
              class="px-2 py-1 text-xs font-medium text-gray-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"
              data-action="click->page-builder#bulkSetWidth"
              data-width="<%= opt[:key] %>"
              title="<%= t("comp_page_builder.floating_action_bar.set_width", label: opt[:label]) %>">
        <%= opt[:label] %>
      </button>
    <% end %>
  </div>

  <div class="h-5 w-px bg-gray-200"></div>

  <%# Duplicate %>
  <button type="button"
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-gray-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"
          data-action="click->page-builder#bulkDuplicate"
          title="<%= t("comp_page_builder.floating_action_bar.duplicate_selected") %>">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
    <%= t("common.actions.duplicate") %>
  </button>

  <%# Move to Page %>
  <button type="button"
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-gray-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"
          data-action="click->page-builder#openMoveToPageModal"
          title="<%= t("comp_page_builder.floating_action_bar.move_to_page_title") %>">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
    </svg>
    <%= t("comp_page_builder.floating_action_bar.move_to_page") %>
  </button>

  <%# Group into Section %>
  <button type="button"
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-gray-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"
          data-action="click->page-builder#groupIntoSection"
          title="<%= t("comp_page_builder.floating_action_bar.group_into_section_title") %>">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
    </svg>
    <%= t("comp_page_builder.floating_action_bar.group_into_section") %>
  </button>

  <div class="h-5 w-px bg-gray-200"></div>

  <%# Delete %>
  <button type="button"
          class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-red-500 hover:text-red-700 hover:bg-red-50 rounded-md transition-colors"
          data-action="click->page-builder#bulkDelete"
          title="<%= t("comp_page_builder.floating_action_bar.delete_selected") %>">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
    </svg>
    <%= t("common.actions.delete") %>
  </button>
</div>
