<%# app/components/page_builder/calculation_editor_component.html.erb %>
<%# Calc Editor — rendered into <template> and cloned by calculations_manager.js %>
<%# The modal chrome (header/close) is provided by ConfigModalComponent. %>
<%# The formula-editor controller is rooted HERE (not in the pill sub-component) so the %>
<%# function inserter tabs/search/chips below are inside its Stimulus scope. %>
<div data-controller="formula-editor"
     data-formula-editor-fields-value="<%= fields_json %>"
     data-formula-editor-formula-value="<%= formula %>"
     data-formula-editor-valid-label-value="<%= t("comp_page_builder.calc_editor.validation.valid_label") %>"
     data-formula-editor-errors-singular-format-value="<%= t("comp_page_builder.calc_editor.validation.errors_singular_format") %>"
     data-formula-editor-errors-plural-format-value="<%= t("comp_page_builder.calc_editor.validation.errors_plural_format") %>"
     data-formula-editor-preview-format-value="<%= t("comp_page_builder.calc_editor.validation.preview_format") %>">

  <%# Back bar %>
  <div class="px-4 py-3 border-b border-gray-100 flex items-center gap-3">
    <button type="button"
            class="p-1.5 -ml-1 text-gray-400 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors"
            data-action="click->page-builder#closeFormulaEditor"
            aria-label="<%= t("comp_page_builder.calc_editor.back_aria") %>">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <span class="text-sm font-medium text-gray-700"><%= t("comp_page_builder.calc_editor.title") %></span>
  </div>

  <%# Target Field %>
  <div class="px-4 py-4 border-b border-gray-100">
    <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5"><%= t("comp_page_builder.calc_editor.target_field") %></label>
    <select data-page-builder-target="calculationTargetField"
            class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500/30 focus:border-purple-400 appearance-none">
      <option value=""><%= t("comp_page_builder.calc_editor.select_field") %></option>
      <% if pages_grouped? %>
        <% pages.each do |page| %>
          <% page_fields = (page["fields"] || []).select { |pf| fields.any? { |f| f["id"] == pf["id"] } } %>
          <% next if page_fields.empty? %>
          <optgroup label="<%= page["name"] %>">
            <% page_fields.each do |f| %>
              <option value="<%= f["id"] %>" <%= "selected" if target_field_id == f["id"] %>>
                <%= f["label"] || f["id"] %>
              </option>
            <% end %>
          </optgroup>
        <% end %>
      <% else %>
        <% fields.each do |f| %>
          <option value="<%= f["id"] %>" <%= "selected" if target_field_id == f["id"] %>>
            <%= f["label"] || f["id"] %>
          </option>
        <% end %>
      <% end %>
    </select>
  </div>

  <%# Formula pill editor %>
  <div class="px-4 py-4 border-b border-gray-100">
    <label class="block text-xs font-medium text-gray-500 uppercase tracking-wide mb-1.5"><%= t("comp_page_builder.calc_editor.formula") %></label>
    <%= render PageBuilder::FormulaPillEditorComponent.new(formula: formula, fields: fields, embedded: true) %>

    <%# Insert a field reference (also: type "{" in the formula to search fields) %>
    <div class="mt-2 flex items-center gap-2">
      <select data-action="change->formula-editor#insertFieldChip"
              class="px-2 py-1.5 text-xs border border-gray-200 rounded-md bg-white max-w-[200px] focus:outline-none focus:ring-1 focus:ring-purple-500">
        <option value=""><%= t("comp_page_builder.calc_editor.insert_field") %></option>
        <% fields.each do |f| %>
          <option value="<%= f["id"] %>"><%= f["label"] || f["id"] %></option>
        <% end %>
      </select>
      <span class="text-[11px] text-gray-400"><%= t("comp_page_builder.calc_editor.type_prefix") %> <code class="px-1 bg-gray-100 rounded">{</code> <%= t("comp_page_builder.calc_editor.type_suffix") %></span>
    </div>
  </div>

  <%# Function Inserter %>
  <div class="px-4 py-3 border-b border-gray-100">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2"><%= t("comp_page_builder.calc_editor.insert_function") %></p>

    <%# Tab bar + search input %>
    <div class="flex items-center gap-2 mb-2">
      <div class="flex items-center gap-0.5 flex-1 bg-gray-100 rounded-lg p-0.5" data-fn-tabs>
        <% ["Math", "Logic", "Text", "Date"].each_with_index do |cat, i| %>
          <button type="button"
                  class="px-2.5 py-1 text-xs font-medium rounded-md transition-all <%= i == 0 ? "bg-white text-gray-900 shadow-sm" : "text-gray-500 hover:text-gray-700" %>"
                  data-category="<%= cat %>"
                  data-action="click->formula-editor#switchFunctionTab">
            <%= t("comp_page_builder.calc_editor.function_categories.#{cat.downcase}") %>
          </button>
        <% end %>
      </div>
      <input type="text"
             class="px-2 py-1 text-xs border border-gray-200 rounded-md w-28 focus:outline-none focus:ring-1 focus:ring-purple-500"
             placeholder="<%= t("comp_page_builder.calc_editor.filter_placeholder") %>"
             data-action="input->formula-editor#filterFunctions"
             data-formula-editor-target="fnSearch">
    </div>

    <%# Function chips grid %>
    <div class="flex flex-wrap gap-1.5 min-h-[52px]" data-formula-editor-target="fnGrid">
      <% functions.each do |category, fn_names| %>
        <% fn_names.each do |fn_name| %>
          <button type="button"
                  class="inline-flex items-center px-2 py-1 text-[11px] font-mono font-medium bg-gray-50 border border-gray-200 text-gray-700 rounded-md cursor-pointer hover:bg-purple-50 hover:border-purple-300 hover:text-purple-700 transition-colors"
                  style="<%= "display:none" unless category == "Math" %>"
                  data-fn-insert
                  data-function="<%= fn_name %>"
                  data-category="<%= category %>"
                  data-action="click->formula-editor#insertFunctionToken"
                  title="<%= fn_name %>()">
            <%= fn_name %>
          </button>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Output Format controls %>
  <div class="px-4 py-4 border-b border-gray-100">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3"><%= t("comp_page_builder.calc_editor.output_format") %></p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div>
        <label class="block text-xs text-gray-500 mb-1"><%= t("common.labels.type") %></label>
        <select data-calc-format="type"
                class="w-full px-2.5 py-1.5 text-sm border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-purple-500 appearance-none">
          <% format_types.each do |ft| %>
            <option value="<%= ft[:value] %>" <%= "selected" if (format["type"] || "plain") == ft[:value] %>>
              <%= ft[:label] %>
            </option>
          <% end %>
        </select>
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1"><%= t("comp_page_builder.calc_editor.decimals") %></label>
        <input type="number"
               data-calc-format="decimals"
               min="0" max="10"
               value="<%= format["decimals"] || 2 %>"
               class="w-full px-2.5 py-1.5 text-sm border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-purple-500">
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1"><%= t("comp_page_builder.calc_editor.prefix") %></label>
        <input type="text"
               data-calc-format="prefix"
               value="<%= format["prefix"] || "" %>"
               placeholder="<%= t("comp_page_builder.calc_editor.prefix_placeholder") %>"
               class="w-full px-2.5 py-1.5 text-sm border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-purple-500">
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1"><%= t("comp_page_builder.calc_editor.suffix") %></label>
        <input type="text"
               data-calc-format="suffix"
               value="<%= format["suffix"] || "" %>"
               placeholder="<%= t("comp_page_builder.calc_editor.suffix_placeholder") %>"
               class="w-full px-2.5 py-1.5 text-sm border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-purple-500">
      </div>
    </div>
  </div>

  <%# Sample Values for Preview %>
  <div class="px-4 py-4 border-b border-gray-100">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2"><%= t("comp_page_builder.calc_editor.sample_values") %></p>
    <p class="text-xs text-gray-400 italic mb-2"><%= t("comp_page_builder.calc_editor.sample_hint") %></p>
    <div data-calc-sample-values data-formula-editor-target="sampleInputs" class="space-y-2"></div>
  </div>

  <%# Footer: Cancel + Save %>
  <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100 bg-white sticky bottom-0 flex-shrink-0">
    <button type="button"
            class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded-lg transition-colors"
            data-action="click->page-builder#closeFormulaEditor">
      <%= t("common.actions.cancel") %>
    </button>
    <button type="button"
            class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium bg-purple-600 hover:bg-purple-700 text-white rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-1"
            data-action="click->page-builder#saveCalculation">
      <%= t("common.actions.save") %>
    </button>
  </div>

</div>
