<%# app/components/page_builder/calculations_panel_component.html.erb %>
<%# Rendered inside the drawer list layer. data-calculations-panel is the JS refresh target. %>
<div data-calculations-panel class="px-4 py-4">

  <%# Top bar: count + Add Calculation %>
  <div class="flex items-center justify-between mb-3">
    <p class="text-xs text-gray-500"><%= t("comp_page_builder.calculations_panel.count", count: calculations.length) %></p>
    <button type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-purple-600 bg-purple-50 hover:bg-purple-100 rounded-md transition-colors"
            data-action="click->page-builder#openFormulaEditor">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      <%= t("comp_page_builder.calculations_panel.add") %>
    </button>
  </div>

  <%# Search (shown when > 6 calculations) %>
  <% if show_search? %>
    <div class="mb-3">
      <input type="text"
             placeholder="<%= t("comp_page_builder.calculations_panel.search_placeholder") %>"
             class="w-full px-2.5 py-1.5 text-xs border border-gray-200 rounded-md focus:outline-none focus:ring-1 focus:ring-purple-500"
             data-action="input->page-builder#filterPanel"
             data-filter-panel="calculations-panel"
             data-filter-items="calculation-id">
    </div>
  <% end %>

  <% if empty? %>
    <%# Empty state %>
    <div class="flex flex-col items-center justify-center py-16 text-center px-4">
      <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center mb-3">
        <svg class="w-6 h-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        </svg>
      </div>
      <p class="text-sm font-medium text-gray-900 mb-1"><%= t("comp_page_builder.calculations_panel.empty_title") %></p>
      <p class="text-xs text-gray-500 max-w-[240px] mb-5"><%= t("comp_page_builder.calculations_panel.empty_desc") %></p>
      <button type="button"
              class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium bg-purple-600 hover:bg-purple-700 text-white rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-1"
              data-action="click->page-builder#openFormulaEditor">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <%= t("comp_page_builder.calculations_panel.add") %>
      </button>
    </div>
  <% else %>
    <div class="space-y-2">
      <% calculations.each do |calc| %>
        <div data-calculation-id="<%= calc['id'] %>"
             class="group flex items-center justify-between p-3 bg-white rounded-lg border border-gray-200 hover:border-purple-200 hover:shadow-sm transition-all">
          <div class="min-w-0 flex flex-col gap-0.5">
            <div class="flex items-center gap-1.5">
              <span class="text-sm font-medium text-gray-800 truncate"><%= field_label(calc['target_field_id']) %></span>
              <% if (badge = format_badge(calc)) %>
                <span class="px-1.5 py-0.5 text-[10px] rounded-md bg-purple-100 text-purple-700 font-medium"><%= badge %></span>
              <% end %>
            </div>
            <span class="text-xs text-gray-500 font-mono block truncate max-w-[300px]">
              = <%= truncate_formula(calc['formula']) %>
            </span>
          </div>
          <div class="flex items-center gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0">
            <button type="button"
                    class="p-1.5 text-gray-400 hover:text-purple-600 hover:bg-purple-50 rounded-md transition-colors"
                    data-action="click->page-builder#editCalculation"
                    data-calculation-id="<%= calc['id'] %>"
                    title="<%= t("comp_page_builder.calculations_panel.edit_calculation") %>">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </button>
            <button type="button"
                    class="p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-md transition-colors"
                    data-action="click->page-builder#deleteCalculation"
                    data-calculation-id="<%= calc['id'] %>"
                    title="<%= t("comp_page_builder.calculations_panel.delete_calculation") %>">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
