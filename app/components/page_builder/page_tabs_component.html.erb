<div class="flex items-center bg-gray-100 px-3 py-1.5" data-page-builder-target="pageTabs">
  <div class="flex items-center gap-1 overflow-x-auto">
    <% sorted_pages.each do |page_data| %>
      <div class="page-tab inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors cursor-pointer <%= active?(page_data) ? 'bg-indigo-600 text-white shadow-md' : 'text-gray-500 hover:text-gray-700 hover:bg-white/60' %>"
           draggable="true"
           data-page-id="<%= page_data['id'] %>"
           data-action="click->page-builder#switchPage dragstart->page-builder#pageTabDragStart dragend->page-builder#pageTabDragEnd dragover->page-builder#pageTabDragOver drop->page-builder#pageTabDrop">
        <span data-page-name><%= page_data['name'] %></span>
        <% if show_delete_button? %>
          <div class="flex items-center gap-0.5">
            <button type="button"
                    class="p-0.5 rounded transition-colors <%= active?(page_data) ? 'text-indigo-200 hover:text-white' : 'text-gray-400 hover:text-indigo-600' %>"
                    data-page-id="<%= page_data['id'] %>"
                    data-action="click->page-builder#renamePage"
                    title="<%= t("comp_page_builder.page_tabs.rename") %>">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </button>
            <button type="button"
                    class="p-0.5 rounded transition-colors <%= active?(page_data) ? 'text-indigo-200 hover:text-white' : 'text-gray-400 hover:text-red-500' %>"
                    data-page-id="<%= page_data['id'] %>"
                    data-action="click->page-builder#deletePage"
                    title="<%= t("comp_page_builder.page_tabs.delete") %>">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <button type="button"
          class="ml-1 inline-flex items-center p-1.5 text-gray-400 hover:text-gray-600 hover:bg-white/50 rounded-md transition-colors"
          data-action="click->page-builder#addPage"
          title="<%= t("comp_page_builder.page_tabs.add") %>">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
  </button>
</div>
