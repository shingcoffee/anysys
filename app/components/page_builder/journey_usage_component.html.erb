<section class="w-full bg-white rounded-lg border border-gray-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.04)] overflow-hidden"
         data-role="journey-usage" aria-labelledby="journey-usage-title">
  <div class="px-3 py-2.5 flex items-center justify-between gap-2">
    <div class="flex min-w-0 items-center gap-2.5">
      <div class="w-6 h-6 rounded-md bg-sky-50 border border-sky-100 flex items-center justify-center flex-shrink-0">
        <svg class="w-3.5 h-3.5 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
        </svg>
      </div>
      <h2 id="journey-usage-title" class="truncate text-xs font-semibold text-gray-700"><%= t("journeys.admin.usage.title") %></h2>
    </div>
    <span class="text-[10px] font-medium tabular-nums text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded-md min-w-[20px] text-center"
          data-role="journey-usage-count"><%= journeys.size %></span>
  </div>

  <% if journeys.any? %>
    <ul class="px-2.5 pb-2 pt-0.5 space-y-0.5 border-t border-gray-100">
      <% journeys.each do |journey| %>
        <li>
          <%= link_to edit_path(journey), class: "group flex items-center gap-2 rounded-md px-2 py-1.5 text-xs text-gray-600 hover:bg-gray-50 transition-colors" do %>
            <span class="size-1.5 shrink-0 rounded-full <%= status_dot(journey) %>" title="<%= status_label(journey) %>" aria-hidden="true"></span>
            <span class="min-w-0 flex-1 truncate group-hover:text-indigo-600"><%= journey.name %></span>
            <span class="sr-only"><%= status_label(journey) %></span>
            <span class="shrink-0 text-[10px] text-gray-400" data-role="journey-usage-role"><%= role_label(journey) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="px-4 py-4 text-[11px] text-gray-400 border-t border-gray-100"><%= t("journeys.admin.usage.empty") %></p>
  <% end %>
</section>
