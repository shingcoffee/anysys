<%# Icon-only layout-components palette. Lives inside the page-builder toolbar. %>
<div class="flex items-center gap-0.5" data-page-builder-target="quickAddToolbar">

  <%# Structure: Section, Card, Columns, Divider, Spacer %>
  <div class="flex items-center gap-0.5">
    <button type="button" class="p-1.5 rounded-md text-violet-500 hover:text-violet-700 hover:bg-violet-50 transition-all" title="<%= t("comp_page_builder.component_palette.section") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="section" data-component-label="Section">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-violet-500 hover:text-violet-700 hover:bg-violet-50 transition-all" title="<%= t("comp_page_builder.component_palette.card") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="card" data-component-label="Card">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-violet-500 hover:text-violet-700 hover:bg-violet-50 transition-all" title="<%= t("comp_page_builder.component_palette.columns") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="columns" data-component-label="Columns">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15M4.5 4.5h15a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5h-15A1.5 1.5 0 013 18V6a1.5 1.5 0 011.5-1.5z" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-violet-500 hover:text-violet-700 hover:bg-violet-50 transition-all" title="<%= t("comp_page_builder.component_palette.divider") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="divider" data-component-label="Divider">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-violet-500 hover:text-violet-700 hover:bg-violet-50 transition-all" title="<%= t("comp_page_builder.component_palette.spacer") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="spacer" data-component-label="Spacer">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7l4-4m0 0l4 4m-4-4v18" /></svg>
    </button>
  </div>

  <div class="h-5 w-px bg-slate-200 mx-1 flex-shrink-0"></div>

  <%# Content: Heading, Paragraph, List, Quote, Code Block %>
  <div class="flex items-center gap-0.5">
    <button type="button" class="p-1.5 rounded-md text-emerald-500 hover:text-emerald-700 hover:bg-emerald-50 transition-all" title="<%= t("comp_page_builder.component_palette.heading") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="heading" data-component-label="Heading">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 4v16M17 4v16M7 12h10" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-emerald-500 hover:text-emerald-700 hover:bg-emerald-50 transition-all" title="<%= t("comp_page_builder.component_palette.paragraph") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="paragraph" data-component-label="Paragraph">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-emerald-500 hover:text-emerald-700 hover:bg-emerald-50 transition-all" title="<%= t("comp_page_builder.component_palette.list") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="list" data-component-label="List">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-emerald-500 hover:text-emerald-700 hover:bg-emerald-50 transition-all" title="<%= t("comp_page_builder.component_palette.quote") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="quote" data-component-label="Quote">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6v12M9 8h12M9 12h10M9 16h8" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-emerald-500 hover:text-emerald-700 hover:bg-emerald-50 transition-all" title="<%= t("comp_page_builder.component_palette.code_block") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="code_block" data-component-label="Code Block">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>
    </button>
  </div>

  <div class="h-5 w-px bg-slate-200 mx-1 flex-shrink-0"></div>

  <%# Media & Actions: Image, Video, Button %>
  <div class="flex items-center gap-0.5">
    <button type="button" class="p-1.5 rounded-md text-amber-500 hover:text-amber-700 hover:bg-amber-50 transition-all" title="<%= t("comp_page_builder.component_palette.image") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="image" data-component-label="Image">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-amber-500 hover:text-amber-700 hover:bg-amber-50 transition-all" title="<%= t("comp_page_builder.component_palette.video") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="video" data-component-label="Video">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-amber-500 hover:text-amber-700 hover:bg-amber-50 transition-all" title="<%= t("comp_page_builder.component_palette.button") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="button" data-component-label="Button">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zM12 2.25V4.5m5.834.166l-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243l-1.59-1.59" /></svg>
    </button>
  </div>

  <div class="h-5 w-px bg-slate-200 mx-1 flex-shrink-0"></div>

  <%# Feedback: Alert, Callout, Progress %>
  <div class="flex items-center gap-0.5">
    <button type="button" class="p-1.5 rounded-md text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition-all" title="<%= t("comp_page_builder.component_palette.alert") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="alert" data-component-label="Alert">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition-all" title="<%= t("comp_page_builder.component_palette.callout") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="callout" data-component-label="Callout">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-rose-500 hover:text-rose-700 hover:bg-rose-50 transition-all" title="<%= t("comp_page_builder.component_palette.progress_bar") %>"
            data-action="click->page-builder#insertFromToolbar" data-component-type="progress_bar" data-component-label="Progress Bar">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
    </button>
  </div>

  <div class="h-5 w-px bg-slate-200 mx-1 flex-shrink-0"></div>

  <%# Layout: Field Width (contextual - active when a field is selected) %>
  <div class="flex items-center gap-0.5 opacity-30 cursor-not-allowed transition-opacity"
       data-page-builder-target="toolbarWidthGroup">
    <button type="button" class="p-1.5 rounded-md text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all"
            title="<%= t("comp_page_builder.component_palette.width_full") %>" data-action="click->page-builder#setFieldWidth" data-width="full"
            data-page-builder-target="toolbarWidthBtn">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
      </svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all"
            title="<%= t("comp_page_builder.component_palette.width_half") %>" data-action="click->page-builder#setFieldWidth" data-width="half"
            data-page-builder-target="toolbarWidthBtn">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <rect x="3" y="5" width="8.5" height="14" rx="1.5"/>
        <rect x="12.5" y="5" width="8.5" height="14" rx="1.5" opacity="0.35"/>
      </svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all"
            title="<%= t("comp_page_builder.component_palette.width_two_thirds") %>" data-action="click->page-builder#setFieldWidth" data-width="two_thirds"
            data-page-builder-target="toolbarWidthBtn">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <rect x="3" y="5" width="12" height="14" rx="1.5"/>
        <rect x="16.5" y="5" width="4.5" height="14" rx="1.5" opacity="0.35"/>
      </svg>
    </button>
    <button type="button" class="p-1.5 rounded-md text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 transition-all"
            title="<%= t("comp_page_builder.component_palette.width_third") %>" data-action="click->page-builder#setFieldWidth" data-width="third"
            data-page-builder-target="toolbarWidthBtn">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <rect x="3" y="5" width="5" height="14" rx="1.5"/>
        <rect x="9.5" y="5" width="5" height="14" rx="1.5" opacity="0.35"/>
        <rect x="16" y="5" width="5" height="14" rx="1.5" opacity="0.35"/>
      </svg>
    </button>
  </div>
</div>
