<div class="<%= video_alignment_class %>">
  <% if video_present? %>
    <div class="relative w-full aspect-video">
      <iframe src="<%= embed_url %>"
              class="absolute inset-0 w-full h-full rounded-lg"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
    </div>
  <% else %>
    <div class="inline-flex items-center justify-center w-full h-48 <%= neutral(:track) %> rounded-lg border-2 border-dashed border-gray-300">
      <div class="text-center">
        <svg class="mx-auto w-10 h-10 <%= neutral(:faint_text) %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" />
        </svg>
        <p class="mt-2 text-sm <%= neutral(:muted_text) %>"><%= t("comp_form_fields.video.no_url") %></p>
      </div>
    </div>
  <% end %>
</div>
