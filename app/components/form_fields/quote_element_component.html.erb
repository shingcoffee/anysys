<blockquote class="pl-5 border-l-2 border-gray-300 py-2 pr-4">
  <p class="text-base <%= neutral(:body_text) %> italic leading-relaxed"><%= content_text %></p>
  <% if attribution_present? %>
    <cite class="block mt-3 text-xs <%= neutral(:faint_text) %> not-italic tracking-wide uppercase">&mdash; <%= attribution %></cite>
  <% end %>
</blockquote>
