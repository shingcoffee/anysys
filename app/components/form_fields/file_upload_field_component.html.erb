<div class="<%= wrapper_classes %>">
  <label for="<%= field_id %>" class="<%= label_classes %>">
    <%= label %>
    <%= required_indicator %>
  </label>

  <div data-file-drop-zone class="<%= dropzone_classes %>">
    <input type="file"
           name="<%= multiple ? "#{field_name.to_s.delete_suffix('[]')}[]" : field_name %>"
           id="<%= field_id %>"
           <% if accept.present? %>accept="<%= accept %>"<% end %>
           <%= 'multiple' if multiple %>
           <%= 'required' if input_required? %>
           <%= 'disabled' if html_attributes[:disabled] %>
           class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">

    <svg class="<%= dropzone_icon_classes %>" stroke="currentColor" fill="none" viewBox="0 0 48 48">
      <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>

    <div class="mt-4">
      <span class="<%= upload_cta_classes %>"><%= t("comp_form_fields.file_upload.click_to_upload") %></span>
      <span class="text-sm text-gray-500"><%= t("comp_form_fields.file_upload.or_drag_and_drop") %></span>
    </div>

    <p class="mt-1 text-xs text-gray-400">
      <% if accept.present? %>
        <%= accept.gsub('/*', t("comp_form_fields.file_upload.files_suffix")).gsub(',', ', ') %>
      <% else %>
        <%= t("comp_form_fields.file_upload.any_file_type") %>
      <% end %>
      <% if max_size_label %>
        <%= t("comp_form_fields.file_upload.up_to", size: max_size_label) %>
      <% end %>
    </p>
  </div>

  <% if current_files.any? %>
    <p class="mt-2 text-sm text-gray-600 break-words [overflow-wrap:anywhere]">
      <%= t("comp_form_fields.file_upload.current_files", names: current_files.join(", ")) %>
    </p>
    <p class="mt-0.5 text-xs text-gray-500"><%= t("comp_form_fields.file_upload.keep_current_hint") %></p>
  <% end %>

  <% if html_attributes[:help_text].present? %>
    <p class="mt-1 text-sm text-gray-500"><%= html_attributes[:help_text] %></p>
  <% end %>
</div>
