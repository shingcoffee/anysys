<figure class="<%= alignment_class(alignment) %>">
  <% if image_present? %>
    <img src="<%= image_url %>" alt="<%= alt_text %>" class="inline-block max-w-full rounded-lg">
  <% else %>
    <div class="inline-flex items-center justify-center w-full h-48 <%= neutral(:track) %> rounded-lg border-2 border-dashed border-gray-300">
      <div class="text-center">
        <svg class="mx-auto w-10 h-10 <%= neutral(:faint_text) %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
        </svg>
        <p class="mt-2 text-sm <%= neutral(:muted_text) %>"><%= t("comp_form_fields.image.no_url") %></p>
      </div>
    </div>
  <% end %>
</figure>
