<div class="<%= form_container_classes %>">
<form
  action="<%= action %>"
  method="<%= form_method %>"
  enctype="multipart/form-data"
  class="<%= form_classes %>"
  <% data.each do |key, value| %>
    data-<%= key.to_s.dasherize %>="<%= value %>"
  <% end %>
>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

  <% if hidden_method_field? %>
    <%= hidden_field_tag :_method, method %>
  <% end %>

  <div class="<%= field_spacing_class %>">
    <%= content %>
  </div>

  <button type="submit" class="<%= submit_button_classes %>">
    <%= submit_text %>
  </button>

  <% if extra_action %>
    <div class="mt-3"><%= render extra_action %></div>
  <% end %>
</form>
</div>
