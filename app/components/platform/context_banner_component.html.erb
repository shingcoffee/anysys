<div class="bg-amber-500 text-amber-950 px-4 py-2 flex items-center justify-between sticky top-0 z-50">
  <div class="flex items-center gap-2">
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
    </svg>
    <span class="font-semibold"><%= t("comp_platform.context_banner.platform_admin_mode") %></span>
    <span class="hidden sm:inline">&mdash;</span>
    <span><%= t("comp_platform.context_banner.acting_as") %> <strong><%= customer_name %></strong> <span class="text-amber-800"><%= t("comp_platform.context_banner.customer_id", id: customer_id) %></span></span>
  </div>

  <%= link_to t("comp_platform.context_banner.return_to_platform"),
      admin_maintenance_platform_customer_context_path(Authentication::User::PLATFORM_CUSTOMER_ID),
      data: { turbo_method: :delete },
      class: "bg-amber-700 hover:bg-amber-800 text-white px-3 py-1 rounded text-sm font-medium transition-colors" %>
</div>
