<%= form_with url: form_url, method: :post,
      class: "flex h-full min-h-0 flex-col bg-canvas",
      data: {
        controller: "generator-form",
        generator_form_preview_url_value: preview_source_url,
        generator_form_lines_count_format_value: t("comp_platform.code_generators.form.lines_count_format")
      } do %>
  <header class="z-30 flex-shrink-0 border-b border-border-subtle bg-surface">
    <div class="flex flex-wrap items-center gap-2 px-4 py-2 sm:min-h-12 sm:flex-nowrap">
      <%= link_to admin_maintenance_platform_code_generators_path(@customer_id),
            class: "flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-text-muted transition-colors hover:bg-surface-active hover:text-text-primary",
            title: t("comp_platform.code_generators.back_to_list"),
            aria: { label: t("comp_platform.code_generators.back_to_list") } do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      <% end %>
      <div class="h-4 w-px shrink-0 bg-border-subtle"></div>
      <h1 class="min-w-0 flex-1 truncate text-sm font-semibold text-text-primary"><%= t("comp_platform.code_generators.new_generator") %></h1>
      <span class="hidden text-caption md:inline"><%= t("comp_platform.code_generators.editor.save_shortcut") %></span>
      <div class="flex items-center gap-1.5">
        <%= render ButtonComponent.new(tag: :a, variant: :ghost, size: :sm, href: admin_maintenance_platform_code_generators_path(@customer_id)) do %>
          <%= t("common.actions.cancel") %>
        <% end %>
        <%= render ButtonComponent.new(variant: :primary, size: :sm, type: "submit") do %>
          <%= t("comp_platform.code_generators.form.create_generator") %>
        <% end %>
      </div>
    </div>
  </header>

  <div class="flex-1 overflow-y-auto">
    <div class="mx-auto w-full max-w-[1400px] space-y-4 p-4 sm:p-6">
      <% if errors.any? %>
        <%= render AlertComponent.new(message: errors.join(". "), type: :error) %>
      <% end %>

      <div class="flex flex-col gap-6 lg:flex-row">
        <div class="min-w-0 flex-1 space-y-4">
          <section class="card p-4">
            <h2 class="section-header mb-3"><%= t("comp_platform.code_generators.form.identity") %></h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              <div>
                <label for="generator-kind" class="form-label mb-1"><%= t("comp_platform.code_generators.form.kind") %></label>
                <select id="generator-kind" name="kind" data-action="change->generator-form#fieldChanged" class="input-field">
                  <option value="step_action" <%= "selected" if kind_selected?("step_action") %>><%= t("comp_platform.code_generators.form.kind_step_action") %></option>
                  <option value="element_type" <%= "selected" if kind_selected?("element_type") %>><%= t("comp_platform.code_generators.form.kind_element_type") %></option>
                </select>
              </div>
              <div>
                <label for="generator-file-name" class="form-label mb-1"><%= t("comp_platform.code_generators.form.file_name") %></label>
                <input id="generator-file-name" type="text" name="file_name" value="" placeholder="<%= t("comp_platform.code_generators.form.file_name_placeholder") %>"
                       data-action="input->generator-form#fieldChanged" class="input-field font-mono">
                <p class="mt-0.5 text-caption"><%= t("comp_platform.code_generators.form.file_name_hint") %></p>
              </div>
              <div>
                <label for="generator-category" class="form-label mb-1"><%= t("comp_platform.code_generators.form.category") %></label>
                <select id="generator-category" name="category" data-action="change->generator-form#fieldChanged" class="input-field">
                  <% category_options.each do |label, value| %>
                    <option value="<%= value %>" <%= "selected" if field(:category) == value %>><%= label %></option>
                  <% end %>
                </select>
              </div>
            </div>
          </section>

          <section class="card p-4">
            <h2 class="section-header mb-3"><%= t("comp_platform.code_generators.form.metadata") %></h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
              <div class="sm:col-span-2">
                <label for="generator-description" class="form-label mb-1"><%= t("common.labels.description") %></label>
                <input id="generator-description" type="text" name="description" value="<%= field(:description) %>"
                       placeholder="<%= t("comp_platform.code_generators.form.description_placeholder") %>"
                       data-action="input->generator-form#fieldChanged" class="input-field">
              </div>
              <div>
                <label for="generator-version" class="form-label mb-1"><%= t("comp_platform.code_generators.form.version") %></label>
                <input id="generator-version" type="text" name="version" value="<%= field(:version) %>" placeholder="<%= t("comp_platform.code_generators.form.version_placeholder") %>"
                       data-action="input->generator-form#fieldChanged" class="input-field font-mono">
              </div>
              <div class="sm:col-span-3">
                <label for="generator-registered-names" class="form-label mb-1">
                  <%= t("comp_platform.code_generators.form.registered_names") %>
                  <span class="font-normal text-text-muted"><%= t("comp_platform.code_generators.form.optional_paren") %></span>
                </label>
                <input id="generator-registered-names" type="text" name="registered_names" value="<%= field(:registered_names) %>"
                       placeholder="<%= t("comp_platform.code_generators.form.registered_names_placeholder") %>"
                       data-action="input->generator-form#fieldChanged" class="input-field font-mono">
                <p class="mt-0.5 text-caption"><%= t("comp_platform.code_generators.form.registered_names_hint") %></p>
              </div>
            </div>
          </section>

          <section class="card overflow-hidden" data-action="input->generator-form#fieldChanged">
            <div class="border-b border-border-subtle px-4 py-3">
              <h2 class="section-header"><%= t("comp_platform.code_generators.form.methods") %></h2>
            </div>
            <%= render Platform::CodeGenerators::SourceEditorComponent.new(
                  name: "methods_body",
                  value: field(:methods_body),
                  label: t("comp_platform.code_generators.form.methods")
                ) %>
          </section>
        </div>

        <aside class="w-full space-y-4 lg:w-[420px] lg:flex-shrink-0">
          <section class="card overflow-hidden">
            <div class="flex items-center justify-between border-b border-border-subtle px-4 py-3">
              <h2 class="section-header"><%= t("comp_platform.code_generators.form.preview_title") %></h2>
              <span data-generator-form-target="previewLineCount" class="text-caption text-text-muted"><%= t("comp_platform.code_generators.lines_count", count: 0) %></span>
            </div>
            <div class="max-h-[calc(100vh-220px)] overflow-auto bg-canvas-elevated p-4" data-generator-form-target="previewPanel">
              <div class="text-caption italic"><%= t("comp_platform.code_generators.form.preview_empty") %></div>
            </div>
          </section>
          <section class="card">
            <%= render Platform::CodeGenerators::HelperReferenceComponent.new %>
          </section>
        </aside>
      </div>
    </div>
  </div>
<% end %>
