<header class="bg-white border-b border-slate-200 flex-shrink-0 z-30">
  <div class="flex items-center h-12 px-4">

    <%# Left: back + title %>
    <div class="flex items-center gap-2 min-w-0">
      <%= link_to back_path,
          class: "flex items-center justify-center w-8 h-8 text-slate-500 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors",
          title: t("comp_platform.code_generators.index_toolbar.back_to_maintenance") do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      <% end %>

      <div class="h-4 w-px bg-slate-200"></div>

      <div class="flex items-center gap-1.5 min-w-0">
        <span class="text-sm font-semibold text-slate-900 truncate"><%= t("comp_platform.code_generators.title") %></span>
        <span class="text-[10px] font-medium text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded"><%= total_count %></span>
      </div>
    </div>

    <div class="flex-1"></div>

    <%# Right: New Generator %>
    <div class="flex items-center gap-1.5">
      <%= render ButtonComponent.new(tag: :a, variant: :primary, size: :sm, href: new_generator_path) do %>
        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <%= t("comp_platform.code_generators.new_generator") %>
      <% end %>
    </div>
  </div>
</header>
