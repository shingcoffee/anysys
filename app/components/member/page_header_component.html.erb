<header class="mb-10 md:mb-14">
  <% if eyebrow.present? %>
    <p class="mb-4">
      <%= link_to eyebrow[:path], class: chrome.text_link_class do %>
        <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M12.707 4.293a1 1 0 010 1.414L7.414 11H17a1 1 0 110 2H7.414l5.293 5.293a1 1 0 11-1.414 1.414l-7-7a1 1 0 010-1.414l7-7a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <%= eyebrow[:label] %>
      <% end %>
    </p>
  <% end %>

  <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div class="min-w-0">
      <h1 data-member-title class="<%= chrome.title_class %>"><%= title %></h1>
      <% if subtitle.present? %>
        <p class="mt-3 <%= chrome.subhead_class %>"><%= subtitle %></p>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-3 sm:justify-end">
      <% if meta.present? %>
        <span class="badge badge-<%= meta[:tone] || :default %>"><%= meta[:label] %></span>
      <% end %>

      <% actions.each do |action| %>
        <%= link_to action[:label], action[:path], class: variant_class(action[:variant]) %>
      <% end %>
    </div>
  </div>
</header>
