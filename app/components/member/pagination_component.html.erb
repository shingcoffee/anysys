<nav class="mt-8 flex flex-col gap-3 border-t pt-6 text-site-sm sm:flex-row sm:items-center sm:justify-between <%= chrome.hairline_class %>" aria-label="<%= t("pagy.aria_label.nav", count: total_count) %>">
  <span class="tabular-nums <%= chrome.muted_class %>"><%= t("pagy.info.multiple_pages", item_name: t("pagy.item_name", count: total_count), from: from, to: to, count: total_count) %></span>
  <div class="flex items-center gap-2">
    <% if show_previous? %>
      <%= link_to previous_path, class: chrome.pager_link_class do %>
        <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M12.707 4.293a1 1 0 010 1.414L7.414 11H17a1 1 0 110 2H7.414l5.293 5.293a1 1 0 11-1.414 1.414l-7-7a1 1 0 010-1.414l7-7a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <%= t("pagy.aria_label.prev") %>
      <% end %>
    <% end %>
    <% if show_next? %>
      <%= link_to next_path, class: chrome.pager_link_class do %>
        <%= t("pagy.aria_label.next") %>
        <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
        </svg>
      <% end %>
    <% end %>
  </div>
</nav>
