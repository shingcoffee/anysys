<div class="hidden md:block overflow-x-auto">
  <table class="min-w-full <%= chrome.table_divide_class %>">
    <thead>
      <tr>
        <% columns.each do |col| %>
          <th class="<%= header_class(col) %>"><%= col[:label] %></th>
        <% end %>
        <th class="px-5 py-3"></th>
      </tr>
    </thead>

    <tbody class="<%= chrome.table_divide_class %>">
      <% records.each do |record| %>
        <tr class="group <%= chrome.table_row_class %>">
          <% columns.each do |col| %>
            <td class="<%= cell_class(col) %>"><%= render_value(record, col) %></td>
          <% end %>
          <td class="px-5 py-4 text-right">
            <% if row_action? %>
              <div class="flex items-center justify-end gap-3">
                <%= link_to row_action_href(record), class: "#{chrome.text_link_class} text-site-sm" do %>
                  <%= row_action_label %>
                <% end %>
                <%= link_to row_path.call(record), class: "#{chrome.text_link_class} text-site-sm" do %>
                  <%= row_label %>
                  <svg class="size-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                  </svg>
                <% end %>
              </div>
            <% else %>
              <%= link_to row_path.call(record), class: "#{chrome.text_link_class} text-site-sm" do %>
                <%= row_label %>
                <svg class="size-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                </svg>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="md:hidden flex flex-col gap-3">
  <% records.each do |record| %>
    <article class="<%= chrome.card_class(:compact) %> flex flex-col gap-3">
      <% if title_column %>
        <p class="text-site-base font-medium break-words"><%= render_value(record, title_column) %></p>
      <% end %>
      <% if detail_columns.any? %>
        <dl class="grid grid-cols-1 gap-2">
          <% detail_columns.each do |col| %>
            <div>
              <dt class="<%= chrome.label_class %>"><%= col[:label] %></dt>
              <dd class="text-site-sm break-words"><%= render_value(record, col) %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
      <div class="flex flex-col gap-2 border-t pt-3 <%= chrome.hairline_class %>">
        <% if row_action? %>
          <%= link_to row_action_href(record), class: chrome.block_button_class(:secondary) do %>
            <%= row_action_label %>
          <% end %>
        <% end %>
        <%= link_to row_path.call(record), class: "#{chrome.text_link_class} min-h-11 justify-center" do %>
          <%= row_label %>
          <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
          </svg>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
