<div class="relative" data-component="member-user-menu" data-controller="user-menu">
  <button type="button"
          class="inline-flex max-w-[14rem] items-center gap-2 rounded-full py-1 pl-1 pr-2.5 text-site-sm font-medium transition-colors <%= chrome.theme.dark? ? "text-white/80 hover:bg-white/10 hover:text-white" : "text-neutral-700 hover:bg-neutral-900/[0.04] hover:text-neutral-950" %> focus-visible:outline-none focus-visible:ring-2 <%= chrome.focus_ring_class %>"
          aria-haspopup="menu"
          aria-expanded="false"
          data-action="click->user-menu#toggle"
          data-user-menu-target="trigger">
    <span class="<%= chrome.avatar_class %> size-8 text-site-xs"><%= initials %></span>
    <span class="hidden min-w-0 truncate sm:inline"><%= user.display_name %></span>
    <svg class="size-3.5 shrink-0 opacity-70" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
  </button>

  <div class="absolute right-0 top-full z-50 mt-2 hidden w-56 origin-top-right rounded-2xl py-1 ring-1 <%= chrome.menu_panel_class %>"
       role="menu"
       data-user-menu-target="panel">
    <div class="border-b px-4 py-3 <%= chrome.hairline_class %>">
      <p class="truncate text-site-sm font-medium"><%= user.display_name %></p>
      <p class="truncate text-site-xs <%= chrome.muted_class %>"><%= user.email %></p>
    </div>
    <div class="py-1">
      <%= link_to t("member.user_menu.your_profile"), profile_path, class: chrome.menu_item_class, role: "menuitem" %>
      <%= link_to t("member.common.security"), security_path, class: chrome.menu_item_class, role: "menuitem" %>
    </div>
    <div class="border-t py-1 <%= chrome.hairline_class %>">
      <%= link_to t("member.common.sign_out"), sign_out_path,
            data: { turbo_method: :delete },
            class: chrome.menu_danger_class,
            role: "menuitem" %>
    </div>
  </div>
</div>
