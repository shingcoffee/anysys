<section data-member-card data-record-rows="<%= section.entity.id %>" class="<%= chrome.card_class(:default) %>">
  <header class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b pb-5 <%= chrome.hairline_class %>">
    <h2 class="<%= chrome.section_title_class %>"><%= title %></h2>
    <% if section.addable? %>
      <%= link_to t("member.record_rows.add"), add_path, class: chrome.secondary_button_class %>
    <% end %>
  </header>

  <% if rows.empty? %>
    <p class="py-6 text-center <%= chrome.body_copy_class %>"><%= t("member.record_rows.empty") %></p>
  <% else %>
    <div class="hidden md:block overflow-x-auto">
      <table class="min-w-full <%= chrome.table_divide_class %>">
        <thead>
          <tr>
            <% columns.each do |column| %>
              <th class="<%= chrome.table_header_class %> text-left"><%= column.label %></th>
            <% end %>
            <% if section.actions? %>
              <th class="<%= chrome.table_header_class %> text-right"><span class="sr-only"><%= t("member.record_rows.actions") %></span></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="<%= chrome.table_divide_class %>">
          <% rows.each do |row| %>
            <tr class="<%= chrome.table_row_class %>">
              <% columns.each do |column| %>
                <td class="px-5 py-4 text-site-sm break-words"><%= value(row, column) %></td>
              <% end %>
              <% if section.actions? %>
                <td class="px-5 py-4 text-right">
                  <div class="flex items-center justify-end gap-4">
                    <% if section.changeable? %>
                      <%= link_to t("member.record_rows.change"), change_path(row), class: "#{chrome.text_link_class} text-site-sm" %>
                    <% end %>
                    <%= remove_button(row, chrome.danger_link_class) %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="md:hidden flex flex-col gap-3">
      <% rows.each do |row| %>
        <article class="<%= chrome.card_class(:compact) %> flex flex-col gap-3">
          <dl class="grid grid-cols-1 gap-2">
            <% columns.each do |column| %>
              <div>
                <dt class="<%= chrome.label_class %>"><%= column.label %></dt>
                <dd class="text-site-sm break-words"><%= value(row, column) %></dd>
              </div>
            <% end %>
          </dl>
          <% if section.actions? %>
            <div class="flex flex-col gap-2 border-t pt-3 <%= chrome.hairline_class %>">
              <% if section.changeable? %>
                <%= link_to t("member.record_rows.change"), change_path(row), class: chrome.block_button_class(:secondary) %>
              <% end %>
              <%= remove_button(row, "#{chrome.danger_quiet_class} w-full") %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>
</section>
