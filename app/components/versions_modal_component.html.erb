<div data-versions-target="modal"
     class="hidden fixed inset-0 z-50 overflow-hidden"
     role="dialog" aria-modal="true" aria-labelledby="versions-title">
  <div class="absolute inset-0 bg-slate-900/50 backdrop-blur-[3px] animate-fade-in"
       data-action="click->versions#close"></div>

  <div class="absolute inset-0 flex items-stretch justify-center p-4 sm:items-center sm:p-6">
    <div class="animate-scale-in relative flex w-full max-w-6xl flex-col overflow-hidden bg-surface shadow-float ring-1 ring-black/5 max-h-full sm:h-[88vh] sm:max-h-[92vh] sm:rounded-2xl">

      <%# ── Header ───────────────────────────────────────────────── %>
      <header class="flex items-start justify-between gap-4 border-b border-border-subtle px-5 py-4">
        <div class="flex min-w-0 items-start gap-3">
          <span class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-subtle text-accent-text sm:flex">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-2.64-6.36M21 4v4h-4" />
            </svg>
          </span>
          <div class="min-w-0">
            <h3 id="versions-title" class="text-heading truncate"><%= t("chrome.versions_modal.title") %></h3>
            <p class="text-body-sm truncate">
              <span data-versions-target="title" class="font-medium text-text-primary"></span><span
                data-versions-target="count" class="text-text-muted"></span>
            </p>
          </div>
        </div>
        <button type="button" data-action="click->versions#close"
                aria-label="<%= t("common.actions.close") %>" class="icon-button shrink-0">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>
      </header>

      <%# ── Inline error ─────────────────────────────────────────── %>
      <div data-versions-target="error"
           class="mx-5 mt-3 hidden items-start gap-2 rounded-md border border-danger/20 bg-danger-subtle px-3 py-2 text-sm text-danger">
        <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.007M10.34 3.94 1.7 18.94A1.5 1.5 0 0 0 3 21.19h18a1.5 1.5 0 0 0 1.3-2.25l-8.64-15a1.5 1.5 0 0 0-2.62 0Z" /></svg>
        <span data-versions-target="errorMessage"></span>
      </div>

      <%# ── Body ─────────────────────────────────────────────────── %>
      <% th = "sticky top-0 z-10 bg-canvas-elevated px-3 py-2.5 text-2xs font-semibold uppercase tracking-wider text-text-tertiary border-b border-border-subtle" %>
      <div class="flex min-h-0 flex-1 flex-col">
        <%# List view — versions as a table %>
        <div data-versions-target="listView" class="flex min-h-0 flex-1 flex-col">
          <div class="flex items-center justify-between gap-2 border-b border-border-subtle bg-canvas-elevated px-5 py-2">
            <span class="text-label"><%= t("chrome.versions_modal.all_versions") %></span>
            <span data-versions-target="hint" class="text-caption text-text-muted"><%= t("chrome.versions_modal.pick_two") %></span>
          </div>
          <div data-versions-target="scroll" class="min-h-0 flex-1 overflow-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr>
                  <th class="<%= th %> w-12 pl-5 text-left"><span class="sr-only"><%= t("chrome.versions_modal.select") %></span></th>
                  <th class="<%= th %> text-left"><%= t("chrome.versions_modal.version") %></th>
                  <th class="<%= th %> hidden text-left md:table-cell"><%= t("chrome.versions_modal.based_on") %></th>
                  <th class="<%= th %> text-left"><%= t("common.labels.status") %></th>
                  <th class="<%= th %> hidden text-left sm:table-cell"><%= t("common.labels.description") %></th>
                  <th class="<%= th %> hidden text-left md:table-cell"><%= t("common.labels.created_at") %></th>
                  <th class="<%= th %> pr-5 text-right"><%= t("common.labels.actions") %></th>
                </tr>
              </thead>
              <tbody data-versions-target="list" class="divide-y divide-border-subtle"></tbody>
            </table>
          </div>

          <%# Pagination — shown only when versions exceed one page %>
          <div data-versions-target="pagination"
               class="hidden items-center justify-between gap-2 border-t border-border-subtle bg-canvas-elevated px-5 py-2">
            <span data-versions-target="pageInfo" class="text-caption tabular-nums text-text-muted"></span>
            <div class="flex items-center gap-1.5">
              <button type="button" data-action="click->versions#prevPage"
                      data-versions-target="prevButton" class="btn btn-secondary px-3 py-1.5 text-xs">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                <span class="hidden sm:inline"><%= t("chrome.pagination.prev") %></span>
              </button>
              <button type="button" data-action="click->versions#nextPage"
                      data-versions-target="nextButton" class="btn btn-secondary px-3 py-1.5 text-xs">
                <span class="hidden sm:inline"><%= t("common.actions.next") %></span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </div>
        </div>

        <%# Diff view — hidden until a comparison is run %>
        <div data-versions-target="content" class="hidden min-h-0 flex-1 overflow-auto"></div>
      </div>

      <%# ── Footer ───────────────────────────────────────────────── %>
      <footer class="flex items-center justify-between gap-3 border-t border-border-subtle bg-canvas-elevated px-5 py-3">
        <p data-versions-target="selectionInfo" class="text-caption text-text-tertiary">
          <%= t("chrome.versions_modal.select_two") %>
        </p>
        <div class="flex items-center gap-2">
          <button type="button" data-versions-target="clearButton"
                  data-action="click->versions#clearSelection"
                  class="btn btn-ghost hidden"><%= t("chrome.versions_modal.clear") %></button>
          <button type="button" data-versions-target="diffButton" disabled
                  data-action="click->versions#diff"
                  class="btn btn-primary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 0 0-2 2v4m6-6h6m-6 0v18m0 0H5a2 2 0 0 1-2-2v-4m6 6h6m0-18h4a2 2 0 0 1 2 2v4m-6-6v18m0 0h4a2 2 0 0 0 2-2v-4" /></svg>
            <%= t("chrome.versions_modal.compare") %>
          </button>
        </div>
      </footer>
    </div>
  </div>
</div>
