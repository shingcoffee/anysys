<div class="relative" data-controller="user-menu">
  <button type="button"
          data-action="click->user-menu#toggle"
          data-user-menu-target="trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label="<%= t("locale_switcher.label") %>"
          class="<%= trigger_class %>">
    <svg class="<%= icon_class %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3M3.6 9h16.8M3.6 15h16.8"/>
    </svg>
    <span class="<%= label_class %>"><%= current_display_name %></span>
    <svg class="<%= chevron_class %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div data-user-menu-target="panel"
       role="menu"
       class="<%= panel_class %>">
    <div class="<%= panel_heading_class %>">
      <p class="<%= panel_heading_label_class %>"><%= t("locale_switcher.label") %></p>
    </div>

    <% locales.each do |locale| %>
      <%= button_to locale_path, method: :patch, params: { locale: locale }, role: "menuitem",
            class: option_class(locale) do %>
        <span><%= display_name(locale) %></span>
        <% if current?(locale) %>
          <svg class="<%= check_class %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
          </svg>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
