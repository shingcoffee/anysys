<div class="card" data-controller="activity-trace" data-activity-trace-url-value="<%= trace_url %>"
     data-activity-trace-running-label-value="<%= t("chrome.activity_trace.running") %>"
     data-activity-trace-run-label-value="<%= t("chrome.activity_trace.run") %>"
     data-activity-trace-success-label-value="<%= t("chrome.activity_trace.success") %>"
     data-activity-trace-failure-label-value="<%= t("chrome.activity_trace.failure") %>"
     data-activity-trace-signal-prefix-value="<%= t("chrome.activity_trace.signal_prefix") %>"
     data-activity-trace-no-trace-available-value="<%= t("chrome.activity_trace.no_trace_available") %>">
  <div class="px-5 py-4 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-base font-semibold text-text-primary"><%= t("chrome.activity_trace.title") %></h2>
    <button type="button"
            data-action="click->activity-trace#run"
            data-activity-trace-target="runButton"
            class="btn btn-success btn-sm flex-shrink-0">
      <span data-activity-trace-target="buttonText"><%= t("chrome.activity_trace.run") %></span>
    </button>
  </div>

  <div class="px-5 pb-5">
    <%# Initial state %>
    <div data-activity-trace-target="placeholder" class="rounded-lg border border-dashed border-border bg-canvas-elevated py-8 text-center">
      <p class="text-sm font-medium text-text-secondary"><%= t("chrome.activity_trace.placeholder_html") %></p>
      <p class="mt-1 text-caption text-text-muted"><%= t("chrome.activity_trace.placeholder_hint") %></p>
    </div>

    <%# Results container (hidden initially) %>
    <div data-activity-trace-target="results" class="hidden space-y-4">
      <%# Status badge %>
      <div class="flex items-center gap-3">
        <span data-activity-trace-target="status" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium"></span>
        <span data-activity-trace-target="signal" class="text-sm text-text-secondary"></span>
      </div>

      <%# Trace output %>
      <div>
        <h4 class="text-sm font-medium text-text-secondary mb-2"><%= t("chrome.activity_trace.execution_trace") %></h4>
        <pre data-activity-trace-target="trace" class="bg-text-primary text-surface rounded-lg p-4 text-sm font-mono overflow-x-auto custom-scrollbar"></pre>
      </div>

      <%# Trace nodes visualization %>
      <div>
        <h4 class="text-sm font-medium text-text-secondary mb-2"><%= t("chrome.activity_trace.step_results") %></h4>
        <div data-activity-trace-target="nodes" class="space-y-1"></div>
      </div>

      <%# Context output %>
      <div>
        <h4 class="text-sm font-medium text-text-secondary mb-2"><%= t("chrome.activity_trace.final_context") %></h4>
        <pre data-activity-trace-target="context" class="bg-canvas-elevated border border-border-subtle rounded-lg p-4 text-sm font-mono overflow-x-auto custom-scrollbar text-text-secondary"></pre>
      </div>
    </div>

    <%# Error container (hidden initially) %>
    <div data-activity-trace-target="error" class="hidden rounded-lg bg-danger-subtle border border-danger/20 p-4">
      <div class="flex">
        <svg class="h-5 w-5 text-danger" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-danger"><%= t("chrome.activity_trace.execution_error") %></h3>
          <p data-activity-trace-target="errorMessage" class="mt-1 text-sm text-danger/80"></p>
        </div>
      </div>
    </div>
  </div>
</div>
