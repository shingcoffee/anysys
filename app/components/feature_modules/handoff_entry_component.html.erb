<section class="mx-auto w-full max-w-md bg-white border border-gray-200 rounded-md p-4 sm:p-6">
  <h1 class="text-lg font-semibold text-gray-900"><%= title %></h1>
  <p class="mt-1 text-sm text-gray-500"><%= subtitle %></p>

  <% if errors&.any? %>
    <div class="mt-3 border-l-4 border-red-400 bg-red-50 px-3 py-2 text-sm text-red-800" role="alert">
      <%= errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= form_with url: submit_url, method: :patch, class: "mt-6 space-y-4", data: { turbo: false } do %>
    <% fields.each do |field| %>
      <% control = control_for(field) %>
      <% input_classes = "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400" %>
      <% if control == :checkbox %>
        <div class="flex items-start gap-2.5">
          <input type="hidden" name="<%= input_name(field) %>" value="0">
          <input type="checkbox" id="<%= input_id(field) %>" name="<%= input_name(field) %>" value="1"
                 <%= "checked" if checked?(field) %>
                 class="mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-gray-900 focus:ring-gray-400">
          <label for="<%= input_id(field) %>" class="min-w-0 cursor-pointer text-sm text-gray-700"><%= label_for(field) %></label>
        </div>
      <% else %>
        <div>
          <label for="<%= input_id(field) %>" class="block text-sm font-medium text-gray-700">
            <%= label_for(field) %>
          </label>
          <% case control %>
          <% when :select %>
            <%= select_tag input_name(field),
                           options_for_select(field.allowed_values, value_for(field)),
                           id: input_id(field), include_blank: !field.required?, required: field.required?,
                           class: input_classes %>
          <% when :number %>
            <input type="number" id="<%= input_id(field) %>" name="<%= input_name(field) %>"
                   value="<%= value_for(field) %>" step="<%= number_step(field) %>"
                   placeholder="<%= placeholder_for(field) %>" <%= "required" if field.required? %>
                   class="<%= input_classes %>">
          <% when :email %>
            <input type="email" id="<%= input_id(field) %>" name="<%= input_name(field) %>"
                   value="<%= value_for(field) %>" autocomplete="email"
                   placeholder="<%= placeholder_for(field) %>" <%= "required" if field.required? %>
                   class="<%= input_classes %>">
          <% when :datetime %>
            <input type="datetime-local" id="<%= input_id(field) %>" name="<%= input_name(field) %>"
                   value="<%= value_for(field) %>" <%= "required" if field.required? %>
                   class="<%= input_classes %>">
          <% else %>
            <textarea id="<%= input_id(field) %>" name="<%= input_name(field) %>" rows="3"
                      placeholder="<%= placeholder_for(field) %>" <%= "required" if field.required? %>
                      class="<%= input_classes %>"><%= value_for(field) %></textarea>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <button type="submit"
            class="w-full rounded-md bg-gray-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400">
      <%= continue_label %>
    </button>
  <% end %>
</section>
