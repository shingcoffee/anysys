<div class="contents" data-controller="website-nav"
     data-website-nav-open-label-value="<%= open_label %>"
     data-website-nav-close-label-value="<%= close_label %>">
  <a href="#site-main" class="sr-only focus:not-sr-only focus:fixed focus:left-5 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-slate-950 focus:ring-2 focus:ring-violet-600"><%= t('chrome.skip_to_content') %></a>
  <header class="sticky top-0 z-30 border-b border-white/10 bg-slate-950/75 text-white backdrop-blur-xl backdrop-saturate-150">
    <div class="<%= inner_measure_class %> flex <%= header_bar_class %> flex-col items-start justify-between gap-1 py-2 min-[280px]:flex-row min-[280px]:items-center min-[280px]:gap-3 min-[280px]:py-0">
      <a href="<%= home_href %>" class="flex min-h-11 min-w-0 w-full items-center gap-2.5 rounded-lg text-[20px] font-bold tracking-[-0.035em] text-white hover:text-violet-200 min-[280px]:w-auto <%= Websites::HomeSite::SectionComponent::FOCUS %> focus-visible:ring-offset-slate-950"><%= render Branding::SapphireLogoComponent.new(size: "h-7", css_class: "shrink-0", decorative: true) %><span class="min-w-0"><%= site_name %></span></a>
      <nav class="hidden items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] p-1 lg:flex" aria-label="<%= site_name %>">
        <% nav_pages.each do |page| %>
          <a href="<%= page_href(page) %>" class="<%= nav_link_class(page) %>" <% if current?(page) %>aria-current="page"<% end %>><%= page_title(page) %></a>
        <% end %>
      </nav>
      <div class="flex min-w-0 w-full flex-wrap items-center justify-end gap-1 min-[280px]:w-auto min-[280px]:shrink-0 sm:gap-2">
        <%= render Websites::HomeSite::LanguageSwitcherComponent.new(theme: theme) %>
        <div class="hidden lg:flex"><a href="<%= signup_href %>" class="<%= signup_class %>"><%= signup_label %></a></div>
        <button type="button" class="<%= nav_button_class %> lg:hidden"
                data-website-nav-target="trigger" data-action="click->website-nav#toggle"
                aria-expanded="false" aria-controls="website-nav-panel" aria-label="<%= open_label %>">
          <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </div>
  </header>
  <%# Keep the fixed sheet outside the blurred header's containing block. %>
  <%= render Websites::HomeSite::MobileNavSheetComponent.new(website: website, pages: nav_pages, current_slug: @current_slug, theme: theme, open_label: open_label, close_label: close_label) %>
</div>
