<section class="relative <%= section_class %> <%= padding_class %>">
  <div class="<%= inner_measure_class %>">
    <%= section_intro(align: :center) %>
    <% if items.any? %>
      <% if process? %>
        <div class="relative mt-14 lg:mt-16">
        <div aria-hidden="true" class="pointer-events-none absolute left-[16%] right-[16%] top-8 hidden h-0.5 bg-gradient-to-r from-violet-400 via-fuchsia-400 to-sky-400 opacity-60 md:block"></div>
        <ol class="relative grid min-w-0 grid-cols-1 gap-6 lg:gap-8 <%= grid_class %>">
          <% items.each_with_index do |item, index| %>
            <li class="relative mt-8 flex min-w-0 flex-col items-center rounded-3xl border border-slate-200/80 bg-white px-6 pb-8 pt-0 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-violet-500/10">
              <span class="relative z-10 -mt-8 inline-flex size-16 items-center justify-center rounded-full bg-gradient-to-br text-[20px] font-bold text-white shadow-xl ring-8 ring-slate-50 <%= ICON_TILES[index % ICON_TILES.size] %>" aria-hidden="true"><%= number(index) %></span>
              <% if present_text?(item['title']) %><h3 class="mt-6 min-w-0 text-[22px] leading-7 font-bold text-slate-950 <%= tracking_class %>"><%= item['title'] %></h3><% end %>
              <% if present_text?(item['body']) %><p class="mt-3 whitespace-pre-line <%= body_class %>"><%= item['body'] %></p><% end %>
            </li>
          <% end %>
        </ol>
        </div>
      <% elsif assistant? %>
        <div class="mt-14 grid min-w-0 grid-cols-1 gap-5 lg:mt-16 lg:gap-6 <%= grid_class %>">
          <% items.each_with_index do |item, index| %>
            <article class="<%= assistant_card_class(index) %>">
              <% if index.zero? %><%= aurora(intensity: :soft) %><% end %>
              <span class="relative <%= assistant_tile_class(index) %>" aria-hidden="true"><%= glyph(card_glyph(index)) %></span>
              <% if present_text?(item['title']) %><h3 class="<%= assistant_title_class(index) %>"><%= item['title'] %></h3><% end %>
              <% if present_text?(item['body']) %><p class="relative mt-3 whitespace-pre-line <%= assistant_body_class(index) %>"><%= item['body'] %></p><% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="mt-14 grid min-w-0 grid-cols-1 gap-5 lg:mt-16 lg:gap-6 <%= grid_class %>">
          <% items.each_with_index do |item, index| %>
            <article class="group relative min-w-0 overflow-hidden rounded-3xl border border-slate-200/80 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-violet-200 hover:shadow-2xl hover:shadow-violet-500/10 lg:p-8">
              <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-16 size-48 rounded-full bg-gradient-to-br from-violet-200/0 to-fuchsia-200/0 blur-2xl transition-colors duration-500 group-hover:from-violet-200/70 group-hover:to-fuchsia-200/50"></div>
              <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-violet-500 via-fuchsia-500 to-sky-500 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="relative flex min-w-0 items-center justify-between gap-3">
                <span class="<%= icon_tile_class(index) %>" aria-hidden="true"><%= foundation? ? check_icon(css_class: 'size-6') : glyph(card_glyph(index)) %></span>
                <% if principles? %><span class="text-[40px] leading-none font-bold tabular-nums text-slate-100 transition-colors group-hover:text-violet-100" aria-hidden="true"><%= number(index) %></span><% end %>
              </div>
              <% if present_text?(item['title']) %><h3 class="relative mt-6 min-w-0 text-[20px] leading-7 font-bold text-slate-950 <%= tracking_class %>"><%= item['title'] %></h3><% end %>
              <% if present_text?(item['body']) %><p class="relative mt-3 whitespace-pre-line <%= body_class %>"><%= item['body'] %></p><% end %>
            </article>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
