<section class="relative isolate overflow-hidden bg-slate-950 text-white <%= padding_class %>">
  <%= aurora(intensity: :soft) %>
  <div class="<%= inner_measure_class %>">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="min-w-0 <%= valid_media?(lead_image) ? 'lg:col-span-6' : 'lg:col-span-12' %>">
        <% if present_text?(prop('kicker')) %>
          <p class="<%= kicker_class(tone: :dark) %> mb-6">
            <span class="relative flex size-2" aria-hidden="true"><span class="absolute inline-flex size-full animate-ping rounded-full bg-fuchsia-400 opacity-75 motion-reduce:animate-none"></span><span class="relative inline-flex size-2 rounded-full bg-fuchsia-400"></span></span>
            <%= prop('kicker') %>
          </p>
        <% end %>
        <% if present_text?(prop('heading')) %><h2 class="<%= section_heading_class(tone: :dark) %>"><%= prop('heading') %></h2><% end %>
        <% if present_text?(prop('subhead')) %><p class="mt-5 w-full <%= subhead_class(tone: :dark) %>"><%= prop('subhead') %></p><% end %>
        <% if text_cards.any? %>
          <div class="mt-10 space-y-4">
            <% text_cards.each_with_index do |card, index| %>
              <div class="flex min-w-0 items-start gap-4 rounded-2xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur transition-colors hover:border-white/20 hover:bg-white/[0.07]">
                <span class="<%= icon_tile_class(index, size: 'size-11') %>" aria-hidden="true"><%= glyph(card_glyph(index), css_class: 'size-5') %></span>
                <div class="min-w-0">
                  <% if present_text?(card['title']) %>
                    <h3 class="min-w-0 text-[18px] leading-6 font-semibold text-white">
                      <% if item_href(card) %><%= action(card['title'], card['href'], css_class: "inline-flex min-h-11 min-w-0 items-center text-[18px] font-semibold text-white hover:text-violet-200 #{FOCUS}") %><% else %><%= card['title'] %><% end %>
                    </h3>
                  <% end %>
                  <% if present_text?(card['body']) %><p class="mt-1.5 w-full whitespace-pre-line text-[15px] leading-6 text-slate-400"><%= card['body'] %></p><% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if valid_media?(lead_image) %>
        <div class="relative min-w-0 lg:col-span-6">
          <div aria-hidden="true" class="absolute -inset-6 rounded-[3rem] bg-gradient-to-tr from-violet-600/50 via-fuchsia-500/30 to-indigo-500/40 blur-3xl"></div>
          <div class="relative rounded-[2rem] border border-white/15 bg-white/5 p-2 shadow-2xl shadow-black/60">
            <div class="<%= media_frame_class %> rounded-[1.5rem]"><%= render_media(lead_image, alt: cards.first['title'].to_s, css_class: 'absolute inset-0 size-full object-cover') %></div>
          </div>
        </div>
      <% end %>
    </div>
    <% if supplementary_cards.any? %>
      <div class="mt-12 grid min-w-0 gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% supplementary_cards.each do |card| %>
          <figure class="min-w-0">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-2"><div class="<%= media_frame_class %> rounded-xl"><%= render_media(card['image_url'], alt: card['title'].to_s, css_class: 'absolute inset-0 size-full object-cover') %></div></div>
            <% if present_text?(card['title']) %><figcaption class="mt-2 text-[14px] leading-[22px] text-slate-400"><%= card['title'] %></figcaption><% end %>
          </figure>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
