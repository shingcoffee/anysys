<section class="relative bg-gradient-to-b from-white via-violet-50/40 to-white <%= padding_class %>">
  <div class="<%= inner_measure_class %>">
    <%= section_intro(align: :center) %>
    <% if board? %>
      <div class="relative isolate mt-12 overflow-hidden rounded-[2rem] bg-slate-950 text-white shadow-2xl shadow-violet-950/30 ring-1 ring-white/10 lg:mt-16">
        <%= aurora(intensity: :soft) %>
        <% if present_text?(prop('example_label')) %>
          <div class="flex min-w-0 items-center gap-3 border-b border-white/10 px-5 py-4 lg:px-8">
            <span class="flex shrink-0 gap-1.5" aria-hidden="true"><span class="size-2.5 rounded-full bg-rose-400/80"></span><span class="size-2.5 rounded-full bg-amber-300/80"></span><span class="size-2.5 rounded-full bg-emerald-400/80"></span></span>
            <p class="min-w-0 text-[14px] leading-[22px] font-medium text-slate-400"><%= prop('example_label') %></p>
          </div>
        <% end %>
        <div class="grid min-w-0 gap-6 p-5 sm:p-8 lg:grid-cols-12 lg:gap-8 lg:p-10">
          <% if brief? %>
            <div class="flex min-w-0 flex-col lg:col-span-4">
              <% if present_text?(prop('prompt_label')) %><p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-violet-300"><%= prop('prompt_label') %></p><% end %>
              <% if present_text?(prop('prompt')) %>
                <div class="relative mt-4 rounded-3xl rounded-tl-md border border-white/10 bg-white/[0.07] p-5 shadow-xl backdrop-blur">
                  <p class="min-w-0 whitespace-pre-line text-[19px] leading-8 font-medium text-white"><%= prop('prompt') %><span aria-hidden="true" class="ml-1 inline-block h-6 w-0.5 translate-y-1 animate-pulse bg-fuchsia-300 motion-reduce:animate-none"></span></p>
                </div>
              <% end %>
              <div aria-hidden="true" class="mt-6 hidden items-center gap-3 text-violet-300 lg:flex">
                <span class="inline-flex size-10 items-center justify-center rounded-full bg-gradient-to-br from-violet-500 to-fuchsia-500 text-white shadow-lg shadow-fuchsia-500/40"><%= sparkle_icon(css_class: 'size-5') %></span>
                <span class="h-px flex-1 bg-gradient-to-r from-fuchsia-400/80 to-transparent"></span>
              </div>
            </div>
          <% end %>
          <div class="min-w-0 <%= brief? ? 'lg:col-span-8' : 'lg:col-span-12' %>">
            <% if present_text?(prop('output_label')) %><p class="mb-4 text-[13px] font-semibold uppercase tracking-[0.14em] text-sky-300"><%= prop('output_label') %></p><% end %>
            <% if items.any? %>
              <div class="grid min-w-0 gap-4 md:grid-cols-3">
                <% items.each_with_index do |item, index| %>
                  <article class="group relative min-w-0 rounded-2xl border border-white/10 bg-white/[0.06] p-5 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-white/25 hover:bg-white/[0.1]">
                    <div class="flex items-start justify-between gap-3">
                      <span class="<%= icon_tile_class(index, size: 'size-11') %>" aria-hidden="true"><%= glyph(output_glyph(index), css_class: 'size-5') %></span>
                      <% if present_text?(item['status']) %><span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2.5 py-0.5 text-[12px] font-semibold text-emerald-300"><span class="size-1.5 rounded-full bg-emerald-400"></span><%= item['status'] %></span><% end %>
                    </div>
                    <% if present_text?(item['title']) %><h3 class="mt-5 min-w-0 text-[18px] leading-6 font-semibold text-white"><%= item['title'] %></h3><% end %>
                    <% if body_lines(item).any? %>
                      <ul class="mt-3 space-y-2">
                        <% body_lines(item).each do |line| %><li class="flex min-w-0 items-start gap-2 text-[14px] leading-[22px] text-slate-300"><span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-violet-400"></span><span class="min-w-0"><%= line %></span></li><% end %>
                      </ul>
                    <% end %>
                  </article>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <% if present_text?(prop('review_note')) %>
          <p class="flex min-w-0 items-center gap-3 border-t border-white/10 px-5 py-4 text-[14px] leading-[22px] text-slate-300 lg:px-8">
            <span aria-hidden="true" class="inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-emerald-400/15 text-emerald-300"><%= glyph("M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6zM9 12l2 2 4-4", css_class: 'size-4') %></span>
            <span class="min-w-0"><%= prop('review_note') %></span>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
