<footer class="relative isolate overflow-hidden bg-slate-950 text-white">
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-fuchsia-400/60 to-transparent"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 left-1/2 -z-10 size-[40rem] -translate-x-1/2 rounded-full bg-violet-700/25 blur-[120px]"></div>
  <div class="<%= inner_measure_class %> pt-16 pb-8 lg:pt-20">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-12">
      <div class="min-w-0 lg:col-span-5">
        <p class="flex min-w-0 items-center gap-3 text-[22px] font-bold tracking-[-0.03em] text-white"><%= render Branding::SapphireLogoComponent.new(size: "h-8", css_class: "shrink-0", decorative: true) %><span class="min-w-0"><%= site_name %></span></p>
        <% if present_text?(blurb) %><p class="mt-5 min-w-0 max-w-sm text-[15px] leading-7 text-slate-400"><%= blurb %></p><% end %>
      </div>
      <% if show_columns? %>
        <div class="grid min-w-0 grid-cols-1 gap-x-4 gap-y-8 min-[280px]:grid-cols-2 min-[380px]:grid-cols-3 lg:col-span-7 lg:gap-x-8">
          <% columns.each do |column| %>
            <div class="min-w-0">
              <% if present_text?(column['heading']) %><p class="mb-3 min-w-0 text-[13px] font-semibold uppercase tracking-[0.14em] text-violet-300"><%= column['heading'] %></p><% end %>
              <div class="flex flex-col items-start">
                <% links_for(column).each do |link| %><a href="<%= href_for(link['url']) %>" class="<%= link_class %>"><%= link['label'] %></a><% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <div aria-hidden="true" class="pointer-events-none mt-16 select-none text-center text-[22vw] leading-[0.8] font-black tracking-[-0.06em] text-transparent bg-gradient-to-b from-white/[0.09] to-white/0 bg-clip-text lg:text-[200px]"><%= site_name %></div>
    <div class="mt-4 flex min-w-0 flex-col gap-2 border-t border-white/10 pt-6 text-[14px] leading-6 text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <span class="min-w-0">&copy; <%= Time.current.year %> <%= site_name %></span>
      <% if present_text?(tagline) %><span class="min-w-0 break-words"><%= tagline %></span><% end %>
    </div>
  </div>
</footer>
