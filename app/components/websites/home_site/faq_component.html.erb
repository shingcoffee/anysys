<section class="<%= section_class %> <%= padding_class %>">
  <div class="<%= inner_measure_class %> grid min-w-0 gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="min-w-0 lg:col-span-4">
      <div class="lg:sticky lg:top-28"><%= section_intro(heading_class: compact_heading_class) %></div>
    </div>
    <% if items.any? %>
      <div class="flex min-w-0 w-full flex-col gap-3 lg:col-span-8">
        <% items.each do |item| %>
          <details class="group min-w-0 rounded-2xl border border-slate-200/80 bg-white shadow-sm transition-all duration-300 open:border-violet-200 open:shadow-xl open:shadow-violet-500/10">
            <summary class="flex min-h-16 min-w-0 cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-5 py-4 text-[17px] leading-6 font-semibold text-slate-900 marker:hidden sm:px-6 [&::-webkit-details-marker]:hidden <%= FOCUS %>">
              <span class="min-w-0 break-words"><%= item['question'] %></span>
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors group-open:bg-gradient-to-br group-open:from-violet-500 group-open:to-fuchsia-500 group-open:text-white" aria-hidden="true"><svg class="size-4 group-open:rotate-45 motion-safe:transition-transform" fill="none" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><path stroke-linecap="round" d="M8 2v12M2 8h12" /></svg></span>
            </summary>
            <% if present_text?(item['answer']) %><p class="min-w-0 whitespace-pre-line px-5 pb-6 text-[16px] leading-7 text-slate-600 sm:px-6"><%= item['answer'] %></p><% end %>
          </details>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
