<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="flex flex-col gap-6 lg:col-span-5">
      <% if present_text?(prop("heading")) %>
        <h2 <%= el_attrs("heading", class: section_heading_class) %>><%= prop("heading") %></h2>
      <% end %>
      <% if email_field %>
        <a href="<%= email_field[:href] %>" <%= el_attrs("email", class: "w-fit break-words text-site-2xl underline decoration-1 underline-offset-[0.4em] transition-opacity hover:opacity-70 md:text-site-4xl #{headline_font_class} #{theme.kicker_class}") %>><%= email_field[:value] %></a>
      <% end %>
    </div>
    <dl class="border-t lg:col-span-7 <%= hairline_class %> <%= divide_class %>">
      <% fields.each do |field| %>
        <div class="grid gap-2 py-6 sm:grid-cols-3 sm:gap-6">
          <dt class="text-site-sm <%= muted_class %>"><%= field_label(field[:key]) %></dt>
          <dd class="sm:col-span-2">
            <% if field[:href].present? %>
              <a href="<%= field[:href] %>" <%= el_attrs(field[:key], class: "break-all text-site-base md:text-site-lg #{link_hover_class}") %>><%= field[:value] %></a>
            <% else %>
              <p <%= el_attrs(field[:key], class: "whitespace-pre-line break-words text-site-base md:text-site-lg") %>><%= field[:value] %></p>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>
</section>
