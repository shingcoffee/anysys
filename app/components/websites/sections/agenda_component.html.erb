<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> flex flex-col <%= gap_class %>">
    <%= header(kicker: prop("kicker"), heading: prop("heading"), subhead: prop("subhead")) %>
    <ol class="border-y <%= hairline_class %> <%= divide_class %>" role="list">
      <% sessions.each do |session| %>
        <li <%= item_attrs("sessions", class: "grid gap-x-8 gap-y-3 py-7 md:grid-cols-12 md:py-9") %>>
          <p <%= el_attrs("sessions.time", class: "md:col-span-2 md:pt-1.5 #{time_class}") %>><%= session["time"] %></p>
          <div class="flex min-w-0 flex-col gap-2 md:col-span-7">
            <h3 <%= el_attrs("sessions.title", class: session_title_class) %>><%= session["title"] %></h3>
            <% if present_text?(session["speaker"]) %>
              <p <%= el_attrs("sessions.speaker", class: "flex items-center gap-2 text-site-base font-medium #{body_text_class}") %>>
                <span class="size-1.5 shrink-0 rounded-full <%= theme.accent_dot_class %>" aria-hidden="true"></span>
                <span class="min-w-0 break-words"><%= session["speaker"] %></span>
              </p>
            <% end %>
            <% if present_text?(session["body"]) %>
              <p <%= el_attrs("sessions.body", class: "max-w-2xl text-pretty text-site-md leading-relaxed #{muted_class}") %>><%= session["body"] %></p>
            <% end %>
          </div>
          <% if present_text?(session["track"]) %>
            <div class="md:col-span-3 md:flex md:items-start md:justify-end md:pt-1">
              <span <%= el_attrs("sessions.track", class: "inline-flex max-w-full items-center rounded-full px-3 py-1 text-site-xs font-medium leading-5 #{theme.accent_soft_class}") %>><%= session["track"] %></span>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  </div>
</section>
