<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> flex flex-col <%= gap_class %>">
    <%= header(kicker: prop("kicker"), heading: prop("heading"), subhead: prop("subhead")) %>
    <div class="grid gap-x-6 gap-y-12 sm:grid-cols-2 md:gap-x-8 lg:grid-cols-3">
      <% cards.each do |card| %>
        <% href = item_href(card, "href") %>
        <% item_tag = href.present? ? "a" : "article" %>
        <<%= item_tag %> <%= item_attrs("cards", class: "group flex min-w-0 flex-col gap-5", href: href.presence) %>>
          <div class="relative aspect-[4/3] <%= image_frame_class %>">
            <%= render_media(card["image_url"], alt: card["title"].to_s, css_class: "absolute inset-0 size-full object-cover transition duration-700 ease-out #{"group-hover:scale-[1.04]" if href.present?}") %>
          </div>
          <div class="flex flex-col gap-2">
            <% if present_text?(card["title"]) %>
              <h3 <%= el_attrs("cards.title", class: "flex items-center gap-2 #{card_title_class}") %>>
                <span class="min-w-0"><%= card["title"] %></span>
                <% if href.present? %>
                  <svg class="size-4 shrink-0 opacity-40 transition duration-300 group-hover:translate-x-1 group-hover:opacity-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                <% end %>
              </h3>
            <% end %>
            <% if present_text?(card["body"]) %>
              <p <%= el_attrs("cards.body", class: "text-pretty text-site-md leading-relaxed md:text-site-lg #{muted_class}") %>><%= card["body"] %></p>
            <% end %>
          </div>
        </<%= item_tag %>>
      <% end %>
    </div>
  </div>
</section>
