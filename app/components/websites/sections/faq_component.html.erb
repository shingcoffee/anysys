<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <%= header(kicker: prop("kicker"), heading: prop("heading")) %>
      </div>
    </div>
    <div class="border-y lg:col-span-8 <%= hairline_class %> <%= divide_class %>">
      <% items.each do |item| %>
        <details <%= item_attrs("items", class: "group") %>>
          <summary class="flex min-w-0 cursor-pointer list-none items-start justify-between gap-6 py-6 text-site-base font-medium md:text-site-lg [&::-webkit-details-marker]:hidden">
            <span <%= el_attrs("items.question", class: "min-w-0 break-words text-left") %>><%= item["question"] %></span>
            <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full transition-transform duration-300 group-open:rotate-45 <%= theme.accent_soft_class %>" aria-hidden="true">
              <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <% if present_text?(item["answer"]) %>
            <p <%= el_attrs("items.answer", class: "max-w-2xl whitespace-pre-line pb-7 pr-10 text-pretty text-site-md leading-relaxed md:text-site-lg #{muted_class}") %>><%= item["answer"] %></p>
          <% end %>
        </details>
      <% end %>
    </div>
  </div>
</section>
