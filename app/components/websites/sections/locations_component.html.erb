<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> flex flex-col <%= gap_class %>">
    <%= header(kicker: prop("kicker"), heading: prop("heading"), subhead: prop("subhead")) %>
    <div class="grid gap-x-8 gap-y-14 <%= grid_class %>">
      <% places.each do |place| %>
        <article <%= item_attrs("places", class: "flex min-w-0 flex-col gap-6") %>>
          <div class="relative aspect-[4/3] <%= image_frame_class %>">
            <%= render_media(place["image_url"], alt: place["name"].to_s, css_class: "absolute inset-0 size-full object-cover") %>
          </div>
          <div class="flex flex-col gap-4">
            <h3 <%= el_attrs("places.name", class: card_title_class) %>><%= place["name"] %></h3>
            <% if details(place).any? %>
              <dl class="flex flex-col gap-3 border-t pt-4 text-site-sm md:text-site-base <%= hairline_class %>">
                <% details(place).each do |detail| %>
                  <div class="flex gap-3">
                    <dt class="shrink-0 pt-0.5 <%= muted_class %>">
                      <span class="sr-only"><%= detail_label(detail[:key]) %></span>
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <% icon_paths(detail[:key]).each do |path| %><path stroke-linecap="round" stroke-linejoin="round" d="<%= path %>"/><% end %>
                      </svg>
                    </dt>
                    <dd <%= el_attrs("places.#{detail[:key]}", class: "min-w-0 whitespace-pre-line break-words leading-relaxed #{body_text_class}") %>><% if detail[:href] %><a href="<%= detail[:href] %>" class="<%= link_hover_class %>"><%= detail[:value] %></a><% else %><%= detail[:value] %><% end %></dd>
                  </div>
                <% end %>
              </dl>
            <% end %>
            <% if present_text?(place["button_label"]) %>
              <% href = item_href(place, "button_href") %>
              <%= content_tag(href.present? ? :a : :span, href: href.presence, class: "#{text_link_class} group w-fit") do %>
                <span><%= place["button_label"] %></span>
                <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              <% end %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>
