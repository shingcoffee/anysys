<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> flex flex-col items-center text-center <%= gap_class %>">
    <div class="flex max-w-3xl flex-col items-center gap-5 md:gap-6">
      <% if present_text?(prop("kicker")) %>
        <p <%= el_attrs("kicker", class: kicker_class) %>><%= prop("kicker") %></p>
      <% end %>
      <% if present_text?(prop("headline")) %>
        <h2 <%= el_attrs("headline", class: "text-balance break-words text-site-4xl leading-[1.02] sm:text-site-5xl md:text-site-6xl lg:text-site-7xl #{headline_font_class}") %>><%= prop("headline") %></h2>
      <% end %>
      <% if present_text?(prop("subhead")) %>
        <p <%= el_attrs("subhead", class: "max-w-2xl #{subhead_class}") %>><%= prop("subhead") %></p>
      <% end %>
      <% if links.any? %>
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 pt-1" data-site-el="buttons">
          <% links.each do |link| %>
            <%= content_tag(link[:href].present? ? :a : :span, href: link[:href].presence, class: apple_link_class, **{ style: styler.button_css(link[:role]) }.compact) do %>
              <span><%= link[:label] %></span>
              <svg class="size-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="relative w-full max-w-5xl">
      <div class="pointer-events-none absolute -inset-x-10 -inset-y-6 -z-10 rounded-full opacity-50 blur-3xl md:-inset-x-16 <%= theme.glow_class %>" aria-hidden="true"></div>
      <div class="relative mx-auto aspect-[4/3] w-full sm:aspect-[16/10] <%= image_frame_class %>">
        <%= render_media(props["image_url"], alt: prop("headline"), css_class: "absolute inset-0 size-full object-cover", eager: true) %>
      </div>
    </div>

    <% if specs.any? %>
      <dl class="grid w-full max-w-4xl gap-y-6 pt-2 md:pt-4 <%= spec_grid_class %>">
        <% specs.each_with_index do |spec, index| %>
          <div <%= item_attrs("specs", class: "flex min-w-0 flex-col items-center gap-1.5 px-4 py-3 sm:px-6 #{spec_cell_class(index)}") %>>
            <% if present_text?(spec["value"]) %>
              <dt <%= el_attrs("specs.value", class: "text-balance text-site-2xl tabular-nums leading-none md:text-site-4xl #{headline_font_class}") %>><%= spec["value"] %></dt>
            <% end %>
            <% if present_text?(spec["label"]) %>
              <dd <%= el_attrs("specs.label", class: "text-pretty text-site-sm md:text-site-base #{muted_class}") %>><%= spec["label"] %></dd>
            <% end %>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>
</section>
