<section class="<%= padding_class %>">
  <div class="mx-auto max-w-3xl px-5 sm:px-8">
    <% if present_text?(prop("heading")) %>
      <h2 <%= el_attrs("heading", class: "mb-8 md:mb-10 #{section_heading_class}") %>><%= prop("heading") %></h2>
    <% end %>
    <div class="flex flex-col gap-6">
      <% paragraphs.each_with_index do |paragraph, index| %>
        <p <%= el_attrs("body", class: "whitespace-pre-line break-words text-pretty #{index.zero? ? "text-site-lg leading-relaxed md:text-site-xl md:leading-relaxed" : "text-site-md leading-[1.75] md:text-site-lg md:leading-[1.75] #{body_text_class}"}") %>><%= paragraph %></p>
      <% end %>
    </div>
  </div>
</section>
