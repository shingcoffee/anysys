<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> grid min-w-0 items-start gap-12 md:grid-cols-12 md:gap-14 lg:gap-20">
    <div class="flex flex-col gap-6 md:col-span-5 lg:col-span-5">
      <% if present_text?(prop("kicker")) %>
        <p <%= el_attrs("kicker", class: kicker_class) %>><%= prop("kicker") %></p>
      <% end %>
      <% if present_text?(prop("heading")) %>
        <h2 <%= el_attrs("heading", class: section_heading_class) %>><%= prop("heading") %></h2>
      <% end %>
      <% if present_text?(prop("body")) %>
        <p <%= el_attrs("body", class: "max-w-xl text-pretty whitespace-pre-line #{body_class} #{body_text_class}") %>><%= prop("body") %></p>
      <% end %>
      <% if present_text?(prop("button_label")) %>
        <div class="pt-1" data-site-el="buttons">
          <%= content_tag(button_href.present? ? :a : :span, prop("button_label"), href: button_href.presence, class: primary_button_class, style: styler.button_css(:primary)) %>
        </div>
      <% end %>
    </div>

    <% if items.any? %>
      <ul class="flex flex-col gap-7 md:col-span-7 lg:col-span-6 lg:col-start-7" role="list">
        <% items.each do |item| %>
          <li <%= item_attrs("items", class: "flex items-start gap-4") %>>
            <span class="<%= check_wrap_class %>" aria-hidden="true">
              <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
            </span>
            <div class="flex min-w-0 flex-col gap-1.5">
              <% if present_text?(item["title"]) %>
                <h3 <%= el_attrs("items.title", class: card_title_class) %>><%= item["title"] %></h3>
              <% end %>
              <% if present_text?(item["body"]) %>
                <p <%= el_attrs("items.body", class: "text-pretty text-site-md leading-relaxed md:text-site-lg #{muted_class}") %>><%= item["body"] %></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</section>
