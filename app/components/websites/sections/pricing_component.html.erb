<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> flex flex-col <%= gap_class %>">
    <%= header(kicker: prop("kicker"), heading: prop("heading"), subhead: prop("subhead"), align: :center) %>
    <div class="grid items-stretch gap-6 md:grid-rows-[auto_auto_auto_1fr_auto] <%= grid_class %>">
      <% tiers.each do |tier| %>
        <article <%= item_attrs("tiers", framed: true, class: tier_class(tier)) %>>
          <div class="flex items-center justify-between gap-3">
            <% if present_text?(tier["name"]) %>
              <h3 <%= el_attrs("tiers.name", class: "text-site-lg font-semibold") %>><%= tier["name"] %></h3>
            <% end %>
            <% if featured?(tier) %>
              <span <%= el_attrs("featured_label", class: "rounded-full px-2.5 py-0.5 text-site-xs font-medium #{theme.accent_soft_class}") %>><%= featured_label %></span>
            <% end %>
          </div>

          <p class="flex flex-wrap items-baseline gap-x-2">
            <span <%= el_attrs("tiers.price", class: "text-site-4xl tabular-nums leading-none md:text-site-5xl #{headline_font_class}") %>><%= tier["price"] %></span>
            <% if present_text?(tier["cadence"]) %>
              <span <%= el_attrs("tiers.cadence", class: "text-site-sm #{muted_class}") %>><%= tier["cadence"] %></span>
            <% end %>
          </p>

          <p <%= el_attrs("tiers.body", class: "text-pretty text-site-md leading-relaxed #{muted_class}") %>><%= tier["body"] %></p>

          <ul class="flex flex-col gap-3 self-start text-site-sm <%= features(tier).any? ? "border-t pt-6 #{hairline_class}" : "" %>" role="list">
            <% features(tier).each do |feature| %>
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 size-4 shrink-0 <%= theme.kicker_class %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                <span <%= el_attrs("tiers.features", class: body_text_class) %>><%= feature %></span>
              </li>
            <% end %>
          </ul>

          <% if present_text?(tier["button_label"]) %>
            <% href = item_href(tier, "button_href") %>
            <%= content_tag(href.present? ? :a : :span, tier["button_label"], href: href.presence, class: "#{tier_button_class(tier)} w-full sm:w-full") %>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</section>
