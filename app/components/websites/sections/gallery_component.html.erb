<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> flex flex-col <%= gap_class %>">
    <%= header(kicker: prop("kicker"), heading: prop("heading"), subhead: prop("subhead")) %>
    <div class="grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-12 md:gap-x-6 md:gap-y-12">
      <% plates.each do |plate| %>
        <figure <%= item_attrs("items", class: "flex min-w-0 flex-col gap-3 #{plate[:span]}") %>>
          <div class="relative overflow-hidden rounded-xl md:rounded-2xl <%= plate_height_class(plate) %>">
            <%= render_media(plate[:item]["image_url"], alt: plate[:item]["caption"].to_s, css_class: "absolute inset-0 size-full object-cover") %>
          </div>
          <% if present_text?(plate[:item]["caption"]) %>
            <figcaption <%= el_attrs("items.caption", class: "text-site-sm #{muted_class}") %>><%= plate[:item]["caption"] %></figcaption>
          <% end %>
        </figure>
      <% end %>
    </div>
  </div>
</section>
