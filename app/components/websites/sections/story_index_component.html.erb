<section class="<%= padding_class %>">
  <div class="<%= inner_measure_class %> flex flex-col gap-8 md:gap-10">
    <% if masthead? %>
      <header class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-t-2 pt-4 <%= rule_class %>">
        <% if present_text?(prop("heading")) %>
          <h2 <%= el_attrs("heading", class: "min-w-0 text-balance break-words text-site-2xl leading-tight md:text-site-4xl #{headline_font_class}") %>><%= prop("heading") %></h2>
        <% end %>
        <% if present_text?(prop("kicker")) %>
          <p <%= el_attrs("kicker", class: "pb-1 #{kicker_class}") %>><%= prop("kicker") %></p>
        <% end %>
      </header>
    <% end %>

    <% if lead %>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <%= story_tag(lead, "flex min-w-0 flex-col gap-6 #{secondary.any? ? "lg:col-span-7" : "lg:col-span-12"}") do %>
          <div class="relative aspect-[3/2] <%= image_frame_class %>">
            <%= render_media(lead["image_url"], alt: lead["title"].to_s, css_class: "absolute inset-0 size-full object-cover transition duration-700 ease-out group-hover:scale-[1.02]", eager: true) %>
          </div>
          <div class="flex flex-col gap-3 md:gap-4">
            <% if present_text?(lead["kicker"]) %>
              <p <%= el_attrs("stories.kicker", class: story_kicker_class) %>><%= lead["kicker"] %></p>
            <% end %>
            <h3 <%= el_attrs("stories.title", class: title_class(lead, "text-site-3xl leading-[1.06] md:text-site-5xl")) %>><%= lead["title"] %></h3>
            <% if present_text?(lead["body"]) %>
              <p <%= el_attrs("stories.body", class: "max-w-2xl text-pretty text-site-md leading-relaxed md:text-site-xl #{body_text_class}") %>><%= lead["body"] %></p>
            <% end %>
            <% if present_text?(lead["byline"]) %>
              <p <%= el_attrs("stories.byline", class: byline_class) %>><%= lead["byline"] %></p>
            <% end %>
          </div>
        <% end %>

        <% if secondary.any? %>
          <div class="flex min-w-0 flex-col border-t pt-2 lg:col-span-5 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0 <%= hairline_class %> <%= divide_class %>">
            <% secondary.each do |story| %>
              <%= story_tag(story, "grid grid-cols-[minmax(0,1fr)_6.5rem] gap-5 py-7 first:pt-4 last:pb-0 sm:grid-cols-[minmax(0,1fr)_9rem] lg:first:pt-0") do %>
                <div class="flex min-w-0 flex-col gap-2">
                  <% if present_text?(story["kicker"]) %>
                    <p <%= el_attrs("stories.kicker", class: story_kicker_class) %>><%= story["kicker"] %></p>
                  <% end %>
                  <h3 <%= el_attrs("stories.title", class: title_class(story, "text-site-xl leading-snug md:text-site-2xl")) %>><%= story["title"] %></h3>
                  <% if present_text?(story["body"]) %>
                    <p <%= el_attrs("stories.body", class: "line-clamp-3 text-pretty text-site-base leading-relaxed #{muted_class}") %>><%= story["body"] %></p>
                  <% end %>
                  <% if present_text?(story["byline"]) %>
                    <p <%= el_attrs("stories.byline", class: "pt-1 #{byline_class}") %>><%= story["byline"] %></p>
                  <% end %>
                </div>
                <div class="relative aspect-square overflow-hidden rounded-xl <%= theme.image_frame_class %>">
                  <%= render_media(story["image_url"], alt: story["title"].to_s, css_class: "absolute inset-0 size-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]") %>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if briefs.any? %>
      <div class="grid gap-x-8 gap-y-8 border-t pt-8 sm:grid-cols-2 lg:grid-cols-4 <%= hairline_class %>">
        <% briefs.each do |story| %>
          <%= story_tag(story, "flex min-w-0 flex-col gap-2") do %>
            <% if present_text?(story["kicker"]) %>
              <p <%= el_attrs("stories.kicker", class: story_kicker_class) %>><%= story["kicker"] %></p>
            <% end %>
            <h3 <%= el_attrs("stories.title", class: title_class(story, "text-site-lg leading-snug md:text-site-xl")) %>><%= story["title"] %></h3>
            <% if present_text?(story["byline"]) %>
              <p <%= el_attrs("stories.byline", class: byline_class) %>><%= story["byline"] %></p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
