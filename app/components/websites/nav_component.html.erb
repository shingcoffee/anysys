<%# backdrop-filter on <header> traps fixed descendants, so the sheet is a sibling. %>
<div class="contents"
     data-controller="website-nav"
     data-website-nav-open-label-value="<%= open_label %>"
     data-website-nav-close-label-value="<%= close_label %>">
  <header class="sticky top-0 z-30 <%= theme.nav_class %>">
    <div class="<%= inner_measure_class %> flex <%= bar_height_class %> items-center justify-between gap-4">
      <div class="flex flex-1 items-center justify-start min-w-0">
        <a href="<%= home_href %>" class="flex min-w-0 items-center break-words text-base leading-snug sm:text-site-lg <%= headline_font_class %>">
          <%= site_name %>
          <% if present_text?(tagline) %>
            <span class="sr-only"><%= tagline %></span>
          <% end %>
        </a>
      </div>

      <nav class="hidden flex-none items-center justify-center gap-1 lg:flex" aria-label="<%= site_name %>">
        <% nav_pages.each do |page| %>
          <a href="<%= page_href(page) %>"
             class="<%= nav_link_class(page) %> shrink-0"
             <% if current?(page) %>aria-current="page"<% end %>>
            <%= page_title(page) %>
          </a>
        <% end %>
      </nav>

      <div class="flex flex-1 shrink-0 items-center justify-end gap-1 sm:gap-2">
        <%= render Websites::LanguageSwitcherComponent.new(theme: theme) %>
        <button type="button"
                class="<%= nav_button_class %> lg:hidden"
                data-website-nav-target="trigger"
                data-action="click->website-nav#toggle"
                aria-expanded="false"
                aria-controls="website-nav-panel"
                aria-label="<%= open_label %>">
          <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <%= render Websites::MobileNavSheetComponent.new(
        website: website,
        pages: nav_pages,
        current_slug: @current_slug,
        theme: theme,
        open_label: open_label,
        close_label: close_label
      ) %>
</div>
