<details class="group relative">
  <summary class="<%= trigger_class %> list-none marker:hidden [&::-webkit-details-marker]:hidden"
           aria-label="<%= t("locale_switcher.label") %>" aria-haspopup="menu">
    <svg class="size-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3M3.6 9h16.8M3.6 15h16.8" />
    </svg>
    <span class="hidden min-[380px]:inline"><%= current_short_name %></span>
    <svg class="<%= chevron_class %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </summary>

  <div class="<%= panel_class %>" role="menu" aria-label="<%= t("locale_switcher.label") %>">
    <p class="border-b border-current/10 px-4 py-2 text-site-xs font-semibold uppercase tracking-[0.14em] <%= panel_heading_class %>">
      <%= t("locale_switcher.label") %>
    </p>
    <div class="py-1">
      <% locales.each do |locale| %>
        <%= link_to locale_href(locale), lang: locale, hreflang: locale,
              role: "menuitem", aria: { current: current?(locale) ? "true" : nil },
              class: option_class(locale) do %>
          <span><%= display_name(locale) %></span>
          <% if current?(locale) %>
            <svg class="size-4 shrink-0 <%= check_class %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</details>
