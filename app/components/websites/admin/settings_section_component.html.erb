<%= tag.section id: id, class: "card min-w-0 scroll-mt-24", data: section_data, aria: { labelledby: heading_id } do %>
  <header class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 border-b border-border-subtle px-4 py-4 sm:px-6">
    <div class="min-w-0 flex-1">
      <h2 id="<%= heading_id %>" class="section-header scroll-mt-24"><%= heading %></h2>
      <% if description.present? %>
        <p class="mt-1 max-w-2xl text-sm leading-normal text-text-secondary"><%= description %></p>
      <% end %>
    </div>
    <%= aside if aside? %>
  </header>
  <div class="min-w-0 px-4 py-5 sm:px-6">
    <%= content %>
  </div>
<% end %>
