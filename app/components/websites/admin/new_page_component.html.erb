<%= tag.div class: shell_class, data: shell_data do %>
  <% if layouts? %>
    <section class="flex min-w-0 flex-col gap-5" aria-labelledby="website-new-page-layout-heading">
      <div class="flex min-w-0 items-start gap-3">
        <span class="<%= STEP_BADGE_CLASS %>" aria-hidden="true">1</span>
        <div class="min-w-0">
          <h2 id="website-new-page-layout-heading" class="section-header"><%= t("website.admin.pages.new.choose_heading") %></h2>
          <p class="mt-0.5 text-sm text-text-tertiary"><%= t("website.admin.pages.form.layout_hint") %></p>
        </div>
      </div>
      <%= render picker %>
    </section>
  <% end %>

  <aside class="min-w-0 lg:sticky lg:top-4" aria-labelledby="website-page-identity-heading">
    <div class="card overflow-hidden">
      <div class="flex min-w-0 items-start gap-3 border-b border-border-subtle px-5 py-4">
        <span class="<%= STEP_BADGE_CLASS %>" aria-hidden="true"><%= layouts? ? 2 : 1 %></span>
        <div class="min-w-0">
          <h2 id="website-page-identity-heading" class="section-header"><%= t("website.admin.pages.new.details_heading") %></h2>
          <p class="mt-0.5 text-sm text-text-tertiary"><%= t("website.admin.pages.new.details_hint") %></p>
        </div>
      </div>
      <div class="px-5 py-4">
        <%= render Websites::Admin::PageIdentityComponent.new(composer: composer, form: form) %>
      </div>
      <% if layouts? %>
        <%= render Websites::Admin::LayoutSummaryComponent.new(layout: picker.selected_layout) %>
      <% end %>
      <div class="flex flex-col gap-2 border-t border-border-subtle px-5 py-4">
        <%= render ButtonComponent.new(variant: :primary, type: "submit", full_width: true, class: "min-h-10") do %>
          <%= t("website.admin.pages.new.submit") %>
        <% end %>
        <p class="text-center text-xs leading-normal text-text-tertiary"><%= t("website.admin.pages.new.submit_hint") %></p>
      </div>
    </div>
  </aside>
<% end %>
