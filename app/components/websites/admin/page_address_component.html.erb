<span class="inline-flex min-w-0 max-w-full flex-wrap items-center gap-x-1.5 gap-y-0.5" data-page-address="true">
  <span class="text-text-tertiary"><%= t("website.admin.pages.edit.address_label") %></span>
  <% if live? %>
    <a href="<%= path %>" target="_blank" rel="noopener"
       class="inline-flex min-w-0 items-center gap-1 font-mono text-text-primary underline-offset-2 hover:text-accent hover:underline focus-visible:outline-2 focus-visible:outline-accent">
      <span class="truncate"><%= path %></span>
      <svg class="size-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11 3a1 1 0 1 0 0 2h2.586l-6.293 6.293a1 1 0 1 0 1.414 1.414L15 6.414V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5Z"/><path d="M5 5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 0 0 0-2H5Z"/></svg>
      <span class="<%= visually_hidden_class %>"><%= t("website.admin.pages.edit.address_opens") %></span>
    </a>
  <% else %>
    <span class="truncate font-mono text-text-primary"><%= path %></span>
    <span class="text-text-tertiary">· <%= t("website.admin.pages.edit.address_hidden") %></span>
  <% end %>
</span>
