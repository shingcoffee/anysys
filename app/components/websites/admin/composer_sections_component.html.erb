<% if workspace? %>
  <div class="flex min-h-0 min-w-0 flex-1 flex-col">
    <div data-workspace-outline class="flex min-h-0 min-w-0 flex-1 flex-col overflow-y-auto">
      <% if inspector_header? %>
        <div class="shrink-0 border-b border-border-subtle px-3 py-3 sm:px-4">
          <button type="button"
                  data-workspace-identity-nav
                  data-action="click->website-builder#focusIdentity"
                  aria-current="false"
                  class="group/identity-nav flex w-full min-w-0 items-start gap-3 rounded-lg px-2.5 py-2 text-left transition-colors hover:bg-surface-hover aria-[current=true]:bg-accent-subtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent">
            <span class="flex size-6 shrink-0 items-center justify-center rounded-md bg-canvas text-text-tertiary transition-colors group-hover/identity-nav:text-text-secondary group-aria-[current=true]/identity-nav:bg-accent-subtle group-aria-[current=true]/identity-nav:text-accent-text" aria-hidden="true">
              <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"/>
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium text-text-primary"><%= t("website.admin.pages.edit.page_settings") %></span>
              <span class="mt-0.5 block truncate text-xs text-text-tertiary"><%= t("website.admin.pages.edit.identity_preview") %></span>
            </span>
          </button>
        </div>
      <% end %>

      <div class="flex min-h-0 min-w-0 flex-1 flex-col">
        <div class="flex shrink-0 items-center justify-between gap-2 px-5 pb-2 pt-4 sm:px-6">
          <h2 class="text-xs font-medium uppercase tracking-[0.08em] text-text-tertiary">
            <%= t("website.admin.pages.edit.sections") %>
          </h2>
          <% unless structure_locked? %>
            <div class="relative shrink-0">
              <%= render ButtonComponent.new(
                    variant: :ghost,
                    size: :sm,
                    class: "h-7 px-2",
                    data: {
                      action: "click->website-builder#toggleKit",
                      kit_toggle: true
                    },
                    aria: { expanded: "false", controls: "website-kit-picker" }
                  ) do %>
                <%= t("website.admin.pages.edit.add_section") %>
              <% end %>
              <div id="website-kit-picker"
                   data-website-builder-target="kit"
                   class="dropdown-panel hidden absolute right-0 z-20 mt-2 max-h-[min(28rem,60vh)] w-[min(36rem,calc(100vw-2rem))] overflow-y-auto p-3">
                <%= render Websites::Admin::KitPickerComponent.new(types: kit_types) %>
              </div>
            </div>
          <% end %>
        </div>

        <nav class="min-h-0 min-w-0 flex-1 px-3 pb-4 sm:px-4" aria-label="<%= t("website.admin.pages.edit.section_nav") %>">
          <div class="flex min-w-0 flex-col gap-0.5" role="tablist" aria-orientation="vertical"
               aria-label="<%= t("website.admin.pages.edit.section_nav") %>" data-workspace-section-nav>
            <% section_nav_items.each_with_index do |item, index| %>
              <%= section_tab(item, index: index) %>
            <% end %>
          </div>
          <div data-website-builder-target="empty" class="<%= "hidden" if sections.any? %> px-2 pt-6">
            <%= render EmptyStateComponent.new(
                  title: t("website.admin.pages.edit.no_sections_title"),
                  description: t("website.admin.pages.edit.no_sections_description")
                ) %>
          </div>
        </nav>
      </div>
    </div>

    <% unless structure_locked? %>
      <template data-section-nav-template>
        <%= section_tab({ id: "SECTION_ID", label: "" }) %>
      </template>
    <% end %>

    <div data-workspace-detail class="hidden flex min-h-0 min-w-0 flex-1 flex-col">
      <div class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-y-auto bg-surface" data-workspace-inspector>
        <div class="@container/content mx-auto flex w-full max-w-3xl flex-col px-5 py-4 sm:px-6">
          <p class="<%= visually_hidden_class %>"><%= t("website.admin.pages.edit.inspector_hint") %></p>
          <%= inspector_header %>
          <div data-website-builder-target="list" class="flex flex-col gap-0" data-workspace-rail>
            <% sections.each_with_index do |section, index| %>
              <%= render Websites::Admin::SectionEditorComponent.new(
                    section: section,
                    presentation: presentation,
                    theme: site_theme,
                    index: index,
                    expanded: false,
                    first: index.zero?,
                    last: index == sections.size - 1,
                    structure_locked: structure_locked?,
                    site_pages: site_pages,
                    defaults: defaults_for(section, index),
                    workspace: true,
                    uploadable: image_upload?,
                    step: step_for(section)
                  ) %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% else %>
<section class="card overflow-hidden relative" aria-labelledby="website-page-sections-heading">
  <div class="card-header flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex min-w-0 items-start justify-between gap-3">
      <div class="flex min-w-0 flex-col gap-1">
        <h2 id="website-page-sections-heading" class="section-header">
          <%= structure_locked? ? t("website.admin.pages.edit.content") : t("website.admin.pages.edit.sections") %>
        </h2>
        <% if structure_locked? %>
          <p class="text-sm text-text-tertiary"><%= t("website.admin.pages.edit.content_hint") %></p>
        <% elsif layout_kind? %>
          <p class="text-sm text-text-tertiary"><%= t("website.platform.layouts.form.sections_hint") %></p>
        <% end %>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <%= render ButtonComponent.new(
              variant: :ghost,
              size: :sm,
              data: {
                action: "click->website-builder#toggleAllSections",
                website_builder_target: "toggleAll"
              }
            ) do %>
          <%= t("website.admin.pages.edit.expand_all") %>
        <% end %>
        <% unless structure_locked? %>
          <div class="relative shrink-0">
            <%= render ButtonComponent.new(
                  variant: :primary,
                  size: :sm,
                  data: {
                    action: "click->website-builder#toggleKit",
                    kit_toggle: true
                  },
                  aria: { expanded: "false", controls: "website-kit-picker" }
                ) do %>
              <%= t("website.admin.pages.edit.add_section") %>
            <% end %>
            <div id="website-kit-picker"
                 data-website-builder-target="kit"
                 class="dropdown-panel hidden absolute right-0 z-20 mt-2 w-full overflow-y-auto p-3 sm:right-auto sm:w-[36rem]">
              <%= render Websites::Admin::KitPickerComponent.new(types: kit_types) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <% if section_nav_items.any? %>
      <nav class="flex gap-2 overflow-x-auto pb-0.5" aria-label="<%= t("website.admin.pages.edit.section_nav") %>">
        <% section_nav_items.each_with_index do |item, index| %>
          <button type="button"
                  data-website-builder-target="sectionNav"
                  data-section-id="<%= item[:id] %>"
                  data-action="click->website-builder#focusSection"
                  aria-current="<%= index.zero? ? "true" : "false" %>"
                  class="<%= outline_item_class %>">
            <span class="truncate text-sm font-medium text-text-secondary"><%= item[:label] %></span>
            <% if item[:preview].present? %>
              <span class="min-w-0 truncate text-sm text-text-tertiary"><%= item[:preview] %></span>
            <% end %>
          </button>
        <% end %>
      </nav>
    <% end %>
  </div>

  <div class="flex flex-col gap-4 px-4 py-4 sm:px-5">
    <div data-website-builder-target="empty" class="<%= "hidden" if sections.any? %>">
      <%= render EmptyStateComponent.new(
            title: t("website.admin.pages.edit.no_sections_title"),
            description: t("website.admin.pages.edit.no_sections_description")
          ) %>
    </div>

    <div data-website-builder-target="list" class="flex flex-col gap-4">
      <% sections.each_with_index do |section, index| %>
        <%= render Websites::Admin::SectionEditorComponent.new(
              section: section,
              presentation: presentation,
              theme: site_theme,
              index: index,
              expanded: index.zero?,
              first: index.zero?,
              last: index == sections.size - 1,
              structure_locked: structure_locked?,
              site_pages: site_pages,
              defaults: defaults_for(section, index),
              workspace: false,
              uploadable: image_upload?
            ) %>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<% unless structure_locked? %>
  <% kit_types.each do |type| %>
    <template data-section-template="<%= type %>">
      <%= render Websites::Admin::SectionEditorComponent.new(
            section: template_section(type),
            presentation: presentation,
            theme: site_theme,
            index: 0,
            expanded: true,
            first: false,
            last: false,
            structure_locked: structure_locked?,
            site_pages: site_pages,
            defaults: empty_defaults_for(type),
            workspace: workspace?,
            uploadable: image_upload?
          ) %>
    </template>
  <% end %>
<% end %>
