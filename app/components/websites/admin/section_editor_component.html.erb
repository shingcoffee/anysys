<article data-website-builder-target="row"
         <% if workspace? %>id="website-section-panel-<%= section_id %>" role="tabpanel" aria-labelledby="website-section-tab-<%= section_id %>" data-section-label="<%= type_label %>"<% end %>
         data-section-id="<%= section_id %>"
         data-section-type="<%= section_type %>"
         data-section-defaults="<%= ERB::Util.html_escape(default_props.to_json) %>"
         class="<%= row_classes %><%= " hidden" if workspace? && !expanded %>">
  <div class="flex items-start gap-3 <%= workspace? ? "flex-wrap py-1" : "p-4 sm:p-5" %>">
  <% unless structure_locked? %>
    <button type="button"
            data-website-builder-target="handle"
            aria-label="<%= t("website.admin.pages.edit.drag") %>"
            class="mt-1.5 shrink-0 cursor-grab touch-none text-text-muted hover:text-text-secondary active:cursor-grabbing focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-md p-1">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="7" cy="5" r="1.5"/>
        <circle cx="13" cy="5" r="1.5"/>
        <circle cx="7" cy="10" r="1.5"/>
        <circle cx="13" cy="10" r="1.5"/>
        <circle cx="7" cy="15" r="1.5"/>
        <circle cx="13" cy="15" r="1.5"/>
      </svg>
    </button>
  <% end %>

    <div class="<%= workspace? ? "order-3 w-full min-w-0" : "min-w-0 flex-1" %>">
      <% if known? %>
        <% if workspace? %>
          <div class="@container/content flex min-w-0 flex-col gap-4">
            <header class="sticky top-0 z-10 -mx-5 flex min-w-0 items-center gap-2 border-b border-border-subtle bg-surface/95 px-5 py-2 backdrop-blur-sm sm:-mx-6 sm:px-6">
              <button type="button"
                      class="<%= chrome_btn_class %>"
                      data-action="click->website-builder#showOutline:prevent"
                      aria-label="<%= t("website.admin.pages.edit.back_to_sections") %>">
                <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.832 10l3.938 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z" clip-rule="evenodd"/></svg>
              </button>
              <div class="flex min-w-0 flex-1 items-baseline gap-2">
                <%= tag.h3 type_label, title: type_description, class: "truncate text-sm font-semibold leading-snug tracking-tight text-text-primary" %>
                <% if position_label %>
                  <span class="shrink-0 text-2xs tabular-nums text-text-muted" data-section-position><%= position_label %></span>
                <% end %>
              </div>
              <div class="flex shrink-0 items-center gap-0.5">
                <% if step_nav? %>
                  <nav class="flex items-center gap-0.5" data-section-steps aria-label="<%= t("website.admin.pages.edit.section_steps") %>">
                  <% if previous_step %>
                    <button type="button"
                            class="<%= chrome_btn_class %>"
                            data-action="click->website-builder#focusSection"
                            data-section-id="<%= previous_step[:id] %>"
                            data-section-step="previous"
                            aria-label="<%= t("website.admin.pages.edit.previous_section") %>: <%= previous_step[:label] %>">
                      <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9.47 6.47a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 1 1-1.06 1.06L10 8.06l-3.72 3.72a.75.75 0 0 1-1.06-1.06l4.25-4.25Z" clip-rule="evenodd"/></svg>
                      <span class="<%= visually_hidden_class %>"><%= t("website.admin.pages.edit.previous_section") %> <%= previous_step[:label] %></span>
                    </button>
                  <% end %>
                  <% if next_step %>
                    <button type="button"
                            class="<%= chrome_btn_class %>"
                            data-action="click->website-builder#focusSection"
                            data-section-id="<%= next_step[:id] %>"
                            data-section-step="next"
                            aria-label="<%= t("website.admin.pages.edit.next_section") %>: <%= next_step[:label] %>">
                      <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>
                      <span class="<%= visually_hidden_class %>"><%= t("website.admin.pages.edit.next_section") %> <%= next_step[:label] %></span>
                    </button>
                  <% end %>
                  </nav>
                <% end %>
                <% if section_design %>
                  <%= render section_design.trigger %>
                <% end %>
                <% if structure_locked? %>
                  <button type="button" class="<%= chrome_btn_class %>"
                          data-action="click->website-builder#resetSection:prevent:stop"
                          aria-label="<%= t("website.admin.pages.form.reset_content") %>">
                    <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    <span class="<%= visually_hidden_class %>"><%= t("website.admin.pages.form.reset_content") %></span>
                  </button>
                <% end %>
              </div>
            </header>
            <% if section_design %>
              <%= render section_design do %>
                <% appearance_fields.each do |field| %>
                  <%= render field_component(field) %>
                <% end %>
              <% end %>
            <% end %>
        <% else %>
          <details class="group/section min-w-0 flex-1" <% if expanded %>open<% end %>>
            <summary class="flex cursor-pointer list-none items-center gap-3 rounded-lg py-0.5 [&::-webkit-details-marker]:hidden">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 text-text-muted transition-transform group-open/section:rotate-90" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
              </svg>
              <%= render BadgeComponent.new(variant: :purple, size: :sm) do %>
                <%= type_label %>
              <% end %>
              <% if preview_text.present? %>
                <span class="min-w-0 flex-1 truncate text-sm text-text-tertiary"><%= preview_text %></span>
              <% end %>
              <% if section_design || structure_locked? %>
                <span class="ml-auto flex shrink-0 items-center gap-1">
                  <% if section_design %>
                    <%= render section_design.trigger %>
                  <% end %>
                  <% if structure_locked? %>
                    <%= render ButtonComponent.new(
                          variant: :ghost,
                          size: :sm,
                          class: "shrink-0",
                          data: { action: "click->website-builder#resetSection:prevent:stop" }
                        ) do %>
                      <%= t("website.admin.pages.edit.reset_section") %>
                    <% end %>
                  <% end %>
                </span>
              <% end %>
            </summary>
            <div class="mt-4 flex flex-col gap-5 border-t border-border-subtle pt-4">
              <% if type_description.present? %>
                <p class="text-sm text-text-tertiary"><%= type_description %></p>
              <% end %>
        <% end %>

            <%= content_tag :div, class: workspace? ? "flex min-w-0 flex-col divide-y divide-border-subtle" : "contents" do %>
              <% if section_design && !workspace? %>
                <%= tag.div class: "contents", data: { section_design: true } do %>
                  <%= render section_design do %>
                    <% appearance_fields.each do |field| %>
                      <%= render field_component(field) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
              <% field_sections.each do |block| %>
                <%= content_tag :div,
                      class: workspace? ? "flex min-w-0 flex-col gap-3 py-4 first:pt-0 last:pb-0" : "flex flex-col gap-3 rounded-xl bg-canvas-elevated/80 p-4 ring-1 ring-border-subtle",
                      data: workspace? ? { field_section: block[:group] } : { field_group: block[:group] } do %>
                  <% if block[:heading] %>
                    <h3 class="text-sm font-semibold uppercase tracking-[0.08em] text-text-secondary"><%= group_label(block[:group]) %></h3>
                  <% end %>
                  <% block[:units].each do |unit| %>
                    <%= content_tag unit[:optional] ? :details : :div, class: "min-w-0#{' group/button' if unit[:button]}", data: { button_pair: unit[:button] }.compact do %>
                      <% if unit[:optional] %>
                        <summary class="flex min-h-9 w-fit cursor-pointer list-none items-center gap-1.5 rounded-md text-sm font-medium text-text-tertiary transition-colors hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:min-h-11 [&::-webkit-details-marker]:hidden">
                          <svg class="size-4 shrink-0 transition-transform group-open/button:rotate-90" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/></svg>
                          <span><%= button_label(unit[:button]) %></span>
                        </summary>
                      <% end %>
                      <%= content_tag unit[:button] ? :fieldset : :div, class: "min-w-0#{' mt-2' if unit[:optional]}" do %>
                        <% if unit[:button] %>
                          <legend class="<%= unit[:optional] ? visually_hidden_class : 'mb-2 text-sm font-medium text-text-primary' %>"><%= button_label(unit[:button]) %></legend>
                        <% end %>
                        <div class="<%= workspace? && unit[:fields].size > 1 ? 'grid min-w-0 grid-cols-1 gap-3 @min-[24rem]/content:grid-cols-2' : 'flex min-w-0 flex-col gap-3' %>">
                          <% unit[:fields].each do |field| %>
                            <%= render field_component(field, button: unit[:button]) %>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>

        <% if workspace? %>
          </div>
        <% else %>
            </div>
          </details>
        <% end %>
      <% else %>
        <div class="flex flex-col gap-1">
          <%= render BadgeComponent.new(variant: :warning, size: :sm) do %>
            <%= type_label %>
          <% end %>
          <p class="text-sm text-warning"><%= t("website.admin.pages.edit.unknown_section") %></p>
        </div>
      <% end %>
    </div>

    <% unless structure_locked? %>
    <div class="flex shrink-0 items-center gap-0.5 <%= "ml-auto" if workspace? %>">
      <button type="button"
              data-action="click->website-builder#moveUp"
              aria-label="<%= t("website.admin.pages.index.move_up") %>"
              <%= "disabled" if first %>
              class="flex size-8 items-center justify-center rounded-md text-text-muted hover:bg-surface-active hover:text-text-primary disabled:cursor-not-allowed disabled:opacity-30 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
      <button type="button"
              data-action="click->website-builder#moveDown"
              aria-label="<%= t("website.admin.pages.index.move_down") %>"
              <%= "disabled" if last %>
              class="flex size-8 items-center justify-center rounded-md text-text-muted hover:bg-surface-active hover:text-text-primary disabled:cursor-not-allowed disabled:opacity-30 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
      <button type="button"
              data-action="click->website-builder#removeSection"
              aria-label="<%= t("common.actions.delete") %>"
              class="flex size-8 items-center justify-center rounded-md text-danger hover:bg-danger-subtle focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-danger">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>
    <% end %>
  </div>
</article>
