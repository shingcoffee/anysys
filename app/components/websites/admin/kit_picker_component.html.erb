<div class="flex flex-col gap-4" role="list" aria-label="<%= t("website.admin.pages.edit.kit_catalog") %>">
  <% grouped_types.each do |group_key, group_types| %>
    <section class="flex flex-col gap-1.5">
      <h3 class="px-1 text-sm font-semibold uppercase tracking-[0.08em] text-text-secondary"><%= group_label(group_key) %></h3>
      <div class="grid grid-cols-1 gap-1 sm:grid-cols-2">
        <% group_types.each do |type| %>
          <button type="button"
                  role="listitem"
                  data-type="<%= type %>"
                  data-action="click->website-builder#addSection"
                  class="rounded-lg px-3 py-2.5 text-left transition-colors hover:bg-surface-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
            <span class="block text-base font-medium text-text-primary"><%= type_name(type) %></span>
            <span class="mt-0.5 block text-sm text-text-tertiary"><%= type_description(type) %></span>
          </button>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
