<div class="flex min-w-0 flex-col gap-5" data-layout-picker="true">
  <div class="flex flex-col gap-3">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="relative w-full sm:max-w-xs">
        <label for="website-layout-search" class="<%= visually_hidden_class %>"><%= t("website.admin.pages.new.search_label") %></label>
        <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z"/>
        </svg>
        <input type="search"
               id="website-layout-search"
               class="input-field h-10 pl-9"
               placeholder="<%= t("website.admin.pages.new.search_placeholder") %>"
               autocomplete="off"
               data-website-layout-picker-target="search"
               data-action="input->website-layout-picker#search keydown.esc->website-layout-picker#clearSearch">
      </div>
      <p class="shrink-0 text-sm tabular-nums text-text-tertiary" aria-live="polite" data-website-layout-picker-target="count"><%= initial_count_label %></p>
    </div>
    <div class="-mx-1 flex gap-2 overflow-x-auto px-1 py-0.5 sm:flex-wrap sm:overflow-visible" role="group" aria-label="<%= t("website.admin.pages.new.filter_label") %>">
      <% filters.each do |filter| %>
        <button type="button"
                class="<%= CHIP_CLASS %>"
                aria-pressed="<%= filter[:id] == initial_filter %>"
                data-website-layout-picker-target="filter"
                data-filter="<%= filter[:id] %>"
                data-action="click->website-layout-picker#filter">
          <span><%= filter[:label] %></span>
          <span class="text-xs tabular-nums text-text-tertiary group-aria-pressed/chip:text-white/80"><%= filter[:count] %></span>
        </button>
      <% end %>
    </div>
  </div>

  <fieldset class="min-w-0">
    <legend class="<%= visually_hidden_class %>"><%= t("website.admin.pages.form.layout") %></legend>
    <div class="flex flex-col gap-8">
      <% groups.each do |family, items| %>
        <section class="<%= group_class(items) %>" data-website-layout-picker-target="group" data-layout-family="<%= family %>">
          <div class="flex min-w-0 items-center gap-3">
            <h3 class="shrink-0 text-sm font-semibold text-text-primary"><%= family_label(family) %></h3>
            <% if (category = group_category_label(family)) %>
              <span class="shrink-0 text-xs text-text-tertiary"><%= category %></span>
            <% end %>
            <span class="h-px min-w-4 flex-1 bg-border-subtle" aria-hidden="true"></span>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 2xl:grid-cols-3">
            <% items.each do |layout| %>
              <% data = card_data(layout) %>
              <%= tag.label class: card_class(layout), data: data do %>
                <%= form.radio_button :layout_key, layout.key,
                      checked: selected?(layout),
                      class: "peer #{visually_hidden_class}",
                      aria: { describedby: description_id(layout) } %>
                <span class="relative block">
                  <%= render Websites::Admin::CatalogThumbnailComponent.new(
                        sections: thumbnail_sections(layout),
                        theme: theme,
                        frame_class: "aspect-[16/10]"
                      ) %>
                  <span class="absolute right-2.5 top-9 z-20 hidden size-6 items-center justify-center rounded-full bg-accent text-white shadow-sm group-has-[:checked]/card:flex" aria-hidden="true">
                    <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.25 7.3a1 1 0 0 1-1.42 0l-3.75-3.775a1 1 0 1 1 1.42-1.41l3.04 3.062 6.54-6.585a1 1 0 0 1 1.414-.006Z" clip-rule="evenodd"/></svg>
                  </span>
                  <% if site_default?(layout) %>
                    <%= render BadgeComponent.new(variant: :primary, size: :sm, class: "absolute left-2.5 top-9 z-20 shadow-xs") do %>
                      <%= t("website.admin.pages.new.site_default") %>
                    <% end %>
                  <% end %>
                </span>
                <span class="flex min-w-0 flex-1 flex-col gap-1 px-4 py-3">
                  <span class="flex min-w-0 items-baseline justify-between gap-2">
                    <span class="min-w-0 truncate text-sm font-semibold text-text-primary"><%= layout.display_name %></span>
                    <span class="shrink-0 text-xs tabular-nums text-text-tertiary"><%= data[:layout_count] %></span>
                  </span>
                  <span id="<%= description_id(layout) %>" class="line-clamp-2 text-sm leading-snug text-text-secondary"><%= layout.display_description %></span>
                </span>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <div class="hidden" data-website-layout-picker-target="empty">
      <div class="flex flex-col items-center gap-2 rounded-xl border border-dashed border-border px-6 py-12 text-center">
        <p class="text-sm font-medium text-text-primary"><%= t("website.admin.pages.new.empty_title") %></p>
        <p class="text-sm text-text-tertiary"><%= t("website.admin.pages.new.empty_description") %></p>
        <%= render ButtonComponent.new(variant: :secondary, size: :sm, class: "mt-2", data: { action: "click->website-layout-picker#reset" }) do %>
          <%= t("website.admin.pages.new.show_all") %>
        <% end %>
      </div>
    </div>
  </fieldset>
</div>
