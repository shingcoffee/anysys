<div class="relative overflow-hidden bg-canvas <%= frame_class %>" data-catalog-thumbnail="true" aria-hidden="true">
  <div class="absolute inset-x-0 top-0 z-10 flex h-7 items-center gap-1.5 border-b border-black/5 bg-surface/90 px-3 backdrop-blur-sm">
    <span class="size-1.5 rounded-full bg-red-400/80"></span>
    <span class="size-1.5 rounded-full bg-amber-400/80"></span>
    <span class="size-1.5 rounded-full bg-emerald-400/80"></span>
  </div>
  <div class="absolute inset-0 top-7 overflow-hidden">
    <div class="pointer-events-none select-none origin-top-left scale-[0.4] w-[250%] <%= theme.body_class %>" inert>
      <% if render_live_preview? %>
        <%= render page_component_class.new(sections: preview_sections, theme: theme) %>
      <% else %>
        <ul class="flex flex-col gap-2 p-6">
          <% preview_types.each do |type| %>
            <li class="rounded-lg border border-border-subtle bg-surface px-3 py-2 text-sm text-text-primary"><%= section_type_label(type) %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-8 bg-gradient-to-t <%= fade_class %>" aria-hidden="true"></div>
</div>
