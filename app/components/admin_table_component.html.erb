<turbo-frame id="<%= frame_id %>" data-turbo-action="advance">
<section class="card overflow-hidden" data-controller="admin-table">
  <% if has_toolbar? %>
    <header class="px-4 py-3 border-b border-border-subtle flex flex-col gap-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <form method="get"
            action="<%= base_path %>"
            data-turbo-frame="<%= frame_id %>"
            data-turbo-action="advance"
            class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto sm:flex-1 min-w-0">
        <% if has_search? %>
          <div class="relative flex-1 sm:flex-initial">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted pointer-events-none"
                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            <input type="search"
                   name="<%= search[:param] %>"
                   value="<%= params[search[:param]] %>"
                   placeholder="<%= search[:placeholder] || t("common.actions.search") %>"
                   data-admin-table-target="searchInput"
                   data-action="input->admin-table#debounceSubmit"
                   class="input-field w-full sm:w-64 lg:w-80 pl-9">
          </div>
        <% end %>
        <% if has_filters? %>
          <div class="flex flex-wrap items-center gap-2">
            <% filters.each do |f| %>
              <select name="<%= f[:key] %>"
                      aria-label="<%= f[:label] %>"
                      data-action="change->admin-table#submit"
                      class="input-field w-full sm:w-auto sm:max-w-44 truncate shrink-0 px-3 py-2 cursor-pointer">
                <% if f.fetch(:include_blank, true) %>
                  <option value=""><%= f[:label] %></option>
                <% end %>
                <% f[:options].each do |label, value| %>
                  <option value="<%= value %>" <%= "selected" if params[f[:key]].to_s == value.to_s %>><%= label %></option>
                <% end %>
              </select>
            <% end %>
          </div>
        <% end %>
        <% (params.except(search&.dig(:param), :page, :sort, :dir, *filters.map { |f| f[:key] })).each do |k, v| %>
          <input type="hidden" name="<%= k %>" value="<%= v %>">
        <% end %>
        <% [:sort, :dir].each do |k| %>
          <% if params[k].present? %>
            <input type="hidden" name="<%= k %>" value="<%= params[k] %>">
          <% end %>
        <% end %>
      </form>
        <% if count_summary.present? %>
          <p class="shrink-0 text-[13px] text-text-muted tabular-nums"><%= count_summary %></p>
        <% end %>
      </div>

      <% chips = active_filter_chips %>
      <% if chips.any? %>
        <div class="flex items-center flex-wrap gap-2">
          <% chips.each do |chip| %>
            <%= link_to chip[:remove_path],
                  class: "inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 rounded-full bg-accent-subtle text-accent-text text-xs font-medium ring-1 ring-inset ring-accent-muted hover:bg-accent-muted transition-base",
                  title: t("chrome.admin_table.remove_filter", label: chip[:label]),
                  data: { turbo_frame: frame_id, turbo_action: "advance" } do %>
              <span><%= chip[:label] %>: <%= chip[:value_label] %></span>
              <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            <% end %>
          <% end %>
          <%= link_to t("chrome.admin_table.clear_filters"), clear_filters_path,
                class: "text-xs font-medium text-text-secondary hover:text-text-primary underline decoration-1 underline-offset-2 transition-base",
                data: { turbo_frame: frame_id, turbo_action: "advance" } %>
        </div>
      <% end %>
    </header>
  <% end %>

  <% if rows.empty? %>
    <div class="px-4 py-16 text-center">
      <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-surface-active flex items-center justify-center">
        <svg class="w-6 h-6 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
        </svg>
      </div>
      <% if empty_after_search? %>
        <% if active_search? %>
          <p class="text-base font-semibold text-text-primary mb-1"><%= t("chrome.admin_table.no_matches_html", query: params[search[:param]]) %></p>
          <p class="text-body-sm text-text-muted"><%= t("chrome.admin_table.no_matches_hint") %></p>
        <% else %>
          <p class="text-base font-semibold text-text-primary mb-1"><%= t("chrome.admin_table.no_filter_matches") %></p>
          <p class="text-body-sm text-text-muted"><%= t("chrome.admin_table.no_filter_matches_hint") %></p>
        <% end %>
      <% elsif empty_state %>
        <p class="text-base font-semibold text-text-primary mb-1"><%= empty_state[:title] %></p>
        <% if empty_state[:description].present? %>
          <p class="text-body-sm text-text-muted mb-4"><%= empty_state[:description] %></p>
        <% end %>
        <% if empty_state[:action_path].present? && empty_state[:action_text].present? %>
          <%= link_to empty_state[:action_text], empty_state[:action_path], class: "btn btn-primary", data: { turbo_frame: "_top" } %>
        <% end %>
      <% else %>
        <p class="text-sm text-text-muted"><%= t("chrome.admin_table.nothing_to_show") %></p>
      <% end %>
    </div>
  <% else %>
    <%# Mobile card view %>
    <div class="sm:hidden divide-y divide-border-subtle">
      <% rows.each do |row| %>
        <div class="p-4 hover:bg-surface-hover transition-base">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <% visible_columns.each_with_index do |col, idx| %>
                <% if idx == 0 %>
                  <div class="flex items-center gap-3 min-w-0">
                    <% if (lead = leading_for(row, col)) %>
                      <span class="w-9 h-9 rounded-lg flex-shrink-0 inline-flex items-center justify-center <%= lead[:tone] %>">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                          <path stroke-linecap="round" stroke-linejoin="round" d="<%= lead[:path] %>"/>
                        </svg>
                      </span>
                    <% end %>
                    <div class="min-w-0">
                      <% if row_link?(col, idx) %>
                        <%= link_to row_path.call(row), class: "link text-sm font-medium", data: row_link_data do %>
                          <%= plain_cell(row, col) %>
                        <% end %>
                      <% elsif (dt = datetime_cell(row, col)) %>
                        <p class="text-sm font-medium text-text-primary truncate">
                          <time datetime="<%= dt[:iso] %>" title="<%= dt[:exact] %>"><%= dt[:text] %></time>
                        </p>
                      <% else %>
                        <p class="text-sm font-medium text-text-primary truncate"><%= plain_cell(row, col) %></p>
                      <% end %>
                      <% if (sub = subtitle_for(row, col)) %>
                        <p class="text-xs text-text-muted mt-0.5 truncate"><%= sub %></p>
                      <% end %>
                    </div>
                  </div>
                <% elsif idx < 3 || col[:mobile] %>
                  <p class="text-[13px] text-text-muted mt-0.5 truncate">
                    <span class="text-text-tertiary"><%= col[:label] %>:</span>
                    <% if row_link?(col, idx) %>
                      <%= link_to row_path.call(row), class: "link", data: row_link_data do %>
                        <%= plain_cell(row, col) %>
                      <% end %>
                    <% elsif (bs = badges_for(row, col)).any? %>
                      <span class="inline-flex flex-wrap items-center gap-1 align-middle">
                        <% bs.each do |b| %>
                          <%= render BadgeComponent.new(variant: b[:variant], size: :sm) do %><%= b[:label] %><% end %>
                        <% end %>
                      </span>
                    <% elsif (dt = datetime_cell(row, col)) %>
                      <time datetime="<%= dt[:iso] %>" title="<%= dt[:exact] %>"><%= dt[:text] %></time>
                    <% else %>
                      <%= plain_cell(row, col) %>
                    <% end %>
                  </p>
                <% end %>
              <% end %>
            </div>
            <% if has_row_actions? %>
              <div class="shrink-0 flex items-center gap-2">
                <% if has_inline_row_actions? %>
                  <% Array(row_actions.call(row)).take(2).each do |a| %>
                    <%= link_to a[:label], a[:path],
                          **link_args_for(a),
                          class: "text-xs font-medium #{action_tone_class(a)} transition-base" %>
                  <% end %>
                <% end %>
                <% menu_items = has_row_menu? ? menu_actions_for(row) : [] %>
                <% if menu_items.any? %>
                  <details class="relative" data-controller="menu-placement" data-action="toggle->menu-placement#reposition">
                    <summary role="button"
                             aria-label="<%= t("common.actions.more") %>"
                             title="<%= t("common.actions.more") %>"
                             class="list-none cursor-pointer inline-flex items-center justify-center w-8 h-8 rounded-md text-text-secondary hover:text-text-primary hover:bg-surface-hover transition-base select-none [&::-webkit-details-marker]:hidden">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <circle cx="12" cy="5" r="1.75"/><circle cx="12" cy="12" r="1.75"/><circle cx="12" cy="19" r="1.75"/>
                      </svg>
                    </summary>
                    <div class="absolute right-0 z-20 mt-1 min-w-[10rem] rounded-lg border border-border-subtle bg-canvas-elevated py-1 shadow-md" data-menu-placement-target="panel">
                      <% menu_items.each do |a| %>
                        <%= link_to a[:label], a[:path],
                              **link_args_for(a),
                              class: "block px-3 py-2 text-xs font-medium #{action_tone_class(a)} hover:bg-surface-hover transition-base" %>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Desktop table view %>
    <div class="hidden sm:block overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="table-header">
          <tr>
            <% visible_columns.each do |col| %>
              <th class="<%= alignment_class(col) %> <%= width_class(col) %> px-4 py-3.5 font-semibold whitespace-nowrap">
                <% if (link = sort_link_for(col)) %>
                  <%= link_to link[:href], class: "inline-flex items-center gap-1 hover:text-text-primary transition-base" do %>
                    <%= col[:label] %>
                    <% if link[:arrow] %><span class="text-text-muted"><%= link[:arrow] %></span><% end %>
                  <% end %>
                <% else %>
                  <%= col[:label] %>
                <% end %>
              </th>
            <% end %>
            <% if has_row_actions? %>
              <th class="w-px px-4 py-3.5 text-right whitespace-nowrap">
                <span class="text-[10.5px] uppercase tracking-[0.1em] font-semibold text-text-tertiary/70"><%= t("common.labels.actions") %></span>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle">
          <% rows.each do |row| %>
            <tr class="table-row">
              <% visible_columns.each_with_index do |col, idx| %>
                <td class="px-4 py-3.5 <%= alignment_class(col) %> <%= "whitespace-nowrap" if col[:nowrap] %> text-text-secondary <%= numeric_class(col) %>">
                  <% if idx == 0 %>
                    <div class="flex items-center gap-3 min-w-0">
                      <% if (lead = leading_for(row, col)) %>
                        <span class="w-9 h-9 rounded-lg flex-shrink-0 inline-flex items-center justify-center <%= lead[:tone] %>">
                          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="<%= lead[:path] %>"/>
                          </svg>
                        </span>
                      <% end %>
                      <div class="min-w-0">
                        <% if row_link?(col, idx) %>
                          <%= link_to row_path.call(row), class: "link", data: row_link_data do %>
                            <%= plain_cell(row, col) %>
                          <% end %>
                        <% elsif (bs = badges_for(row, col)).any? %>
                          <div class="inline-flex flex-wrap items-center gap-1">
                            <% bs.each do |b| %>
                              <%= render BadgeComponent.new(variant: b[:variant], size: :sm) do %><%= b[:label] %><% end %>
                            <% end %>
                          </div>
                        <% elsif (dt = datetime_cell(row, col)) %>
                          <time datetime="<%= dt[:iso] %>" title="<%= dt[:exact] %>"><%= dt[:text] %></time>
                        <% else %>
                          <%= plain_cell(row, col) %>
                        <% end %>
                        <% if (sub = subtitle_for(row, col)) %>
                          <p class="text-xs text-text-muted mt-0.5 truncate"><%= sub %></p>
                        <% end %>
                      </div>
                    </div>
                  <% elsif (bs = badges_for(row, col)).any? %>
                    <div class="inline-flex flex-wrap items-center gap-1">
                      <% bs.each do |b| %>
                        <%= render BadgeComponent.new(variant: b[:variant], size: :sm) do %><%= b[:label] %><% end %>
                      <% end %>
                    </div>
                  <% elsif (dt = datetime_cell(row, col)) %>
                    <time datetime="<%= dt[:iso] %>" title="<%= dt[:exact] %>"><%= dt[:text] %></time>
                  <% elsif row_link?(col, idx) %>
                    <%= link_to row_path.call(row), class: "link", data: row_link_data do %>
                      <%= plain_cell(row, col) %>
                    <% end %>
                  <% else %>
                    <%= plain_cell(row, col) %>
                  <% end %>
                </td>
              <% end %>
              <% if has_row_actions? %>
                <td class="px-4 py-3.5 text-right align-middle whitespace-nowrap">
                  <div class="inline-flex items-center justify-end gap-x-3 text-[12.5px] tracking-[0.005em]">
                    <% if has_inline_row_actions? %>
                      <% items = Array(row_actions.call(row)) %>
                      <% items.each_with_index do |a, i| %>
                        <%= link_to a[:label], a[:path],
                              **link_args_for(a),
                              class: "#{action_tone_class(a)} font-medium decoration-1 underline-offset-[3px] hover:underline transition-base" %>
                        <% if i < items.size - 1 %>
                          <span class="inline-block h-3 w-px bg-border-subtle/80 align-middle select-none" aria-hidden="true"></span>
                        <% end %>
                      <% end %>
                    <% end %>
                    <% menu_items = has_row_menu? ? menu_actions_for(row) : [] %>
                    <% if menu_items.any? %>
                      <details class="relative" data-controller="menu-placement" data-action="toggle->menu-placement#reposition">
                        <summary role="button"
                                 aria-label="<%= t("common.actions.more") %>"
                                 title="<%= t("common.actions.more") %>"
                                 class="list-none cursor-pointer inline-flex items-center justify-center w-8 h-8 rounded-md text-text-secondary hover:text-text-primary hover:bg-surface-hover transition-base select-none [&::-webkit-details-marker]:hidden">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <circle cx="12" cy="5" r="1.75"/><circle cx="12" cy="12" r="1.75"/><circle cx="12" cy="19" r="1.75"/>
                          </svg>
                        </summary>
                        <div class="absolute right-0 z-20 mt-1 min-w-[11rem] rounded-lg border border-border-subtle bg-canvas-elevated py-1 shadow-md text-left" data-menu-placement-target="panel">
                          <% menu_items.each do |a| %>
                            <%= link_to a[:label], a[:path],
                                  **link_args_for(a),
                                  class: "block px-3 py-2 text-sm font-medium #{action_tone_class(a)} hover:bg-surface-hover transition-base" %>
                          <% end %>
                        </div>
                      </details>
                    <% end %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%= render Admin::PaginationComponent.new(
        pagination: pagination,
        page_path: ->(page_num) { page_link(page_num) }
      ) %>
</section>
</turbo-frame>
