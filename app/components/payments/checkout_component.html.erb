<section class="mx-auto w-full max-w-md bg-white border border-gray-200 rounded-md p-6">
  <h1 class="text-lg font-semibold text-gray-900"><%= order.subject %></h1>
  <p class="mt-1 text-xs text-gray-500 tabular-nums"><%= t("comp_payments.shared.order_prefix") %><%= order.external_ref %></p>
  <p class="mt-4 text-3xl font-semibold text-gray-900 tabular-nums"><%= formatted_amount %> <%= order.currency.to_s.upcase %></p>

  <% if errors&.any? %>
    <div class="mt-3 border-l-4 border-red-400 bg-red-50 px-3 py-2 text-sm text-red-800"><%= errors.full_messages.to_sentence %></div>
  <% end %>

  <% if any_gateways? %>
    <div class="mt-6 space-y-3">
      <% gateways.each do |gw| %>
        <%= form_with url: helpers.request.path, method: :post, class: "space-y-3", data: { turbo: false } do |f| %>
          <%= f.hidden_field :ref, value: order.external_ref %>
          <% if show_save_card?(gw) %>
            <div class="flex items-start gap-2.5">
              <%= f.check_box :save_card, { include_hidden: false, id: "checkout_save_card_#{gw.key}", class: "mt-0.5 h-4 w-4 shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" }, "1", "0" %>
              <%= f.label :save_card, t("comp_payments.widget_checkout.save_card"), for: "checkout_save_card_#{gw.key}", class: "min-w-0 cursor-pointer text-sm text-gray-700" %>
            </div>
          <% end %>
          <button type="submit" name="provider" value="<%= gw.key %>"
                  class="flex w-full items-center justify-center gap-2 rounded-md border border-gray-300 px-4 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-400">
            <%= gw.display_name %>
          </button>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-6 text-sm text-gray-500"><%= t("comp_payments.checkout.no_methods") %></p>
  <% end %>
</section>
