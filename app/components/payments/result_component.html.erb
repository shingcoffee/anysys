<section class="mx-auto w-full max-w-md bg-white border border-gray-200 rounded-md p-6 text-center">
  <% if success? %>
    <div class="mx-auto w-12 h-12 rounded-full bg-green-100 text-green-700 flex items-center justify-center">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </div>
    <h2 class="mt-3 text-base font-semibold text-gray-900"><%= t("comp_payments.result.success_title") %></h2>
    <p class="mt-1 text-sm text-gray-500"><%= t("comp_payments.shared.order_prefix") %><%= payment.payment_order.external_ref %></p>
  <% else %>
    <div class="mx-auto w-12 h-12 rounded-full bg-yellow-100 text-yellow-700 flex items-center justify-center">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M4.93 19h14.14c1.54 0 2.5-1.67 1.73-3L13.73 4a2 2 0 00-3.46 0L3.2 16c-.77 1.33.19 3 1.73 3z"/>
      </svg>
    </div>
    <h2 class="mt-3 text-base font-semibold text-gray-900"><%= t(pending? ? "comp_payments.result.pending_title" : "comp_payments.result.failure_title") %></h2>
    <p class="mt-1 text-sm text-gray-500"><%= t("comp_payments.result.status_prefix") %><%= status_label %></p>
  <% end %>
  <%= link_to t("comp_payments.result.return"), return_path, class: "btn btn-primary mt-6" %>
</section>
