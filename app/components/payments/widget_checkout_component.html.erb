<%# Vendor-agnostic in-page payment widget checkout.
    The outer section mirrors card_checkout_component.html.erb (order summary
    card + rounded-xl white card). The inner wrapper div injects all Stimulus
    data attributes via Rails tag helpers — no attribute-name interpolation.

    Data-* layout (varies by gateway descriptor):
      data-controller="<controller_id>"
      data-<controller_id>-result-url-value
      data-<controller_id>-status-url-value
      data-<controller_id>-<key>-value   (one per gateway value_key)

    Targets always present:
      data-<controller_id>-target="element"  — widget mount point
      data-<controller_id>-target="error"    — inline error region
%>
<section class="mx-auto w-full max-w-md bg-white border border-gray-200 rounded-xl p-6 shadow-sm">

  <%# ── Order summary ───────────────────────────────────────────────────── %>
  <h1 class="text-lg font-semibold text-gray-900"><%= order.subject %></h1>
  <p class="mt-0.5 text-xs text-gray-500 tabular-nums"><%= t("comp_payments.shared.order_prefix") %><%= order.external_ref %></p>
  <p class="mt-3 text-3xl font-bold text-gray-900 tabular-nums">
    <%= formatted_amount %> <%= currency_code %>
  </p>

  <hr class="my-5 border-gray-200">

  <%# ── Widget wrapper — data attributes built via tag helper (no name interpolation) ── %>
  <%= tag.div(data: widget_container_data) do %>

    <%# Gateway widget mount point (Payment Element, Smart Buttons, etc.) %>
    <%= tag.div("",
          data:  element_target_data,
          class: "min-h-[3rem] rounded-lg border border-gray-200 bg-white p-4 mb-4") %>

    <%# Inline error region %>
    <%= tag.p("",
          data:      error_target_data,
          class:     "mb-3 text-sm text-red-600 hidden",
          role:      "alert",
          aria: { live: "polite" }) %>

    <%# ── Pay button — rendered only when gateway declares renders_pay_button ── %>
    <% if renders_pay_button? %>
      <%= tag.button(
            type:       "button",
            data:       pay_button_data,
            class:      "flex w-full items-center justify-center gap-2 rounded-lg bg-indigo-600 px-4 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed motion-safe:transition-colors",
            aria: { label: t("comp_payments.widget_checkout.pay_aria", amount: formatted_amount, currency: currency_code) }) do %>
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <%= t("comp_payments.widget_checkout.pay") %> <%= formatted_amount %> <%= currency_code %>
      <% end %>
    <% end %>

  <% end %>

  <%# ── Trust footer ────────────────────────────────────────────────────── %>
  <p class="mt-4 text-center text-[11px] text-gray-400">
    <%= t("comp_payments.widget_checkout.secured_by", vendor: secured_by) %>
  </p>
</section>
