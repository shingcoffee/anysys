<%= render ::Admin::Settings::PageComponent.new(
  customer_id: helpers.params[:customer_id], title: title,
  description: t("settings_modules.payments.provider_description", name: title),
  breadcrumbs: [{ label: t("settings_navigation.items.payment_providers"), path: cancel_url }, { label: title }],
  badges: [{ label: t("settings_modules.payments.environments.#{account.mode}"), variant: :default }]
) do %>
  <div class="w-full max-w-3xl space-y-6">
    <nav class="flex flex-wrap gap-2" aria-label="<%= t("settings_modules.payments.environment") %>">
      <% mode_tabs.each do |tab| %>
        <% if tab[:active] || tab[:url].blank? %>
          <span class="btn <%= tab[:active] ? 'btn-secondary' : 'text-text-secondary' %>" data-mode="<%= tab[:mode] %>"
                <%= "data-active" if tab[:active] %> <%= 'aria-current="page"'.html_safe if tab[:active] %>><%= tab[:label] %></span>
        <% else %>
          <%= link_to tab[:label], tab[:url], class: "btn text-text-secondary", data: { mode: tab[:mode] } %>
        <% end %>
      <% end %>
    </nav>
    <p class="flex flex-wrap gap-3 text-sm text-text-secondary">
      <span><%= account.enabled? ? t("common.status.enabled") : t("common.status.disabled") %></span>
      <span><%= t("settings_modules.payments.#{credentials_present? ? 'credentials_saved' : 'not_configured'}") %></span>
    </p>
    <%= form_with model: account, url: form_url, method: :patch, scope: :payment_merchant_account,
      data: { controller: "payments--gateway-config",
        "payments--gateway-config-test-url-value": test_connection_url,
        "payments--gateway-config-testing-label-value": t("comp_payments.test_connection.testing"),
        "payments--gateway-config-verified-label-value": t("settings_modules.payments.saved_connection_verified"),
        "payments--gateway-config-last-verified-prefix-value": t("comp_payments.test_connection.last_verified_prefix"),
        "payments--gateway-config-failed-label-value": t("comp_payments.test_connection.failed"),
        "payments--gateway-config-default-error-message-value": t("comp_payments.test_connection.default_error_message"),
        "payments--gateway-config-network-error-message-value": t("comp_payments.test_connection.network_error_message") },
      class: "flex flex-col gap-6" do |f| %>
      <%= render FormErrorsComponent.new(resource: account) %>
      <%= render ::Admin::Settings::SectionComponent.new(title: t("settings_modules.payments.connection_details")) do %>
        <fieldset class="space-y-5">
          <legend class="sr-only"><%= t("settings_modules.payments.connection_details") %></legend>
          <div>
            <%= f.label :merchant_id, t("settings_modules.payments.merchant_id"), class: "form-label" %>
            <%= f.text_field :merchant_id, value: merchant_id_value, class: "input-field mt-1 w-full", required: true, aria: { describedby: "merchant-id-hint" } %>
            <p id="merchant-id-hint" class="mt-2 text-sm text-text-secondary"><%= t("settings_modules.payments.merchant_hint") %></p>
          </div>
          <%= render Payments::Admin::CredentialFieldsComponent.new(account: account, fields: credential_fields) %>
        </fieldset>
      <% end %>

      <%= render ::Admin::Settings::SectionComponent.new(title: t("settings_modules.payments.payment_preferences")) do %>
        <div class="max-w-md">
          <%= f.label :default_currency, t("comp_payments.gateway_config.default_currency_label"), class: "form-label" %>
          <%= f.select :default_currency, options_for_select(currency_options, account.default_currency), {}, class: "input-field mt-1 w-full" %>
        </div>
        <details class="mt-5" <%= "open" if account.errors[:notify_url_override].any? %>>
          <summary class="cursor-pointer text-sm font-medium text-text-primary"><%= t("settings_modules.payments.additional_options") %></summary>
          <div class="mt-4">
            <%= f.label :notify_url_override, t("comp_payments.gateway_config.notify_url_label"), class: "form-label" %>
            <%= f.url_field :notify_url_override, class: "input-field mt-1 w-full", aria: { describedby: "notification-url-hint" } %>
            <p id="notification-url-hint" class="mt-2 text-sm text-text-secondary"><%= t("settings_modules.payments.callback_hint") %></p>
          </div>
        </details>
      <% end %>

      <%= render ::Admin::Settings::SectionComponent.new(title: t("settings_modules.payments.saved_connection"), description: t("settings_modules.payments.test_hint")) do %>
        <button type="button" class="btn btn-secondary" data-payments--gateway-config-target="testButton" data-action="click->payments--gateway-config#testConnection"><%= t("settings_modules.payments.test_saved") %></button>
        <div class="mt-3"><%= render Payments::Admin::TestConnectionResultComponent.new %></div>
      <% end %>
      <div class="flex flex-col-reverse gap-3 border-t border-border-subtle pt-5 sm:flex-row sm:justify-end">
        <%= link_to t("common.actions.cancel"), cancel_url, class: "btn btn-secondary" %>
        <%= f.submit t("comp_payments.gateway_config.save_changes"), class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
<% end %>
