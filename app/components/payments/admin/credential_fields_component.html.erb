<% fields.each do |field| %>
  <div>
    <% if field[:encrypted] %>
      <label for="payment_merchant_account_<%= field[:name] %>"
             class="form-label flex items-center gap-1.5">
        <%= field_label(field) %>
        <%# Lock icon — signals encryption at rest %>
        <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-3 h-3 text-text-muted"
             viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd"
                d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2
                   2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0
                   016 0z" clip-rule="evenodd" />
        </svg>
      </label>
    <% else %>
      <label for="payment_merchant_account_<%= field[:name] %>"
             class="form-label">
        <%= field_label(field) %>
      </label>
    <% end %>

    <% if field[:type] == :password %>
      <%= password_field_tag "payment_merchant_account[#{field[:name]}]",
                             "",
                             id: "payment_merchant_account_#{field[:name]}",
                             placeholder: encrypted_placeholder(field),
                              autocomplete: "new-password",
                              aria: { describedby: show_keep_hint?(field) ? "credential-#{field[:name]}-hint" : nil },
                             class: "mt-1 input-field" %>
    <% elsif field[:type] == :text %>
      <%= text_area_tag "payment_merchant_account[#{field[:name]}]",
                        field_value(field),
                        id: "payment_merchant_account_#{field[:name]}",
                        placeholder: encrypted_placeholder(field),
                        aria: { describedby: show_keep_hint?(field) ? "credential-#{field[:name]}-hint" : nil },
                        class: "mt-1 input-field w-full",
                        rows: 6 %>
    <% else %>
      <%= text_field_tag "payment_merchant_account[#{field[:name]}]",
                         field_value(field),
                         id: "payment_merchant_account_#{field[:name]}",
                         class: "mt-1 input-field" %>
    <% end %>

    <% if show_keep_hint?(field) %>
      <p id="credential-<%= field[:name] %>-hint" class="mt-2 text-sm text-text-secondary">
        <%= t("comp_payments.credential_fields.keep_hint") %>
      </p>
    <% end %>
  </div>
<% end %>
