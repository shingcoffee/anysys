<div data-payments--gateway-config-target="result"
     role="status" aria-live="polite" aria-atomic="true"
     class="<%= idle? ? 'hidden' : container_classes %>">
  <% if loading? %>
    <%# Animated spinner %>
    <svg class="animate-spin w-4 h-4 text-text-muted shrink-0 mt-0.5"
         xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
         aria-hidden="true">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
    </svg>
    <span class="text-body-sm text-text-secondary"><%= t("comp_payments.test_connection.testing") %></span>

  <% elsif success? %>
    <%# Checkmark icon %>
    <svg class="w-4 h-4 text-success shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0
               00-1.414-1.414L9 10.586 7.707 9.293a1 1 0
               00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
            clip-rule="evenodd" />
    </svg>
    <div>
      <p class="text-body-sm font-medium text-success"><%= t("comp_payments.test_connection.verified") %></p>
      <% if verified_at %>
        <p class="text-caption text-text-secondary mt-0.5">
          <%= t("comp_payments.test_connection.last_verified_prefix") %><%= I18n.l(verified_at, format: :long) %>
        </p>
      <% end %>
      <% if message.present? %>
        <p class="text-caption text-text-secondary mt-0.5"><%= message %></p>
      <% end %>
    </div>

  <% elsif error? %>
    <%# X-circle icon %>
    <svg class="w-4 h-4 text-danger shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0
               00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10
               11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1
               1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
            clip-rule="evenodd" />
    </svg>
    <div>
      <p class="text-body-sm font-medium text-danger"><%= t("comp_payments.test_connection.failed") %></p>
      <% if message.present? %>
        <p class="text-body-sm text-text-secondary mt-0.5"><%= message %></p>
      <% end %>
    </div>
  <% end %>
</div>
