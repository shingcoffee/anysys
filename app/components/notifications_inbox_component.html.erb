<div id="<%= panel_body_dom_id %>" class="max-h-[min(28rem,calc(100vh-9rem))] overflow-y-auto overscroll-contain">
  <div id="<%= list_dom_id %>"
       class="divide-y divide-border-subtle"
       data-notifications-menu-target="list">
    <% items.each do |item| %>
      <%= render NotificationsInboxRowComponent.new(
            item: item, mark_read_path: mark_read_path, support_ticket_read_path: support_ticket_read_path
          ) %>
    <% end %>
  </div>

  <div id="<%= empty_dom_id %>"
       data-notifications-menu-target="empty"
       class="flex flex-col items-center justify-center gap-1.5 px-6 py-12 text-center <%= "hidden" unless empty? %>">
    <div class="relative mb-2 flex size-14 items-center justify-center rounded-full bg-canvas ring-1 ring-inset ring-border-subtle text-text-tertiary">
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      <span class="absolute -bottom-0.5 -right-0.5 flex size-5 items-center justify-center rounded-full bg-success text-white ring-2 ring-surface" aria-hidden="true">
        <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"/>
        </svg>
      </span>
    </div>
    <p class="text-sm font-semibold text-text-primary"><%= t("chrome.notifications.caught_up_html") %></p>
    <p class="max-w-[16rem] text-xs leading-5 text-text-muted"><%= t("chrome.notifications.empty") %></p>
  </div>
</div>
