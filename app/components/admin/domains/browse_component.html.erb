<%= render AdminPageComponent.new(
      breadcrumbs: breadcrumbs,
      title: title,
      description: description,
      icon_path: icon_path,
      icon_class: (icon_class if icon_path),
      wrap_title: true
    ) do %>
  <% if (summary = stats).any? %>
    <dl class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4" aria-label="<%= t("admin_misc.domains.summary_label") %>">
      <% summary.each do |stat| %>
        <div class="flex min-w-0 flex-col rounded-2xl border border-border-subtle bg-surface p-4 shadow-xs sm:p-5" data-role="stat-<%= stat.key %>">
          <div class="flex min-w-0 items-center justify-between gap-3">
            <dt class="truncate text-sm font-medium text-text-tertiary"><%= stat.label %></dt>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface-active text-text-tertiary" aria-hidden="true">
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= STAT_ICONS.fetch(stat.key) %>"/>
              </svg>
            </span>
          </div>
          <dd class="mt-3 flex min-h-9 items-end <%= stat_value_classes(stat) %>">
            <% if stat.time %>
              <time class="truncate" datetime="<%= stat.time.iso8601 %>" title="<%= l(stat.time, format: :long) %>"><%= stat.value %></time>
            <% else %>
              <span class="truncate"><%= stat.value %></span>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  <% else %>
    <%= render EmptyStateComponent.new(
          title: t("admin_misc.domains.empty_title"),
          description: t("admin_misc.domains.empty_hint"),
          icon_path: EntitiesContributor::ICONS[:all]
        ) %>
  <% end %>
  <% if content.present? %>
    <div class="mt-6"><%= content %></div>
  <% end %>
<% end %>
