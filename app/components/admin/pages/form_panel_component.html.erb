<% if page? %>
  <div class="card overflow-x-auto">
    <div class="p-4 sm:p-6">
      <div class="mx-auto max-w-4xl rounded-lg bg-surface p-4 shadow-lg sm:p-8">
        <%= content %>
      </div>
    </div>
  </div>

  <%= render Admin::Entities::QuickAddDialogComponent.new %>
<% else %>
  <%= render EmptyStateComponent.new(title: empty_title, description: empty_description) %>
<% end %>
