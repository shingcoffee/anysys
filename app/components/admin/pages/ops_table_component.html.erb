<turbo-frame id="<%= frame_id %>" data-turbo-action="advance">
<section class="card" data-controller="tooltip">
  <%= render Admin::ListToolbarComponent.new(
        base_path: base_path,
        frame_id: frame_id,
        params: params,
        search: search,
        filters: filters
      ) %>

  <% if rows.empty? %>
    <div class="px-4 py-16 text-center">
      <div class="size-14 mx-auto mb-4 rounded-2xl bg-surface-active flex items-center justify-center">
        <svg class="size-6 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
        </svg>
      </div>
      <% if empty_after_search? %>
        <% if active_search? %>
          <p class="text-base font-semibold text-text-primary mb-1"><%= t("chrome.admin_table.no_matches_html", query: params[search[:param]]) %></p>
          <p class="text-body-sm text-text-muted mb-4"><%= t("chrome.admin_table.no_matches_hint") %></p>
          <%= link_to t("comp_admin.entries_table.clear_search"), clear_search_path,
                class: "text-sm font-medium text-accent-text hover:underline",
                data: { turbo_frame: frame_id, turbo_action: "advance" } %>
        <% else %>
          <p class="text-base font-semibold text-text-primary mb-1"><%= t("chrome.admin_table.no_filter_matches") %></p>
          <p class="text-body-sm text-text-muted"><%= t("chrome.admin_table.no_filter_matches_hint") %></p>
        <% end %>
      <% elsif empty_state %>
        <p class="text-base font-semibold text-text-primary mb-1"><%= empty_state[:title] %></p>
        <% if empty_state[:description].present? %>
          <p class="text-body-sm text-text-muted"><%= empty_state[:description] %></p>
        <% end %>
      <% else %>
        <p class="text-sm text-text-muted"><%= t("chrome.admin_table.nothing_to_show") %></p>
      <% end %>
    </div>
  <% else %>
    <%# Mobile cards — tapping a card opens the form preview in a new tab. %>
    <div class="sm:hidden divide-y divide-border-subtle"
         data-controller="row-link"
         data-action="click->row-link#open">
      <% rows.each do |page_row| %>
        <% updated = relative_updated(page_row) %>
        <div class="flex items-start gap-3 p-4 cursor-pointer active:bg-surface-active hover:bg-surface-hover transition-base" data-row-link-row>
          <span class="flex size-10 shrink-0 items-center justify-center rounded-lg <%= form_tile_classes(page_row) %>" aria-hidden="true">
            <%= icon_svg(FORM_ICON, "size-5") %>
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex min-w-0 items-center gap-1">
              <%= name_link(page_row, "block min-w-0 truncate text-sm font-semibold text-text-primary") %>
              <%= icon_svg(NEW_TAB_ICON, "size-3.5 text-text-muted") %>
            </div>
            <% if (sub = entity_subtitle(page_row)) %>
              <p class="mt-0.5 flex min-w-0 items-center gap-1 text-xs text-text-muted">
                <%= icon_svg(ENTITY_ICON, "size-3.5 text-text-tertiary") %>
                <span class="truncate" data-tooltip="<%= sub %>" data-tooltip-overflow="true"><%= sub %></span>
              </p>
            <% end %>
            <div class="mt-2.5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[13px] text-text-muted">
              <span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset <%= status_pill_classes(page_row) %>">
                <span class="size-1.5 rounded-full <%= page_row.launched? ? "bg-success" : "bg-text-tertiary" %>" aria-hidden="true"></span>
                <%= page_row.launched? ? t("common.status.live") : t("common.status.draft") %>
              </span>
              <%= render Admin::Pages::FormHealthBadgeComponent.new(status: form_status(page_row)) %>
              <%= render Admin::Pages::AudienceReachComponent.new(page: page_row) %>
              <% if updated %>
                <time datetime="<%= updated[:iso] %>" title="<%= updated[:exact] %>" class="tabular-nums"><%= updated[:text] %></time>
              <% end %>
            </div>
          </div>
          <div class="shrink-0 -mr-1">
            <%= render Admin::Pages::RowMenuComponent.new(
                  page: page_row,
                  manage_path: manage_path(page_row),
                  preview_path: preview_path(page_row),
                  launch_path: launch_path(page_row),
                  publishing_frame: PUBLISHING_FRAME
                ) %>
          </div>
        </div>
      <% end %>
    </div>

    <%# Desktop table — table-fixed with widths on the header cells so Form
        takes the remaining width; secondary columns hide on narrower screens.
        No overflow-x-auto: that forces overflow-y:auto and clips row menus. %>
    <div class="hidden sm:block">
      <table class="w-full table-fixed text-sm">
        <thead class="table-header">
          <tr>
            <% sort_headers.each_with_index do |header, index| %>
              <th scope="col"
                  class="<%= index.zero? ? "pl-4 pr-3 sm:pl-5" : "px-3" %> py-3 text-left font-semibold whitespace-nowrap <%= header[:classes] %>"
                  <%= tag.attributes(aria: { sort: Admin::SortableHeaderComponent.aria_sort(header[:direction]) }) %>>
                <%= render Admin::SortableHeaderComponent.new(
                      label: header[:label], href: header[:href],
                      direction: header[:direction], frame_id: frame_id
                    ) %>
              </th>
            <% end %>
            <th scope="col" class="w-12 py-3 pl-3 pr-4 sm:pr-5">
              <span class="sr-only"><%= t("common.labels.actions") %></span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle"
               data-controller="row-link"
               data-action="click->row-link#open">
          <% rows.each do |page_row| %>
            <% updated = relative_updated(page_row) %>
            <tr class="table-row group cursor-pointer" data-row-link-row>
              <td class="py-3 pl-4 pr-3 sm:pl-5 align-middle">
                <div class="flex min-w-0 items-center gap-3">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-lg <%= form_tile_classes(page_row) %>" aria-hidden="true">
                    <%= icon_svg(FORM_ICON, "size-[18px]") %>
                  </span>
                  <div class="min-w-0">
                    <div class="flex min-w-0 items-center gap-1">
                      <%= name_link(page_row, "block min-w-0 truncate text-sm font-semibold text-text-primary group-hover:text-accent-text focus-visible:text-accent-text transition-base") %>
                      <%= icon_svg(NEW_TAB_ICON, "size-3.5 text-text-muted") %>
                    </div>
                    <% if (sub = entity_subtitle(page_row)) %>
                      <p class="mt-0.5 flex min-w-0 items-center gap-1 text-xs text-text-muted">
                        <%= icon_svg(ENTITY_ICON, "size-3.5 text-text-tertiary") %>
                        <span class="truncate" data-tooltip="<%= sub %>" data-tooltip-overflow="true"><%= sub %></span>
                      </p>
                    <% end %>
                    <% if (status = form_status(page_row)) %>
                      <div class="mt-1"><%= render Admin::Pages::FormHealthBadgeComponent.new(status: status) %></div>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="px-3 py-3 align-middle <%= column_classes(:visibility) %>">
                <div class="truncate"
                     data-tooltip="<%= audience_tooltip(page_row) %>"
                     data-tooltip-overflow="true">
                  <%= render Admin::Pages::AudienceReachComponent.new(page: page_row) %>
                </div>
              </td>
              <td class="px-3 py-3 align-middle whitespace-nowrap <%= column_classes(:launched) %>">
                <span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset <%= status_pill_classes(page_row) %>">
                  <span class="size-1.5 rounded-full <%= page_row.launched? ? "bg-success" : "bg-text-tertiary" %>" aria-hidden="true"></span>
                  <%= page_row.launched? ? t("common.status.live") : t("common.status.draft") %>
                </span>
              </td>
              <td class="px-3 py-3 align-middle whitespace-nowrap text-text-muted <%= column_classes(:updated_at) %>">
                <% if updated %>
                  <time datetime="<%= updated[:iso] %>" title="<%= updated[:exact] %>" class="text-[13px] tabular-nums"><%= updated[:text] %></time>
                <% else %>
                  <span class="text-[13px] text-text-tertiary"><%= t("common.labels.em_dash") %></span>
                <% end %>
              </td>
              <td class="py-3 pl-3 pr-4 sm:pr-5 text-right align-middle" data-row-link-ignore>
                <%= render Admin::Pages::RowMenuComponent.new(
                      page: page_row,
                      manage_path: manage_path(page_row),
                      preview_path: preview_path(page_row),
                      launch_path: launch_path(page_row),
                      publishing_frame: PUBLISHING_FRAME
                    ) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%= render Admin::PaginationComponent.new(
        pagination: pagination,
        page_path: ->(n) { page_link(n) },
        turbo_frame: frame_id,
        summary: true,
        per_page_options: PER_PAGE_OPTIONS,
        per_page_path: ->(size) { per_page_link(size) }
      ) %>
</section>
</turbo-frame>
