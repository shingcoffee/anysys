<header class="px-4 py-3 border-b border-border-subtle flex flex-col lg:flex-row lg:items-center gap-3"
        <%= tag.attributes(data: html_data) %>>
  <form method="get"
        action="<%= base_path %>"
        role="search"
        data-controller="admin-table"
        data-turbo-frame="<%= frame_id %>"
        data-turbo-action="advance"
        class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2 min-w-0 flex-1">
    <% if search %>
      <div class="relative sm:w-72 lg:w-80">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 size-4 text-text-muted pointer-events-none"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input type="search"
               name="<%= search_param %>"
               value="<%= search_value %>"
               placeholder="<%= search[:placeholder] || t("common.actions.search") %>"
               aria-label="<%= search[:placeholder] || t("common.actions.search") %>"
               autocomplete="off"
               data-admin-table-target="searchInput"
               data-action="input->admin-table#debounceSubmit"
               class="input-field h-9 w-full py-0 pl-9 text-sm">
      </div>
    <% end %>

    <% filters.each do |filter| %>
      <div class="relative">
        <select name="<%= filter[:key] %>"
                aria-label="<%= filter[:label] %>"
                data-action="change->admin-table#submit"
                class="<%= filter_classes(filter) %>">
          <option value=""><%= filter[:label] %></option>
          <% Array(filter[:options]).each do |label, value| %>
            <option value="<%= value %>" <%= "selected" if filter_value(filter) == value.to_s %>><%= label %></option>
          <% end %>
        </select>
        <svg class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 size-3.5 <%= filter_active?(filter) ? "text-accent-text" : "text-text-muted" %>"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    <% end %>

    <% if narrowed? %>
      <%= link_to reset_path,
            class: "btn btn-ghost h-9 px-2.5 py-0 text-sm self-start sm:self-auto",
            data: frame_data do %>
        <%= t("chrome.admin_table.reset") %>
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      <% end %>
    <% end %>

    <% hidden_params.each do |key, value| %>
      <input type="hidden" name="<%= key %>" value="<%= value %>">
    <% end %>
  </form>

  <% if actions? %>
    <div class="flex flex-wrap items-center gap-2 shrink-0">
      <%= actions %>
    </div>
  <% end %>
</header>
