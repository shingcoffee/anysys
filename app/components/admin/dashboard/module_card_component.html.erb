<% if rich? %>
  <article class="flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-border-subtle bg-surface shadow-xs transition-colors hover:border-border">
    <div class="flex items-start gap-4 px-5 py-5 sm:px-6 sm:py-6">
      <span class="flex size-11 shrink-0 items-center justify-center rounded-xl <%= icon_well_classes %>" aria-hidden="true">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= module_icon_path %>"/>
        </svg>
      </span>
      <div class="min-w-0 flex-1 space-y-1.5">
        <h3 class="text-base font-semibold leading-snug tracking-tight text-text-primary"><%= name %></h3>
        <% if description.present? %>
          <p class="text-sm leading-relaxed text-text-secondary"><%= description %></p>
        <% end %>
      </div>
    </div>

    <% if quick_links.any? %>
      <div class="mt-auto border-t border-border-subtle px-3 py-3 sm:px-4">
        <p class="px-2 pb-1.5 text-xs font-medium text-text-muted"><%= t("admin_modules.index.quick_links") %></p>
        <ul class="divide-y divide-border-subtle/70">
        <% quick_links.each do |link| %>
          <li>
            <%= link_to link.href,
                   class: "group/link flex min-h-12 min-w-0 items-center justify-between gap-3 rounded-lg px-2 py-2 text-sm font-medium text-text-secondary no-underline transition-colors hover:bg-canvas-elevated hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" do %>
              <span class="min-w-0 break-words"><%= link.label %></span>
              <svg class="size-4 shrink-0 text-text-muted transition-colors group-hover/link:text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            <% end %>
          </li>
        <% end %>
        </ul>
      </div>
    <% end %>
  </article>
<% else %>
  <article class="group/card relative flex h-full min-w-0 flex-col justify-between overflow-hidden rounded-2xl border border-border-subtle bg-surface p-5 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-border hover:shadow-md">
    <div class="flex flex-1 items-start gap-3.5">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-xl ring-1 ring-inset ring-black/5 shadow-2xs <%= icon_well_classes %>" aria-hidden="true">
        <svg class="size-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= module_icon_path %>"/>
        </svg>
      </span>
      <div class="flex min-w-0 flex-1 flex-col gap-1">
        <div class="flex min-w-0 items-center justify-between gap-2">
          <h3 class="truncate text-base font-semibold tracking-tight text-text-primary"><%= name %></h3>
          <span class="size-2 shrink-0 rounded-full bg-success ring-4 ring-success-subtle" aria-hidden="true"></span>
        </div>
        <% if description.present? %>
          <p class="line-clamp-2 text-xs leading-relaxed text-text-secondary"><%= description %></p>
        <% end %>
      </div>
    </div>

    <% if show_footer? %>
      <div class="mt-4 flex flex-wrap items-center gap-1.5 border-t border-border-subtle/80 pt-3.5">
        <% if primary_link %>
          <%= link_to primary_link.href,
                data: { module_link: "primary" },
                class: "group/primary inline-flex min-h-8 items-center gap-1.5 rounded-lg bg-accent-subtle px-3 py-1 text-xs font-semibold text-accent-text no-underline ring-1 ring-inset ring-accent-muted/70 transition-base hover:bg-accent hover:text-white hover:ring-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:min-h-11" do %>
            <%= primary_link.label %>
            <svg class="size-3 transition-transform group-hover/primary:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
            </svg>
          <% end %>
        <% end %>
        <% secondary_links.each do |link| %>
          <%= link_to link.label, link.href,
                data: { module_link: "secondary" },
                class: "inline-flex min-h-8 items-center rounded-lg bg-canvas-elevated px-2.5 py-1 text-xs font-medium text-text-secondary no-underline ring-1 ring-inset ring-border-subtle transition-base hover:bg-surface-hover hover:text-text-primary hover:ring-border-strong focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent pointer-coarse:min-h-11" %>
        <% end %>
      </div>
    <% end %>
  </article>
<% end %>
