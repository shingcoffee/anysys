<footer class="px-4 py-3 border-t border-border-subtle flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm">
  <span class="text-text-muted tabular-nums text-[13px]">
    <% if summary? %>
      <%= summary_text %>
    <% else %>
      <%= t("chrome.pagination.page_of_html", page: page, total: total_pages) %>
    <% end %>
  </span>

  <div class="flex items-center gap-3 sm:gap-5">
    <% if per_page_menu? %>
      <div class="relative flex items-center gap-2" data-controller="dropdown">
        <span class="hidden sm:inline text-[13px] text-text-muted"><%= t("chrome.pagination.rows_per_page") %></span>
        <button type="button"
                data-action="click->dropdown#toggle"
                aria-haspopup="menu"
                aria-label="<%= t("chrome.pagination.rows_per_page") %>"
                class="btn btn-secondary h-8 px-2.5 py-0 text-[13px] tabular-nums gap-1">
          <%= per_page %>
          <svg class="size-3.5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/>
          </svg>
        </button>
        <div data-dropdown-target="menu"
             role="menu"
             class="hidden absolute right-0 bottom-full z-30 mb-1 min-w-[5.5rem] py-1 dropdown-panel">
          <% per_page_options.each do |size| %>
            <%= link_to per_page_href(size),
                  role: "menuitem",
                  class: "flex items-center justify-between gap-3 px-3 py-1.5 text-[13px] tabular-nums transition-base hover:bg-surface-hover #{size == per_page ? 'font-semibold text-text-primary' : 'text-text-secondary'}",
                  aria: { current: (size == per_page ? "true" : nil) },
                  data: link_data do %>
              <%= size %>
              <% if size == per_page %>
                <svg class="size-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if multi_page? %>
      <nav class="flex items-center gap-1" aria-label="<%= t("chrome.pagination.navigation") %>">
        <% if show_previous? %>
          <%= link_to previous_href,
                class: "btn btn-secondary h-8 px-2.5 py-0 text-xs",
                aria: { label: t("chrome.pagination.previous_page") },
                data: link_data do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            <span class="hidden sm:inline"><%= t("chrome.pagination.prev") %></span>
          <% end %>
        <% end %>

        <span class="sm:hidden px-2 text-[13px] text-text-muted tabular-nums"><%= page %> / <%= total_pages %></span>
        <div class="hidden sm:flex items-center gap-1">
          <% page_window.each do |item| %>
            <% if item == :gap %>
              <span class="inline-flex size-8 items-center justify-center text-text-tertiary" aria-hidden="true">…</span>
            <% elsif item == page %>
              <span class="inline-flex h-8 min-w-8 px-2 items-center justify-center rounded-md border border-border-strong bg-surface text-[13px] font-semibold text-text-primary tabular-nums shadow-xs"
                    aria-current="page"><%= item %></span>
            <% else %>
              <%= link_to item, page_href(item),
                    class: "inline-flex h-8 min-w-8 px-2 items-center justify-center rounded-md text-[13px] text-text-secondary tabular-nums transition-base hover:bg-surface-active hover:text-text-primary",
                    aria: { label: t("chrome.pagination.go_to_page", page: item) },
                    data: link_data %>
            <% end %>
          <% end %>
        </div>

        <% if show_next? %>
          <%= link_to next_href,
                class: "btn btn-secondary h-8 px-2.5 py-0 text-xs",
                aria: { label: t("chrome.pagination.next_page") },
                data: link_data do %>
            <span class="hidden sm:inline"><%= t("common.actions.next") %></span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          <% end %>
        <% end %>
      </nav>
    <% end %>
  </div>
</footer>
