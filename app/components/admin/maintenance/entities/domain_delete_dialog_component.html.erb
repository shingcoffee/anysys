<div data-controller="modal-dialog" class="contents">
  <button type="button" class="btn btn-ghost min-h-9 justify-center gap-1.5 px-3 text-[13px] text-danger hover:bg-danger-subtle"
          data-action="modal-dialog#open" aria-haspopup="dialog" aria-controls="<%= dialog_id %>">
    <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="<%= AdminPageComponent::ICONS[:trash] %>"/>
    </svg>
    <%= t("maint_core.entity_domains.index.delete_domain") %>
  </button>

  <%= render ModalDialogComponent.new(id: dialog_id, title: t("maint_core.entity_domains.delete_dialog.title", name: domain.name),
                                      tone: :danger, width: :sm) do %>
    <div class="space-y-5" data-role="domain-delete-dialog">
      <p class="text-sm text-text-secondary"><%= t("maint_core.entity_domains.delete_dialog.description") %></p>
      <% if blocked? %>
        <div role="alert">
          <%= render AlertComponent.new(message: safe_join([tag.strong(t("maint_core.entity_domains.delete_dialog.blocked_title"), class: "block"), blocked_message]), type: :error) %>
        </div>
      <% else %>
        <div>
          <h3 class="text-sm font-semibold text-text-primary"><%= t("maint_core.entity_domains.delete_dialog.heading") %></h3>
          <ul class="mt-2 space-y-1.5 text-sm text-text-secondary">
            <% impact_lines.each do |line| %>
              <li class="flex items-start gap-2">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-danger" aria-hidden="true"></span>
                <span><%= line %></span>
              </li>
            <% end %>
          </ul>
          <% if shared_count.positive? %>
            <p class="mt-3 text-xs text-text-muted"><%= t("maint_core.entity_domains.delete_dialog.shared", count: shared_count) %></p>
          <% end %>
        </div>
      <% end %>

      <div class="flex flex-col-reverse gap-2 border-t border-border-subtle pt-4 sm:flex-row sm:justify-end">
        <button type="button" class="btn btn-secondary min-h-10 justify-center" data-action="modal-dialog#close">
          <%= t("common.actions.cancel") %>
        </button>
        <% unless blocked? %>
          <%= button_to t("maint_core.entity_domains.delete_dialog.confirm"), destroy_path, method: :delete,
                        form: { data: { turbo_frame: "_top" }, class: "contents" },
                        class: "btn btn-danger min-h-10 justify-center" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
