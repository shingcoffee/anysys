<% if empty? %>
  <%= render EmptyStateComponent.new(
        title: t("maint_core.modules.index.empty"),
        description: t("maint_core.modules.index.empty_hint"),
        icon_path: Admin::Maintenance::Platform::ModuleSettingsHelper::DEFAULT_MODULE_ICON_PATH
      ) %>
<% else %>
  <div class="flex flex-col gap-6 pb-8" data-controller="list-filter">
    <dl class="grid grid-cols-3 gap-3">
      <% stats.each do |stat| %>
        <div class="card px-4 py-3 sm:px-5 sm:py-4" data-module-stat="<%= stat[:key] %>">
          <dt class="flex items-center gap-2 text-xs font-medium leading-tight text-text-muted">
            <span class="size-2 shrink-0 rounded-full <%= stat[:dot] %>" aria-hidden="true"></span>
            <span class="min-w-0"><%= t("maint_core.modules.index.stats.#{stat[:key]}") %></span>
          </dt>
          <dd class="mt-1 text-xl font-semibold tabular-nums text-text-primary sm:text-2xl"><%= stat[:value] %></dd>
        </div>
      <% end %>
    </dl>

    <div class="flex flex-col gap-3 border-b border-border-subtle pb-4 sm:flex-row sm:items-center sm:justify-between">
      <form class="relative w-full sm:w-72" role="search" data-action="submit->list-filter#search">
        <label class="sr-only" for="<%= SEARCH_ID %>"><%= t("maint_core.modules.index.search_placeholder") %></label>
        <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input type="search"
               id="<%= SEARCH_ID %>"
               class="input-field min-h-9 w-full pl-9"
               placeholder="<%= t("maint_core.modules.index.search_placeholder") %>"
               autocomplete="off"
               data-list-filter-target="search"
               data-action="input->list-filter#search">
      </form>
      <p class="text-caption"><%= t("maint_core.modules.index.enabled_count", enabled: enabled_count, total: modules.size) %></p>
    </div>

    <div class="flex flex-col gap-8" data-list-filter-target="directory">
      <% sections.each do |section, section_modules| %>
        <section class="flex flex-col gap-3" aria-labelledby="<%= section_heading_id(section) %>" data-list-filter-target="group" data-module-section="<%= section %>">
          <div class="flex items-center gap-3">
            <h2 id="<%= section_heading_id(section) %>" class="text-sm font-semibold text-text-primary"><%= section_label(section) %></h2>
            <span class="rounded-full bg-surface-active px-2 py-px text-[11px] font-medium tabular-nums text-text-muted"><%= section_modules.size %></span>
            <div class="h-px flex-1 bg-border-subtle" aria-hidden="true"></div>
          </div>
          <ul class="grid grid-cols-1 items-stretch gap-4 lg:grid-cols-2">
            <% section_modules.each do |fm| %>
              <%= render Admin::Maintenance::ModuleCatalogCardComponent.new(
                    customer_id: customer_id,
                    feature_module: fm,
                    enabled: enabled?(fm),
                    open_link: open_links[fm.key],
                    owner_assignment: assignment_for(fm)
                  ) %>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>

    <div data-list-filter-target="empty" class="hidden rounded-xl border border-dashed border-border-strong px-6 py-12 text-center" role="status">
      <p class="text-sm font-medium text-text-primary"><%= t("maint_core.modules.index.no_matches_title") %></p>
      <p class="mt-1 text-xs text-text-muted"><%= t("maint_core.modules.index.no_matches_hint") %></p>
    </div>
  </div>
<% end %>
