<li class="min-w-0" data-list-filter-target="item" data-search-text="<%= search_text %>" data-module-key="<%= feature_module.key %>" data-module-enabled="<%= enabled? %>">
  <article class="<%= card_classes %>">
    <div class="flex items-start gap-4">
      <span class="flex size-10 shrink-0 items-center justify-center rounded-lg <%= icon_classes %>" aria-hidden="true">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon_path %>" />
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <h3 class="truncate text-sm font-semibold text-text-primary"><%= name %></h3>
          <%= render BadgeComponent.new(variant: status_badge[:variant], size: :sm) do %><%= status_badge[:label] %><% end %>
        </div>
        <p class="mt-1 text-body-sm text-text-secondary line-clamp-2"><%= description %></p>
      </div>
      <div class="shrink-0 pt-0.5">
        <%= render toggle %>
      </div>
    </div>

    <% if owner_assignment %>
      <%= render Admin::Maintenance::ModuleOwnerConfigurationComponent.new(
            customer_id: customer_id, feature_module: feature_module, assignment: owner_assignment
          ) %>
    <% end %>

    <% if show_footer? %>
      <div class="mt-auto flex flex-wrap items-center gap-2 border-t border-border-subtle pt-3">
        <% if locked? %>
          <p class="flex items-center gap-1.5 text-xs text-text-muted">
            <svg class="size-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= LOCK_ICON_PATH %>" />
            </svg>
            <%= t("maint_core.modules.index.locked_hint") %>
          </p>
        <% end %>
        <% if show_open_link? %>
          <%= link_to open_link.href, class: "ml-auto inline-flex items-center gap-1 rounded-md text-sm font-medium text-accent-text hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" do %>
            <%= t("maint_core.modules.index.open_module") %>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </article>
</li>
