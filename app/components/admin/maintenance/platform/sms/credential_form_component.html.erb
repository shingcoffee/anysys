<%= form_with model: credential, url: form_url, method: form_method, class: form_class,
      data: { controller: "sms-credential-form",
              "sms-credential-form-provider-value": selected_provider,
              "sms-credential-form-labels-value": labels_by_provider.to_json } do |f| %>
  <%= render FormErrorsComponent.new(resource: credential) %>

  <div class="card overflow-hidden">
    <div class="card-header">
      <h2 class="section-header"><%= t("maint_platform.sms.credentials.form.identity_title") %></h2>
      <p class="mt-0.5 text-caption"><%= identity_hint %></p>
    </div>
    <ul class="divide-y divide-border-subtle">
      <% if lock_identity? %>
        <%= f.hidden_field :provider %>
        <%= f.hidden_field :mode %>
      <% else %>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :provider, t("maint_platform.sms.credentials.form.provider_label"), class: "form-label mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.select :provider, adapters.map { |a| [a.display_name, a.key] }, {},
                    class: "input-field",
                    data: { action: "change->sms-credential-form#toggle" } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :mode, t("common.labels.mode"), class: "form-label mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.select :mode, mode_options.map { |m| [t("common.modes.#{m}"), m] }, { include_blank: true },
                    class: "input-field" %>
            </div>
          </div>
        </li>
      <% end %>
      <li class="px-4 sm:px-6 py-4">
        <div class="<%= field_grid_class %>">
          <%= f.label :status, t("common.labels.status"), class: "form-label mb-0" %>
          <div class="w-full max-w-xl">
            <%= f.select :status, status_options.map { |s| [t("common.status.#{s}"), s] }, {},
                  class: "input-field" %>
          </div>
        </div>
      </li>
    </ul>
  </div>

  <%= render CardComponent.new(padding: :none) do %>
    <div class="p-4 sm:p-6 <%= field_grid_class %>">
      <%= label_tag "sms_credential_config_sender_rate_per_second", t("activerecord.attributes.sms/credential.sender_rate_per_second"), class: "form-label mb-0" %>
      <div class="w-full max-w-xl min-w-0 space-y-2">
        <%= number_field_tag "sms_credential[sender_rate_per_second]", credential.config_value(:sender_rate_per_second) || 1, id: "sms_credential_config_sender_rate_per_second", min: 0, max: 1, step: "any", required: true, class: "input-field w-full", aria: { describedby: "sms-account-rate-help", invalid: credential.errors[:sender_rate_per_second].any? ? true : nil } %>
        <p id="sms-account-rate-help" class="text-caption"><%= t("sms_campaign_ui.platform.sender_rate_help") %></p>
      </div>
    </div>
  <% end %>

  <% adapters.each do |adapter| %>
    <div data-sms-credential-form-target="fields" data-provider="<%= adapter.key %>"
         class="<%= "hidden" unless adapter.key.to_s == selected_provider %>">
      <div class="card overflow-hidden">
        <div class="card-header">
          <h2 class="section-header"><%= t("maint_platform.sms.credentials.form.provider_fields_legend", provider: adapter.display_name) %></h2>
        </div>
        <ul class="divide-y divide-border-subtle">
          <% adapter.config_fields.each do |field| %>
            <li class="px-4 sm:px-6 py-4">
              <div class="<%= field_grid_class %>">
                <label class="form-label mb-0" for="<%= config_field_id(field) %>"><%= field_label(adapter, field) %></label>
                <div class="w-full max-w-xl">
                  <% if field[:type] == :password %>
                    <%= password_field_tag config_field_name(field), "",
                          id: config_field_id(field), class: "input-field", autocomplete: "new-password",
                          placeholder: credential.config_value(field[:name]).present? ? "••••••••" : nil %>
                  <% else %>
                    <%= text_field_tag config_field_name(field), credential.config_value(field[:name]),
                          id: config_field_id(field), class: "input-field" %>
                  <% end %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="card overflow-hidden scroll-mb-24">
    <div class="card-header">
      <h2 class="section-header"><%= t("maint_platform.sms.credentials.form.secret_title") %></h2>
      <p class="mt-0.5 text-caption"><%= t(credential.persisted? ? "maint_platform.sms.credentials.form.secret_hint" : "maint_platform.sms.credentials.form.secret_hint_new") %></p>
    </div>
    <ul class="divide-y divide-border-subtle">
      <li class="px-4 sm:px-6 py-4">
        <div class="<%= field_grid_class %>">
          <%= f.label :access_key_id, access_key_id_label, class: "form-label mb-0",
                data: { sms_credential_form_target: "accessKeyIdLabel" } %>
          <div class="w-full max-w-xl">
            <%= f.text_field :access_key_id, class: "input-field" %>
          </div>
        </div>
      </li>
      <li class="px-4 sm:px-6 py-4">
        <div class="<%= field_grid_class %>">
          <%= f.label :access_key_secret, access_key_secret_label, class: "form-label mb-0",
                data: { sms_credential_form_target: "accessKeySecretLabel" } %>
          <div class="w-full max-w-xl flex flex-col gap-2">
            <%= f.password_field :access_key_secret, value: "",
                  placeholder: credential.persisted? ? "••••••••" : nil,
                  autocomplete: "new-password",
                  class: "input-field" %>
            <% if credential.persisted? %>
              <p class="text-caption"><%= t("maint_platform.sms.credentials.form.secret_keep_hint") %></p>
            <% end %>
          </div>
        </div>
      </li>
    </ul>
  </div>

  <% if lock_identity? %>
    <%= render Admin::Maintenance::Platform::ModuleSettings::FormActionsComponent.new(
          cancel_path: cancel_path, submit_label: submit_label
        ) %>
  <% else %>
    <div class="h-16 shrink-0" aria-hidden="true"></div>
    <%= render Admin::Maintenance::Platform::ModuleSettings::FormActionsComponent.new(
          cancel_path: cancel_path, submit_label: submit_label, sticky: true
        ) %>
  <% end %>
<% end %>
