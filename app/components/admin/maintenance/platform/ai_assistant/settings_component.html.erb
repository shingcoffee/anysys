<% workspace_body = capture do %>
<%= render Admin::Maintenance::Platform::ModuleSettings::ProviderWorkspaceComponent.new do |workspace| %>
  <% workspace.with_assignment do %>
  <% if errors.any? %>
    <%= render AlertComponent.new(message: errors_message, type: :error) %>
  <% end %>

  <% if edit_jobs? %>
    <%= form_with url: settings_path, method: :patch, local: true, class: "flex w-full flex-col gap-6" do %>
      <input type="hidden" name="section" value="jobs">
      <div class="card overflow-hidden">
        <div class="card-header">
          <h2 class="section-header"><%= t("ai_assistant.platform_settings.jobs_section") %></h2>
          <p class="mt-0.5 text-caption"><%= t("ai_assistant.platform_settings.jobs_section_hint") %></p>
        </div>
        <ul class="divide-y divide-border-subtle">
          <% jobs.each do |job| %>
            <li class="px-4 sm:px-6 py-4 flex flex-col gap-3">
              <div class="min-w-0">
                <h3 class="text-body text-text-primary font-medium"><%= job[:title] %></h3>
                <p class="text-caption"><%= job[:hint] %></p>
              </div>
              <div class="grid grid-cols-1 gap-2 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-start sm:gap-6">
                <label class="form-label mb-0" for="<%= field_input_id(job[:param]) %>"><%= t("ai_assistant.platform_settings.jobs.provider") %></label>
                <div class="w-full max-w-xl">
                  <select id="<%= field_input_id(job[:param]) %>"
                          name="<%= param_key %>[<%= job[:param] %>]"
                          class="input-field">
                    <option value="" <%= "selected" if job[:selected].blank? %>><%= t("ai_assistant.platform_settings.jobs.not_assigned") %></option>
                    <% job[:choices].each do |pc| %>
                      <option value="<%= pc.key %>" <%= "selected" if pc.key.to_s == job[:selected] %>>
                        <%= pc.display_name %>
                      </option>
                    <% end %>
                  </select>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
      <%= render Admin::Maintenance::Platform::ModuleSettings::FormActionsComponent.new(
            cancel_path: settings_path, submit_label: t("ai_assistant.platform_settings.save")
          ) %>
    <% end %>
  <% else %>
    <div class="card overflow-hidden">
      <div class="card-header flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <h2 class="section-header"><%= t("ai_assistant.platform_settings.jobs_section") %></h2>
          <p class="mt-0.5 text-caption"><%= t("ai_assistant.platform_settings.jobs_section_hint") %></p>
        </div>
        <% if show_mode? %>
          <%= render ButtonComponent.new(variant: :secondary, size: :sm, tag: :a, href: jobs_edit_path) do %>
            <%= t("ai_assistant.platform_settings.edit_jobs") %>
          <% end %>
        <% end %>
      </div>
      <ul class="divide-y divide-border-subtle">
        <% jobs.each do |job| %>
          <li class="px-4 sm:px-6 py-4 flex flex-col gap-3">
            <div class="min-w-0">
              <h3 class="text-body text-text-primary font-medium"><%= job[:title] %></h3>
              <p class="text-caption"><%= job[:hint] %></p>
            </div>
            <dl class="flex flex-col gap-3">
              <div class="grid grid-cols-1 gap-1 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
                <dt class="text-body text-text-primary font-medium"><%= t("ai_assistant.platform_settings.jobs.provider") %></dt>
                <dd class="text-body-sm text-text-secondary">
                  <%= job[:provider_name].presence || t("ai_assistant.platform_settings.jobs.not_assigned") %>
                </dd>
              </div>
              <% if job[:model_label].present? %>
                <div class="grid grid-cols-1 gap-1 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
                  <dt class="text-body text-text-primary font-medium"><%= job[:model_label] %></dt>
                  <dd class="text-body-sm text-text-secondary break-all"><%= job[:model_value] %></dd>
                </div>
              <% end %>
            </dl>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% end %>

  <% unless edit_jobs? %>
    <% workspace.with_provider do %>
    <div class="flex flex-col gap-3">
      <div>
        <h2 class="section-header"><%= t("ai_assistant.platform_settings.vendor_section") %></h2>
        <p class="mt-0.5 text-caption"><%= t("ai_assistant.platform_settings.vendor_section_hint") %></p>
      </div>

      <%= render Admin::Maintenance::Platform::ProviderSwitcherComponent.new(
            nav_label: t("ai_assistant.platform_settings.nav_label"),
            items: switcher_items
          ) %>
    </div>
    <% end %>

    <% workspace.with_health do %>
    <div class="card px-4 sm:px-5 py-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex min-w-0 flex-col gap-1">
        <div class="flex items-center gap-2">
          <span class="text-caption"><%= t("ai_assistant.platform_settings.status.health") %></span>
          <%= render BadgeComponent.new(variant: health_badge_variant, size: :sm) do %>
            <%= t("ai_assistant.platform_settings.health.#{health_status_key}") %>
          <% end %>
        </div>
        <% if health_error_message %>
          <p class="text-caption text-danger break-words" data-health-error="true"><%= health_error_message %></p>
        <% end %>
      </div>
      <% if show_mode? %>
        <%= form_with url: test_connection_path, method: :post, local: true, class: "inline" do %>
          <%= render ButtonComponent.new(variant: :secondary, size: :sm, tag: :button, type: :submit,
                                         data: { turbo_submits_with: t("comp_payments.test_connection.testing") }) do %>
            <%= t("ai_assistant.platform_settings.test.button") %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% end %>

    <% workspace.with_credentials do %>
      <% edit_action = if show_mode?
           render(ButtonComponent.new(variant: :secondary, size: :sm, tag: :a, href: vendor_edit_path)) {
             t("ai_assistant.platform_settings.edit_credentials")
           }
         end %>
      <%= render Admin::Maintenance::Platform::ModuleSettings::CredentialPanelComponent.new(
            title: t("ai_assistant.platform_settings.credentials_section"),
            description: edit_vendor? ? t("ai_assistant.platform_settings.credentials_section_hint") : t("ai_assistant.platform_settings.credentials_section_hint_show"),
            action: edit_action
          ) do %>
        <ul class="divide-y divide-border-subtle">
          <% if edit_vendor? %>
            <li class="px-4 sm:px-6 py-4 grid grid-cols-1 gap-2 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-start sm:gap-6">
              <div class="min-w-0">
                <label class="form-label mb-0" for="<%= field_input_id(:api_key) %>"><%= credential_label(:api_key) %></label>
                <% if api_key_present? %>
                  <p class="text-caption mt-1"><%= t("ai_assistant.platform_settings.keep_hint") %></p>
                <% end %>
              </div>
              <div class="w-full max-w-xl">
                <input type="password"
                       id="<%= field_input_id(:api_key) %>"
                       name="<%= param_key %>[api_key]"
                       autocomplete="new-password"
                       placeholder="<%= api_key_present? ? t("ai_assistant.platform_settings.secret_placeholder") : "" %>"
                       class="input-field">
              </div>
            </li>
            <% credential_config_fields.each do |field| %>
              <li class="px-4 sm:px-6 py-4 grid grid-cols-1 gap-2 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-start sm:gap-6">
                <div class="min-w-0">
                  <label class="form-label mb-0" for="<%= field_input_id(field[:name]) %>"><%= field_label(field) %></label>
                  <% if field[:type] == :password && config_secret_present?(field) %>
                    <p class="text-caption mt-1"><%= t("ai_assistant.platform_settings.keep_hint") %></p>
                  <% end %>
                </div>
                <div class="w-full max-w-xl">
                  <% if field[:type] == :password %>
                    <input type="password"
                           id="<%= field_input_id(field[:name]) %>"
                           name="<%= param_key %>[<%= field[:name] %>]"
                           autocomplete="new-password"
                           placeholder="<%= config_secret_present?(field) ? t("ai_assistant.platform_settings.secret_placeholder") : "" %>"
                           class="input-field">
                  <% else %>
                    <input type="text"
                           id="<%= field_input_id(field[:name]) %>"
                           name="<%= param_key %>[<%= field[:name] %>]"
                           value="<%= field_value(field) %>"
                           class="input-field">
                  <% end %>
                </div>
              </li>
            <% end %>
          <% else %>
            <li class="px-4 sm:px-6 py-3 grid grid-cols-1 gap-1 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
              <span class="text-body text-text-primary font-medium"><%= credential_label(:api_key) %></span>
              <span class="text-body-sm text-text-secondary font-mono"><%= api_key_present? ? t("ai_assistant.platform_settings.masked") : t("common.labels.em_dash") %></span>
            </li>
            <% credential_config_fields.each do |field| %>
              <li class="px-4 sm:px-6 py-3 grid grid-cols-1 gap-1 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
                <span class="text-body text-text-primary font-medium"><%= field_label(field) %></span>
                <% if field[:type] == :password %>
                  <span class="text-body-sm text-text-secondary font-mono"><%= config_secret_present?(field) ? t("ai_assistant.platform_settings.masked") : t("common.labels.em_dash") %></span>
                <% else %>
                  <span class="text-body-sm text-text-secondary break-all"><%= field_value(field).presence || t("common.labels.em_dash") %></span>
                <% end %>
              </li>
            <% end %>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <% if option_config_fields.any? %>
      <% workspace.with_advanced_options do %>
        <%= render Admin::Maintenance::Platform::ModuleSettings::CredentialPanelComponent.new(
              title: t("ai_assistant.platform_settings.configuration_section"),
              description: t("ai_assistant.platform_settings.configuration_section_hint")
            ) do %>
          <ul class="divide-y divide-border-subtle">
            <% option_config_fields.each do |field| %>
              <% if edit_vendor? && cursor_select?(field) %>
                <li class="px-4 sm:px-6 py-4 grid grid-cols-1 gap-2 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-start sm:gap-6">
                  <label class="form-label mb-0" for="<%= field_input_id(field[:name]) %>"><%= field_label(field) %></label>
                  <div class="w-full max-w-xl">
                    <select id="<%= field_input_id(field[:name]) %>"
                            name="<%= param_key %>[<%= field[:name] %>]"
                            class="input-field">
                      <option value=""><%= t("ai_assistant.platform_settings.jobs.cursor_default") %></option>
                      <% cursor_chat_model_choices.each do |model| %>
                        <option value="<%= model[:id] %>" <%= "selected" if model[:id] == stored_chat_model %>>
                          <%= model[:display_name] %>
                        </option>
                      <% end %>
                    </select>
                  </div>
                </li>
              <% elsif edit_vendor? && cursor_models_empty_caption?(field) %>
                <li class="px-4 sm:px-6 py-4 flex flex-col gap-1">
                  <span class="text-body text-text-primary font-medium"><%= field_label(field) %></span>
                  <p class="text-caption"><%= t("ai_assistant.platform_settings.jobs.cursor_models_empty") %></p>
                </li>
              <% elsif edit_vendor? %>
                <li class="px-4 sm:px-6 py-4 grid grid-cols-1 gap-2 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-start sm:gap-6">
                  <label class="form-label mb-0" for="<%= field_input_id(field[:name]) %>"><%= field_label(field) %></label>
                  <div class="w-full max-w-xl">
                    <input type="text"
                           id="<%= field_input_id(field[:name]) %>"
                           name="<%= param_key %>[<%= field[:name] %>]"
                           value="<%= field_value(field) %>"
                           class="input-field">
                  </div>
                </li>
              <% else %>
                <li class="px-4 sm:px-6 py-3 grid grid-cols-1 gap-1 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
                  <span class="text-body text-text-primary font-medium"><%= field_label(field) %></span>
                  <span class="text-body-sm text-text-secondary break-all">
                    <%= option_field_display(field) %>
                    <% if cursor_models_empty_caption?(field) %>
                      <p class="text-caption"><%= t("ai_assistant.platform_settings.jobs.cursor_models_empty") %></p>
                    <% end %>
                  </span>
                </li>
              <% end %>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<% end %>

<% if edit_vendor? %>
  <%= form_with url: settings_path, method: :patch, local: true, class: "flex w-full flex-col gap-6" do %>
    <input type="hidden" name="section" value="vendor">
    <%= workspace_body %>
    <%= render Admin::Maintenance::Platform::ModuleSettings::FormActionsComponent.new(
          cancel_path: settings_path, submit_label: t("ai_assistant.platform_settings.save")
        ) %>
  <% end %>
<% else %>
  <%= workspace_body %>
<% end %>
