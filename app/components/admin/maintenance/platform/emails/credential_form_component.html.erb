<%= form_with model: credential, url: form_url, method: form_method, class: form_class,
      data: { controller: "email-credential-form",
              "email-credential-form-provider-value": selected_provider,
              "email-credential-form-labels-value": labels_by_provider.to_json,
              "email-credential-form-secret-required-value": (!credential.persisted?).to_s } do |f| %>
  <%= render FormErrorsComponent.new(resource: credential) %>

  <div class="card overflow-hidden">
    <div class="card-header">
      <h2 class="section-header"><%= t("maint_platform.emails.credentials.form.identity_title") %></h2>
      <p class="mt-0.5 text-caption"><%= identity_hint %></p>
    </div>
    <ul class="divide-y divide-border-subtle">
      <% if lock_identity? %>
        <%= f.hidden_field :provider %>
        <%= f.hidden_field :mode %>
      <% else %>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :provider, t("maint_platform.emails.credentials.form.provider_label"), class: "form-label form-label-required mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.select :provider, providers.map { |p| [p.display_name, p.key] }, {},
                    required: true,
                    class: "input-field",
                    data: { action: "change->email-credential-form#toggle" } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :mode, t("maint_platform.emails.credentials.form.mode_label"), class: "form-label form-label-required mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.select :mode, ::Emails::Credential::MODES.map { |mode| [t("maint_platform.emails.credentials.form.modes.#{mode}"), mode] }, { include_blank: true },
                    required: true,
                    class: "input-field" %>
            </div>
          </div>
        </li>
      <% end %>
      <li class="px-4 sm:px-6 py-4">
        <div class="<%= field_grid_class %>">
          <%= f.label :status, t("maint_platform.emails.credentials.form.status_label"), class: "form-label form-label-required mb-0" %>
          <div class="w-full max-w-xl">
            <%= f.select :status, ::Emails::Credential::STATUSES.map { |status| [t("common.status.#{status}"), status] }, {},
                  required: true,
                  class: "input-field" %>
          </div>
        </div>
      </li>
    </ul>
  </div>

  <div data-email-credential-form-target="fields" data-provider="<%= Admin::Maintenance::Platform::Emails::CredentialFormComponent::SMTP_KEY %>"
       class="flex flex-col gap-6 <%= "hidden" unless smtp? %>">
    <div class="card overflow-hidden">
      <div class="card-header">
        <h2 class="section-header"><%= t("maint_platform.emails.credentials.form.smtp_legend") %></h2>
      </div>
      <ul class="divide-y divide-border-subtle">
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :host, t("maint_platform.emails.credentials.form.host_label"), class: "form-label form-label-required mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.text_field :host, class: "input-field", placeholder: "smtp.example.com",
                    required: smtp?,
                    data: { email_credential_form_target: "requiredWhenVisible" } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :port, t("maint_platform.emails.credentials.form.port_label"), class: "form-label form-label-required mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.number_field :port, class: "input-field", placeholder: "587",
                    required: smtp?,
                    data: { email_credential_form_target: "requiredWhenVisible" } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :username, t("maint_platform.emails.credentials.form.username_label"), class: "form-label form-label-required mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.text_field :username, class: "input-field", autocomplete: "off",
                    required: smtp?,
                    data: { email_credential_form_target: "requiredWhenVisible" } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :domain, t("maint_platform.emails.credentials.form.domain_label"), class: "form-label mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.text_field :domain, class: "input-field", placeholder: "example.com" %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :authentication, t("maint_platform.emails.credentials.form.authentication_label"), class: "form-label form-label-required mb-0" %>
            <div class="w-full max-w-xl">
              <%= f.select :authentication, ::Emails::Credential::AUTHENTICATIONS.map { |a| [t("maint_platform.emails.credentials.form.authentications.#{a}"), a] }, {},
                    required: smtp?,
                    class: "input-field",
                    data: { email_credential_form_target: "requiredWhenVisible" } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :enable_starttls, t("maint_platform.emails.credentials.form.enable_starttls"), class: "form-label mb-0" %>
            <div class="w-full max-w-xl pt-0.5">
              <%= f.check_box :enable_starttls, class: "h-4 w-4 rounded border-border-subtle text-accent focus:ring-accent" %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :ssl, t("maint_platform.emails.credentials.form.ssl_label"), class: "form-label mb-0" %>
            <div class="w-full max-w-xl pt-0.5">
              <%= f.check_box :ssl, class: "h-4 w-4 rounded border-border-subtle text-accent focus:ring-accent" %>
            </div>
          </div>
        </li>
      </ul>
    </div>

    <div class="card overflow-hidden">
      <div class="card-header">
        <h2 class="section-header"><%= t("maint_platform.emails.credentials.form.dkim_legend") %></h2>
      </div>
      <ul class="divide-y divide-border-subtle">
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :dkim_enabled, t("maint_platform.emails.credentials.form.enable_dkim"), class: "form-label mb-0" %>
            <div class="w-full max-w-xl pt-0.5">
              <%= f.check_box :dkim_enabled, class: "h-4 w-4 rounded border-border-subtle text-accent focus:ring-accent",
                    data: {
                      email_credential_form_target: "dkimEnabled",
                      action: "change->email-credential-form#toggleDkim"
                    } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :dkim_domain, t("maint_platform.emails.credentials.form.dkim_domain_label"),
                  class: "form-label mb-0 #{'form-label-required' if credential.dkim_enabled}",
                  data: { email_credential_form_target: "dkimLabel" } %>
            <div class="w-full max-w-xl">
              <%= f.text_field :dkim_domain, class: "input-field", placeholder: "example.com",
                    data: { email_credential_form_target: "dkimRequired" } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :dkim_selector, t("maint_platform.emails.credentials.form.dkim_selector_label"),
                  class: "form-label mb-0 #{'form-label-required' if credential.dkim_enabled}",
                  data: { email_credential_form_target: "dkimLabel" } %>
            <div class="w-full max-w-xl">
              <%= f.text_field :dkim_selector, class: "input-field", placeholder: "mail",
                    data: { email_credential_form_target: "dkimRequired" } %>
            </div>
          </div>
        </li>
        <li class="px-4 sm:px-6 py-4">
          <div class="<%= field_grid_class %>">
            <%= f.label :dkim_private_key, t("maint_platform.emails.credentials.form.dkim_private_key_label"),
                  class: "form-label mb-0 #{'form-label-required' if credential.dkim_enabled && !credential.persisted?}",
                  data: { email_credential_form_target: "dkimKeyLabel" } %>
            <div class="w-full max-w-xl flex flex-col gap-2">
              <% if credential.persisted? %>
                <p class="text-caption"><%= t("maint_platform.emails.credentials.form.dkim_key_keep_hint") %></p>
              <% end %>
              <%= f.text_area :dkim_private_key, value: "",
                    placeholder: credential.persisted? ? "••••••••" : "-----BEGIN RSA PRIVATE KEY-----\n...",
                    rows: 6,
                    class: "input-field font-mono text-xs",
                    autocomplete: "off",
                    data: { email_credential_form_target: "dkimKeyInput" } %>
            </div>
          </div>
        </li>
        <% if (dns_hint = credential.dkim_dns_txt_record) %>
          <li class="px-4 sm:px-6 py-4">
            <div class="rounded-lg bg-info-subtle border border-info/20 p-4 flex flex-col gap-2" data-controller="clipboard">
              <div class="flex items-center justify-between gap-3">
                <p class="text-sm font-medium text-info"><%= t("maint_platform.emails.credentials.form.dns_txt_hint") %></p>
                <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
                        class="btn btn-secondary text-xs whitespace-nowrap">
                  <span data-clipboard-target="icon"><%= t("common.actions.copy") %></span>
                  <span data-clipboard-target="success" class="hidden"><%= t("common.actions.copied") %></span>
                </button>
              </div>
              <pre data-clipboard-target="text" class="text-xs font-mono text-text-primary break-all whitespace-pre-wrap"><%= dns_hint %></pre>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <% api_providers.each do |provider| %>
    <% provider_visible = provider.key.to_s == selected_provider %>
    <div data-email-credential-form-target="fields" data-provider="<%= provider.key %>"
         class="<%= "hidden" unless provider_visible %>">
      <div class="card overflow-hidden">
        <div class="card-header">
          <h2 class="section-header"><%= provider.display_name %></h2>
        </div>
        <ul class="divide-y divide-border-subtle">
          <% provider.config_fields.each do |field| %>
            <% field_required = field[:name].to_sym == :from_email %>
            <li class="px-4 sm:px-6 py-4">
              <div class="<%= field_grid_class %>">
                <label class="form-label mb-0 <%= "form-label-required" if field_required %>" for="<%= config_field_id(provider, field) %>"><%= field_label(provider, field) %></label>
                <div class="w-full max-w-xl">
                  <%= text_field_tag config_field_name(field), credential.config_value(field[:name]),
                        id: config_field_id(provider, field),
                        class: "input-field",
                        required: field_required && provider_visible,
                        disabled: !provider_visible,
                        data: (field_required ? { email_credential_form_target: "requiredWhenVisible" } : {}) %>
                </div>
              </div>
            </li>
          <% end %>
          <% if webhook_provider?(provider) %>
            <li class="px-4 sm:px-6 py-4">
              <div class="<%= field_grid_class %>">
                <label class="form-label mb-0" for="emails_credential_<%= provider.key %>_webhook_secret"><%= t("email.credentials.webhook_secret") %></label>
                <div class="w-full max-w-xl">
                  <%= password_field_tag "emails_credential[webhook_secret]", "",
                        id: "emails_credential_#{provider.key}_webhook_secret", autocomplete: "new-password",
                        disabled: !provider_visible,
                        placeholder: (credential.persisted? ? "••••••••" : nil), class: "input-field" %>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="card overflow-hidden scroll-mb-24">
    <div class="card-header">
      <h2 class="section-header"><%= t("maint_platform.emails.credentials.form.secret_title") %></h2>
      <p class="mt-0.5 text-caption"><%= t("maint_platform.emails.credentials.form.secret_hint") %></p>
    </div>
    <div class="px-4 sm:px-6 py-4">
      <div class="<%= field_grid_class %>">
        <%= f.label :password, secret_label,
              class: "form-label mb-0 #{'form-label-required' unless credential.persisted?}",
              data: { email_credential_form_target: "secretLabel" } %>
        <div class="w-full max-w-xl flex flex-col gap-2">
          <% if credential.persisted? %>
            <p class="text-caption"><%= t("maint_platform.emails.credentials.form.password_keep_hint") %></p>
          <% end %>
          <%= f.password_field :password, value: "",
                placeholder: credential.persisted? ? "••••••••" : nil,
                autocomplete: "new-password",
                required: !credential.persisted?,
                class: "input-field scroll-mb-24",
                data: { email_credential_form_target: "secretInput" } %>
        </div>
      </div>
    </div>
  </div>

  <% if lock_identity? %>
    <%= render Admin::Maintenance::Platform::ModuleSettings::FormActionsComponent.new(
          cancel_path: cancel_path, submit_label: submit_label
        ) %>
  <% else %>
    <div class="h-16 shrink-0" aria-hidden="true"></div>
    <%= render Admin::Maintenance::Platform::ModuleSettings::FormActionsComponent.new(
          cancel_path: cancel_path, submit_label: submit_label, sticky: true
        ) %>
  <% end %>
<% end %>
