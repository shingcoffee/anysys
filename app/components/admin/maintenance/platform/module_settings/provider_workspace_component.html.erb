<div class="flex flex-col gap-6" data-provider-workspace="true">
  <% stages.each do |name, slot| %>
    <section data-provider-workspace-section="<%= name %>"
             aria-label="<%= t("maint_platform.module_settings.workspace.stages.#{name.to_s.tr("-", "_")}") %>">
      <%= slot %>
    </section>
  <% end %>
</div>
