<%= render Admin::Maintenance::Platform::ModuleSettings::SectionCardComponent.new(
      title: title, description: description, action: action
    ) do %>
  <div data-credential-panel="true">
    <% if status.present? %>
      <div class="border-b border-border-subtle px-4 py-3 sm:px-6">
        <%= render BadgeComponent.new(variant: status_variant, size: :sm) do %>
          <%= status %>
        <% end %>
      </div>
    <% end %>
    <% if content? %>
      <%= content %>
    <% elsif rows.any? %>
      <dl class="divide-y divide-border-subtle">
        <% rows.each do |row| %>
          <div class="grid grid-cols-1 gap-1 px-4 py-3 sm:grid-cols-[12rem_minmax(0,1fr)] sm:items-baseline sm:gap-6 sm:px-6">
            <dt class="text-sm font-medium text-text-primary"><%= row.fetch(:label) %></dt>
            <dd class="break-all text-sm text-text-secondary <%= "font-mono" if row[:masked] %>"><%= row.fetch(:value) %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>
<% end %>
