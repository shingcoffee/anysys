<turbo-frame id="<%= frame_id %>" data-turbo-action="advance">
<section class="card"
         data-controller="batch-select tooltip"
         data-batch-select-count-template-value="<%= t("comp_admin.batch_select.selected") %>">
  <%= render Admin::ListToolbarComponent.new(
        base_path: base_path,
        frame_id: frame_id,
        params: params,
        search: search,
        filters: filters,
        data: { batch_select_target: "toolbar" }
      ) do |toolbar| %>
    <% toolbar.with_actions do %>
      <%= toolbar_actions %>
      <div class="hidden sm:inline-flex h-9 items-center rounded-md border border-border bg-surface-active/60 p-0.5"
           role="group"
           aria-label="<%= t("chrome.admin_table.density") %>">
        <% DENSITIES.each do |value| %>
          <% current = density == value %>
          <%= link_to density_link(value),
                class: "inline-flex size-7 items-center justify-center rounded transition-base #{current ? 'bg-surface text-text-primary shadow-xs' : 'text-text-muted hover:text-text-primary'}",
                title: t("comp_admin.entries_table.density_#{value}"),
                aria: { label: t("comp_admin.entries_table.density_#{value}"), current: (current ? "true" : nil) },
                data: frame_data do %>
            <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <% if value == "compact" %>
                <path stroke-linecap="round" d="M4 5h16M4 10h16M4 15h16M4 20h16"/>
              <% else %>
                <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
              <% end %>
            </svg>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= form_tag batch_path,
               method: :delete,
               data: frame_data,
               class: "contents" do %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <header class="hidden rounded-t-xl px-4 py-3 border-b border-accent-muted bg-accent-subtle/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
            data-batch-select-target="bulkbar">
      <p class="text-sm font-medium text-accent-text tabular-nums">
        <span data-batch-select-target="count"></span>
      </p>
      <div class="flex items-center gap-2">
        <button type="button"
                class="btn btn-ghost h-8 px-3 py-0 text-xs"
                data-action="batch-select#clear">
          <%= t("comp_admin.entries_table.clear_selection") %>
        </button>
        <button type="submit"
                class="btn btn-secondary h-8 px-3 py-0 text-xs text-danger hover:text-danger"
                data-batch-select-target="submit"
                data-turbo-confirm="<%= t("comp_admin.entries_table.bulk_delete_confirm") %>"
                disabled="disabled">
          <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
          <%= t("comp_admin.entries_table.delete_selected") %>
        </button>
      </div>
    </header>

    <% if rows.empty? %>
      <div class="px-4 py-16 text-center">
        <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-surface-active flex items-center justify-center">
          <svg class="w-6 h-6 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
          </svg>
        </div>
        <% if empty_after_search? %>
          <% if active_search? %>
            <p class="text-base font-semibold text-text-primary mb-1"><%= t("chrome.admin_table.no_matches_html", query: params[search[:param]]) %></p>
            <p class="text-body-sm text-text-muted mb-4"><%= t("chrome.admin_table.no_matches_hint") %></p>
            <%= link_to t("comp_admin.entries_table.clear_search"), clear_search_path,
                  class: "text-sm font-medium text-accent-text hover:underline",
                  data: frame_data %>
          <% else %>
            <p class="text-base font-semibold text-text-primary mb-1"><%= t("chrome.admin_table.no_filter_matches") %></p>
            <p class="text-body-sm text-text-muted"><%= t("chrome.admin_table.no_filter_matches_hint") %></p>
          <% end %>
        <% elsif empty_state %>
          <p class="text-base font-semibold text-text-primary mb-1"><%= empty_state[:title] %></p>
          <% if empty_state[:description].present? %>
            <p class="text-body-sm text-text-muted"><%= empty_state[:description] %></p>
          <% end %>
        <% else %>
          <p class="text-sm text-text-muted"><%= t("chrome.admin_table.nothing_to_show") %></p>
        <% end %>
      </div>
    <% else %>
      <%# Mobile cards — no ids[] checkboxes here; batch selection uses the desktop table only (avoids duplicate form fields). %>
      <div class="sm:hidden divide-y divide-border-subtle"
           data-controller="row-link"
           data-action="click->row-link#open">
        <% title_col = mobile_title_column %>
        <% meta_cols = mobile_meta_columns %>
        <% rows.each do |row| %>
          <div class="flex items-start gap-3 p-4 cursor-pointer active:bg-surface-active hover:bg-surface-hover transition-base" data-row-link-row>
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline gap-2 min-w-0">
                <%= link_to entry_href(row),
                      class: "min-w-0 truncate text-sm font-medium text-text-primary",
                      data: { turbo_frame: "_top", row_link_primary: true, tooltip: cell_text(row, title_col), tooltip_overflow: "true" } do %>
                  <%= cell_text(row, title_col) %>
                <% end %>
                <% if title_col[:key].to_sym != :id %>
                  <%= link_to "##{row.id}", entry_href(row),
                        class: "link shrink-0 text-xs underline underline-offset-2 tabular-nums",
                        data: { turbo_frame: "_top" } %>
                <% end %>
              </div>
              <% if meta_cols.any? %>
                <dl class="mt-2 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 text-[13px]">
                  <% meta_cols.each do |col| %>
                    <dt class="text-text-tertiary whitespace-nowrap"><%= col[:label] %></dt>
                    <dd class="min-w-0 text-text-secondary <%= numeric_class(col) %>">
                      <% if (href = cell_href(row, col)) %>
                        <%= link_to href, class: "link underline underline-offset-2", data: { turbo_frame: "_top" } do %>
                          <%= cell_content(row, col) %>
                        <% end %>
                      <% else %>
                        <%= cell_content(row, col) %>
                      <% end %>
                    </dd>
                  <% end %>
                </dl>
              <% end %>
            </div>
            <% if (edit_link = edit_href(row)) %>
              <%= link_to edit_link,
                    class: "shrink-0 inline-flex items-center justify-center size-9 rounded-md text-text-tertiary hover:text-text-primary hover:bg-surface-hover transition-base",
                    title: t("common.actions.edit"),
                    aria: { label: t("common.actions.edit") },
                    data: { turbo_frame: "_top" } do %>
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/>
                </svg>
              <% end %>
            <% end %>
            <%= link_to destroy_href(row),
                  class: "shrink-0 -mr-1 inline-flex items-center justify-center size-9 rounded-md text-text-tertiary hover:text-danger hover:bg-danger-subtle transition-base",
                  title: t("common.actions.delete"),
                  aria: { label: t("common.actions.delete") },
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: t("comp_admin.entries_table.delete_entry_confirm"),
                    turbo_frame: "_top"
                  } do %>
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Desktop table — the whole row opens the entry drawer. %>
      <div class="hidden sm:block overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="table-header">
            <tr>
              <th class="w-px pl-4 pr-2 <%= cell_padding_class %> text-center">
                <input type="checkbox"
                       class="rounded border-border text-accent focus:ring-accent"
                       data-batch-select-target="all"
                       data-action="change->batch-select#toggleAll"
                       aria-label="<%= t("common.labels.all") %>">
              </th>
              <% visible_columns.each do |col| %>
                <% link = sort_link_for(col) %>
                <th class="text-center <%= width_class(col) %> px-4 <%= cell_padding_class %> font-semibold whitespace-nowrap"
                    <%= tag.attributes(aria: { sort: Admin::SortableHeaderComponent.aria_sort(link&.dig(:direction)) }) %>>
                  <% if link %>
                    <%= render Admin::SortableHeaderComponent.new(
                          label: col[:label], href: link[:href], direction: link[:direction],
                          frame_id: frame_id, align: :center
                        ) %>
                  <% else %>
                    <%= col[:label] %>
                  <% end %>
                </th>
              <% end %>
              <th class="w-px px-4 <%= cell_padding_class %> text-center">
                <span class="sr-only"><%= t("common.labels.actions") %></span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-subtle"
                 data-controller="row-link"
                 data-action="click->row-link#open">
            <% rows.each do |row| %>
              <tr class="table-row group cursor-pointer has-[:checked]:bg-accent-subtle/50" data-row-link-row>
                <td class="pl-4 pr-2 <%= cell_padding_class %> text-center align-middle">
                  <input type="checkbox"
                         name="ids[]"
                         value="<%= row.id %>"
                         class="rounded border-border text-accent focus:ring-accent"
                         aria-label="<%= t("comp_admin.entries_table.select_entry", id: row.id) %>"
                         data-batch-select-target="item"
                         data-action="change->batch-select#refresh">
                </td>
                <% visible_columns.each_with_index do |col, idx| %>
                  <td class="px-4 <%= cell_padding_class %> text-center max-w-xs align-middle text-text-secondary <%= numeric_class(col) %>">
                    <% if entry_link?(col, idx) %>
                      <%= link_to entry_href(row),
                            class: "#{id_column?(col) ? "link underline underline-offset-2" : "font-medium text-text-primary group-hover:text-accent-text focus-visible:text-accent-text"} transition-base",
                            data: { turbo_frame: "_top", row_link_primary: true } do %>
                        <%= cell_content(row, col) %>
                      <% end %>
                    <% elsif (href = cell_href(row, col)) %>
                      <%= link_to href, class: "link underline underline-offset-2 transition-base", data: { turbo_frame: "_top" } do %>
                        <%= cell_content(row, col) %>
                      <% end %>
                    <% else %>
                      <%= cell_content(row, col) %>
                    <% end %>
                  </td>
                <% end %>
                <td class="px-4 <%= cell_padding_class %> text-center align-middle whitespace-nowrap">
                  <% if (edit_link = edit_href(row)) %>
                    <%= link_to edit_link,
                          class: "inline-flex items-center justify-center size-8 rounded-md text-text-tertiary hover:text-text-primary hover:bg-surface-hover focus-visible:text-text-primary transition-base",
                          title: t("common.actions.edit"),
                          aria: { label: t("common.actions.edit") },
                          data: { turbo_frame: "_top" } do %>
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/>
                      </svg>
                    <% end %>
                  <% end %>
                  <%= link_to destroy_href(row),
                        class: "inline-flex items-center justify-center size-8 rounded-md text-text-tertiary hover:text-danger hover:bg-danger-subtle focus-visible:text-danger transition-base",
                        title: t("common.actions.delete"),
                        aria: { label: t("common.actions.delete") },
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: t("comp_admin.entries_table.delete_entry_confirm"),
                          turbo_frame: "_top"
                        } do %>
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <%= render Admin::PaginationComponent.new(
        pagination: pagination,
        page_path: ->(page_num) { page_link(page_num) },
        turbo_frame: frame_id,
        summary: true,
        per_page_options: PER_PAGE_OPTIONS,
        per_page_path: ->(size) { per_page_link(size) }
      ) %>
</section>
</turbo-frame>
