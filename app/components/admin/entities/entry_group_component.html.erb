<% if separated? %>
  <hr class="my-6 border-border-subtle">
<% end %>
<fieldset class="min-w-0">
  <legend class="w-full border-l-2 border-accent-muted pl-3 text-lg font-semibold leading-snug text-text-primary break-words [overflow-wrap:anywhere]"><%= label %></legend>
  <% if description.present? %>
    <p class="mt-2 pl-3 text-sm text-text-muted break-words [overflow-wrap:anywhere]"><%= description %></p>
  <% end %>
  <div class="mt-5 grid grid-cols-1 gap-x-4 gap-y-5 md:grid-cols-2">
    <%= content %>
  </div>
</fieldset>
