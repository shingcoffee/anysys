<%= tag.section id: id, class: section_classes, aria: { labelledby: "#{id}-heading" }, data: section_data do %>
  <header class="flex flex-wrap items-center gap-3 px-4 pt-4 pb-3 sm:px-6 sm:pt-5">
    <span class="flex size-7 shrink-0 items-center justify-center rounded-lg ring-1 ring-inset <%= icon_tile_classes %>" aria-hidden="true">
      <%= helpers.attribute_group_icon(association.target.icon, css_class: "size-3.5") %>
    </span>
    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-2 gap-y-1">
      <%= content_tag heading_tag, heading, id: "#{id}-heading", class: "min-w-0 text-sm font-semibold text-text-primary break-words [overflow-wrap:anywhere]" %>
      <span class="inline-flex shrink-0 items-center rounded-full bg-surface-active px-2 py-0.5 text-xs font-medium text-text-muted tabular-nums">
        <%= t("admin_misc.entities.association_entries.entry_count", count: rows.size) %>
      </span>
    </div>
    <% if writable? && journey_start? %>
      <%= button_to journey_start_path, method: :post, form: { class: "shrink-0" }, **journey_start_attributes do %>
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <%= add_label %>
      <% end %>
    <% elsif writable? %>
      <%= render ButtonComponent.new(tag: :a, href: new_path, variant: :secondary, size: :sm, class: add_button_class, data: add_button_data) do %>
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <%= add_label %>
      <% end %>
    <% end %>
  </header>

  <% if rows.empty? %>
    <div class="mx-4 mb-4 rounded-lg border border-dashed border-border px-4 py-8 text-center sm:mx-6 sm:mb-6">
      <p class="text-sm font-medium text-text-primary"><%= t("admin_misc.entities.association_entries.empty_title", name: heading) %></p>
      <% if writable? %>
        <p class="mt-1 text-sm text-text-muted"><%= t("admin_misc.entities.association_entries.empty_hint", name: heading) %></p>
      <% end %>
    </div>
  <% else %>
    <ul class="divide-y divide-border-subtle border-t border-border-subtle sm:hidden">
      <% rows.each do |row| %>
        <li class="flex items-start gap-3 px-4 py-3.5">
          <div class="min-w-0 flex-1">
            <% href = title_column && reference_href(row, title_column) %>
            <% if href %>
              <%= link_to row_title(row), href, class: "text-sm font-medium text-accent-text hover:underline break-words [overflow-wrap:anywhere]", data: { turbo_frame: "_top" } %>
            <% else %>
              <p class="text-sm font-medium text-text-primary break-words [overflow-wrap:anywhere]"><%= row_title(row) %></p>
            <% end %>
            <% if detail_columns.any? %>
              <dl class="mt-2 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 text-[13px]">
                <% detail_columns.each do |column| %>
                  <% text = cell_text(row, column) %>
                  <dt class="whitespace-nowrap text-text-muted"><%= column_label(column) %></dt>
                  <dd class="min-w-0 whitespace-pre-line break-words [overflow-wrap:anywhere] <%= blank?(text) ? 'text-text-tertiary' : 'text-text-primary' %>"><%= text %></dd>
                <% end %>
              </dl>
            <% end %>
          </div>
          <% if row_actions? %>
            <div class="-mr-2 flex shrink-0 items-center">
              <%= link_to edit_path(row), class: "inline-flex size-10 items-center justify-center rounded-md text-text-tertiary hover:bg-surface-hover hover:text-text-primary transition-base",
                    title: t("common.actions.edit"), aria: { label: t("common.actions.edit") }, data: dialog_link_data("edit_title") do %>
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/></svg>
              <% end %>
              <%= link_to destroy_path(row), class: "inline-flex size-10 items-center justify-center rounded-md text-text-tertiary hover:bg-danger-subtle hover:text-danger transition-base",
                    title: t("common.actions.delete"), aria: { label: t("common.actions.delete") },
                    data: { turbo_method: :delete, turbo_confirm: t("admin_misc.entities.association_entries.delete_confirm"), turbo_frame: "_top" } do %>
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="hidden overflow-x-auto border-t border-border-subtle sm:block">
      <table class="w-full text-sm">
        <thead class="border-b border-border-subtle bg-canvas/60">
          <tr>
            <% columns.each do |column| %>
              <th scope="col" class="px-4 py-2.5 text-left text-xs font-medium whitespace-nowrap text-text-muted first:pl-6"><%= column_label(column) %></th>
            <% end %>
            <% if row_actions? %>
              <th scope="col" class="w-px px-4 py-2.5 pr-6"><span class="sr-only"><%= t("common.labels.actions") %></span></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-subtle">
          <% rows.each do |row| %>
            <tr class="hover:bg-surface-hover transition-base">
              <% columns.each do |column| %>
                <% text = cell_text(row, column) %>
                <% href = reference_href(row, column) %>
                <td class="max-w-xs px-4 py-3 align-top first:pl-6 break-words [overflow-wrap:anywhere] <%= blank?(text) ? 'text-text-tertiary' : 'text-text-primary' %>">
                  <% if href %>
                    <%= link_to text, href, class: "font-medium text-accent-text hover:underline", data: { turbo_frame: "_top" } %>
                  <% else %>
                    <span class="line-clamp-3 whitespace-pre-line"><%= text %></span>
                  <% end %>
                </td>
              <% end %>
              <% if row_actions? %>
                <td class="px-4 py-2 pr-6 align-top">
                  <div class="flex items-center justify-end gap-0.5">
                    <%= link_to edit_path(row), class: "inline-flex size-8 items-center justify-center rounded-md text-text-tertiary hover:bg-surface-active hover:text-text-primary transition-base",
                          title: t("common.actions.edit"), aria: { label: t("common.actions.edit") }, data: dialog_link_data("edit_title") do %>
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125"/></svg>
                    <% end %>
                    <%= link_to destroy_path(row), class: "inline-flex size-8 items-center justify-center rounded-md text-text-tertiary hover:bg-danger-subtle hover:text-danger transition-base",
                          title: t("common.actions.delete"), aria: { label: t("common.actions.delete") },
                          data: { turbo_method: :delete, turbo_confirm: t("admin_misc.entities.association_entries.delete_confirm"), turbo_frame: "_top" } do %>
                      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    <% end %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
