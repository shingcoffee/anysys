<%= form_with url: url, method: :post, local: true, class: "min-w-0 space-y-6", data: form_data do %>
  <% if errors? %>
    <section role="alert" tabindex="-1" autofocus="autofocus" aria-labelledby="association_rows_errors_heading" class="rounded-lg border border-danger bg-danger-subtle p-4 text-danger break-words [overflow-wrap:anywhere]">
      <h2 id="association_rows_errors_heading" class="font-semibold"><%= t("admin_misc.entities.entry_form.errors_heading") %></h2>
      <% if base_errors.any? %>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          <% base_errors.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    </section>
  <% end %>

  <% if available? %>
    <div class="space-y-4" data-controller="association-rows"
         data-association-rows-next-index-value="<%= forms.size %>"
         data-association-rows-heading-value="<%= heading_template %>">
      <ol class="space-y-4" data-association-rows-target="list">
        <% forms.each_with_index do |form, index| %>
          <%= render row(form, index) %>
        <% end %>
      </ol>
      <template data-association-rows-target="template">
        <%= render template_row %>
      </template>

      <button type="button"
              class="flex min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-dashed border-border-strong px-4 py-2.5 text-sm font-medium text-text-secondary hover:border-accent hover:bg-accent-subtle/40 hover:text-accent-text focus-visible:border-accent transition-base"
              data-action="association-rows#add">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        <%= t("admin_misc.entities.association_entries.add_row") %>
      </button>
    </div>
  <% else %>
    <p role="status" class="rounded-lg border border-warning bg-warning-subtle p-4 text-sm text-text-primary break-words [overflow-wrap:anywhere]"><%= unavailable_message %></p>
  <% end %>

  <div class="flex flex-col gap-3 border-t border-border-subtle pt-6 sm:flex-row sm:justify-end">
    <%= render ButtonComponent.new(type: "submit", name: nil, disabled: !available?, class: "min-h-11 w-full sm:w-auto",
                                   data: { turbo_submits_with: t("admin_misc.entities.entry_form.updating") }) do %>
      <%= t("admin_misc.entities.association_entries.submit") %>
    <% end %>
    <% if frame? %>
      <%= render ButtonComponent.new(variant: :secondary, class: "min-h-11 w-full sm:w-auto", data: { action: "entity-quick-add-dialog#close" }) do %>
        <%= t("common.actions.cancel") %>
      <% end %>
    <% else %>
      <%= render ButtonComponent.new(tag: :a, href: cancel_path, variant: :secondary, class: "min-h-11 w-full sm:w-auto", data: { turbo_frame: "_top" }) do %>
        <%= t("common.actions.cancel") %>
      <% end %>
    <% end %>
  </div>
<% end %>
<% if available? && quick_add_dialog? %>
  <%= render Admin::Entities::QuickAddDialogComponent.new(depth: quick_add_depth) %>
<% end %>
