<dialog id="<%= dialog_id %>"
        class="m-auto h-[100dvh] max-h-none w-full max-w-none overflow-hidden bg-canvas p-0 text-text-primary shadow-float backdrop:bg-text-primary/60 backdrop:backdrop-blur-sm sm:h-fit sm:max-h-[90dvh] sm:w-[94vw] sm:max-w-3xl sm:rounded-2xl"
        aria-modal="true"
        aria-labelledby="<%= title_id %>"
        data-controller="entity-quick-add-dialog"
        data-action="click->entity-quick-add-dialog#backdrop close->entity-quick-add-dialog#reset turbo:frame-missing->entity-quick-add-dialog#missing">
  <div class="flex h-full min-h-0 flex-col sm:max-h-[90dvh]">
    <header class="flex shrink-0 items-center gap-3 border-b border-border-subtle bg-surface px-4 py-3 sm:px-6">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-subtle text-accent" aria-hidden="true">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M5 12h14"/>
        </svg>
      </span>
      <h2 id="<%= title_id %>" class="min-w-0 flex-1 truncate text-base font-semibold tracking-tight text-text-primary"
          data-entity-quick-add-dialog-target="title"></h2>
      <button type="button" class="icon-button -mr-1.5" aria-label="<%= t("common.actions.close") %>"
              data-action="entity-quick-add-dialog#close">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <div class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-6">
      <turbo-frame id="<%= frame_id %>" data-entity-quick-add-dialog-target="frame"></turbo-frame>
    </div>
  </div>

  <template data-entity-quick-add-dialog-target="loading">
    <div class="flex flex-col items-center gap-3 py-16 text-center" role="status">
      <span class="size-8 animate-spin rounded-full border-2 border-border-strong border-t-accent" aria-hidden="true"></span>
      <p class="text-body-sm text-text-muted"><%= t("admin_misc.entities.quick_add.loading") %></p>
    </div>
  </template>

  <template data-entity-quick-add-dialog-target="failure">
    <div class="py-16 text-center" role="alert">
      <p class="text-body-sm text-text-muted"><%= t("admin_misc.entities.quick_add.unavailable") %></p>
    </div>
  </template>
</dialog>
