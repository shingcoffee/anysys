<div class="relative" data-controller="dropdown">
  <button type="button"
          data-action="click->dropdown#toggle"
          aria-haspopup="true"
          class="btn btn-secondary h-9 px-3 py-0 text-[13px] inline-flex items-center gap-1.5">
    <svg class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125z"/>
    </svg>
    <%= t("comp_admin.column_picker.button") %>
    <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1 rounded-full bg-accent-subtle text-accent-text text-[11px] font-semibold tabular-nums" aria-hidden="true"><%= selected_count %></span>
  </button>

  <div data-dropdown-target="menu"
       class="hidden absolute right-0 z-20 mt-2 w-80 overflow-hidden dropdown-panel"
       role="dialog"
       aria-label="<%= t("comp_admin.column_picker.title") %>">
    <%= form_with url: update_path, method: :patch, local: true, data: { turbo_frame: "_top" } do %>
      <input type="hidden" name="<%= array_param_name %>" value="" autocomplete="off"/>

      <div class="px-4 py-3 border-b border-border-subtle bg-surface">
        <h3 class="text-sm font-semibold text-text-primary"><%= t("comp_admin.column_picker.title") %></h3>
        <p class="mt-0.5 text-xs text-text-muted"><%= t("comp_admin.column_picker.subtitle") %></p>
      </div>

      <div class="max-h-80 overflow-y-auto overscroll-contain">
        <div class="px-4 pt-3 pb-1">
          <p class="text-[10.5px] font-semibold uppercase tracking-[0.08em] text-text-tertiary"><%= t("comp_admin.column_picker.system_group") %></p>
        </div>
        <div class="px-2 pb-2 grid grid-cols-1">
          <% system_choices.each do |choice| %>
            <div class="flex items-center gap-2.5 rounded-md px-2 py-1.5 text-sm text-text-muted">
              <svg class="w-3.5 h-3.5 shrink-0 text-text-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
              </svg>
              <input type="checkbox"
                     value="<%= choice[:key] %>"
                     checked
                     disabled
                     tabindex="-1"
                     class="rounded border-border-subtle text-text-muted opacity-60 cursor-not-allowed"/>
              <span class="truncate"><%= choice[:label] %></span>
            </div>
          <% end %>
        </div>

        <div class="px-4 pt-2 pb-1 border-t border-border-subtle">
          <p class="text-[10.5px] font-semibold uppercase tracking-[0.08em] text-text-tertiary"><%= t("comp_admin.column_picker.attributes_group") %></p>
        </div>
        <div class="px-2 pb-2 grid grid-cols-1">
          <% attribute_choices.each do |choice| %>
            <label class="flex items-center gap-2.5 rounded-md px-2 py-1.5 text-sm text-text-primary cursor-pointer hover:bg-surface-hover transition-base">
              <input type="checkbox"
                     name="<%= array_param_name %>"
                     value="<%= choice[:key] %>"
                     <%= "checked" if choice[:checked] %>
                     class="rounded border-border-strong text-accent focus:ring-accent"/>
              <span class="truncate"><%= choice[:label] %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="px-4 py-3 border-t border-border-subtle bg-surface flex items-center justify-between gap-2">
        <p class="text-xs text-text-muted tabular-nums"><%= t("comp_admin.column_picker.selected_summary", count: selected_count) %></p>
        <%= render ButtonComponent.new(variant: :primary, size: :sm, type: :submit) do %>
          <%= t("comp_admin.column_picker.apply") %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
