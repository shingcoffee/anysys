<div class="pb-32" data-controller="grants-editor"
     data-grants-editor-update-url-value="<%= update_url %>"
     data-grants-editor-locked-value="<%= locked? %>"
     data-grants-editor-dirty-count-singular-format-value="<%= t("comp_admin.grants_editor.dirty_count_singular_format") %>"
     data-grants-editor-dirty-count-plural-format-value="<%= t("comp_admin.grants_editor.dirty_count_plural_format") %>"
     data-grants-editor-granted-counter-format-value="<%= t("comp_admin.grants_editor.granted_counter_format") %>"
     data-grants-editor-discard-confirm-format-value="<%= t("comp_admin.grants_editor.discard_confirm_format") %>"
     data-grants-editor-saving-label-value="<%= t("comp_admin.grants_editor.saving") %>"
     data-grants-editor-save-grants-label-value="<%= t("common.actions.save") %>"
     data-grants-editor-save-failed-format-value="<%= t("comp_admin.grants_editor.save_failed_format") %>"
     data-grants-editor-unknown-error-label-value="<%= t("comp_admin.grants_editor.unknown_error") %>"
     data-grants-editor-added-label-value="<%= t("comp_admin.grants_editor.added") %>"
     data-grants-editor-removed-label-value="<%= t("comp_admin.grants_editor.removed") %>"
     data-grants-editor-no-changes-yet-label-value="<%= t("comp_admin.grants_editor.no_changes_yet") %>">

  <%= render Admin::Settings::SectionComponent.new(description: Admin::Settings::RolePresenter.new(role).scope) do %>
    <% if locked? %>
      <p class="font-medium"><%= t("settings_people.locked_permissions") %></p>
      <p class="mt-1 text-sm text-text-secondary"><%= t("settings_people.locked_note") %></p>
    <% end %>
  <% end %>

  <%# Sticky toolbar %>
  <div class="card mb-4 px-4 py-4">
    <div class="flex items-center gap-3 flex-wrap">
      <div class="relative w-full sm:flex-1 sm:min-w-56">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-4 h-4 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input type="search"
               aria-label="<%= t("comp_admin.grants_editor.filter_placeholder") %>"
               data-grants-editor-target="search"
               data-action="input->grants-editor#filter"
               placeholder="<%= t("comp_admin.grants_editor.filter_placeholder") %>"
               class="input-field pl-9">
      </div>

      <div class="flex items-center gap-1 flex-wrap" role="group" aria-label="<%= t("comp_admin.grants_editor.filter_by_action") %>">
        <% all_actions_present.each do |action| %>
          <button type="button"
                  data-grants-editor-target="actionFilter"
                  data-action-name="<%= action %>"
                  data-action="click->grants-editor#toggleActionFilter"
                  class="grants-action-pill">
            <%= t("comp_admin.grants_editor.actions.#{action}") %>
          </button>
        <% end %>
        <button type="button"
                data-grants-editor-target="onlyGrantedFilter"
                data-action="click->grants-editor#toggleOnlyGranted"
                class="grants-action-pill">
          <%= t("comp_admin.grants_editor.only_granted") %>
        </button>
      </div>

      <div class="flex items-center gap-2 ml-auto">
        <% if owner_access? %>
          <span class="text-sm text-text-secondary"><%= t("settings_people.all_access") %></span>
        <% else %>
          <span class="text-caption" data-grants-editor-target="counter"><%= t("comp_admin.grants_editor.granted_counter", granted: total_granted, total: total_actions) %></span>
        <% end %>
      </div>
    </div>
  </div>

  <div data-grants-editor-target="emptyState" class="hidden card p-8 text-center">
    <p class="text-body-sm"><%= t("comp_admin.grants_editor.no_matches") %></p>
  </div>

  <div class="space-y-3">
    <% catalog.groups.each_with_index do |group, idx| %>
      <% granted_count = group_granted_count(group) %>
      <% group_total_count = group_total(group) %>
      <details class="card overflow-hidden grants-group"
               data-grants-editor-target="group"
               data-group-key="<%= group[:key] %>"
               <%= "open" if idx.zero? %>>
        <summary class="flex cursor-pointer list-none flex-wrap items-center gap-3 px-5 py-4 transition-base hover:bg-surface-hover">
          <svg class="w-4 h-4 text-text-muted transition-transform grants-group-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-sm font-semibold text-text-primary"><%= group_display_label(group) %></span>
              <% unless owner_access? %>
              <%= render BadgeComponent.new(variant: :default, size: :sm) do %>
                <span data-grants-editor-target="groupCount"
                      data-group-key="<%= group[:key] %>"
                      data-group-total="<%= group_total_count %>"><%= granted_count %></span>/<%= group_total_count %>
              <% end %>
              <% end %>
              <span data-grants-editor-target="groupDirty"
                    data-group-key="<%= group[:key] %>"
                    class="hidden">
                <%= render BadgeComponent.new(variant: :warning, size: :sm) do %><%= t("comp_admin.grants_editor.modified") %><% end %>
              </span>
            </div>
            <p class="mt-0.5 text-caption"><%= t("comp_admin.grants_editor.resource_count", count: group[:descriptors].size) %></p>
          </div>
          <% unless locked? %>
            <div class="flex items-center gap-1">
              <button type="button"
                      data-action="click->grants-editor#grantAllInGroup:stop:prevent"
                      data-group-key="<%= group[:key] %>"
                      class="btn btn-ghost text-xs px-2 py-1">
                <%= t("comp_admin.grants_editor.grant_all") %>
              </button>
              <button type="button"
                      data-action="click->grants-editor#revokeAllInGroup:stop:prevent"
                      data-group-key="<%= group[:key] %>"
                      class="btn btn-ghost text-xs px-2 py-1">
                <%= t("comp_admin.grants_editor.revoke_all") %>
              </button>
            </div>
          <% end %>
        </summary>

        <div class="border-t border-border-subtle divide-y divide-border-subtle">
          <% group[:descriptors].each do |descriptor| %>
            <% resource_label = display_label(descriptor) %>
            <div class="grants-row px-5 py-3"
                 data-grants-editor-target="row"
                 data-group-key="<%= group[:key] %>"
                 data-display-label="<%= resource_label %>"
                 data-row-label="<%= resource_label.downcase %>"
                 data-actions="<%= descriptor.actions.map(&:to_s).join(' ') %>"
                 data-row-granted="<%= descriptor.actions.any? { |a| granted?(descriptor, a) } %>">
              <div class="flex flex-col lg:flex-row lg:items-start gap-4">
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-text-primary break-words"><%= resource_label %></p>
                  <% if descriptor.description.present? %>
                    <p class="mt-1 text-caption"><%= descriptor.description %></p>
                  <% end %>
                </div>
                <div class="flex flex-wrap items-center gap-3 pt-0.5">
                  <% descriptor.actions.each do |action| %>
                    <% checked = granted?(descriptor, action) %>
                    <label class="grants-checkbox-label inline-flex items-center gap-1.5 select-none cursor-pointer"
                           title="<%= t("comp_admin.grants_editor.actions.#{action}") %>">
                      <input type="checkbox"
                             class="grants-checkbox h-4 w-4 rounded border-border-strong text-accent focus:ring-2 focus:ring-accent focus:ring-offset-0"
                             <%= "checked" if checked %>
                             <%= "disabled" if locked? %>
                             data-action="change->grants-editor#toggle"
                             data-grants-editor-target="checkbox"
                             data-grants-editor-original-checked-param="<%= checked %>"
                             data-grants-editor-subject-type-param="<%= descriptor.subject_type %>"
                             data-grants-editor-subject-key-param="<%= descriptor.subject_key %>"
                             data-grants-editor-subject-id-param="<%= descriptor.subject_id %>"
                             data-grants-editor-action-param="<%= action %>"
                             data-grants-editor-group-key-param="<%= group[:key] %>"
                             data-action-name="<%= action %>">
                      <span class="text-sm text-text-secondary"><%= t("comp_admin.grants_editor.actions.#{action}") %></span>
                    </label>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <%# Sticky save bar (only visible when dirty) %>
  <% unless locked? %>
    <div data-grants-editor-target="saveBar"
         class="fixed bottom-0 left-0 right-0 z-30 bg-surface border-t border-border-strong shadow-[0_-4px_12px_rgba(0,0,0,0.05)] translate-y-full transition-transform duration-200 ease-out">
      <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2 text-sm text-text-primary">
          <svg class="w-4 h-4 text-warning" fill="currentColor" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="3"/>
          </svg>
          <span data-grants-editor-target="dirtyCount"><%= t("comp_admin.grants_editor.dirty_count") %></span>
        </div>
        <button type="button"
                data-action="click->grants-editor#openDiff"
                class="btn btn-ghost btn-sm">
          <%= t("comp_admin.grants_editor.review_changes") %>
        </button>
        <div class="ml-auto flex items-center gap-2">
          <button type="button"
                  data-action="click->grants-editor#discard"
                  class="btn btn-secondary">
            <%= t("comp_admin.grants_editor.discard") %>
          </button>
          <button type="button"
                  data-action="click->grants-editor#save"
                  data-grants-editor-target="saveButton"
                  class="btn btn-primary">
            <%= t("common.actions.save") %>
          </button>
        </div>
      </div>
    </div>
  <% end %>

  <%# Diff drawer (hidden by default) %>
  <div data-grants-editor-target="diffDrawer" class="hidden fixed inset-0 z-40 flex items-end justify-center sm:items-center bg-black/50 backdrop-blur-sm p-4"
       data-action="click->grants-editor#closeDiffOnBackdrop">
    <div class="card w-full max-w-2xl max-h-[85vh] flex flex-col" role="dialog" aria-modal="true" aria-labelledby="grants-review-title">
      <div class="card-header flex items-center justify-between">
        <h3 id="grants-review-title" class="text-subtitle"><%= t("comp_admin.grants_editor.review_changes") %></h3>
        <button type="button" data-action="click->grants-editor#closeDiff"
                class="action-icon" aria-label="<%= t("common.actions.close") %>">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto p-6 space-y-4" data-grants-editor-target="diffContent">
        <p class="text-body-sm"><%= t("comp_admin.grants_editor.no_changes_yet") %></p>
      </div>
      <div class="px-6 py-4 border-t border-border-subtle flex items-center justify-end gap-2 bg-surface">
        <button type="button" data-action="click->grants-editor#closeDiff" class="btn btn-secondary"><%= t("common.actions.close") %></button>
        <% unless locked? %>
          <button type="button" data-action="click->grants-editor#save" data-grants-editor-target="saveButton" class="btn btn-primary"><%= t("common.actions.save") %></button>
        <% end %>
      </div>
    </div>
  </div>
</div>
