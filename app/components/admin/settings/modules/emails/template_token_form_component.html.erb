<div class="flex w-full max-w-3xl flex-col gap-6">
  <%= render FormErrorsComponent.new(resource: token) %>
  <%= form_with model: token, url: url, method: method, local: true,
        class: "w-full",
        data: {
          controller: "email-template-token-form",
          email_template_token_form_attributes_value: entity_attributes.to_json,
          email_template_token_form_blank_label_value: t("settings_modules.email.choose_field")
        } do |f| %>
    <%= render Admin::Settings::SectionComponent.new(flush: true) do %>
      <div class="divide-y divide-border-subtle">
        <%= render Admin::Settings::SettingRowComponent.new(label: t("settings_modules.email.record_type"), description: t("settings_modules.email.record_type_hint"), label_for: "email-token-record", required: true) do %>
          <%= f.select :entity_id, entity_options,
                { include_blank: t("settings_modules.email.choose_record"), selected: form_value(:entity_id) },
                id: "email-token-record",
                required: true,
                class: "input-field w-full sm:w-72",
                data: {
                  email_template_token_form_target: "entity",
                  action: "change->email-template-token-form#changeEntity"
                } %>
        <% end %>
        <div class="px-4 py-5 sm:px-6">
          <div class="mb-4 space-y-1">
            <h2 class="text-sm font-semibold text-text-primary"><%= t("settings_modules.email.field_mapping") %></h2>
            <p class="text-sm text-text-secondary"><%= t("settings_modules.email.edit_field_hint") %></p>
            <p class="text-sm text-text-muted"><%= t("settings_modules.email.bulk_field_hint") %></p>
          </div>
          <div class="flex flex-col gap-3 rounded-lg border border-border-subtle px-4 py-4 sm:flex-row sm:items-center sm:gap-6">
            <div class="min-w-0 sm:w-2/5">
              <%= f.label :attribute_slug, t("settings_modules.email.field"), for: "email-token-field", class: "mb-1 block text-xs font-medium text-text-secondary form-label-required" %>
              <%= f.select :attribute_slug, selected_attribute_options,
                    { include_blank: t("settings_modules.email.choose_field"), selected: form_value(:attribute_slug) },
                    id: "email-token-field", required: true, class: "input-field w-full",
                    data: { email_template_token_form_target: "attribute", action: "change->email-template-token-form#changeAttribute" } %>
            </div>
            <div class="min-w-0 flex-1">
              <%= f.label :label, t("settings_modules.email.display_name"), for: "email-token-label", class: "mb-1 block text-xs font-medium text-text-secondary form-label-required" %>
               <%= f.text_field :label, id: "email-token-label", required: true, maxlength: 100,
                    value: form_value(:label),
                    class: "input-field w-full", autocomplete: "off",
                    data: { email_template_token_form_target: "label" } %>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap justify-end gap-3 border-t border-border-subtle bg-canvas-elevated px-4 py-3 sm:px-6">
        <%= link_to t("common.actions.cancel"), cancel_path, class: "btn btn-secondary" %>
        <%= f.submit t("comp_payments.gateway_config.save_changes"), class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
</div>
