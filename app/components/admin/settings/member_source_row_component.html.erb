<div data-list-filter-target="item" data-search-text="<%= presenter.label %>" class="min-w-0">
  <% if editable %>
    <%= form_with url: update_path, method: :patch, local: true,
                  data: { controller: "auto-submit" },
                  class: "flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between border-b border-border-subtle" do %>
      <input type="hidden" name="member_settings[rows][0][surface_key]" value="<%= presenter.surface_key %>"/>
      <span class="font-medium break-words"><%= presenter.label %></span>
      <div class="flex flex-wrap items-center gap-3 sm:shrink-0">
        <label class="inline-flex min-h-11 items-center gap-2 text-sm">
          <input type="hidden" name="member_settings[rows][0][enabled]" value="0"/>
          <input type="checkbox" name="member_settings[rows][0][enabled]" value="1"
                 <%= "checked" if presenter.enabled? %> data-action="change->auto-submit#submit" class="rounded"/>
          <span><%= t("comp_admin.member_surface_form.visible_to_members") %></span>
        </label>
        <%= link_to t("settings_people.display_settings"), edit_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  <% else %>
    <div class="flex flex-col gap-2 py-4 sm:flex-row sm:justify-between border-b border-border-subtle">
      <span class="font-medium break-words"><%= presenter.label %></span>
      <span class="text-sm text-text-secondary"><%= t("settings_people.always_available") %></span>
    </div>
  <% end %>
</div>
