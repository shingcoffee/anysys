<% if empty? %>
  <%= render EmptyStateComponent.new(title: t("admin_settings.catalog.empty_title"), description: t("admin_settings.catalog.empty_description")) %>
<% else %>
  <div data-settings-catalog class="grid grid-cols-1 items-stretch gap-5 pb-8 lg:grid-cols-2 2xl:grid-cols-3">
    <% groups.each do |group| %>
      <section class="flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-border-subtle bg-surface shadow-xs transition-colors hover:border-border"
                <% if group.label.present? %>aria-labelledby="catalog-<%= group.key.parameterize %>"<% end %>>
        <% if group.label.present? %>
          <div class="flex items-start gap-4 px-5 py-5 sm:px-6 sm:py-6">
            <% if group.icon.present? %>
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl <%= icon_well_classes(group) %>" aria-hidden="true">
                <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                  <path stroke-linecap="round" stroke-linejoin="round" d="<%= group.icon %>" />
                </svg>
              </span>
            <% end %>
            <div class="min-w-0 flex-1 space-y-1.5">
              <h2 id="catalog-<%= group.key.parameterize %>" class="text-base font-semibold leading-snug tracking-tight text-text-primary"><%= group.label %></h2>
              <% if group.description.present? %>
                <p class="text-sm leading-relaxed text-text-secondary"><%= group.description %></p>
              <% end %>
            </div>
          </div>
        <% end %>
        <ul class="mt-auto divide-y divide-border-subtle/70 border-t border-border-subtle px-3 py-3 sm:px-4">
          <% group.items.each do |item| %>
            <li>
              <%= link_to item.path,
                    class: "group/link flex min-h-14 min-w-0 items-center justify-between gap-3 rounded-lg px-2 py-2.5 text-text-secondary no-underline transition-colors hover:bg-canvas-elevated hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent" do %>
                <span class="flex min-w-0 flex-col gap-0.5">
                  <span class="text-sm font-medium leading-snug"><%= item.label %></span>
                  <% if item.description.present? %>
                    <span class="text-[13px] leading-relaxed text-text-secondary"><%= item.description %></span>
                  <% end %>
                </span>
                <svg class="size-4 shrink-0 text-text-muted transition-colors group-hover/link:text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% end %>
