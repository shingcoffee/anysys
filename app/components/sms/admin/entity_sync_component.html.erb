<div class="space-y-6 min-w-0">
  <%= error_summary(root: "sms_entity_sync") %>
  <%= section(ui("entity_sync.choose_source")) do %>
    <%= form_with url: sms_path(:new_contacts_entity_sync), method: :get, local: true, class: "space-y-4" do |f| %>
      <%= label_tag :entity_id, t("common.labels.entity"), class: "form-label" %>
      <%= select_tag :entity_id, options_for_select([[ui("entity_sync.choose_entity"), ""]] + @entities.map { |e| [e[:label], e[:id]] }, form_value(:entity_id)), class: "input-field w-full" %>
      <%= f.submit ui("entity_sync.load_fields"), name: nil, class: "btn btn-secondary" %>
    <% end %>
    <% if @entities.empty? %><p class="text-text-secondary"><%= ui("entity_sync.no_sources") %></p><% end %>
  <% end %>
  <%= section(ui("entity_sync.mapping")) do %>
    <%= form_with scope: :sms_entity_sync, url: sms_path(:preview_contacts_entity_sync), method: :post, local: true, data: { turbo: false }, class: "space-y-4" do |f| %>
      <% [:entity_id, :after_entry_id, :through_entry_id].each do |key| %><%= f.hidden_field key, value: form_value(key) %><% end %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <%= field(f, :phone_field, type: :select, options: [[ui("entity_sync.choose_phone"), ""]] + Array(@source_fields[:phone]).map { |entry| [entry[:label], entry[:value]] }, required: true) %>
        <%= field(f, :name_field, type: :select, options: [[t("common.labels.none"), ""]] + Array(@source_fields[:scalar]).map { |entry| [entry[:label], entry[:value]] }) %>
        <%= field(f, :country_code, required: true, maxlength: 2) %><%= field(f, :timezone, help: ui("contacts.timezone_help")) %>
      </div>
      <%= field(f, :attribute_map_json, type: :textarea, help: ui("entity_sync.attributes_help"), spellcheck: false) %>
      <p class="text-text-secondary"><%= ui("entity_sync.no_consent") %></p>
      <% if Array(@source_fields[:phone]).empty? %><p class="text-text-secondary"><%= ui("entity_sync.no_phone_fields") %></p><% end %>
      <%= f.submit ui("entity_sync.preview"), name: nil, class: "btn btn-primary", disabled: Array(@source_fields[:phone]).empty? %>
    <% end %>
  <% end %>
  <% if @sync_result %>
    <%= section(ui(@sync_result[:preview] ? "entity_sync.preview_title" : "entity_sync.result_title")) do %>
      <dl class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4"><% [:scanned, :created, :updated, :unchanged, :invalid, :conflicts].each do |key| %><%= fact(label_text(:entity_sync, key), @sync_result[key]) %><% end %></dl>
      <%= render AdminTableComponent.new(rows: @sync_result[:items], columns: result_columns, pagination: {}, params: {}, frame_id: "sms-sync-results") %>
      <% if @sync_result[:preview] %>
        <%= form_with scope: :sms_entity_sync, url: sms_path(:contacts_entity_sync), method: :post, local: true, data: { turbo: false } do |f| %>
          <% batch_values.each do |key, value| %><%= f.hidden_field key, value: value %><% end %>
          <%= f.submit ui("entity_sync.execute"), name: nil, class: "btn btn-primary" %>
        <% end %>
      <% elsif @sync_result[:has_more] %>
        <%= form_with scope: :sms_entity_sync, url: sms_path(:preview_contacts_entity_sync), method: :post, local: true, data: { turbo: false } do |f| %>
          <% batch_values(next_batch: true).each do |key, value| %><%= f.hidden_field key, value: value %><% end %>
          <%= f.submit ui("entity_sync.continue"), name: nil, class: "btn btn-primary" %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= link_to ui("contacts.back"), sms_path(:contacts), class: "btn btn-secondary" %>
</div>
