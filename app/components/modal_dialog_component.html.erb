<dialog id="<%= id %>"
        class="m-auto h-[100dvh] max-h-none w-full max-w-none overflow-hidden bg-canvas p-0 text-text-primary shadow-float backdrop:bg-text-primary/60 backdrop:backdrop-blur-sm sm:h-fit sm:max-h-[90dvh] sm:w-[94vw] <%= width_class %> sm:rounded-2xl"
        aria-modal="true"
        aria-labelledby="<%= title_id %>"
        data-modal-dialog-target="dialog"
        data-action="click->modal-dialog#backdrop">
  <div class="flex h-full min-h-0 flex-col sm:max-h-[90dvh]">
    <header class="flex shrink-0 items-center gap-3 border-b border-border-subtle bg-surface px-4 py-3 sm:px-6">
      <span class="flex size-9 shrink-0 items-center justify-center rounded-lg <%= tile_class %>" aria-hidden="true">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="<%= icon_path %>"/>
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <h2 id="<%= title_id %>" class="truncate text-base font-semibold tracking-tight text-text-primary"><%= title %></h2>
        <% if description.present? %>
          <p class="truncate text-xs text-text-muted"><%= description %></p>
        <% end %>
      </div>
      <button type="button" class="icon-button -mr-1.5" aria-label="<%= t("common.actions.close") %>"
              data-action="modal-dialog#close">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <div class="min-h-0 flex-1 overflow-y-auto p-4 sm:p-6">
      <%= content %>
    </div>
  </div>
</dialog>
