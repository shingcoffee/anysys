<header class="relative flex flex-col gap-5 overflow-hidden rounded-2xl border border-border-subtle bg-surface bg-[radial-gradient(120%_140%_at_100%_0%,var(--color-accent-subtle)_0%,transparent_60%)] p-5 shadow-xs sm:flex-row sm:items-center sm:justify-between sm:p-6 lg:px-8 lg:py-7">
  <div class="min-w-0 space-y-2">
    <p class="flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-1.5 text-xs font-medium text-text-tertiary">
      <span class="inline-flex min-w-0 items-center gap-1.5 rounded-full bg-accent-subtle/90 px-2.5 py-0.5 text-xs font-semibold text-accent-text ring-1 ring-inset ring-accent-muted/70">
        <svg class="size-3.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
        </svg>
        <span class="truncate"><%= customer.name %></span>
      </span>
      <span class="text-border-strong" aria-hidden="true">/</span>
      <span class="inline-flex items-center gap-1.5 text-text-tertiary">
        <svg class="size-3.5 shrink-0 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
        </svg>
        <time datetime="<%= Date.current.iso8601 %>"><%= l(Date.current, format: :long) %></time>
      </span>
    </p>
    <div class="space-y-1">
      <h1 class="truncate text-2xl font-bold tracking-tight text-text-primary sm:text-3xl"><%= t("chrome.landing_header.welcome", name: user.first_name) %></h1>
      <p class="text-sm leading-relaxed text-text-secondary"><%= t("admin_misc.dashboard.subtitle") %></p>
    </div>
  </div>
  <% if content? %>
    <div class="flex shrink-0 flex-wrap items-center gap-2.5">
      <%= content %>
    </div>
  <% end %>
</header>
