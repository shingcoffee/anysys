<div class="overflow-hidden rounded-xl border border-slate-700 bg-slate-900 shadow-lg">
  <%# Header %>
  <div class="flex items-center justify-between border-b border-slate-700 bg-slate-800 px-4 py-3">
    <div class="flex items-center space-x-3">
      <%# macOS window buttons %>
      <div class="flex space-x-2">
        <div class="h-3 w-3 rounded-full bg-red-500"></div>
        <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
        <div class="h-3 w-3 rounded-full bg-green-500"></div>
      </div>
      <%# Filename %>
      <div class="flex items-center space-x-2">
        <svg class="h-4 w-4 text-red-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.156.083c3.033.525 3.893 2.598 3.829 4.77L24 4.822 22.635 22.71 4.89 23.926h.016C2.109 24.122 0 22.255 0 19.984v-.818l-.003-.017.003-.001V4.147l.013-.03c.225-1.797 1.632-3.593 4.095-4.03L20.156.083z"/>
        </svg>
        <span class="text-sm font-medium text-slate-300"><%= filename %></span>
      </div>
    </div>

    <%# Copy button %>
    <button type="button"
            data-controller="copy-code"
            data-action="click->copy-code#copy"
            data-copy-code-copy-value="<%= t("chrome.code_block.copy") %>"
            data-copy-code-copied-value="<%= t("chrome.code_block.copied") %>"
            class="flex items-center space-x-2 rounded-md bg-slate-700 px-3 py-1.5 text-xs font-medium text-slate-300 transition-colors hover:bg-slate-600 hover:text-white">
      <svg data-copy-code-target="copyIcon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <svg data-copy-code-target="checkIcon" class="hidden h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span data-copy-code-target="copyText"><%= t("chrome.code_block.copy") %></span>
      <pre data-copy-code-target="code" class="hidden"><%= code %></pre>
    </button>
  </div>

  <%# Code area %>
  <div class="overflow-x-auto p-4">
    <div class="flex font-mono text-sm">
      <%# Line numbers column %>
      <div class="select-none border-r border-slate-700 pr-4 text-right text-slate-400">
        <% code.lines.each_with_index do |_, index| %>
          <div class="leading-6"><%= index + 1 %></div>
        <% end %>
      </div>
      <%# Code column %>
      <div class="pl-4 flex-1">
        <pre class="leading-6"><code class="highlight"><%= highlighted_code %></code></pre>
      </div>
    </div>
  </div>

  <%# Footer %>
  <div class="flex items-center justify-end border-t border-slate-700 bg-slate-800 px-4 py-2 text-xs text-slate-400">
    <span><%= line_count %> <%= t("chrome.code_block.lines_label") %></span>
  </div>
</div>
