<%
  max_lists = Emails::SendActivities::SendActivity::MAX_EMAIL_LISTS
  selected_lists = send_activity.email_lists.to_a
  selected_ids = selected_lists.map(&:id)
%>
<div class="flex flex-col gap-6">
  <div data-wizard-field-group
       data-wizard-field="lists"
       data-wizard-required-msg="<%= t("admin_modules.emails.send_activities.wizard.errors.list_required") %>"
       data-wizard-max-msg="<%= t("admin_modules.emails.send_activities.wizard.errors.lists_too_many", max: max_lists) %>"
       data-wizard-max="<%= max_lists %>"
       data-email-send-activity-wizard-target="listsFieldGroup">
    <%= f.label :email_list_ids, t("admin_modules.emails.send_activities.form.lists_label"), class: "form-label form-label-required" %>

    <%# Selected lists chips (Validators-style) %>
    <div data-email-send-activity-wizard-target="listsContainer"
         class="mt-1 flex flex-wrap gap-1.5 min-h-[2rem] p-1.5 rounded-lg border border-border-subtle bg-canvas-elevated">
      <% selected_lists.each do |list| %>
        <div data-list-item
             data-list-id="<%= list.id %>"
             class="inline-flex items-center gap-1 px-2 py-1 bg-blue-50 text-blue-700 text-xs font-medium rounded border border-blue-200">
          <input type="hidden" name="email_send_activity[email_list_ids][]" value="<%= list.id %>">
          <span title="<%= list.name %>"><%= list.name %></span>
          <button type="button"
                  data-action="click->email-send-activity-wizard#removeList"
                  class="p-0.5 hover:bg-blue-100 rounded transition-colors"
                  title="<%= t("admin_modules.emails.send_activities.form.remove_list") %>"
                  aria-label="<%= t("admin_modules.emails.send_activities.form.remove_list") %>">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      <% end %>
    </div>

    <%# Dropdown + add (Validators-style) + refresh + create %>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <select data-email-send-activity-wizard-target="listSelect"
              class="input-field text-sm py-1.5 flex-1 min-w-0">
        <option value=""><%= t("admin_modules.emails.send_activities.form.select_list") %></option>
        <% lists.each do |list| %>
          <option value="<%= list.id %>" <%= "disabled" if selected_ids.include?(list.id) %>><%= list.name %></option>
        <% end %>
      </select>
      <button type="button"
              data-action="click->email-send-activity-wizard#addList"
              data-email-send-activity-wizard-target="addListButton"
              class="flex-none px-3 py-1.5 text-accent bg-canvas-elevated border border-accent/40
                     rounded-lg hover:bg-surface-active hover:border-accent/70 transition-base"
              title="<%= t("admin_modules.emails.send_activities.form.add_list") %>"
              aria-label="<%= t("admin_modules.emails.send_activities.form.add_list") %>">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </button>
      <button type="button"
              class="inline-flex shrink-0 items-center justify-center rounded-md border border-border bg-surface px-3 py-2 text-text-muted hover:bg-surface-active hover:text-text-primary focus:outline-none focus:ring-2 focus:ring-primary/40"
              data-action="email-send-activity-wizard#refreshLists"
              data-email-send-activity-wizard-target="refreshListsButton"
              aria-label="<%= t("admin_modules.emails.send_activities.form.refresh_lists") %>"
              title="<%= t("admin_modules.emails.send_activities.form.refresh_lists") %>">
        <svg class="h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
        </svg>
      </button>
      <%= link_to t("admin_modules.emails.send_activities.form.create_list"), new_list_url,
            target: "_blank", rel: "noopener noreferrer",
            class: "shrink-0 whitespace-nowrap text-sm text-text-muted hover:text-primary hover:underline" %>
    </div>
    <p class="mt-1 text-body-sm text-text-muted"><%= t("admin_modules.emails.send_activities.form.lists_hint", max: max_lists) %></p>
  </div>
</div>
