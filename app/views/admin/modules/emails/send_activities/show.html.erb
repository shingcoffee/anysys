<%
  actions = []
  if @send_activity.status == "pending"
    actions << { label: t("common.actions.edit"), path: edit_admin_modules_emails_send_activity_path(current_customer_id, @send_activity), variant: :secondary, icon: :edit }
    if @send_activity.email_template_id.present? && @send_activity.email_lists.any?
      actions << {
        label: t("admin_modules.emails.send_activities.show.send_now"),
        path: admin_modules_emails_send_activity_delivery_path(current_customer_id, @send_activity),
        variant: :success,
        data: { turbo_method: :post, turbo_confirm: t("admin_modules.emails.send_activities.show.send_confirm") }
      }
    end
  end
  if %w[pending processing].include?(@send_activity.status)
    actions << {
      label: t("common.actions.cancel"),
      path: admin_modules_emails_send_activity_cancellation_path(current_customer_id, @send_activity),
      variant: :danger,
      data: { turbo_method: :post, turbo_confirm: t("admin_modules.emails.send_activities.show.cancel_confirm") }
    }
  end
%>
<%= render Admin::Modules::PageComponent.new(
      module_key: "email",
      breadcrumbs: [
        { label: t("admin_modules.nav.modules") },
        { label: t("admin_modules.nav.send_activities"), path: admin_modules_emails_send_activities_path(current_customer_id) },
        { label: @send_activity.name }
      ],
      title: @send_activity.name,
      actions: actions
    ) do %>
  <div class="flex flex-col gap-6">
    <div>
      <%= render BadgeComponent.new(variant: @send_activity.status_variant, size: :sm) do %><%= @send_activity.status_label %><% end %>
      <% if @send_activity.status == "failed" && @send_activity.stats["failure_reason"].present? %>
        <div class="mt-3 rounded-lg bg-danger-subtle border border-danger/20 p-3" role="alert">
          <p class="text-sm font-medium text-danger"><%= t("admin_modules.emails.send_activities.show.failure_reason_label") %></p>
          <p class="mt-1 text-sm text-danger"><%= @send_activity.stats["failure_reason"] %></p>
        </div>
      <% end %>
    </div>

  <div class="card divide-y divide-border-subtle">
    <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <dt class="form-label"><%= t("admin_modules.emails.send_activities.show.template") %></dt>
      <dd class="text-body text-text-primary col-span-2">
        <% if @send_activity.email_template %>
          <%= link_to @send_activity.email_template.name,
                admin_modules_emails_template_path(current_customer_id, @send_activity.email_template),
                target: "_blank", rel: "noopener noreferrer",
                class: "link underline underline-offset-2" %>
        <% else %>
          <%= t("common.labels.em_dash") %>
        <% end %>
      </dd>
    </div>
    <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <dt class="form-label"><%= t("admin_modules.emails.send_activities.show.lists") %></dt>
      <dd class="text-body text-text-primary col-span-2">
        <% lists = @send_activity.email_lists.to_a %>
        <% if lists.empty? %>
          <%= t("common.labels.em_dash") %>
        <% else %>
          <ul class="flex flex-col gap-1">
            <% lists.each do |list| %>
              <li>
                <%= link_to list.name,
                      admin_modules_emails_list_path(current_customer_id, list),
                      target: "_blank", rel: "noopener noreferrer",
                      class: "link underline underline-offset-2" %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </dd>
    </div>
    <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <dt class="form-label"><%= t("admin_modules.emails.send_activities.show.scheduled") %></dt>
      <dd class="text-body text-text-primary col-span-2">
        <% if @send_activity.scheduled_at %>
          <%= @send_activity.scheduled_at.in_time_zone(@send_activity.timezone).to_fs(:long) %> (<%= @send_activity.timezone %>)
        <% else %>
          <span class="text-text-muted"><%= t("admin_modules.emails.send_activities.show.not_scheduled") %></span>
        <% end %>
      </dd>
    </div>
    <% if @send_activity.recurring? %>
      <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <dt class="form-label"><%= t("admin_modules.emails.send_activities.show.recurrence") %></dt>
        <dd class="text-body text-text-primary col-span-2">
          <code class="text-mono text-sm bg-surface-active px-1.5 py-0.5 rounded"><%= @send_activity.recurrence_rule %></code>
        </dd>
      </div>
    <% end %>
    <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <dt class="form-label"><%= t("admin_modules.emails.send_activities.show.started") %></dt>
      <dd class="text-body text-text-primary col-span-2"><%= @send_activity.started_at&.to_fs(:long) || t("common.labels.em_dash") %></dd>
    </div>
    <div class="px-4 py-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <dt class="form-label"><%= t("admin_modules.emails.send_activities.show.completed") %></dt>
      <dd class="text-body text-text-primary col-span-2"><%= @send_activity.completed_at&.to_fs(:long) || t("common.labels.em_dash") %></dd>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <%= render Emails::MetricCardComponent.new(label: t("admin_modules.emails.send_activities.show.sent"), value: @send_activity.stats["sent_count"] || 0, tone: :sent) %>
    <%= render Emails::MetricCardComponent.new(label: t("admin_modules.emails.send_activities.show.delivered"), value: @delivery_counts["delivered"] || 0, tone: :delivered) %>
    <%= render Emails::MetricCardComponent.new(label: t("admin_modules.emails.send_activities.show.failed"), value: @send_activity.stats["failed_count"] || 0, tone: :failed) %>
    <%= render Emails::MetricCardComponent.new(label: t("admin_modules.emails.send_activities.show.bounced"), value: (@delivery_counts["bounced"] || 0) + (@delivery_counts["complained"] || 0), tone: :bounced) %>
    <%= render Emails::MetricCardComponent.new(label: t("admin_modules.emails.send_activities.show.suppressed"), value: @send_activity.stats["suppressed_count"] || 0, tone: :suppressed) %>
  </div>
</div>
<% end %>
