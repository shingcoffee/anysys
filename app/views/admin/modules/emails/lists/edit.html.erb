<%= render Admin::Modules::PageComponent.new(
      module_key: "email",
      breadcrumbs: [
        { label: t("admin_modules.nav.modules") },
        { label: t("feature_modules.email.entries.audience"), path: admin_modules_emails_lists_path(current_customer_id) },
        { label: t("feature_modules.email.tabs.lists"), path: admin_modules_emails_lists_path(current_customer_id) },
        { label: @list.name, path: admin_modules_emails_list_path(current_customer_id, @list) },
        { label: t("common.actions.edit") }
      ],
      title: t("admin_modules.emails.lists.edit.title"),
      description: t("admin_modules.emails.lists.edit.subtitle")
    ) do %>
  <div class="card p-6 sm:p-8 max-w-5xl">
    <%= render "form", list: @list, url: admin_modules_emails_list_path(current_customer_id, @list), method: :patch %>
  </div>
<% end %>
