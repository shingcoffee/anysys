<%= render Admin::Modules::PageComponent.new(
      module_key: "email",
      breadcrumbs: [
        { label: t("admin_modules.nav.modules") },
        { label: t("feature_modules.email.entries.content"), path: admin_modules_emails_templates_path(current_customer_id) },
        { label: t("feature_modules.email.tabs.templates"), path: admin_modules_emails_templates_path(current_customer_id) },
        { label: t("common.actions.new") }
      ],
      title: t("admin_modules.emails.templates.new.title"),
      actions: [
        { label: t("common.actions.cancel"), path: admin_modules_emails_templates_path(current_customer_id), variant: :secondary },
        { label: t("admin_modules.emails.templates.form.create_submit"), form: Emails::TemplateEditorComponent::FORM_ID, variant: :primary }
      ]
    ) do %>
  <%= render Emails::TemplateEditorComponent.new(
        template: @template,
        url: admin_modules_emails_templates_path(current_customer_id),
        method: :post,
        customer_id: current_customer_id,
        test_recipient: current_user&.email
      ) %>
<% end %>
