<%= render Admin::Modules::PageComponent.new(
      module_key: "sms",
      breadcrumbs: [
        { label: t("admin_modules.nav.modules") },
        { label: t("feature_modules.email.entries.audience"), path: admin_modules_sms_contacts_path(current_customer_id) },
        { label: t("admin_modules.emails.segments.index.title") }
      ],
      title: t("admin_modules.emails.segments.index.title"),
      description: t("sms_campaign_ui.segments.description"),
      actions: [
        {
          label: t("sms_campaign_ui.segments.create"),
          path: admin_modules_sms_new_segment_path(current_customer_id),
          variant: :primary,
          icon: :plus
        }
      ]
    ) do %>
  <%= render "admin/modules/sms/shared/audience_tabs", active_tab: :segments %>
  <%= render Sms::Admin::SegmentsIndexComponent.new(records: @records, columns: @columns, pagination: @pagination, filters: @filters) %>
<% end %>
