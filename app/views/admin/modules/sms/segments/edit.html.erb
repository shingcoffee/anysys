<%= render Admin::Modules::PageComponent.new(
      module_key: "sms",
      title: t("sms_campaign_ui.segments.edit"),
      breadcrumbs: [
        { label: t("admin_modules.nav.modules") },
        { label: t("feature_modules.email.entries.audience"), path: admin_modules_sms_contacts_path(current_customer_id) },
        { label: t("admin_modules.emails.segments.index.title"), path: admin_modules_sms_segments_path(current_customer_id) },
        { label: @segment.name, path: admin_modules_sms_segment_path(current_customer_id, @segment) },
        { label: t("common.actions.edit") }
      ]
    ) do %>
  <%= render Sms::Admin::SegmentFormComponent.new(segment: @segment, catalog: @catalog, form_values: @form_values, preview: @preview, errors: @errors) %>
<% end %>
