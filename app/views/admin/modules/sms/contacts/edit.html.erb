<%= render Admin::Modules::PageComponent.new(
      module_key: "sms",
      title: t("sms_campaign_ui.contacts.edit"),
      breadcrumbs: [
        { label: t("admin_modules.nav.modules") },
        { label: t("feature_modules.email.entries.audience"), path: admin_modules_sms_contacts_path(current_customer_id) },
        { label: t("sms_campaign_http.navigation.contacts"), path: admin_modules_sms_contacts_path(current_customer_id) },
        { label: @contact.name.presence || @contact.phone_e164, path: admin_modules_sms_contact_path(current_customer_id, @contact) },
        { label: t("common.actions.edit") }
      ]
    ) do %>
  <%= render Sms::Admin::ContactFormComponent.new(contact: @contact, form_values: @form_values, errors: @errors) %>
<% end %>
