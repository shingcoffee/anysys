<%= render Admin::Modules::PageComponent.new(
      module_key: "sms",
      title: @campaign.name,
      breadcrumbs: [
        { label: t("admin_modules.nav.modules") },
        { label: t("sms_campaign_http.navigation.campaigns"), path: admin_modules_sms_campaigns_path(current_customer_id) },
        { label: @campaign.name }
      ]
    ) do %>
  <%= render Sms::Admin::CampaignDetailsComponent.new(campaign: @campaign, templates: @templates, segments: @segments, contacts: @contacts, preview: @preview, report: @report, errors: @errors) %>
<% end %>
