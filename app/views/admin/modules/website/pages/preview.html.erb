<%
  presentation = Websites::HomeSite::Presentation.for(website: @website, page: @page)
  website, site_page, nav_pages = @website, @page, @nav_pages || []
  if presentation
    localization = Websites::HomeSiteLocalization.new
    website = localization.website(website)
    site_page = localization.page(site_page)
    # The layout's document helpers must read the same readonly, post-overlay copies.
    @website, @page = website, site_page
    nav_pages = presentation.nav_pages(nav_pages).map { |page| localization.page(page) }
  end
%>
<% if website %>
  <%= render (presentation&.header_class || Websites::NavComponent).new(website: website, pages: nav_pages, current_slug: site_page.try(:slug), embed: true, theme: @theme) %>
<% end %>
<% if site_page && @theme %>
  <%= render Websites::PageComponent.new(page: site_page, website: website, nav_pages: nav_pages, presentation: presentation, theme: @theme) %>
<% else %>
  <main></main>
<% end %>
<% if website %>
  <%= render (presentation&.footer_class || Websites::FooterComponent).new(website: website, theme: @theme) %>
<% end %>
