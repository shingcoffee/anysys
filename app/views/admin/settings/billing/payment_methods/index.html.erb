<%= render Billing::Admin::CustomerBillingPageComponent.new(
  customer_id: current_customer_id, active: :payment_methods, description: t("settings_billing.payment_methods.description"),
  tab_counts: current_billing_tab_counts
) do %>
  <%= render Billing::Admin::PaymentMethodComponent.new(
    payment_methods:     @payment_methods,
    available_providers: @available_providers,
    customer_id:         current_customer_id,
    customer_settings:   true,
    currency:            @currency,
    provider_options:    @provider_options,
    payment_method_readiness: @payment_method_readiness,
    authorization:       @authorization,
    form:                @contract,
    request_key:         @request_key,
    pagination:          @pagination,
    page_path:           @page_path
  ) %>
<% end %>
