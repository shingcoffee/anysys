<%= render Billing::Admin::CustomerBillingPageComponent.new(
  customer_id: current_customer_id, active: :invoices, description: t("settings_billing.invoices.description"),
  tab_counts: current_billing_tab_counts
) do %>
  <%= render Billing::Admin::CustomerInvoiceSummaryComponent.new(summary: @invoice_summary, customer_id: current_customer_id) %>
  <%= render Billing::Admin::InvoiceTableComponent.new(
    invoices:    @invoices,
    customer_id: current_customer_id,
    context:     :settings,
    customer_settings: true,
    filters: @filters,
    pagination: @pagination,
    page_path: @page_path,
    collection_by_invoice_id: @collection_by_invoice_id,
    load_error: @load_error
  ) %>
<% end %>
