<%= render Admin::Settings::PageComponent.new(
  customer_id: current_customer_id,
  printable: true,
  breadcrumbs: [
    { label: t("settings_navigation.items.invoices"), path: admin_settings_billing_invoices_path(current_customer_id) },
    { label: @invoice.number.presence || t("admin_settings.breadcrumbs.draft"), path: admin_settings_billing_invoice_path(current_customer_id, @invoice) },
    { label: t("common.actions.download") }
  ],
  title: t("admin_settings.billing.invoices.download.title", number: @invoice.number.presence || t("admin_settings.breadcrumbs.draft")),
  description: t("settings_billing.invoices.download_hint"),
  actions: [{ label: t("admin_settings.billing.invoices.show.back_link"), path: admin_settings_billing_invoices_path(current_customer_id), class: "print:hidden" }]
) do %>
  <%= render Billing::Admin::InvoiceDetailComponent.new(
    invoice: @invoice,
    customer_id: current_customer_id,
    platform: false,
    customer_settings: true,
    download: true
  ) %>
<% end %>
