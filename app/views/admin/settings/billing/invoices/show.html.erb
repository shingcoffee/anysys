<%= render Billing::Admin::CustomerBillingPageComponent.new(
  customer_id: current_customer_id,
  active: :invoices,
  title: t("admin_settings.billing.invoices.show.title", number: @invoice.number.presence || t("admin_settings.breadcrumbs.draft")),
  description: t("admin_settings.billing.invoices.show.description"),
  breadcrumbs: [
    { label: t("settings_navigation.items.invoices"), path: admin_settings_billing_invoices_path(current_customer_id, **(@filters || {}).symbolize_keys.slice(:status)) }
  ],
  tab_counts: current_billing_tab_counts
) do %>
  <%= render Billing::Admin::InvoiceDetailComponent.new(
    invoice:     @invoice,
    customer_id: current_customer_id,
    platform:    false,
    customer_settings: true,
    collection: @collection,
    payment_action: @payment_action,
    form: @contract
  ) %>
<% end %>
