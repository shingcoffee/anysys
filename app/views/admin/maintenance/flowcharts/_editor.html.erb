  <% if @editing_version %>
    <div class="bg-indigo-50 border-b border-indigo-200 px-4 py-2 flex items-center gap-2">
      <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-sm font-medium text-indigo-800">
        <%= t("maint_core.flowcharts.editor.editing_version", version: @editing_version.version_number) %>
      </span>
    </div>
  <% end %>

  <% if @flowchart.shared? && !shared_resources_mode? %>
    <div class="bg-sky-50 border-b border-sky-200 px-4 py-2 flex items-center gap-2">
      <svg class="w-5 h-5 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-sm font-medium text-sky-800"><%= t("maint_core.flowcharts.editor.shared_override_notice") %></span>
    </div>
  <% else %>
    <%= render Flowcharts::LaunchedNoticeComponent.new(flowchart: @flowchart, customer_id: current_customer_id) %>
  <% end %>

  <div data-flowchart-canvas-target="saveConflictBanner" role="alert"
       class="hidden bg-red-50 border-b border-red-200 px-4 py-2 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-start gap-2 min-w-0">
      <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span data-flowchart-canvas-target="saveConflictMessage" class="text-sm font-medium text-red-800"><%= t("maint_core.flash.flowcharts.save_conflict") %></span>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <button type="button" data-action="click->flowchart-canvas#reloadAfterConflict" class="btn btn-secondary">
        <%= t("maint_core.flowcharts.editor.save_conflict_reload") %>
      </button>
      <button type="button" data-action="click->flowchart-canvas#overwriteAfterConflict" class="btn btn-primary">
        <%= t("maint_core.flowcharts.editor.save_conflict_overwrite") %>
      </button>
    </div>
  </div>

  <div data-flowchart-canvas-target="previewNotice" role="status"
       class="hidden bg-sky-50 border-b border-sky-200 px-4 py-2 flex items-start gap-2 sm:items-center">
    <svg class="w-5 h-5 text-sky-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span class="text-sm font-medium text-sky-800"><%= t("maint_core.flowcharts.editor.preview_subflow_notice") %></span>
  </div>

  <%= render Flowcharts::ToolbarComponent.new(flowchart: @flowchart) %>

  <!-- Main content area: Left sidebar + Canvas + Right sidebar -->
  <div class="flex-1 flex overflow-hidden relative">

    <%= render Flowcharts::ElementPaletteComponent.new(flowchart: @flowchart) %>

    <!-- Center Workspace: Canvas + Docked Bottom Panel -->
    <div class="flex-1 min-w-0 flex flex-col overflow-hidden relative">
      <!-- Main Canvas Area -->
      <div class="flex-1 min-h-0 bg-slate-100 overflow-hidden relative" data-flowchart-canvas-target="canvasContainer">
        <div class="absolute inset-0" data-flowchart-canvas-target="canvasWrapper">
          <!-- SVG canvas placeholder - will be replaced by FlowchartCanvas -->
          <div data-flowchart-canvas-target="canvas"
               class="flowchart-canvas-container w-full h-full">
          </div>

          <!-- Canvas overlay for interactions -->
          <div data-flowchart-canvas-target="overlay"
               class="absolute inset-0 pointer-events-none">
          </div>

          <!-- Toast notifications -->
          <div data-flowchart-canvas-target="toastContainer"
               class="absolute top-4 left-1/2 -translate-x-1/2 z-40 flex flex-col items-center gap-2 pointer-events-none">
          </div>

          <!-- Minimap -->
          <div data-flowchart-canvas-target="minimapContainer"
               class="absolute bottom-2 left-2 z-30 border border-slate-300 rounded-lg shadow-md bg-white overflow-hidden w-[160px] sm:w-[200px] h-[120px] sm:h-[140px]">
          </div>

          <!-- Top-center HUD stack: Search Bar + Alignment Toolbar never overlap -->
          <div class="pointer-events-none absolute top-2 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-2 max-w-[calc(100%-1rem)]">
            <!-- Search Bar -->
            <div data-flowchart-canvas-target="searchBar"
                 class="pointer-events-auto bg-white rounded-lg shadow-lg ring-1 ring-slate-200 px-3 py-2 hidden w-80 max-w-full">
              <div class="flex items-center space-x-2">
                <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text"
                       data-flowchart-canvas-target="searchInput"
                       data-action="input->flowchart-canvas#handleSearchInput keydown->flowchart-canvas#handleSearchKeydown"
                       placeholder="<%= t("maint_core.flowcharts.editor.search_placeholder") %>"
                       class="flex-1 text-sm border-0 focus:ring-0 focus:outline-none min-w-0 px-1 py-0.5">
                <span data-flowchart-canvas-target="searchCount"
                      class="text-xs text-slate-500 whitespace-nowrap"><%= t("maint_core.flowcharts.editor.search_count_initial") %></span>
                <div class="flex items-center space-x-0.5 border-l border-slate-200 pl-2">
                  <button type="button"
                          data-action="click->flowchart-canvas#searchPrev"
                          title="<%= t("maint_core.flowcharts.editor.search_prev") %>"
                          class="p-1 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                    </svg>
                  </button>
                  <button type="button"
                          data-action="click->flowchart-canvas#searchNext"
                          title="<%= t("maint_core.flowcharts.editor.search_next") %>"
                          class="p-1 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                </div>
                <button type="button"
                        data-action="click->flowchart-canvas#closeSearch"
                        title="<%= t("maint_core.flowcharts.editor.search_close") %>"
                        class="p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-600">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Alignment Toolbar (shown when 2+ elements selected) -->
            <div data-flowchart-canvas-target="alignmentToolbar"
                 class="pointer-events-auto bg-white border border-slate-200 rounded-lg shadow-lg px-2 py-1 flex items-center space-x-1 hidden">
              <button type="button" data-action="click->flowchart-canvas#alignLeft" title="<%= t("maint_core.flowcharts.editor.align_left") %>"
                      class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900">
