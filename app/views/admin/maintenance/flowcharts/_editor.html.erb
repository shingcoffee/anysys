              </button>
              <button type="button" data-action="click->flowchart-canvas#alignCenterH" title="<%= t("maint_core.flowcharts.editor.align_center_h") %>"
                      class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M12 4v16M7 8h10M9 16h6"/></svg>
              </button>
              <button type="button" data-action="click->flowchart-canvas#alignRight" title="<%= t("maint_core.flowcharts.editor.align_right") %>"
                      class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M20 4v16M6 8h10M10 16h6"/></svg>
              </button>
              <div class="w-px h-5 bg-slate-300"></div>
              <button type="button" data-action="click->flowchart-canvas#alignTop" title="<%= t("maint_core.flowcharts.editor.align_top") %>"
                      class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M4 4h16M8 8v10M16 8v6"/></svg>
              </button>
              <button type="button" data-action="click->flowchart-canvas#alignCenterV" title="<%= t("maint_core.flowcharts.editor.align_center_v") %>"
                      class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M4 12h16M8 7v10M16 9v6"/></svg>
              </button>
              <button type="button" data-action="click->flowchart-canvas#alignBottom" title="<%= t("maint_core.flowcharts.editor.align_bottom") %>"
                      class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M4 20h16M8 6v10M16 10v6"/></svg>
              </button>
              <div class="w-px h-5 bg-slate-300 hidden" data-flowchart-canvas-target="distributeSeparator"></div>
              <button type="button" data-action="click->flowchart-canvas#distributeH" title="<%= t("maint_core.flowcharts.editor.distribute_h") %>"
                      data-flowchart-canvas-target="distributeHBtn" class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900 hidden">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M4 4v16M20 4v16M9 12h6"/></svg>
              </button>
              <button type="button" data-action="click->flowchart-canvas#distributeV" title="<%= t("maint_core.flowcharts.editor.distribute_v") %>"
                      data-flowchart-canvas-target="distributeVBtn" class="p-1.5 rounded hover:bg-slate-100 text-slate-600 hover:text-slate-900 hidden">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M4 4h16M4 20h16M12 9v6"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Tabbed Bottom Panel (docked below canvas so minimap never overlaps tabs or content) -->
      <div data-flowchart-canvas-target="bottomPanel"
           class="bg-white border-t border-slate-200 shadow-sm z-20 flex-shrink-0 max-h-[42%] flex flex-col hidden">
        <div class="flex flex-col flex-1 min-h-0">

          <!-- Tab Bar -->
          <div class="flex items-center border-b border-slate-100 bg-slate-50 flex-shrink-0 overflow-x-auto">
            <button type="button"
                    data-action="click->flowchart-canvas#switchBottomTab"
                    data-tab="problems"
                    data-flowchart-canvas-target="bottomTab"
                    class="px-3 py-2 text-xs font-medium whitespace-nowrap border-b-2 border-indigo-500 text-indigo-600">
              <%= t("maint_core.flowcharts.editor.tab_problems") %>
            </button>
            <button type="button"
                    data-action="click->flowchart-canvas#switchBottomTab"
                    data-tab="test"
                    data-flowchart-canvas-target="bottomTab"
                    class="px-3 py-2 text-xs font-medium whitespace-nowrap border-b-2 border-transparent text-slate-500 hover:text-slate-700">
              <%= t("maint_core.flowcharts.editor.tab_test_runner") %>
            </button>
            <button type="button"
                    data-action="click->flowchart-canvas#switchBottomTab"
                    data-tab="history"
                    data-flowchart-canvas-target="bottomTab"
                    class="px-3 py-2 text-xs font-medium whitespace-nowrap border-b-2 border-transparent text-slate-500 hover:text-slate-700">
              <%= t("maint_core.flowcharts.editor.tab_history") %>
              <span data-flowchart-canvas-target="versionCount" class="ml-1 text-slate-400 font-normal text-[10px]"></span>
            </button>
            <button type="button"
                    data-action="click->flowchart-canvas#switchBottomTab"
                    data-tab="elements"
                    data-flowchart-canvas-target="bottomTab"
                    class="px-3 py-2 text-xs font-medium whitespace-nowrap border-b-2 border-transparent text-slate-500 hover:text-slate-700">
              <%= t("maint_core.flowcharts.editor.tab_elements") %>
              <span data-flowchart-canvas-target="elementsCount" class="ml-1 text-slate-400 font-normal text-[10px]"></span>
            </button>
            <div class="flex-1"></div>
            <button type="button"
                    data-action="click->flowchart-canvas#closeBottomPanel"
                    class="p-1.5 mr-1 text-slate-400 hover:text-slate-600 rounded hover:bg-slate-100 shrink-0">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Tab Contents -->
          <div class="flex-1 overflow-y-auto min-h-0">

            <!-- Problems Tab -->
            <div data-tab-content="problems">
              <div data-flowchart-canvas-target="validationList" class="divide-y divide-slate-100"></div>
            </div>

            <!-- Test Runner Tab -->
            <div data-tab-content="test" class="hidden">
              <div class="flex items-center justify-between px-4 py-2 border-b border-slate-50">
                <span data-flowchart-canvas-target="testStatus" class="hidden items-center px-2 py-0.5 rounded-full text-xs font-medium"></span>
                <div class="flex items-center gap-2 ml-auto">
                  <button type="button"
                          data-action="click->flowchart-canvas#clearTraceOverlay"
                          class="text-xs text-slate-500 hover:text-slate-700 px-2 py-1 rounded hover:bg-slate-100">
                    <%= t("maint_core.flowcharts.editor.clear_overlay") %>
                  </button>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-4">
                <!-- Input Section -->
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label class="text-xs font-medium text-slate-600 uppercase tracking-wider"><%= t("maint_core.flowcharts.editor.input_json") %></label>
                    <button type="button"
                            data-flowchart-canvas-target="testRunButton"
                            data-action="click->flowchart-canvas#runTest"
                            class="btn btn-success text-xs">
                      <svg class="-ml-0.5 mr-1.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                      </svg>
                      <%= t("maint_core.flowcharts.editor.run") %>
                    </button>
                  </div>
                  <textarea data-flowchart-canvas-target="testInput"
                            data-action="input->flowchart-canvas#validateTestInput"
                            class="w-full h-32 text-xs font-mono border border-slate-300 rounded-md p-2 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-y"
                            placeholder='{ "key": "value" }'>{}</textarea>
                  <p data-flowchart-canvas-target="testInputError" class="hidden text-xs text-red-600 mt-1"></p>
                </div>
                <!-- Output Section -->
                <div>
                  <label class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-2 block"><%= t("maint_core.flowcharts.editor.output") %></label>
                  <div data-flowchart-canvas-target="testHistory" class="flex flex-wrap items-center gap-1 px-1 pb-1 empty:hidden"></div>
                  <div data-flowchart-canvas-target="testOutput"
                       class="w-full h-32 text-xs font-mono border border-slate-200 rounded-md p-2 bg-slate-50 overflow-auto">
                    <span class="text-slate-400"><%= t("maint_core.flowcharts.editor.run_test_hint") %></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- History Tab -->
            <div data-tab-content="history" class="hidden">
              <div data-flowchart-canvas-target="versionList">
                <div class="px-4 py-3 text-sm text-slate-500 text-center"><%= t("maint_core.flowcharts.editor.loading_versions") %></div>
              </div>
            </div>

            <!-- Elements Tab -->
            <div data-tab-content="elements" class="hidden">
              <table class="w-full text-sm">
                <thead class="bg-slate-50 sticky top-0">
                  <tr>
                    <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase"><%= t("common.labels.type") %></th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase"><%= t("maint_core.flowcharts.editor.col_label") %></th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase"><%= t("maint_core.flowcharts.editor.col_connections") %></th>
                  </tr>
                </thead>
                <tbody data-flowchart-canvas-target="elementsList" class="divide-y divide-slate-100">
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- Right Sidebar - Property Editor (hidden by default, overlays canvas) -->
