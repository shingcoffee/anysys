         data-property-editor-step-change-action-title-value="<%= t("maint_core.flowcharts.editor.property_editor.step_change_action_title") %>"
         data-property-editor-step-remove-button-label-value="<%= t("maint_core.flowcharts.editor.property_editor.step_remove_button_label") %>"
         data-property-editor-step-remove-button-title-value="<%= t("maint_core.flowcharts.editor.property_editor.step_remove_button_title") %>"
         data-property-editor-step-error-badge-label-value="<%= t("maint_core.flowcharts.editor.property_editor.step_error_badge_label") %>"
         data-property-editor-step-params-prefix-label-value="<%= t("maint_core.flowcharts.editor.property_editor.step_params_prefix_label") %>"
         data-property-editor-step-more-options-label-value="<%= t("maint_core.flowcharts.editor.property_editor.step_more_options_label") %>"

         data-property-editor-insert-variable-title-value="<%= t("maint_core.flowcharts.editor.property_editor.insert_variable_title") %>"
         data-property-editor-join-and-label-value="<%= t("maint_core.flowcharts.editor.property_editor.join_and") %>"
         data-property-editor-join-or-label-value="<%= t("maint_core.flowcharts.editor.property_editor.join_or") %>"
         data-property-editor-no-variables-available-value="<%= t("maint_core.pages.editor.context_autocomplete.no_variables_available") %>"
         data-property-editor-used-in-this-element-label-value="<%= t("maint_core.pages.editor.context_autocomplete.used_in_this_element") %>"
         data-property-editor-no-matching-variables-label-value="<%= t("maint_core.pages.editor.context_autocomplete.no_matching_variables") %>"
         data-property-editor-select-column-placeholder-value="<%= t("maint_core.flowcharts.editor.property_editor.select_column_placeholder") %>"
         data-property-editor-kv-key-placeholder-value="<%= t("maint_core.flowcharts.editor.property_editor.kv_key_placeholder") %>"
         data-property-editor-kv-value-placeholder-value="<%= t("maint_core.flowcharts.editor.property_editor.kv_value_placeholder") %>"
         data-property-editor-kv-remove-row-title-value="<%= t("maint_core.flowcharts.editor.property_editor.kv_remove_row_title") %>"
         data-property-editor-add-label-value="<%= t("maint_core.flowcharts.editor.property_editor.add_label") %>"
         data-property-editor-step-picker-search-placeholder-value="<%= t("maint_core.flowcharts.editor.property_editor.step_picker_search_placeholder") %>"
         data-property-editor-step-picker-no-match-label-value="<%= t("maint_core.flowcharts.editor.property_editor.step_picker_no_match_label") %>"
         data-property-editor-step-picker-already-used-label-value="<%= t("maint_core.flowcharts.editor.property_editor.step_picker_already_used_label") %>"
         data-property-editor-step-picker-all-categories-label-value="<%= t("maint_core.flowcharts.editor.filter_all") %>"
         data-property-editor-step-picker-categories-label-value="<%= t("maint_core.flowcharts.editor.property_editor.step_picker_categories_label") %>"
         data-property-editor-step-picker-recent-label-value="<%= t("maint_core.flowcharts.editor.property_editor.step_picker_recent_label") %>"
         data-property-editor-step-retry-not-idempotent-hint-value="<%= t("maint_core.flowcharts.editor.property_editor.step_retry_not_idempotent_hint") %>"
         data-property-editor-step-timeout-gives-up-format-value="<%= t("maint_core.flowcharts.editor.property_editor.step_timeout_gives_up_format") %>"
         data-property-editor-none-option-label-value="<%= t("maint_core.flowcharts.editor.property_editor.none_option_label") %>"
         data-property-editor-add-row-label-value="<%= t("maint_core.flowcharts.editor.property_editor.add_row_label") %>"
         data-property-editor-remove-row-title-value="<%= t("maint_core.flowcharts.editor.property_editor.remove_row_title") %>"
         data-property-editor-search-placeholder-value="<%= t("maint_core.flowcharts.editor.property_editor.search_placeholder") %>"
         data-property-editor-locale-en-label-value="<%= t("maint_core.flowcharts.editor.property_editor.locale_en_label") %>"
         data-property-editor-locale-zh-cn-label-value="<%= t("maint_core.flowcharts.editor.property_editor.locale_zh_cn_label") %>"
         data-property-editor-reference-loading-label-value="<%= t("maint_core.flowcharts.editor.property_editor.reference_loading_label") %>"
         data-property-editor-reference-empty-label-value="<%= t("maint_core.flowcharts.editor.property_editor.reference_empty_label") %>"
         data-property-editor-reference-error-label-value="<%= t("maint_core.flowcharts.editor.property_editor.reference_error_label") %>"
         data-property-editor-reference-placeholder-value="<%= t("maint_core.flowcharts.editor.property_editor.reference_placeholder") %>"
         data-property-editor-default-placeholder-format-value="<%= t("maint_core.flowcharts.editor.property_editor.default_placeholder_format") %>">

      <!-- Drag handle for resizing (left edge, desktop/tablet only) -->
      <div class="absolute left-0 top-0 bottom-0 w-1.5 cursor-col-resize group z-50 hidden sm:flex items-center justify-center"
           data-action="mousedown->panel-resize#startResize">
        <div class="w-0.5 h-8 rounded-full bg-slate-300 group-hover:bg-indigo-400 group-hover:h-12 transition-all duration-200"></div>
      </div>

      <!-- Modal Content Container (for positioning step modal) -->
      <div class="relative h-full flex flex-col" data-property-editor-target="modalContent">

        <!-- Property Editor Header — element-type tinted band -->
        <div class="flex-shrink-0" data-property-editor-target="headerWrapper">
          <div class="px-3 pt-2.5 pb-1.5 flex items-start justify-between">
            <div class="flex items-center gap-2 min-w-0">
              <!-- Type icon circle -->
              <div data-property-editor-target="typeIndicator"
                   class="w-6 h-6 rounded-lg flex items-center justify-center flex-shrink-0 ring-1 ring-black/5"
                   style="background-color: #f0fdf4;">
                <svg data-property-editor-target="typeIcon" class="w-3.5 h-3.5" style="color: #10b981;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 3l14 9-14 9V3z" />
                </svg>
              </div>
              <div class="min-w-0">
                <h3 class="text-sm font-semibold text-slate-900 truncate leading-tight" data-property-editor-target="title">
                  <%= t("maint_core.flowcharts.editor.element_properties") %>
                </h3>
              </div>
            </div>
            <button type="button"
                    data-action="click->property-editor#close"
                    class="mt-0.5 p-1 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-md transition-colors">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Tab Bar — pill/segment style -->
          <div class="px-3 pb-1.5" data-property-editor-target="tabBar">
            <div class="flex gap-1 p-1 bg-slate-100 rounded-lg">
              <!-- Tabs rendered dynamically by TabManager -->
            </div>
          </div>

          <!-- Subtle divider -->
          <div class="h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>
        </div>

        <!-- Property Editor Form -->
        <form data-property-editor-target="form"
              data-action="submit->property-editor#save"
              class="flex-1 flex flex-col min-h-0">

          <!-- Tab Pane: General -->
          <div class="flex-1 overflow-y-auto px-3 py-2" data-property-editor-target="tabPaneGeneral">
            <div data-property-editor-target="formFieldsGeneral" class="space-y-2"></div>
          </div>

          <!-- Tab Pane: Steps/Branches -->
          <div class="flex-1 overflow-y-auto px-3 py-2 hidden" data-property-editor-target="tabPaneSteps">
            <div data-property-editor-target="formFieldsSteps" class="space-y-2"></div>
          </div>

          <!-- Tab Pane: I/O -->
          <div class="flex-1 overflow-y-auto px-3 py-2 hidden" data-property-editor-target="tabPaneIo">
            <div data-property-editor-target="formFieldsIo" class="space-y-2"></div>
          </div>

          <!-- Tab Pane: Advanced -->
          <div class="flex-1 overflow-y-auto px-3 py-2 hidden" data-property-editor-target="tabPaneAdvanced">
            <div data-property-editor-target="formFieldsAdvanced" class="space-y-2"></div>
          </div>

          <!-- Pinned Footer -->
          <div class="flex items-center justify-end gap-2 px-3 py-2 border-t border-slate-100 bg-slate-50/50 flex-shrink-0">
            <button type="button"
                    data-action="click->property-editor#close"
                    data-property-editor-target="cancelButton"
                    class="btn btn-secondary text-xs">
              <%= t("common.actions.cancel") %>
            </button>
            <button type="submit"
                    data-property-editor-target="saveButton"
                    class="btn btn-primary text-xs">
              <%= t("common.actions.save") %>
            </button>
          </div>
        </form>

      </div>
    </div>
  </div>
</div>
