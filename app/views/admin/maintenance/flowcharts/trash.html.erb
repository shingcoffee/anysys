<%# app/views/flowcharts/trash.html.erb %>
<% content_for :title, t("maint_core.nav.trash") %>
<%= render BreadcrumbsComponent.new(crumbs: definition_resource_breadcrumbs(:flowcharts, t("maint_core.nav.trash"))) %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-subtitle"><%= t("maint_core.nav.trash") %></h1>
    <p class="mt-1 text-body-sm"><%= t("maint_core.flowcharts.trash.subtitle") %></p>
  </div>

  <% if @pagination[:total] > 0 %>
    <%= button_to empty_trash_admin_maintenance_flowcharts_path(current_customer_id),
        method: :delete,
        class: "btn btn-danger",
        data: { turbo_confirm: t("maint_core.flowcharts.trash.empty_confirm", count: @pagination[:total]) } do %>
      <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
      <%= t("maint_core.trash.empty_trash") %>
    <% end %>
  <% end %>
</div>

  <% if @flowcharts.any? %>
    <div class="card overflow-x-auto">
      <table class="min-w-full divide-y divide-border-subtle">
        <thead class="table-header">
          <tr>
            <th scope="col" class="px-6 py-3 text-left"><%= t("common.labels.name") %></th>
            <th scope="col" class="px-6 py-3 text-left"><%= t("common.labels.description") %></th>
            <th scope="col" class="px-6 py-3 text-left"><%= t("maint_core.flowcharts.trash.col_elements") %></th>
            <th scope="col" class="px-6 py-3 text-left"><%= t("maint_core.trash.deleted_at") %></th>
            <th scope="col" class="px-6 py-3 text-right"><%= t("common.labels.actions") %></th>
          </tr>
        </thead>
        <tbody class="bg-surface divide-y divide-border-subtle">
          <% @flowcharts.each do |flowchart| %>
            <tr class="table-row">
              <!-- Name -->
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-sm font-medium text-text-primary"><%= flowchart.name %></span>
              </td>

              <!-- Description -->
              <td class="px-6 py-4">
                <span class="text-body-sm line-clamp-1"><%= flowchart.description.presence || '-' %></span>
              </td>

              <!-- Elements Count -->
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="badge badge-default"><%= flowchart.elements.length %></span>
              </td>

              <!-- Deleted At -->
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="text-body-sm"><%= format_datetime(flowchart.updated_at) %></span>
              </td>

              <!-- Actions -->
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <%= button_to admin_maintenance_flowchart_restoration_path(current_customer_id, flowchart),
                    method: :patch,
                    class: "btn btn-primary text-xs",
                    form: { data: { turbo_confirm: t("maint_core.flowcharts.trash.restore_confirm", name: flowchart.name) } } do %>
                  <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <%= t("maint_core.trash.restore") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render Admin::PaginationComponent.new(
          pagination: @pagination,
          page_path: ->(page_num) { trash_admin_maintenance_flowcharts_path(current_customer_id, page: page_num) }
        ) %>

  <% else %>
    <div class="card text-center py-12 px-6">
      <div class="w-14 h-14 bg-surface-active rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-7 h-7 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </div>

      <h3 class="section-header mb-1"><%= t("maint_core.trash.is_empty") %></h3>
      <p class="text-body-sm mb-4"><%= t("maint_core.flowcharts.trash.empty_hint") %></p>

      <%= link_to admin_maintenance_flowcharts_path(current_customer_id), class: "btn btn-secondary" do %>
        <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <%= t("maint_core.flowcharts.trash.back") %>
      <% end %>
    </div>
  <% end %>
