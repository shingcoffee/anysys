<%= render AdminPageComponent.new(
  breadcrumbs: definition_resource_breadcrumbs(:flowcharts, t("common.actions.new")),
  title: t("maint_core.flowcharts.new.title"),
  width: :narrow
) do %>
<div class="card">
    <%= form_with model: @flowchart, url: admin_maintenance_flowcharts_path(current_customer_id), local: true, class: "space-y-6 p-6", data: { controller: "flowchart-form" } do |form| %>
      <% if @flowchart.errors.any? %>
        <div class="p-4 bg-danger-subtle border border-danger rounded-lg">
          <div class="flex items-center mb-2">
            <svg class="w-5 h-5 text-danger mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm font-medium text-danger"><%= t("maint_core.flowcharts.new.fix_errors") %></span>
          </div>
          <ul class="list-disc list-inside text-body-sm text-danger ml-7">
            <% @flowchart.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Template Selection -->
      <div>
        <label class="form-label form-label-required mb-3">
          <%= t("maint_core.flowcharts.new.choose_template") %>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% [
               { key: "blank", title: t("maint_core.flowcharts.new.tmpl_blank"), description: t("maint_core.flowcharts.new.tmpl_blank_desc"),
                 icon: "M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" },
               { key: "page_record", title: t("maint_core.flowcharts.new.tmpl_page_record"), description: t("maint_core.flowcharts.new.tmpl_page_record_desc"),
                 icon: "M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" }
             ].each do |template| %>
            <div class="template-card relative p-4 border-2 border-border-strong rounded-lg cursor-pointer transition-base hover:border-accent hover:shadow-md"
                 data-flowchart-form-target="templateCard"
                 data-template="<%= template[:key] %>"
                 data-action="click->flowchart-form#selectTemplate">
              <div class="flex flex-col items-center text-center">
                <div class="w-12 h-12 mb-3 text-text-muted">
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="<%= template[:icon] %>" />
                  </svg>
                </div>
                <h3 class="text-sm font-semibold text-text-primary mb-1"><%= template[:title] %></h3>
                <p class="text-caption"><%= template[:description] %></p>
              </div>
              <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-border-strong flex items-center justify-center template-checkmark hidden">
                <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          <% end %>
        </div>
        <%= form.hidden_field :template, data: { flowchart_form_target: "templateInput" }, value: "blank" %>
      </div>

      <div>
        <label for="flowchart_name" class="form-label form-label-required">
          <%= t("common.labels.name") %>
        </label>
        <%= form.text_field :name,
            class: "input-field",
            placeholder: t("maint_core.flowcharts.new.name_placeholder"),
            required: true %>
      </div>

      <div>
        <label for="flowchart_description" class="form-label">
          <%= t("common.labels.description") %> <span class="text-text-muted font-normal"><%= t("maint_core.flowcharts.new.optional") %></span>
        </label>
        <%= form.text_area :description,
            rows: 3,
            class: "input-field resize-none",
            placeholder: t("maint_core.flowcharts.new.description_placeholder") %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-6 border-t border-border-subtle">
        <%= link_to t("common.actions.cancel"), admin_maintenance_flowcharts_path(current_customer_id), class: "btn btn-secondary" %>
        <%= form.submit t("maint_core.flowcharts.new.create_flowchart"), class: "btn btn-primary cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% end %>
