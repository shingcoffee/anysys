<%= form_with model: @constant,
            url: @constant.persisted? ? admin_maintenance_constant_path(current_customer_id, @constant) : admin_maintenance_constants_path(current_customer_id),
            class: "flex flex-col gap-5",
            data: {
              controller: "constant-form",
              action: "submit->constant-form#collectOptions",
              constant_form_duplicate_error_format_value: t("maint_core.constants.form.duplicate_error_format"),
              constant_form_option_value_placeholder_value: t("maint_core.constants.form.option_value_placeholder"),
              constant_form_remove_option_label_value: t("maint_core.constants.form.remove_option")
            } do |form| %>

  <% if @constant.errors.any? %>
    <%= render "shared/form_errors", resource: @constant %>
  <% end %>

  <%= form.hidden_field :options,
      value: (@constant.options || []).to_json,
      data: { constant_form_target: "optionsField" } %>

  <div class="card">
    <div class="p-5 flex flex-col gap-5">
      <div class="flex flex-col gap-1.5">
        <label class="form-label form-label-required" for="constant_name"><%= t("common.labels.name") %></label>
        <%= form.text_field :name,
            required: true,
            class: "input-field",
            id: "constant_name",
            placeholder: t("maint_core.constants.form.name_placeholder") %>
        <p class="text-caption"><%= t("maint_core.constants.form.name_hint") %></p>
      </div>

      <div class="flex flex-col gap-3">
        <label class="form-label"><%= t("maint_core.constants.form.options") %></label>

        <div data-constant-form-target="emptyState"
             class="<%= "hidden" if @constant.options&.any? %> text-caption py-6 text-center border border-dashed border-border rounded-md">
          <%= t("maint_core.constants.form.no_options_html") %>
        </div>

        <div data-constant-form-target="optionsContainer" class="flex flex-col gap-1.5 <%= "hidden" unless @constant.options&.any? %>">
          <% if @constant.options&.any? %>
            <% @constant.options.each_with_index do |option, index| %>
              <div data-option-item class="flex items-center gap-2">
                <svg class="size-4 text-text-muted shrink-0 drag-handle cursor-grab" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
                </svg>
                <span class="text-caption font-medium w-6 shrink-0 tabular-nums"><%= index + 1 %>.</span>
                <input type="text"
                       value="<%= option %>"
                       data-option-input
                       placeholder="<%= t("maint_core.constants.form.option_value_placeholder") %>"
                       class="input-field flex-1 py-1.5">
                <button type="button"
                        data-action="click->constant-form#removeOption"
                        class="p-1.5 text-text-muted hover:text-danger rounded-md transition-colors"
                        title="<%= t("maint_core.constants.form.remove_option") %>">
                  <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            <% end %>
          <% end %>
        </div>

        <div>
          <button type="button"
                  data-action="click->constant-form#addOption"
                  class="btn btn-secondary">
            <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <%= t("maint_core.constants.form.add_option") %>
          </button>
        </div>
      </div>
    </div>

    <div class="form-actions px-5 pb-5">
      <%= link_to t("common.actions.cancel"), (@constant.persisted? ? admin_maintenance_constant_path(current_customer_id, @constant) : admin_maintenance_constants_path(current_customer_id)), class: "btn btn-secondary" %>
      <button type="submit" class="btn btn-primary">
        <%= @constant.persisted? ? t("maint_core.constants.form.save_changes") : t("maint_core.constants.form.create_constant") %>
      </button>
    </div>
  </div>
<% end %>
