<% sms_module = FeatureModules::Module.find_by(key: "sms") %>
<% sort_path = lambda do |key|
     active = params[:sort].to_s == key.to_s
     next_dir = active && params[:dir].to_s == "asc" ? "desc" : "asc"
     admin_maintenance_platform_module_settings_sms_templates_path(
       customer_id: current_customer_id, q: params[:q], sort: key, dir: next_dir
     )
   end %>
<%= render Admin::Maintenance::Platform::ModuleSettings::ShellComponent.new(
      feature_module: sms_module, customer_id: current_customer_id, current: :resources,
      actions: [{
        label: t("maint_platform.sms.templates.new_template"),
        path: new_admin_maintenance_platform_module_settings_sms_template_path(customer_id: current_customer_id),
        variant: :primary,
        icon: :plus
      }]
    ) do %>
  <%= render Admin::Maintenance::Platform::ModuleSettings::SectionCardComponent.new(
        title: t("maint_platform.sms.templates.index.title"),
        description: t("maint_platform.sms.templates.index.description")
      ) do %>
    <form method="get"
          action="<%= admin_maintenance_platform_module_settings_sms_templates_path(customer_id: current_customer_id) %>"
          class="border-b border-border-subtle px-4 py-3 sm:px-6">
      <label class="sr-only" for="sms-template-search"><%= t("maint_platform.sms.templates.index.search_placeholder") %></label>
      <div class="relative w-full sm:max-w-sm">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-text-muted">
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input id="sms-template-search"
               type="search"
               name="q"
               value="<%= params[:q] %>"
               placeholder="<%= t("maint_platform.sms.templates.index.search_placeholder") %>"
               class="input-field pl-9 w-full">
      </div>
      <% if params[:sort].present? %><input type="hidden" name="sort" value="<%= params[:sort] %>"><% end %>
      <% if params[:dir].present? %><input type="hidden" name="dir" value="<%= params[:dir] %>"><% end %>
    </form>

    <% if @rows.empty? %>
      <%= render Admin::Maintenance::Platform::ModuleSettings::EmptySectionComponent.new(
            title: t("maint_platform.sms.templates.index.empty_title"),
            description: t("maint_platform.sms.templates.index.empty_description"),
            action_path: new_admin_maintenance_platform_module_settings_sms_template_path(customer_id: current_customer_id),
            action_label: t("maint_platform.sms.templates.new_template")
          ) %>
    <% else %>
      <%= render Admin::Maintenance::Platform::ModuleSettings::ResponsiveCollectionComponent.new(
            label: t("maint_platform.module_settings.collections.sms_templates"),
            columns: [
              {
                label: t("common.labels.key"),
                sort_path: sort_path.call(:key),
                sort_direction: params[:sort].to_s == "key" ? (params[:dir].to_s == "desc" ? :descending : :ascending) : nil,
                data: { sms_template_sort: :key }
              },
              t("common.labels.provider_codes"),
              t("common.labels.variables"),
              {
                label: t("common.labels.status"),
                sort_path: sort_path.call(:status),
                sort_direction: params[:sort].to_s == "status" ? (params[:dir].to_s == "desc" ? :descending : :ascending) : nil,
                data: { sms_template_sort: :status }
              },
              {
                label: t("common.labels.updated_at"),
                sort_path: sort_path.call(:updated_at),
                sort_direction: params[:sort].to_s == "updated_at" ? (params[:dir].to_s == "desc" ? :descending : :ascending) : nil,
                data: { sms_template_sort: :updated_at }
              },
              t("common.labels.actions")
            ],
            desktop_grid_class: "lg:grid-cols-[minmax(9rem,1fr)_minmax(10rem,1.2fr)_minmax(8rem,1fr)_7rem_9rem_8rem]"
          ) do %>
        <div class="divide-y divide-border-subtle">
          <% @rows.each do |template| %>
            <article class="grid grid-cols-1 gap-3 px-4 py-4 lg:grid-cols-[minmax(9rem,1fr)_minmax(10rem,1.2fr)_minmax(8rem,1fr)_7rem_9rem_8rem] lg:items-center lg:gap-4"
                     role="row"
                     data-responsive-collection-record="<%= template.id %>">
              <div class="min-w-0" role="cell">
                <span class="mb-1 block text-xs font-medium text-text-muted lg:hidden" data-responsive-collection-mobile-label><%= t("common.labels.key") %></span>
                <p class="truncate text-sm font-semibold text-text-primary"><%= template.key %></p>
              </div>
              <div class="min-w-0" role="cell">
                <span class="mb-1 block text-xs font-medium text-text-muted lg:hidden" data-responsive-collection-mobile-label><%= t("common.labels.provider_codes") %></span>
                <p class="break-words text-sm text-text-secondary"><%= template.provider_codes.map { |key, value| "#{key}: #{value}" }.join(", ") %></p>
              </div>
              <div class="min-w-0" role="cell">
                <span class="mb-1 block text-xs font-medium text-text-muted lg:hidden" data-responsive-collection-mobile-label><%= t("common.labels.variables") %></span>
                <p class="break-words text-sm text-text-secondary"><%= Array(template.variables).join(", ") %></p>
              </div>
              <div role="cell">
                <span class="mb-1 block text-xs font-medium text-text-muted lg:hidden" data-responsive-collection-mobile-label><%= t("common.labels.status") %></span>
                <%= render BadgeComponent.new(variant: template.active? ? :success : :default, size: :sm) do %><%= t("common.status.#{template.status}") %><% end %>
              </div>
              <div role="cell">
                <span class="mb-1 block text-xs font-medium text-text-muted lg:hidden" data-responsive-collection-mobile-label><%= t("common.labels.updated_at") %></span>
                <p class="text-sm tabular-nums text-text-secondary"><%= format_datetime(template.updated_at) %></p>
              </div>
              <div class="grid grid-cols-2 gap-2 lg:flex lg:justify-end" role="cell">
                <%= render ButtonComponent.new(variant: :secondary, size: :sm, tag: :a, full_width: true,
                      href: edit_admin_maintenance_platform_module_settings_sms_template_path(customer_id: current_customer_id, id: template.id)) do %>
                  <%= t("common.actions.edit") %>
                <% end %>
                <%= link_to t("common.actions.delete"),
                      admin_maintenance_platform_module_settings_sms_template_path(customer_id: current_customer_id, id: template.id),
                      class: "btn btn-danger px-3 py-1.5 text-center text-[13px]",
                      data: { turbo_method: :delete, turbo_confirm: t("maint_platform.sms.templates.index.delete_confirm") } %>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
      <% current_sort_key = params[:sort].to_s.in?(%w[key status updated_at]) ? params[:sort].to_s : "updated_at" %>
      <% current_sort_label = {
           "key" => t("common.labels.key"),
           "status" => t("common.labels.status"),
           "updated_at" => t("common.labels.updated_at")
         }.fetch(current_sort_key) %>
      <% current_sort_direction = params[:dir].to_s == "asc" ? "asc" : "desc" %>
      <nav class="flex flex-wrap items-center gap-4 border-t border-border-subtle px-4 py-3 text-sm lg:hidden"
           data-responsive-collection-mobile-sort="true"
           aria-label="<%= t("maint_platform.sms.templates.index.sort_label") %>">
        <span class="w-full text-xs text-text-muted">
          <%= t("maint_platform.sms.templates.index.current_sort",
                column: current_sort_label,
                direction: t("maint_platform.sms.templates.index.sort_directions.#{current_sort_direction}")) %>
        </span>
        <% [[:key, t("common.labels.key")], [:status, t("common.labels.status")], [:updated_at, t("common.labels.updated_at")]].each do |key, label| %>
          <%= link_to label, sort_path.call(key),
                class: "font-medium text-text-secondary hover:text-text-primary",
                data: { sms_template_sort: key } %>
        <% end %>
      </nav>
      <%= render Admin::PaginationComponent.new(
            pagination: @pagination,
            page_path: ->(page_number) { admin_maintenance_platform_module_settings_sms_templates_path(
              customer_id: current_customer_id, q: params[:q], sort: params[:sort],
              dir: params[:dir], page: page_number
            ) }
          ) %>
    <% end %>
  <% end %>
<% end %>
