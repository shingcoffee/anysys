<% captcha_module = FeatureModules::Module.find_by(key: "captcha") %>
<%= render Admin::Maintenance::Platform::ModuleSettings::ShellComponent.new(
  feature_module: captcha_module, customer_id: current_customer_id, current: :providers
) do %>
  <%= render Admin::Maintenance::Platform::Captcha::SettingsComponent.new(
        settings: @settings, mode: @mode || :edit_vendor, customer_id: current_customer.id,
        providers: @providers, active_key: @active_key, errors: @errors || []) %>
<% end %>
