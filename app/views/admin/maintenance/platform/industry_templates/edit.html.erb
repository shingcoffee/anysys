<%# app/views/industry_template_mappings/edit.html.erb %>
<% content_for :title, strip_tags(t("maint_platform.industry_templates.edit.manage_title_html", industry: Customer.industry_label_for(@industry))) %>
<%= render BreadcrumbsComponent.new(crumbs: [
  { label: t("maint_platform.industry_templates.breadcrumbs.maintenance"), path: admin_maintenance_path(current_customer_id) },
  { label: t("maint_platform.industry_templates.breadcrumbs.industry_template_mappings"), path: admin_maintenance_platform_industry_templates_path(current_customer_id) },
  { label: Customer.industry_label_for(@industry), path: nil }
]) %>

<div class="flex items-center justify-between mb-6" data-controller="template-mapping">
  <div>
    <h1 class="text-subtitle"><%= t("maint_platform.industry_templates.edit.manage_title_html", industry: Customer.industry_label_for(@industry)) %></h1>
    <p class="mt-1 text-body-sm">
      <%= t("maint_platform.industry_templates.edit.intro") %>
      <span data-template-mapping-target="counter" class="font-medium text-accent"><%= @mapped_keys.size %></span>
      <%= t("maint_platform.industry_templates.edit.of_selected", count: @templates.size) %>
    </p>
  </div>
</div>

<%= render AlertComponent.new(message: notice, type: :success, auto_dismiss: true) %>

<div data-controller="template-mapping">
  <%# Category filter tabs %>
  <div class="mb-6 flex flex-wrap gap-2">
    <button type="button"
            class="btn btn-primary text-xs"
            data-template-mapping-target="filterTab"
            data-action="click->template-mapping#filterCategory"
            data-category="all">
      <%= t("maint_platform.industry_templates.edit.all_filter", count: @templates.size) %>
    </button>
    <% @categories.each_key do |key| %>
      <% cat_count = @templates.count { |t| t[:category] == key } %>
      <% next if cat_count == 0 %>
      <button type="button"
              class="btn btn-ghost text-xs"
              data-template-mapping-target="filterTab"
              data-action="click->template-mapping#filterCategory"
              data-category="<%= key %>">
        <%= PageLayoutTemplates.category_label(key) %> (<%= cat_count %>)
      </button>
    <% end %>
  </div>

  <%# Bulk actions %>
  <div class="mb-4 flex items-center gap-3">
    <button type="button"
            class="text-xs font-medium text-accent hover:opacity-80 transition-opacity"
            data-action="click->template-mapping#selectAll">
      <%= t("maint_platform.industry_templates.edit.select_all_visible") %>
    </button>
    <span class="text-text-muted">|</span>
    <button type="button"
            class="text-xs font-medium text-accent hover:opacity-80 transition-opacity"
            data-action="click->template-mapping#deselectAll">
      <%= t("maint_platform.industry_templates.edit.deselect_all_visible") %>
    </button>
  </div>

  <%= form_with url: admin_maintenance_platform_industry_template_path(current_customer_id, @industry), method: :patch do |form| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3" data-template-mapping-target="grid">
      <% @templates.each do |template| %>
        <% checked = @mapped_keys.include?(template[:key]) %>
        <label class="relative flex items-start gap-3 p-3 rounded-lg border cursor-pointer transition-all
                      <%= checked ? 'border-accent/40 bg-canvas-elevated' : 'border-border-subtle bg-surface hover:border-border-subtle/80' %>"
               data-template-mapping-target="card"
               data-category="<%= template[:category] %>">
          <input type="checkbox"
                 name="template_keys[]"
                 value="<%= template[:key] %>"
                 <%= "checked" if checked %>
                 class="mt-0.5 h-4 w-4 rounded border-border-subtle text-accent focus:ring-accent"
                 data-template-mapping-target="checkbox"
                 data-action="change->template-mapping#toggleCard">
          <div class="min-w-0 flex-1">
            <div class="text-body text-text-primary font-medium truncate"><%= template[:name] %></div>
            <div class="text-caption truncate"><%= template[:description] %></div>
            <div class="mt-1">
              <%= render BadgeComponent.new(variant: :default, size: :sm) do %><%= PageLayoutTemplates.category_label(template[:category]) %><% end %>
            </div>
          </div>
        </label>
      <% end %>
    </div>

    <%# Sticky save bar %>
    <div class="sticky bottom-0 mt-6 py-4 bg-canvas-elevated border-t border-border-subtle flex items-center justify-between">
      <p class="text-body-sm">
        <span data-template-mapping-target="counter" class="font-medium text-accent"><%= @mapped_keys.size %></span>
        <%= t("maint_platform.industry_templates.edit.templates_selected") %>
      </p>
      <div class="flex items-center gap-3">
        <%= link_to t("common.actions.cancel"), admin_maintenance_platform_industry_templates_path(current_customer_id),
            class: "btn btn-secondary" %>
        <button type="submit" class="btn btn-primary"><%= t("maint_platform.industry_templates.edit.save_mappings") %></button>
      </div>
    </div>
  <% end %>
</div>
