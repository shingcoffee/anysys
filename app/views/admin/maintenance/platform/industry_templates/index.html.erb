<%# app/views/industry_template_mappings/index.html.erb %>
<%= render AdminPageComponent.new(
  breadcrumbs: [
    { label: t("maint_platform.industry_templates.breadcrumbs.maintenance"), path: admin_maintenance_path(current_customer_id) },
    { label: t("maint_platform.industry_templates.breadcrumbs.industry_mappings") }
  ],
  title: t("maint_platform.industry_templates.index.title"),
  description: t("maint_platform.industry_templates.index.description", count: @total_templates)
) do %>
  <div class="flex items-center gap-2 mb-6">
    <%= form_with url: admin_maintenance_platform_default_seed_path(current_customer_id), method: :post, class: "inline" do %>
      <%= render ButtonComponent.new(type: :submit, variant: :ghost, size: :sm) do %>
        <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <%= t("maint_platform.industry_templates.index.seed_unmapped") %>
      <% end %>
    <% end %>

    <%= form_with url: admin_maintenance_platform_new_template_seed_path(current_customer_id), method: :post, class: "inline" do %>
      <%= render ButtonComponent.new(type: :submit, variant: :ghost, size: :sm) do %>
        <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <%= t("maint_platform.industry_templates.index.sync_new") %>
      <% end %>
    <% end %>

    <%= form_with url: admin_maintenance_platform_default_seed_path(current_customer_id), method: :delete, class: "inline",
        data: { turbo_confirm: t("maint_platform.industry_templates.index.reset_confirm") } do %>
      <%= render ButtonComponent.new(type: :submit, variant: :secondary, size: :sm) do %>
        <%= t("maint_platform.industry_templates.index.reset_all") %>
      <% end %>
    <% end %>
  </div>

  <%# Industry Groups Accordion %>
<div class="space-y-3"
     data-controller="industry-mapping"
     data-industry-mapping-base-url-value="<%= admin_maintenance_platform_industry_templates_path(current_customer_id) %>"
     data-industry-mapping-loading-templates-label-value="<%= t("maint_platform.industry_templates.index.loading_templates") %>"
     data-industry-mapping-load-failed-message-value="<%= t("maint_platform.industry_templates.index.load_failed") %>"
     data-action="industry-template-panel:countChanged->industry-mapping#handleCountChanged">
  <% @industry_groups.each_with_index do |(group_name, industry_keys), group_idx| %>
    <div class="card overflow-hidden"
         data-industry-mapping-target="group">

      <%# Group header %>
      <button type="button"
              class="w-full px-5 py-4 flex items-center justify-between text-left hover:bg-canvas-elevated transition-colors focus:outline-none"
              data-action="click->industry-mapping#toggleGroup"
              data-industry-mapping-target="groupToggle"
              data-group-index="<%= group_idx %>">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-text-muted transition-transform duration-200"
               data-industry-mapping-target="groupChevron"
               data-group-index="<%= group_idx %>"
               fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          <h2 class="text-body text-text-primary font-semibold"><%= Customer.industry_group_label(group_name) %></h2>
          <span class="text-caption"><%= t("maint_platform.industry_templates.index.industries_count", count: industry_keys.size) %></span>
        </div>
        <% group_total = industry_keys.sum { |k| @mapping_counts[k.to_s] || 0 } %>
        <%= render BadgeComponent.new(variant: group_total > 0 ? :primary : :default, size: :sm) do %>
          <%= t("maint_platform.industry_templates.index.mappings_count", count: group_total) %>
        <% end %>
      </button>

      <%# Group body (child industries) %>
      <div class="hidden border-t border-border-subtle"
           data-industry-mapping-target="groupBody"
           data-group-index="<%= group_idx %>">

        <% industry_keys.each do |industry_key| %>
          <% ik = industry_key.to_s %>
          <% count = @mapping_counts[ik] || 0 %>
          <div data-industry-mapping-target="industryRow" data-industry="<%= ik %>">

            <%# Industry row %>
            <button type="button"
                    class="w-full pl-14 pr-5 py-3 flex items-center justify-between text-left hover:bg-canvas-elevated transition-colors focus:outline-none group"
                    data-action="click->industry-mapping#toggleIndustry"
                    data-industry="<%= ik %>">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-text-muted transition-transform duration-200"
                     data-industry-mapping-target="industryChevron"
                     data-industry="<%= ik %>"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <span class="text-body-sm text-text-secondary group-hover:text-text-primary transition-colors font-medium">
                  <%= Customer.industry_label_for(ik) %>
                </span>
              </div>
              <span class="inline-flex items-center gap-0.5 text-caption"
                    data-industry-mapping-target="industryBadge"
                    data-industry="<%= ik %>">
                <span data-industry-mapping-target="industryCount" data-industry="<%= ik %>"><%= count %></span>
                <span class="text-text-muted">/</span>
                <span><%= @total_templates %></span>
              </span>
            </button>

            <%# Expanded panel (lazy loaded on click) %>
            <div class="hidden"
                 data-industry-mapping-target="industryPanel"
                 data-industry="<%= ik %>">
            </div>

          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  </div>
<% end %>
