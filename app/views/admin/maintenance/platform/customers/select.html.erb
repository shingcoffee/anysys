<%= render AdminPageComponent.new(
  breadcrumbs: [],
  title: "Anysys",
  description: t("maint_platform.customers.select.subtitle")
) do %>

<% if @customers.any? %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @customers.each do |customer| %>
      <%= link_to admin_maintenance_flowcharts_path(customer.id), class: "card p-6 block hover:shadow-md transition-shadow" do %>
        <div class="flex items-center gap-4">
          <div class="flex-shrink-0 w-12 h-12 bg-surface-active rounded-full flex items-center justify-center">
            <span class="text-xl font-bold text-text-primary"><%= customer.name[0].upcase %></span>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-subheading truncate"><%= customer.name %></h3>
            <div class="flex items-center gap-2 mt-1">
              <span class="text-caption text-mono"><%= customer.id %></span>
              <%= render RoleBadgeComponent.new(role: customer.role) %>
            </div>
          </div>
          <svg class="w-5 h-5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(
    title: t("maint_platform.customers.select.empty_title"),
    description: t("maint_platform.customers.select.empty_description"),
    icon_path: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
  ) %>
<% end %>
<% end %>
