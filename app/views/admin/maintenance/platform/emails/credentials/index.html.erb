<% emails_module = FeatureModules::Module.find_by(key: "email") %>
<%= render Admin::Maintenance::Platform::ModuleSettings::ShellComponent.new(
  feature_module: emails_module, customer_id: current_customer_id, current: :providers
) do %>
  <%= render Admin::Maintenance::Platform::Emails::SettingsComponent.new(
        provider_key: @provider_key,
        providers: @providers,
        credentials_by_mode: @credentials_by_mode,
        all_credentials: @all_credentials,
        delivery_by_mode: @delivery_by_mode,
        customer_id: current_customer_id,
        mode: @ui_mode || :show,
        edit_mode_key: @edit_mode_key,
        credential: @credential,
        errors: @errors || []
      ) %>
<% end %>
