<% if @feature_module %>
  <%= render Admin::Maintenance::Platform::ModuleSettings::ShellComponent.new(
        feature_module: @feature_module,
        customer_id: current_customer_id,
        current: :layouts
      ) do %>
    <div class="flex flex-col gap-5">
      <%= render Websites::Admin::CatalogEditorHeaderComponent.new(
            title: t("website.platform.layouts.new"),
            description: t("website.platform.layouts.description"),
            back_path: admin_maintenance_platform_module_settings_website_layouts_path(current_customer_id)
          ) do |header| %>
        <% header.with_actions do %>
          <%= render ButtonComponent.new(
                variant: :primary,
                size: :sm,
                tag: :button,
                type: :submit,
                form: Websites::Admin::ComposerComponent::LAYOUT_FORM_ID
              ) do %>
            <%= t("common.actions.create") %>
          <% end %>
        <% end %>
      <% end %>
      <%= render Websites::Admin::ComposerComponent.new(
            page: @layout,
            form_url: admin_maintenance_platform_module_settings_website_layouts_path(current_customer_id),
            method: :post,
            kind: :layout,
            structure_locked: false
          ) %>
    </div>
  <% end %>
<% end %>
