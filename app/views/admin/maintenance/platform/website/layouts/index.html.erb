<% if @feature_module %>
  <%= render Admin::Maintenance::Platform::ModuleSettings::ShellComponent.new(
        feature_module: @feature_module,
        customer_id: current_customer_id,
        current: :layouts
      ) do %>
    <%= render Websites::Admin::LayoutsGalleryComponent.new(
          layouts: @layouts,
          customer_id: current_customer_id,
          family: @family
        ) %>
  <% end %>
<% else %>
  <h1 class="text-subtitle"><%= t("website.platform.layouts.heading") %></h1>
<% end %>
