<%# locals: (associations:, editable: true, pending_bridge_label: nil) %>
<% editable = local_assigns.fetch(:editable, true) %>
<% pending_bridge_label = local_assigns[:pending_bridge_label].presence || t("maint_core.entities.assoc.will_be_created") %>
<% customer_id = current_customer_id %>

<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-border-subtle"<%= ' data-entity-form-target="associationsTable"' if editable %>>
    <thead class="table-header">
      <tr>
        <th scope="col" class="px-3 py-3 text-left"><%= t("maint_core.entities.assoc.target_entity") %></th>
        <th scope="col" class="px-3 py-3 text-left"><%= t("maint_core.entities.assoc.display") %></th>
        <th scope="col" class="px-3 py-3 text-left"><%= t("maint_core.entities.bridge.title") %></th>
        <th scope="col" class="px-3 py-3 text-left"><%= t("maint_core.entities.assoc.additional_attributes") %></th>
        <% if editable %>
          <th scope="col" class="px-3 py-3 text-right"><%= t("common.labels.actions") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody class="bg-surface divide-y divide-border-subtle">
    <% associations.each_with_index do |assoc, index| %>
      <tr class="table-row"
          <% if editable %>data-association-item
          data-association-index="<%= index %>"
          data-association-data="<%= ERB::Util.html_escape(assoc.to_json) %>"<% end %>>
        <td class="px-3 py-2">
          <span class="text-body text-text-primary font-medium">
            <%= link_to_entity(assoc['target_entity_id'], customer_id, link_text: assoc['target_entity_name']) %>
          </span>
        </td>
        <td class="px-3 py-2">
          <% if assoc['display_field_label'].present? %>
            <code class="text-mono text-xs text-accent bg-surface-active px-1.5 py-0.5 rounded"><%= assoc['display_field_label'] %></code>
          <% else %>
            <span class="text-caption"><%= t("common.labels.em_dash") %></span>
          <% end %>
        </td>
        <td class="px-3 py-2">
          <% if assoc['bridge_entity_name'].present? %>
            <%= link_to admin_maintenance_entity_path(customer_id, assoc['bridge_entity_id']),
                class: "inline-flex items-center gap-1" do %>
              <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              <%= render BadgeComponent.new(variant: :primary, size: :sm) do %><%= assoc['bridge_entity_name'] %><% end %>
            <% end %>
          <% else %>
            <span class="text-caption text-warning"><%= pending_bridge_label %></span>
          <% end %>
        </td>
        <td class="px-3 py-2">
          <% additional_attrs = assoc['additional_attributes'] || [] %>
          <% if additional_attrs.any? %>
            <div class="flex flex-wrap gap-1">
              <% additional_attrs.first(3).each do |attr| %>
                <%= render BadgeComponent.new(variant: :default, size: :sm) do %><%= attr['name'] %><% end %>
              <% end %>
              <% if additional_attrs.size > 3 %>
                <span class="text-caption"><%= t("maint_core.entities.assoc.more_count", count: additional_attrs.size - 3) %></span>
              <% end %>
            </div>
          <% else %>
            <span class="text-caption"><%= t("common.labels.none") %></span>
          <% end %>
        </td>
        <% if editable %>
          <td class="px-3 py-2 text-right">
            <div class="inline-flex items-center gap-1">
              <button type="button"
                      data-action="click->entity-form#editAssociation"
                      data-index="<%= index %>"
                      class="action-icon"
                      title="<%= t("maint_core.entities.assoc.edit_title") %>">
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              </button>
              <button type="button"
                      data-action="click->entity-form#removeAssociation"
                      data-index="<%= index %>"
                      class="action-icon action-icon-danger"
                      title="<%= t("maint_core.entities.assoc.remove_title") %>">
                <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </td>
        <% end %>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
