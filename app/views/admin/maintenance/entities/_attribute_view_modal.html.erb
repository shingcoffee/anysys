<%# Attribute View Modal Partial %>
<div data-entity-form-target="viewModal"
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     aria-labelledby="view-modal-title"
     role="dialog"
     aria-modal="true">

  <%# Backdrop %>
  <div class="fixed inset-0 bg-text-primary/60 transition-opacity"
       data-action="click->entity-form#closeViewModal"></div>

  <%# Modal Panel %>
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="relative bg-surface rounded-xl shadow-xl w-full max-w-2xl max-h-[min(90vh,44rem)] flex flex-col overflow-hidden">

      <%# Modal Header %>
      <div class="card-header shrink-0">
        <div class="flex items-start justify-between gap-4">
          <div class="flex items-start gap-3 min-w-0">
            <span class="h-9 w-9 shrink-0 flex items-center justify-center rounded-lg bg-accent-subtle text-accent mt-0.5">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </span>
            <div class="min-w-0">
              <p class="text-caption text-text-muted uppercase tracking-wider"><%= t("maint_core.entities.attr_view.title") %></p>
              <h3 class="section-header truncate" id="view-modal-title" data-entity-form-target="viewModalTitle"></h3>
              <p data-entity-form-target="viewModalSubtitle" class="text-caption text-text-muted truncate mt-0.5"></p>
            </div>
          </div>
          <button type="button"
                  data-action="click->entity-form#closeViewModal"
                  class="icon-button shrink-0"
                  aria-label="<%= t("common.actions.close") %>">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <%# Modal Body %>
      <div class="px-6 py-5 overflow-y-auto flex-1 min-h-0">
        <div data-entity-form-target="viewModalContent">
        </div>
      </div>

      <%# Modal Footer %>
      <div class="px-6 py-4 bg-canvas-elevated rounded-b-xl border-t border-border-subtle flex justify-end shrink-0">
        <button type="button"
                data-action="click->entity-form#closeViewModal"
                class="btn btn-secondary">
          <%= t("common.actions.close") %>
        </button>
      </div>
    </div>
  </div>
</div>
