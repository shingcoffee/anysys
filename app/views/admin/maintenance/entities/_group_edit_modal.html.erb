<%# Group Modal Partial — handles both creating a new group and editing an existing one. %>
<%# The mode (create vs edit) is driven entirely from the entity-form Stimulus controller, %>
<%# which sets the title/submit-label and toggles icon/color selection state. %>
<div data-entity-form-target="groupEditModal"
     class="hidden fixed inset-0 overflow-y-auto z-[60]"
     aria-labelledby="group-modal-title"
     role="dialog"
     aria-modal="true">

  <%# Backdrop %>
  <div class="fixed inset-0 bg-text-primary/60 transition-opacity"
       data-action="click->entity-form#closeGroupEditModal"></div>

  <%# Modal Panel %>
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="relative bg-surface rounded-xl shadow-xl w-full max-w-md flex flex-col max-h-[90vh]"
         data-action="click->entity-form#stopPropagation">

      <%# Modal Header %>
      <div class="flex-none card-header">
        <div class="flex items-center justify-between">
          <h3 class="section-header" id="group-modal-title"
              data-entity-form-target="groupModalTitle"><%= t("maint_core.entities.group_modal.new_group") %></h3>
          <button type="button"
                  data-action="click->entity-form#closeGroupEditModal"
                  class="p-1.5 text-text-muted hover:text-text-primary hover:bg-surface-active rounded-lg transition-colors"
                  aria-label="<%= t("maint_core.entities.group_modal.close_modal") %>">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <%# Modal Body — scrollable %>
      <div class="flex-1 overflow-y-auto px-6 py-5 space-y-5">
        <%# Name %>
        <div>
          <label class="form-label-required" for="group_edit_name"><%= t("common.labels.name") %></label>
          <input type="text" id="group_edit_name"
                 data-entity-form-target="groupEditName"
                 data-action="keydown.enter->entity-form#saveGroupEdit"
                 class="input-field mt-1" placeholder="<%= t("maint_core.entities.group_modal.name_placeholder") %>">
        </div>

        <%# Description %>
        <div>
          <label class="form-label" for="group_edit_description"><%= t("common.labels.description") %></label>
          <input type="text" id="group_edit_description"
                 data-entity-form-target="groupEditDescription"
                 class="input-field mt-1" placeholder="<%= t("maint_core.entities.group_modal.description_placeholder") %>">
        </div>

        <%# Icon %>
        <div>
          <label class="form-label"><%= t("maint_core.entities.group_modal.icon") %></label>
          <div class="mt-1 grid grid-cols-3 sm:grid-cols-4 gap-2" data-entity-form-target="groupEditIcon">
            <% EntityAttributeGroupOptions::ICONS.each_key do |key| %>
              <button type="button" data-icon-key="<%= key %>"
                      data-action="click->entity-form#selectGroupIcon"
                      class="group-icon-option flex items-center justify-center p-2 border border-border-subtle rounded-lg text-text-secondary hover:bg-surface-active transition-colors">
                <%= attribute_group_icon(key, css_class: "w-5 h-5") %>
              </button>
            <% end %>
          </div>
        </div>

        <%# Color %>
        <div>
          <label class="form-label"><%= t("maint_core.entities.group_modal.color") %></label>
          <div class="mt-1 flex flex-wrap gap-2.5" data-entity-form-target="groupEditColor">
            <% EntityAttributeGroupOptions::COLORS.each do |color| %>
              <button type="button" data-color-key="<%= color %>"
                      data-action="click->entity-form#selectGroupColor"
                      aria-label="<%= t("maint_core.entities.group_modal.colors.#{color}") %>"
                      class="group-color-option w-7 h-7 rounded-full border border-white/40 ring-offset-2 ring-offset-surface transition-shadow <%= attribute_group_color_classes(color, variant: :bar) %>">
              </button>
            <% end %>
          </div>
        </div>
      </div>

      <%# Modal Footer %>
      <div class="flex-none px-6 py-4 border-t border-border-subtle flex justify-end gap-3">
        <button type="button" class="btn btn-secondary"
                data-action="click->entity-form#closeGroupEditModal"><%= t("common.actions.cancel") %></button>
        <button type="button" class="btn btn-primary"
                data-entity-form-target="groupModalSubmit"
                data-action="click->entity-form#saveGroupEdit"><%= t("maint_core.entities.group_modal.create_group") %></button>
      </div>
    </div>
  </div>
</div>
