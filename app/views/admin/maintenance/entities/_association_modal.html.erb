<%# Add Association Modal Partial %>
<div data-entity-form-target="associationModal"
     class="hidden fixed inset-0 z-50 overflow-y-auto"
     aria-labelledby="association-modal-title"
     role="dialog"
     aria-modal="true">

  <%# Backdrop %>
  <div class="fixed inset-0 bg-text-primary/60 transition-opacity"
       data-action="click->entity-form#closeAssociationModal"></div>

  <%# Modal Panel %>
  <div class="flex min-h-full items-center justify-center p-4">
    <div class="relative bg-surface rounded-lg shadow-xl w-full max-w-2xl">

      <%# Modal Header %>
      <div class="card-header">
        <div class="flex items-center justify-between">
          <h3 class="section-header" id="association-modal-title" data-entity-form-target="associationModalTitle"><%= t("maint_core.entities.form.add_association") %></h3>
          <button type="button"
                  data-action="click->entity-form#closeAssociationModal"
                  class="icon-button"
                  aria-label="<%= t("common.actions.close") %>">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <%# Modal Body %>
      <div class="px-6 py-4 flex flex-col gap-4">
        <%# Target Entity Selection %>
        <div>
          <label class="form-label-required mb-1"><%= t("maint_core.entities.assoc.target_entity") %></label>
          <select data-entity-form-target="associationTargetEntity"
                  data-action="change->entity-form#associationTargetEntityChanged"
                  class="input-field">
            <option value=""><%= t("maint_core.entities.assoc_modal.select_entity") %></option>
            <!-- Entities will be populated via JavaScript -->
          </select>
          <p class="mt-1 text-caption"><%= t("maint_core.entities.assoc_modal.target_hint") %></p>
        </div>

        <%# Display Field Selection %>
        <div data-entity-form-target="associationDisplaySection" class="hidden">
          <label class="form-label-required mb-1"><%= t("maint_core.entities.assoc.display") %></label>
          <select data-entity-form-target="associationDisplayField" class="input-field">
            <option value=""><%= t("maint_core.entities.assoc_modal.select_field") %></option>
          </select>
          <p class="mt-1 text-caption"><%= t("maint_core.entities.assoc_modal.display_hint") %></p>
        </div>

        <%# Info Box %>
        <div class="p-3 bg-canvas-elevated border border-border-subtle rounded-lg">
          <div class="flex items-start">
            <svg class="w-4 h-4 text-accent mt-0.5 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div class="text-caption">
              <p class="font-medium mb-1 text-text-primary"><%= t("maint_core.entities.bridge.title") %></p>
              <p><%= t("maint_core.entities.assoc_modal.bridge_info") %></p>
            </div>
          </div>
        </div>

        <%# Additional Attributes Section %>
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="form-label">
              <%= t("maint_core.entities.assoc.additional_attributes") %>
              <span class="ml-1 text-caption"><%= t("maint_core.entities.assoc_modal.optional_paren") %></span>
            </label>
          </div>

          <%# Additional Attributes Table Container %>
          <div class="border border-border-subtle rounded-lg overflow-hidden">
            <div data-entity-form-target="associationAttributesEmptyState" class="text-caption italic py-3 text-center bg-canvas-elevated">
              <%= t("maint_core.entities.assoc_modal.no_additional_attrs_html") %>
            </div>
            <div data-entity-form-target="associationAttributesTableWrapper" class="hidden overflow-x-auto">
              <table class="min-w-full divide-y divide-border-subtle">
                <thead>
                  <tr>
                    <th scope="col" class="table-header"><%= t("common.labels.name") %></th>
                    <th scope="col" class="table-header"><%= t("common.labels.type") %></th>
                    <th scope="col" class="table-header"><%= t("maint_core.entities.attrs.html_type") %></th>
                    <th scope="col" class="table-header"><%= t("maint_core.entities.attrs.validators") %></th>
                    <th scope="col" class="table-header text-right"><%= t("common.labels.actions") %></th>
                  </tr>
                </thead>
                <tbody data-entity-form-target="associationAttributesContainer" class="divide-y divide-border-subtle">
                  <%# Rows will be added here via JavaScript %>
                </tbody>
              </table>
            </div>
          </div>

          <%# Add Attribute Button %>
          <button type="button"
                  data-action="click->entity-form#addAssociationAttribute"
                  class="mt-2 w-full inline-flex items-center justify-center px-2 py-1.5 text-xs font-medium text-accent bg-canvas-elevated border border-accent/30 rounded hover:bg-surface-active transition-colors">
            <svg class="w-3 h-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <%= t("maint_core.entities.form.add_attribute") %>
          </button>
        </div>
      </div>

      <%# Modal Footer %>
      <div class="px-6 py-4 border-t border-border-subtle flex items-center justify-end gap-3">
        <button type="button"
                data-action="click->entity-form#closeAssociationModal"
                class="btn btn-secondary">
          <%= t("common.actions.cancel") %>
        </button>
        <button type="button"
                data-action="click->entity-form#saveAssociation"
                data-entity-form-target="associationModalSubmitBtn"
                class="btn btn-primary">
          <%= t("maint_core.entities.form.add_association") %>
        </button>
      </div>
    </div>
  </div>
</div>
