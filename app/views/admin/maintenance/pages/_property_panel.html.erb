    <%# ===== RIGHT SIDEBAR - Property Editor (hidden by default) ===== %>
    <%# Absolute overlay anchored to the right edge of the (relative) canvas area:
        when shown it floats over the canvas rather than reserving a flex column,
        so selecting an element never reflows / shifts the canvas editor. %>
    <aside class="absolute inset-y-0 right-0 bg-white border-l border-gray-200 shadow-xl z-30 w-full sm:w-[22rem] max-w-[95vw] overflow-hidden hidden"
           data-page-builder-target="floatingPanel">

      <%# Property Editor Content Container %>
      <div class="relative h-full flex flex-col" data-page-builder-target="propertyPanel">

        <%# Panel Header %>
        <div class="px-3 py-2.5 border-b border-gray-200 bg-gray-50/50 flex items-center justify-between">
          <div class="flex items-center min-w-0">
            <div class="w-7 h-7 rounded-md flex items-center justify-center mr-2 flex-shrink-0" data-page-builder-target="fieldIcon">
              <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
              </svg>
            </div>
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="text-sm font-semibold text-gray-900 truncate" data-page-builder-target="fieldName"></span>
              <span class="text-xs text-gray-400 flex-shrink-0">/</span>
              <span class="text-xs text-gray-500 truncate flex-shrink-0" data-page-builder-target="fieldTypeLabel"></span>
            </div>
          </div>
          <div class="flex items-center gap-0.5 flex-shrink-0">
            <button type="button"
                    data-action="click->page-builder#duplicateField"
                    class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors"
                    title="<%= t("maint_core.pages.props.duplicate_field") %>">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
              </svg>
            </button>
            <button type="button"
                    data-action="click->page-builder#deleteField"
                    class="p-1.5 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors"
                    title="<%= t("maint_core.pages.props.delete_field") %>">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
            <button type="button"
                    data-action="click->page-builder#deselectField"
                    class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors"
                    title="<%= t("maint_core.pages.props.close_panel") %>">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <%# Breadcrumb Navigation %>
        <%= render PageBuilder::BreadcrumbComponent.new %>

        <%# Tab Bar %>
        <div class="border-b border-gray-200" data-page-builder-target="propertyTabs">
          <nav class="flex -mb-px" role="tablist">
            <%# Data field tabs %>
            <button type="button" role="tab" data-tab="content" data-action="click->page-builder#switchPropertyTab"
                    class="flex-1 px-2 py-2 text-xs font-medium text-center border-b-2 border-indigo-500 text-indigo-600 transition-colors"><%= t("maint_core.pages.props.tab_content") %></button>
            <button type="button" role="tab" data-tab="layout" data-action="click->page-builder#switchPropertyTab"
                    class="flex-1 px-2 py-2 text-xs font-medium text-center border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors"><%= t("maint_core.pages.props.tab_layout") %></button>
            <button type="button" role="tab" data-tab="validation" data-action="click->page-builder#switchPropertyTab"
                    class="flex-1 px-2 py-2 text-xs font-medium text-center border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors" data-field-section="dataOnly"><%= t("maint_core.pages.props.tab_validation") %></button>
            <button type="button" role="tab" data-tab="advanced" data-action="click->page-builder#switchPropertyTab"
                    class="flex-1 px-2 py-2 text-xs font-medium text-center border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors" data-field-section="dataOnly"><%= t("maint_core.pages.props.tab_advanced") %></button>
            <%# Layout-only tabs %>
            <button type="button" role="tab" data-tab="style" data-action="click->page-builder#switchPropertyTab"
                    class="hidden flex-1 px-2 py-2 text-xs font-medium text-center border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors" data-field-section="layoutOnly"><%= t("maint_core.pages.props.tab_style") %></button>
            <%# Columns-only tabs %>
            <button type="button" role="tab" data-tab="structure" data-action="click->page-builder#switchPropertyTab"
                    class="hidden flex-1 px-2 py-2 text-xs font-medium text-center border-b-2 border-transparent text-gray-500 hover:text-gray-700 transition-colors" data-field-section="columnsOnly"><%= t("maint_core.pages.props.tab_structure") %></button>
          </nav>
        </div>

        <%# Panel Content %>
        <div class="flex-1 overflow-y-auto">
          <form data-page-builder-target="propertyForm" data-action="change->page-builder#updateField">

            <%# ================================================================ %>
            <%# CONTENT TAB                                                      %>
            <%# ================================================================ %>
            <div data-property-tab-content="content">
              <div class="px-3 py-3 space-y-2.5">
                <%# Hidden label for backward compat %>
                <span class="hidden" data-page-builder-target="generalSectionLabel"><%= t("maint_core.pages.props.general") %></span>

                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.label") %></label>
                  <input type="text" name="label" data-page-builder-target="fieldLabel"
                         data-property="label"
                         data-action="input->page-builder#updateFieldProperty"
                         class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.placeholder") %></label>
                  <input type="text" name="placeholder" data-page-builder-target="fieldPlaceholder"
                         data-property="placeholder"
                         data-action="input->page-builder#updateFieldProperty"
                         class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.help_text") %></label>
                  <input type="text" name="help_text" data-page-builder-target="fieldHelpText"
                         data-property="help_text"
                         data-action="input->page-builder#updateFieldProperty"
                         class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                         placeholder="<%= t("maint_core.pages.props.optional_description") %>">
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.default_value") %></label>
                  <input type="text" name="default_value" data-page-builder-target="fieldDefaultValue"
                         data-property="default_value"
                         data-action="input->page-builder#updateFieldProperty"
                         class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                         placeholder="<%= t("maint_core.pages.props.optional_default") %>">
                </div>

                <%# Layout-specific: Content %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.content") %></label>
                  <textarea name="content" data-page-builder-target="fieldContent"
                            data-property="content"
                            data-action="input->page-builder#updateFieldProperty"
                            rows="3"
                            class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                            placeholder="<%= t("maint_core.pages.props.content_placeholder") %>"></textarea>
                </div>

                <%# Layout-specific: Heading Level %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.heading_level") %></label>
                  <select name="heading_level" data-page-builder-target="headingLevel"
                          data-property="heading_level"
                          data-action="change->page-builder#updateFieldProperty"
                          class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="h2"><%= t("maint_core.pages.props.heading_h2") %></option>
                    <option value="h3" selected><%= t("maint_core.pages.props.heading_h3") %></option>
                    <option value="h4"><%= t("maint_core.pages.props.heading_h4") %></option>
                  </select>
                </div>

                <%# Layout-specific: Spacer Height %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.spacer_height") %></label>
                  <select name="spacer_height" data-page-builder-target="spacerHeight"
                          data-property="spacer_height"
                          data-action="change->page-builder#updateFieldProperty"
                          class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="sm"><%= t("maint_core.pages.props.size_small") %></option>
                    <option value="md" selected><%= t("maint_core.pages.props.size_medium") %></option>
                    <option value="lg"><%= t("maint_core.pages.props.size_large") %></option>
                    <option value="xl"><%= t("maint_core.pages.props.size_extra_large") %></option>
                  </select>
                </div>

                <%# Layout-specific: Alert Variant %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.alert_style") %></label>
                  <select name="alert_variant" data-page-builder-target="alertVariant"
                          data-property="alert_variant"
                          data-action="change->page-builder#updateFieldProperty"
                          class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="info" selected><%= t("maint_core.pages.props.alert_info") %></option>
                    <option value="warning"><%= t("maint_core.pages.props.alert_warning") %></option>
                    <option value="success"><%= t("maint_core.pages.props.alert_success") %></option>
                    <option value="danger"><%= t("maint_core.pages.props.alert_danger") %></option>
                  </select>
                </div>

                <%# Layout-specific: Image URL + Alt Text %>
                <div class="hidden space-y-2" data-page-builder-target="imageUrlAltGroup">
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.image_url") %></label>
                    <input type="text" name="image_url" data-page-builder-target="imageUrl"
                           data-property="image_url"
                           data-action="input->page-builder#updateFieldProperty"
                           class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                           placeholder="https://example.com/image.jpg">
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.alt_text") %></label>
                    <input type="text" name="alt_text" data-page-builder-target="altText"
                           data-property="alt_text"
                           data-action="input->page-builder#updateFieldProperty"
                           class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                           placeholder="<%= t("maint_core.pages.props.alt_text_placeholder") %>">
                  </div>
                </div>

                <%# Layout-specific: Attribution (Quote) %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.attribution") %></label>
                  <input type="text" name="attribution" data-page-builder-target="attribution"
                         data-property="attribution"
                         data-action="input->page-builder#updateFieldProperty"
                         class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                         placeholder="<%= t("maint_core.pages.props.attribution_placeholder") %>">
                </div>

                <%# Layout-specific: Button URL %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.button_url") %></label>
                  <input type="text" name="button_url" data-page-builder-target="buttonUrl"
                         data-property="button_url"
                         data-action="input->page-builder#updateFieldProperty"
                         class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                         placeholder="https://example.com">
                </div>

                <%# Layout-specific: Button Variant + Size %>
                <div class="hidden grid grid-cols-2 gap-2" data-page-builder-target="buttonVariantSizeGroup">
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.button_style") %></label>
                    <select name="button_variant" data-page-builder-target="buttonVariant"
                            data-property="button_variant"
                            data-action="change->page-builder#updateFieldProperty"
                            class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                      <option value="primary" selected><%= t("maint_core.pages.props.btn_primary") %></option>
                      <option value="secondary"><%= t("maint_core.pages.props.btn_secondary") %></option>
                      <option value="outline"><%= t("maint_core.pages.props.btn_outline") %></option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.button_size") %></label>
                    <select name="button_size" data-page-builder-target="buttonSize"
                            data-property="button_size"
                            data-action="change->page-builder#updateFieldProperty"
                            class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                      <option value="sm"><%= t("maint_core.pages.props.size_small") %></option>
                      <option value="md" selected><%= t("maint_core.pages.props.size_medium") %></option>
                      <option value="lg"><%= t("maint_core.pages.props.size_large") %></option>
                    </select>
                  </div>
                </div>

                <%# Layout-specific: Video URL %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.video_url") %></label>
                  <input type="text" name="video_url" data-page-builder-target="videoUrl"
                         data-property="video_url"
                         data-action="input->page-builder#updateFieldProperty"
                         class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                         placeholder="https://youtube.com/watch?v=...">
                </div>

                <%# Layout-specific: List Style %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.list_style") %></label>
                  <select name="list_style" data-page-builder-target="listStyle"
                          data-property="list_style"
                          data-action="change->page-builder#updateFieldProperty"
                          class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="bullet" selected><%= t("maint_core.pages.props.list_bullet") %></option>
                    <option value="numbered"><%= t("maint_core.pages.props.list_numbered") %></option>
                    <option value="none"><%= t("maint_core.pages.props.list_plain") %></option>
                  </select>
                </div>

                <%# Layout-specific: Code Language %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.language") %></label>
                  <input type="text" name="code_language" data-page-builder-target="codeLanguage"
                         data-property="code_language"
                         data-action="input->page-builder#updateFieldProperty"
                         class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                         placeholder="<%= t("maint_core.pages.props.language_placeholder") %>">
                </div>

                <%# Layout-specific: Progress Value + Color %>
                <div class="hidden grid grid-cols-2 gap-2" data-page-builder-target="progressValueColorGroup">
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.value_percent") %></label>
                    <input type="number" name="progress_value" data-page-builder-target="progressValue"
                           data-property="progress_value"
                           data-action="input->page-builder#updateFieldProperty"
                           min="0" max="100"
                           class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                           placeholder="50">
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.color") %></label>
                    <select name="progress_color" data-page-builder-target="progressColor"
                            data-property="progress_color"
                            data-action="change->page-builder#updateFieldProperty"
                            class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                      <option value="indigo" selected><%= t("maint_core.pages.props.color_indigo") %></option>
                      <option value="green"><%= t("maint_core.pages.props.color_green") %></option>
                      <option value="blue"><%= t("maint_core.pages.props.color_blue") %></option>
                      <option value="red"><%= t("maint_core.pages.props.color_red") %></option>
                    </select>
                  </div>
                </div>

                <%# Options Editor (for select/radio/checkbox) %>
                <div class="hidden border-t border-gray-100 pt-2 mt-2" data-field-section data-field-types="select,radio,checkbox">
                  <div data-options-editor data-page-builder-target="optionsEditor">
                    <label class="block text-xs font-medium text-gray-500 mb-1.5"><%= t("maint_core.pages.props.options") %></label>
                    <div class="space-y-2" data-page-builder-target="optionsList">
                      <%# Options will be rendered dynamically %>
                    </div>
                    <button type="button"
                            class="w-full mt-2 px-2.5 py-1.5 text-sm text-gray-600 border border-dashed border-gray-300 rounded-md hover:border-indigo-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors"
                            data-action="click->page-builder#addOption">
                      <svg class="w-4 h-4 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                      </svg>
                      <%= t("maint_core.pages.props.add_option") %>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <%# ================================================================ %>
            <%# LAYOUT TAB (data fields: width + alignment)                      %>
            <%# ================================================================ %>
            <div class="hidden" data-property-tab-content="layout">
              <div class="px-3 py-3 space-y-2.5">
                <%# Width picker %>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1.5"><%= t("maint_core.pages.props.width") %></label>
                  <div class="flex gap-1" data-page-builder-target="fieldWidth">
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="full"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_full") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="three_quarters"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_three_quarters") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="two_thirds"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_two_thirds") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="half"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_half") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="third"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_third") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="quarter"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_quarter") %></button>
                  </div>

                  <%# Breakpoint selector %>
                  <div class="flex items-center gap-1 mt-2" data-page-builder-target="breakpointSelector">
                    <span class="text-[10px] text-gray-400 mr-1"><%= t("maint_core.pages.props.breakpoint") %></span>
                    <button type="button" data-breakpoint="desktop" data-action="click->page-builder#switchBreakpoint"
                            class="px-2 py-0.5 text-xs rounded border border-indigo-300 bg-indigo-50 text-indigo-600"><%= t("maint_core.pages.props.bp_desktop") %></button>
                    <button type="button" data-breakpoint="tablet" data-action="click->page-builder#switchBreakpoint"
                            class="px-2 py-0.5 text-xs rounded border border-gray-200 text-gray-500 hover:border-indigo-300"><%= t("maint_core.pages.props.bp_tablet") %></button>
                    <button type="button" data-breakpoint="mobile" data-action="click->page-builder#switchBreakpoint"
                            class="px-2 py-0.5 text-xs rounded border border-gray-200 text-gray-500 hover:border-indigo-300"><%= t("maint_core.pages.props.bp_mobile") %></button>
                    <a href="#" class="text-[10px] text-indigo-500 hover:text-indigo-700 ml-2 hidden" data-page-builder-target="resetBreakpoint"
                       data-action="click->page-builder#resetBreakpointWidth"><%= t("common.actions.reset") %></a>
                  </div>
                </div>

                <%# Alignment (shared with layout elements) %>
                <div class="hidden">
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.alignment") %></label>
                  <select name="alignment" data-page-builder-target="alignment"
                          data-property="alignment"
                          data-action="change->page-builder#updateFieldProperty"
                          class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="left" selected><%= t("maint_core.pages.props.align_left") %></option>
                    <option value="center"><%= t("maint_core.pages.props.align_center") %></option>
                    <option value="right"><%= t("maint_core.pages.props.align_right") %></option>
                  </select>
                </div>
              </div>
            </div>

            <%# ================================================================ %>
            <%# VALIDATION TAB (data fields only)                                %>
            <%# ================================================================ %>
            <div class="hidden" data-property-tab-content="validation" data-property-section="validation">
              <div class="px-3 py-3 space-y-2.5">
                <label class="flex items-center">
                  <input type="checkbox" name="required" data-page-builder-target="fieldRequired"
                         data-property="required"
                         data-action="change->page-builder#updateFieldProperty"
                         class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                  <span class="ml-2 text-xs text-gray-700"><%= t("maint_core.pages.props.required_field") %></span>
                </label>
                <div data-page-builder-target="validationOptions">
                  <%# Dynamic validation options based on field type %>
                </div>

                <%# Type Settings (moved from old section) %>
                <%= render PageBuilder::FieldTypeSettingsComponent.new %>
              </div>
            </div>

            <%# ================================================================ %>
            <%# ADVANCED TAB (data fields only)                                  %>
            <%# ================================================================ %>
            <div class="hidden" data-property-tab-content="advanced">
              <div class="px-3 py-3 space-y-2.5">
                <%# Conditional Rules Summary + per-field "Add logic" %>
                <div class="pt-2 border-t border-gray-100 mt-2">
                  <div class="flex items-center justify-between mb-1">
                    <label class="block text-xs font-medium text-gray-500"><%= t("maint_core.pages.props.conditional_rules") %></label>
                    <button type="button"
                            class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-medium text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded transition-colors"
                            data-action="click->page-builder#openRuleEditor"
                            data-prefill-target-field
                            title="<%= t("maint_core.pages.props.add_rule_title") %>">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                      </svg>
                      <%= t("maint_core.pages.props.add_logic") %>
                    </button>
                  </div>
                  <div data-advanced-rules-summary></div>
                </div>

                <%# Conditional Logic (legacy container) %>
                <div data-field-section data-property-section="conditions">
                  <div data-condition-builder data-page-builder-target="conditionsContainer">
                    <%# Conditions will be rendered dynamically %>
                  </div>
                  <button type="button"
                          class="w-full mt-2 px-2.5 py-1.5 text-sm text-gray-600 border border-dashed border-gray-300 rounded-md hover:border-indigo-400 hover:text-indigo-600 hover:bg-indigo-50 transition-colors"
                          data-action="click->page-builder#addCondition">
                    <svg class="w-4 h-4 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    <%= t("maint_core.pages.props.add_condition") %>
                  </button>
                </div>
              </div>
            </div>

            <%# ================================================================ %>
            <%# STYLE TAB (layout elements only: width, alignment, variants)     %>
            <%# ================================================================ %>
            <div class="hidden" data-property-tab-content="style">
              <div class="px-3 py-3 space-y-2.5">
                <%# Width picker for layout elements %>
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1.5"><%= t("maint_core.pages.props.width") %></label>
                  <div class="flex gap-1">
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="full"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_full") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="three_quarters"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_three_quarters") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="two_thirds"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_two_thirds") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="half"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_half") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="third"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_third") %></button>
                    <button type="button" data-action="click->page-builder#setFieldWidth" data-width="quarter"
                            class="flex-1 px-2 py-1.5 text-xs font-medium text-gray-500 border border-gray-200 rounded-md hover:bg-gray-50 transition-colors text-center"><%= t("maint_core.pages.props.width_quarter") %></button>
                  </div>
                </div>
              </div>
            </div>

            <%# ================================================================ %>
            <%# STRUCTURE TAB (columns only)                                     %>
            <%# ================================================================ %>
            <div class="hidden" data-property-tab-content="structure">
              <div class="px-3 py-3 space-y-2.5">
                <div>
                  <label class="block text-xs font-medium text-gray-700 mb-1"><%= t("maint_core.pages.props.column_layout") %></label>
                  <select name="column_layout" data-page-builder-target="columnLayout"
                          data-action="change->page-builder#updateColumnLayout"
                          class="w-full px-2.5 py-1.5 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    <option value="50-50"><%= t("maint_core.pages.props.col_50_50") %></option>
                    <option value="33-33-33"><%= t("maint_core.pages.props.col_33_33_33") %></option>
                    <option value="66-33"><%= t("maint_core.pages.props.col_66_33") %></option>
                    <option value="33-66"><%= t("maint_core.pages.props.col_33_66") %></option>
                    <option value="25-25-25-25"><%= t("maint_core.pages.props.col_25_25_25_25") %></option>
                  </select>
                </div>
              </div>
            </div>

          </form>
        </div>
      </div>
    </aside>
