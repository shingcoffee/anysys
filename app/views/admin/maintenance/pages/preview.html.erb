<div class="card overflow-x-auto">
  <div class="card-header">
    <h2 class="section-header"><%= @page.name %></h2>
    <% if @page.description.present? %>
      <p class="mt-1 text-body-sm"><%= @page.description %></p>
    <% end %>
  </div>

  <div class="p-6">
    <% if @content.present? %>
      <%= render inline: @content %>
    <% else %>
      <div class="border-2 border-dashed border-border rounded-lg p-8 text-center bg-canvas-elevated">
        <svg class="mx-auto h-12 w-12 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="mt-4 text-body-sm font-medium"><%= t("maint_core.pages.preview_page.no_content") %></p>
        <p class="mt-1 text-caption"><%= t("maint_core.pages.preview_page.no_content_hint") %></p>
      </div>
    <% end %>
  </div>
</div>
