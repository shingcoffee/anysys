<% entity_id = @page.metadata["entity_id"] %>
<% selected_entity = @page.entity %>
<% entity_properties = selected_entity&.property_schema_json || [] %>
<% field_sections = organize_entity_fields(selected_entity) %>
<% entity_section_name = selected_entity&.display_label || "" %>
<% identity_field_html_types = { "email" => "email" } %>
<% identity_fields = if selected_entity&.person?
     People::IDENTITY_KEYS.map do |key|
       {
         "name" => t("member.profiles.show.fields.#{key}"),
         "name_slug" => key,
         "html_type" => identity_field_html_types.fetch(key, "text")
       }
     end
   else
     []
   end %>
<% base_field_items = field_sections[:base_fields].is_a?(Hash) ? field_sections[:base_fields].values.flatten : Array(field_sections[:base_fields]) %>
<% layout_template_key = @page.metadata["layout_template_key"] %>
<% layout_template_obj = layout_template_key.present? ? PageLayoutTemplates.find(layout_template_key) : nil %>
<% layout_template_data = layout_template_obj.present? ? layout_template_obj[:layout].to_json : "{}" %>

