  <%# ===== TOP TOOLBAR ===== %>
  <%= render PageBuilder::ToolbarComponent.new(
    page: @page,
    customer_id: current_customer_id,
    selected_entity: selected_entity
  ) %>

  <%# ===== MAIN CONTENT AREA ===== %>
  <div class="flex-1 flex overflow-hidden relative">

    <%# ===== LEFT SIDEBAR - Entity Fields & Flows ===== %>
    <aside class="w-72 bg-gray-50/70 border-r border-gray-200/80 flex flex-col flex-shrink-0 z-20"
           data-page-builder-target="leftSidebar">

      <%# Search Box %>
      <div class="px-3 pt-3 pb-2">
        <div class="relative">
          <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text"
                 placeholder="<%= t("maint_core.pages.editor.search_fields_flows_html") %>"
                 data-page-builder-target="searchInput"
                 data-action="input->page-builder#filterSidebar"
                 class="w-full pl-8 pr-3 py-1.5 text-xs bg-white/80 border border-gray-200 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-400 focus:bg-white transition-all duration-200">
        </div>
      </div>

      <div class="flex-1 overflow-y-auto px-2.5 pb-3 space-y-2" data-page-builder-target="sidebarContent">

        <%# ===== FIELDS SECTION ===== %>
        <div class="bg-white rounded-lg border border-gray-200/70 shadow-[0_1px_3px_rgba(0,0,0,0.04)] overflow-hidden" data-searchable-category="fields">
          <%# Fields Header %>
          <% total_fields = base_field_items.length + field_sections[:own_fields].length +
                            field_sections[:associated_entities].sum { |e| e[:fields].length + e[:bridge_fields].length } +
                            identity_fields.length %>
          <button type="button"
                  data-action="click->page-builder#toggleCategory"
                  class="w-full px-3 py-2.5 flex items-center justify-between text-left hover:bg-gray-50/60 transition-colors duration-150">
            <div class="flex items-center gap-2.5">
              <div class="w-6 h-6 rounded-md bg-indigo-50 border border-indigo-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-3.5 h-3.5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                </svg>
              </div>
              <span class="text-xs font-semibold text-gray-700"><%= t("maint_core.pages.editor.fields") %></span>
              <svg class="w-3 h-3 text-gray-400 transform transition-transform duration-200 rotate-180" data-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
            <span class="text-[10px] font-medium tabular-nums text-gray-400 bg-gray-100 px-1.5 py-0.5 rounded-md min-w-[20px] text-center"><%= total_fields %></span>
          </button>

          <%# Fields Content (Sub-sections) %>
          <div data-page-builder-target="entityFieldsCategory">

            <%# -- Sub-section: Account identity fields (person entities only) -- %>
            <% if identity_fields.any? %>
              <div class="border-t border-gray-100" data-searchable-section="identity">
                <div class="flex items-center group/header">
                  <button type="button"
                          data-action="click->page-builder#toggleSubsection"
                          title="<%= t("maint_core.pages.editor.identity_group_help") %>"
                          class="flex-1 pl-4 pr-2 py-2 flex items-center gap-1.5 text-left hover:bg-gray-50/60 transition-colors duration-150">
                    <svg class="w-3 h-3 text-gray-300 transform transition-transform duration-200 rotate-180" data-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                    <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span class="text-[11px] font-medium text-gray-500"><%= t("maint_core.pages.editor.identity_group") %></span>
                    <span class="text-[10px] tabular-nums text-gray-300"><%= identity_fields.length %></span>
                  </button>
                  <div class="flex items-center gap-px pr-1.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
                    <button type="button" data-add-all-section data-action="click->page-builder#addAllFieldsFromSection"
                            class="px-1.5 py-0.5 text-[9px] font-semibold text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded transition-colors" title="<%= t("maint_core.pages.editor.add_all_title") %>"><%= t("maint_core.pages.editor.add_all") %></button>
                    <button type="button" data-remove-all-section data-action="click->page-builder#removeAllFieldsFromSection"
                            class="px-1.5 py-0.5 text-[9px] font-semibold text-gray-400 hover:text-red-500 hover:bg-red-50 rounded transition-colors" title="<%= t("maint_core.pages.editor.remove_all_title") %>"><%= t("maint_core.pages.editor.remove_all") %></button>
                  </div>
                </div>
                <p class="px-4 pb-1 text-[10px] leading-tight text-gray-400"><%= t("maint_core.pages.editor.identity_group_help") %></p>
                <div class="px-2 pb-1.5">
                  <% identity_fields.each do |prop| %>
                    <%= render "admin/maintenance/pages/field_sidebar_item",
                               prop: prop,
                               search_text: "#{prop['name'].downcase} #{prop['html_type']&.downcase} #{t("maint_core.pages.editor.identity_group").downcase}",
                               source: "identity" %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# -- Sub-section macro (Base Model) -- %>
            <% if base_field_items.any? %>
              <div class="border-t border-gray-100" data-searchable-section="base">
                <div class="flex items-center group/header">
                  <button type="button"
                          data-action="click->page-builder#toggleSubsection"
                          class="flex-1 pl-4 pr-2 py-2 flex items-center gap-1.5 text-left hover:bg-gray-50/60 transition-colors duration-150">
                    <svg class="w-3 h-3 text-gray-300 transform transition-transform duration-200 rotate-180" data-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                    <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                    <span class="text-[11px] font-medium text-gray-500"><%= t("maint_core.pages.editor.base_model") %></span>
                    <span class="text-[10px] tabular-nums text-gray-300"><%= base_field_items.length %></span>
                  </button>
                  <div class="flex items-center gap-px pr-1.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
                    <button type="button" data-add-all-section data-action="click->page-builder#addAllFieldsFromSection"
                            class="px-1.5 py-0.5 text-[9px] font-semibold text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded transition-colors" title="<%= t("maint_core.pages.editor.add_all_title") %>"><%= t("maint_core.pages.editor.add_all") %></button>
                    <button type="button" data-remove-all-section data-action="click->page-builder#removeAllFieldsFromSection"
                            class="px-1.5 py-0.5 text-[9px] font-semibold text-gray-400 hover:text-red-500 hover:bg-red-50 rounded transition-colors" title="<%= t("maint_core.pages.editor.remove_all_title") %>"><%= t("maint_core.pages.editor.remove_all") %></button>
                  </div>
                </div>
                <div class="px-2 pb-1.5">
                  <% base_field_items.each do |prop| %>
                    <% field_name = prop["name"] || prop["key"] || prop["name_slug"] %>
                    <%= render "admin/maintenance/pages/field_sidebar_item", prop: prop.merge("name" => field_name), search_text: "#{field_name.to_s.downcase} #{prop['html_type']&.downcase}", source: "entity", source_section: entity_section_name %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# -- Sub-section: Entity's Own Fields -- %>
            <% if field_sections[:own_fields].any? %>
              <div class="border-t border-gray-100" data-searchable-section="own">
                <div class="flex items-center group/header">
                  <button type="button"
                          data-action="click->page-builder#toggleSubsection"
                          class="flex-1 pl-4 pr-2 py-2 flex items-center gap-1.5 text-left hover:bg-gray-50/60 transition-colors duration-150">
                    <svg class="w-3 h-3 text-gray-300 transform transition-transform duration-200 rotate-180" data-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                    <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    <span class="text-[11px] font-medium text-gray-500"><%= t("maint_core.pages.editor.entity_fields") %></span>
                    <span class="text-[10px] tabular-nums text-gray-300"><%= field_sections[:own_fields].length %></span>
                  </button>
                  <div class="flex items-center gap-px pr-1.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
                    <button type="button" data-add-all-section data-action="click->page-builder#addAllFieldsFromSection"
                            class="px-1.5 py-0.5 text-[9px] font-semibold text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded transition-colors" title="<%= t("maint_core.pages.editor.add_all_title") %>"><%= t("maint_core.pages.editor.add_all") %></button>
                    <button type="button" data-remove-all-section data-action="click->page-builder#removeAllFieldsFromSection"
                            class="px-1.5 py-0.5 text-[9px] font-semibold text-gray-400 hover:text-red-500 hover:bg-red-50 rounded transition-colors" title="<%= t("maint_core.pages.editor.remove_all_title") %>"><%= t("maint_core.pages.editor.remove_all") %></button>
                  </div>
                </div>
                <div class="px-2 pb-1.5">
                  <% field_sections[:own_fields].each do |prop| %>
                    <%= render "admin/maintenance/pages/field_sidebar_item", prop: prop, search_text: "#{prop['name'].downcase} #{prop['html_type']&.downcase}", source: "entity", source_section: entity_section_name %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# -- Sub-sections: Associated Entities (bridge fields only) -- %>
            <% field_sections[:associated_entities].each do |assoc_entity| %>
              <% next if assoc_entity[:bridge_fields].empty? %>
              <div class="border-t border-gray-100" data-searchable-section="bridge-<%= assoc_entity[:bridge_entity_id] %>">
                <div class="flex items-center group/header">
                  <button type="button"
                          data-action="click->page-builder#toggleSubsection"
                          class="flex-1 pl-4 pr-2 py-2 flex items-center gap-1.5 text-left hover:bg-gray-50/60 transition-colors duration-150">
                    <svg class="w-3 h-3 text-gray-300 transform transition-transform duration-200" data-chevron fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                    <svg class="w-3 h-3 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                    </svg>
                    <span class="text-[11px] font-medium text-gray-500 truncate"><%= assoc_entity[:entity_name] %></span>
                    <span class="text-[10px] tabular-nums text-gray-300"><%= assoc_entity[:bridge_fields].length %></span>
                  </button>
                  <div class="flex items-center gap-px pr-1.5 opacity-0 group-hover/header:opacity-100 transition-opacity duration-150">
                    <button type="button" data-add-all-section data-action="click->page-builder#addAllFieldsFromSection"
                            class="px-1.5 py-0.5 text-[9px] font-semibold text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 rounded transition-colors" title="<%= t("maint_core.pages.editor.add_all_title") %>"><%= t("maint_core.pages.editor.add_all") %></button>
                    <button type="button" data-remove-all-section data-action="click->page-builder#removeAllFieldsFromSection"
                            class="px-1.5 py-0.5 text-[9px] font-semibold text-gray-400 hover:text-red-500 hover:bg-red-50 rounded transition-colors" title="<%= t("maint_core.pages.editor.remove_all_title") %>"><%= t("maint_core.pages.editor.remove_all") %></button>
                  </div>
                </div>
                <div class="px-2 pb-1.5 hidden">
                  <% assoc_entity[:bridge_fields].each do |prop| %>
                    <%= render "admin/maintenance/pages/field_sidebar_item", prop: prop, search_text: "#{prop['name'].downcase} #{prop['html_type']&.downcase} #{assoc_entity[:entity_name].downcase}", source: "bridge", source_section: assoc_entity[:bridge_entity_name] %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%# Empty State %>
            <% if selected_entity.nil? || (identity_fields.empty? && base_field_items.empty? && field_sections[:own_fields].empty? && field_sections[:associated_entities].all? { |a| a[:bridge_fields].empty? }) %>
              <div class="px-4 py-8 text-center">
                <div class="w-10 h-10 mx-auto mb-2.5 rounded-full bg-gray-100 flex items-center justify-center">
                  <svg class="w-5 h-5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                  </svg>
                </div>
                <p class="text-xs font-medium text-gray-500 mb-0.5"><%= t("maint_core.pages.editor.no_fields") %></p>
                <p class="text-[11px] text-gray-400"><%= t("maint_core.pages.editor.no_fields_hint") %></p>
              </div>
            <% end %>

          </div>
        </div>

        <%= render PageBuilder::JourneyUsageComponent.new(page: @page, customer_id: current_customer.id) if JourneyVisibility.allowed?(current_user) %>
      </div>
    </aside>

    <%# ===== CENTER - CANVAS AREA ===== %>
    <main class="flex-1 overflow-auto bg-gray-100 relative flex flex-col" data-page-builder-target="canvasArea"
          data-action="mousedown->page-builder#canvasMouseDown mousemove->page-builder#canvasMouseMove mouseup->page-builder#canvasMouseUp">
      <%# Sticky header: Multi-page tabs (component palette now lives in the top toolbar) %>
      <div class="sticky top-0 z-20 flex-shrink-0">
        <%# Multi-page tabs %>
        <%= render PageBuilder::PageTabsComponent.new(
          pages: @page.configuration_json&.dig("pages") || [],
          active_page_id: @page.configuration_json&.dig("pages", 0, "id") || "page_1"
        ) %>

      </div><%# End sticky header %>

      <%# Canvas Background Pattern %>
      <div class="absolute inset-0 opacity-50 pointer-events-none bg-[radial-gradient(circle,#d1d5db_1px,transparent_1px)] [background-size:20px_20px]"></div>

      <%# Responsive Canvas Container %>
      <div class="relative min-h-full flex items-start justify-center py-4 px-4">
        <div class="canvas-frame transition-all duration-300 ease-out w-full max-w-[800px]"
             data-page-builder-target="canvasFrame">

          <%# Form Container %>
          <div class="bg-white rounded-xl shadow-xl border border-gray-200 overflow-hidden">

            <%# Form Header %>
            <div class="px-6 py-4 bg-gradient-to-r from-indigo-500 to-purple-600">
              <h1 class="text-lg font-bold text-white"><%= @page.name %></h1>
              <% if @page.description.present? %>
                <p class="mt-1 text-sm text-indigo-100"><%= @page.description %></p>
              <% end %>
            </div>

            <%# Drop Zone / Fields Container %>
            <div class="p-4 min-h-[400px]"
                 data-page-builder-target="dropZone"
                 data-action="contextmenu->page-builder#openCanvasContextMenu">

              <%# Fields Grid %>
              <div class="fields-grid grid gap-2 grid-cols-12"
                   role="list" aria-label="<%= t("maint_core.pages.editor.fields_list_aria") %>"
                   data-page-builder-target="fieldsContainer">

                <%# Empty State %>
                <div class="col-span-12 empty-state transition-opacity duration-200"
                     data-page-builder-target="emptyState">
                  <div class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center hover:border-indigo-300 hover:bg-indigo-50/30 transition-colors">
                    <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-indigo-100 flex items-center justify-center">
                      <svg class="w-6 h-6 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                      </svg>
                    </div>
                    <h3 class="text-base font-semibold text-gray-900 mb-1.5"><%= t("maint_core.pages.editor.start_building") %></h3>
                    <p class="text-sm text-gray-500 mb-3 max-w-sm mx-auto"><%= t("maint_core.pages.editor.start_building_before") %> <kbd class="px-1.5 py-0.5 bg-gray-100 rounded text-gray-600 text-xs font-mono">/</kbd> <%= t("maint_core.pages.editor.start_building_after") %></p>
                    <div class="flex items-center justify-center gap-4 text-xs text-gray-400">
                      <span class="flex items-center">
                        <kbd class="px-2 py-1 bg-gray-100 rounded text-gray-600 mr-1">/</kbd>
                        <%= t("maint_core.pages.editor.component_picker") %>
                      </span>
                      <span class="flex items-center">
                        <kbd class="px-2 py-1 bg-gray-100 rounded text-gray-600 mr-1"><%= t("maint_core.pages.editor.component_drag_key") %></kbd>
                        <%= t("maint_core.pages.editor.entity_fields_hint") %>
                      </span>
                    </div>
                  </div>
                </div>

                <%# Fields will be rendered here dynamically %>
              </div>
            </div>

            <%# Form Footer — dynamically updated based on single/multi page %>
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200"
                 data-page-builder-target="formFooter">
            </div>
          </div>
        </div>
      </div>

      <%# Inserter Popover %>
      <div class="hidden fixed z-50 w-80 max-h-96 bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden"
           data-page-builder-target="inserterPopover">
        <div class="p-3 border-b border-gray-100">
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input type="text"
                   placeholder="<%= t("maint_core.pages.editor.search_components") %>"
                   data-page-builder-target="inserterPopoverSearch"
                   data-action="input->page-builder#filterInserterPopover"
                   class="w-full pl-9 pr-3 py-2 text-sm bg-gray-50 border border-gray-200 rounded-lg placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-400 focus:bg-white transition-all duration-200">
          </div>
        </div>
        <div class="p-3 overflow-y-auto max-h-72"
             data-page-builder-target="inserterPopoverContent">
        </div>
      </div>

      <%# Drag Preview Ghost — floating clone of the dragged card. DragVisuals
          applies lift/tilt/shadow classes; base classes keep it invisible and
          non-interactive until a drag starts. %>
      <div class="drag-preview fixed pointer-events-none z-50 opacity-0 top-0 left-0 will-change-transform"
           data-page-builder-target="dragPreview">
      </div>

      <%# Drop Indicator — animated insertion marker. Width/height set by
          DragVisuals for horizontal (between rows) or vertical (between
          side-by-side fields) orientation. CSS transitions on geometry
          properties make it glide when crossing slot boundaries. %>
      <div class="drop-indicator fixed pointer-events-none z-50 bg-indigo-500 rounded-full
                  shadow-[0_0_8px_2px_rgba(99,102,241,0.5)]
                  transition-[left,top,width,height] duration-150 ease-out
                  opacity-0 overflow-visible"
           data-page-builder-target="dropIndicator"></div>

      <%# Zoom Controls & Mini-Map %>
      <%= render PageBuilder::ZoomControlsComponent.new %>
      <%= render PageBuilder::MiniMapComponent.new %>

    </main>

    <%= render "admin/maintenance/pages/property_panel" %>
  </div>

  <%# ===== TAB PANEL OVERLAYS (all rendered as centered modals) ===== %>

  <%# Templates Modal %>
  <%= render PageBuilder::ConfigModalComponent.new(
        key: "templates", title: t("maint_core.pages.editor.templates_modal_title"),
        subtitle: t("maint_core.pages.editor.templates_modal_subtitle"),
        icon: :templates, accent: :slate, size: :xl) do %>
    <div class="p-6 space-y-6"
         data-controller="template-applier"
         data-template-applier-page-id-value="<%= @page.id %>"
         data-template-applier-customer-id-value="<%= current_customer_id %>"
         data-template-applier-entity-id-value="<%= entity_id %>"
         data-template-applier-page-builder-not-found-msg-value="<%= t("comp_page_builder.template_picker.page_builder_not_found") %>"
         data-template-applier-applying-label-value="<%= t("comp_page_builder.template_picker.applying") %>"
         data-template-applier-apply-failed-format-value="<%= t("comp_page_builder.template_picker.apply_failed_format") %>"
         data-template-applier-unknown-error-label-value="<%= t("comp_page_builder.template_picker.unknown_error") %>"
         data-template-applier-apply-failed-generic-msg-value="<%= t("comp_page_builder.template_picker.apply_failed_generic") %>">

      <%# Warning about template switching %>
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 flex gap-3">
        <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <h4 class="text-sm font-medium text-amber-900"><%= t("maint_core.pages.editor.template_switching") %></h4>
          <p class="text-sm text-amber-700 mt-1"><%= t("maint_core.pages.editor.template_switching_hint_html") %></p>
        </div>
      </div>

      <%# Search and filters %>
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <div class="flex gap-3 mb-4">
          <div class="flex-1">
            <div class="relative">
              <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <input type="text"
                     class="w-full pl-10 pr-4 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                     placeholder="<%= t("maint_core.pages.editor.search_by_name_category") %>"
                     data-action="input->template-applier#searchTemplates"
                     data-template-applier-target="searchInput">
            </div>
          </div>
        </div>

        <%# Category tabs %>
        <% category_counts = PageLayoutTemplates.category_counts %>
        <%= render "shared/category_tabs", controller_name: "template-applier", category_counts: category_counts %>

        <%# Search results count %>
        <div class="hidden mt-3 text-sm text-gray-500" data-template-applier-target="searchResultsCount">
          <span data-template-applier-target="searchResultsNumber">0</span> <%= t("maint_core.pages.editor.templates_found") %>
        </div>
      </div>

      <%# Templates grid - smaller cards in 4 columns, scrollable %>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 max-h-[40vh] overflow-y-auto pr-1 pb-1" data-template-applier-target="templatesGrid">
        <% PageLayoutTemplates.all.each do |template| %>
          <%= render PageBuilder::TemplateCardComponent.new(
            template: template,
            controller_name: "template-applier"
          ) %>
        <% end %>
      </div>

      <%# No results message %>
      <div class="hidden text-center py-12" data-template-applier-target="noResults">
        <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-sm font-medium text-gray-900 mb-1"><%= t("maint_core.pages.editor.no_templates_found") %></h3>
        <p class="text-sm text-gray-500"><%= t("maint_core.pages.editor.no_templates_hint") %></p>
      </div>

      <%# Preview Modal %>
      <div class="hidden fixed inset-0 z-50 overflow-y-auto" data-template-applier-target="previewModal" data-action="click->template-applier#closePreviewModalOnBackdrop">
        <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:p-0">
          <%# Backdrop %>
          <div class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75" aria-hidden="true"></div>

          <%# Modal panel - max-w-6xl for larger preview %>
          <div class="relative inline-block w-full max-w-6xl overflow-hidden text-left align-middle transition-all transform bg-white rounded-lg shadow-xl">
            <%# Header %>
            <div class="px-6 py-4 border-b border-gray-200">
              <div class="flex items-start justify-between">
                <div class="flex-1 min-w-0 mr-4">
                  <h3 class="text-lg font-semibold text-gray-900" data-template-applier-target="previewModalName">
                    <%= t("maint_core.pages.editor.template_preview") %>
                  </h3>
                  <p class="mt-1 text-sm text-gray-500" data-template-applier-target="previewModalDescription">
                    <%= t("maint_core.pages.editor.template_description") %>
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 ring-1 ring-inset ring-indigo-200">
                    <span data-template-applier-target="previewModalTheme"><%= t("maint_core.pages.editor.theme_modern") %></span>
                  </span>
                  <button type="button"
                          class="inline-flex items-center justify-center w-8 h-8 text-gray-400 transition-colors rounded-lg hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                          data-action="click->template-applier#closePreviewModal">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <%# Preview content - increased height and padding for larger preview %>
            <div class="px-6 py-6 bg-gray-50">
              <div class="overflow-hidden bg-white border border-gray-200 rounded-lg shadow-sm">
                <div class="p-8 min-h-[500px]" data-template-applier-target="previewModalContent">
                  <!-- Preview will be injected here -->
                </div>
              </div>
            </div>

            <%# Footer %>
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200">
              <div class="flex justify-end gap-3">
                <button type="button"
                        class="btn btn-secondary"
                        data-action="click->template-applier#closePreviewModal">
                  <%= t("common.actions.close") %>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Settings Modal — sidebar-navigated sections (General / Multi-step / After submit / Security) %>
  <%= render PageBuilder::SettingsModalComponent.new(page: @page, customer_id: current_customer_id) %>

  <%# Conditional Rules Modal %>
  <%= render PageBuilder::ConfigModalComponent.new(
        key: "rules", title: t("maint_core.pages.editor.rules_modal_title"),
        subtitle: t("maint_core.pages.editor.rules_modal_subtitle"),
        icon: :rules, accent: :indigo, size: :md) do %>
    <%# List layer — JS shows/hides vs. editor layer %>
    <div data-drawer-list="rules" data-page-builder-target="rulesPanel" class="p-4">
      <%= render PageBuilder::RulesPanelComponent.new(
            rules: @page.configuration_json&.dig('rules') || [],
            fields: @page.configuration_json&.dig('pages')&.flat_map { |p| p['fields'] || [] } || []) %>
    </div>
    <%# Editor layer — JS clones ruleEditorTemplate here %>
    <div data-drawer-editor="rules" class="hidden" data-page-builder-target="ruleEditorModal"></div>
  <% end %>

  <%# Calculated Fields Modal %>
  <%= render PageBuilder::ConfigModalComponent.new(
        key: "calculations", title: t("maint_core.pages.editor.calculations_modal_title"),
        subtitle: t("maint_core.pages.editor.calculations_modal_subtitle"),
        icon: :calculations, accent: :purple, size: :md) do %>
    <%# List layer %>
    <div data-drawer-list="calculations" data-page-builder-target="calculationsPanel" class="p-4">
      <%= render PageBuilder::CalculationsPanelComponent.new(
            calculations: @page.configuration_json&.dig('calculations') || [],
            fields: @page.configuration_json&.dig('pages')&.flat_map { |p| p['fields'] || [] } || []) %>
    </div>
    <%# Editor layer — JS clones calculationEditorTemplate here %>
    <div data-drawer-editor="calculations" class="hidden" data-page-builder-target="formulaEditorModal"></div>
  <% end %>

  <%# Theme Modal %>
  <%= render PageBuilder::ConfigModalComponent.new(
        key: "theme", title: t("maint_core.pages.editor.theme_modal_title"),
        subtitle: t("maint_core.pages.editor.theme_modal_subtitle"),
        icon: :theme, accent: :slate, size: :lg) do %>
    <%= render PageBuilder::ThemePanelComponent.new %>
  <% end %>

  <%# Context Menu %>
  <%= render PageBuilder::ContextMenuComponent.new %>

  <%# Command Palette %>
  <%= render PageBuilder::CommandPaletteComponent.new %>

  <%# Floating Action Bar for Multi-Select %>
  <%= render PageBuilder::FloatingActionBarComponent.new %>

  <%# Move-to-Page Modal container (rules/calc editors now live inside drawers) %>
  <div data-page-builder-target="moveToPageModal"></div>

  <%# Server-rendered component templates (cloned by JS managers, avoiding innerHTML strings) %>
  <% all_fields = @page.configuration_json&.dig("pages")&.flat_map { |p| p["fields"] || [] } || [] %>
  <% all_pages  = @page.configuration_json&.dig("pages") || [] %>

  <template data-page-builder-target="calculationEditorTemplate">
    <%= render PageBuilder::CalculationEditorComponent.new(
      calculation: nil,
      fields: all_fields,
      pages: all_pages
    ) %>
  </template>

  <template data-page-builder-target="ruleEditorTemplate">
    <%= render PageBuilder::RuleEditorComponent.new(
      rule: nil,
      fields: all_fields,
      pages: all_pages
    ) %>
  </template>

  <%# Keyboard Shortcuts Help (hidden by default) %>
  <div class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center"
       data-page-builder-target="shortcutsModal">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4"><%= t("maint_core.pages.editor.shortcuts_title") %></h3>
      <div class="grid grid-cols-2 gap-3 text-sm">
        <div class="flex justify-between"><span class="text-gray-600"><%= t("common.actions.save") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + S</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_undo") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + Z</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_redo") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + Shift + Z</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_select_all") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + A</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("common.actions.delete") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Delete</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("common.actions.duplicate") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + D</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_navigate") %></span><kbd class="px-2 py-1 bg-gray-100 rounded"><%= t("maint_core.pages.editor.shortcut_navigate_keys") %></kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_deselect") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Escape</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_multi_select") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + Click</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_range_select") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Shift + Click</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_search_fields") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + F</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_zoom_in") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + +</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_zoom_out") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + -</kbd></div>
        <div class="flex justify-between"><span class="text-gray-600"><%= t("maint_core.pages.editor.shortcut_zoom_reset") %></span><kbd class="px-2 py-1 bg-gray-100 rounded">Ctrl + 0</kbd></div>
      </div>
      <button type="button" data-action="click->page-builder#hideShortcuts" class="mt-6 w-full px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200"><%= t("common.actions.close") %></button>
    </div>
  </div>
</div>

