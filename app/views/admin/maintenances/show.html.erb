<%# app/views/maintenances/show.html.erb %>
<%= render AdminPageComponent.new(
  breadcrumbs: [{ label: t("admin_misc.maintenance.breadcrumb"), path: nil }],
  title: t("admin_misc.maintenance.title"),
  description: t("admin_misc.maintenance.subtitle")
) do %>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <%= render QuickActionCardComponent.new(label: t("page_shortcuts.title"), description: t("page_shortcuts.description"), path: admin_maintenance_page_shortcuts_path(current_customer.id), icon: MaintenanceContributor::ICONS[:pages]) %>
  <%= link_to admin_maintenance_entities_path(current_customer.id), class: "group card p-6 hover:shadow-md transition-all" do %>
    <div class="w-10 h-10 rounded-lg bg-surface-active flex items-center justify-center mb-4 group-hover:bg-canvas-elevated transition-colors">
      <svg class="w-5 h-5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
      </svg>
    </div>
    <h3 class="text-sm font-semibold text-text-primary mb-1"><%= t("admin_misc.maintenance.cards.entities_title") %></h3>
    <p class="text-body-sm"><%= t("admin_misc.maintenance.cards.entities_description") %></p>
  <% end %>

  <% if FlowchartVisibility.allowed?(current_user) %>
    <%= link_to admin_maintenance_flowcharts_path(current_customer.id), class: "group card p-6 hover:shadow-md transition-all" do %>
      <div class="w-10 h-10 rounded-lg bg-surface-active flex items-center justify-center mb-4 group-hover:bg-canvas-elevated transition-colors">
        <svg class="w-5 h-5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
        </svg>
      </div>
      <h3 class="text-sm font-semibold text-text-primary mb-1"><%= t("admin_misc.maintenance.cards.flowcharts_title") %></h3>
      <p class="text-body-sm"><%= t("admin_misc.maintenance.cards.flowcharts_description") %></p>
    <% end %>
  <% end %>

  <%= link_to admin_maintenance_pages_path(current_customer.id), class: "group card p-6 hover:shadow-md transition-all" do %>
    <div class="w-10 h-10 rounded-lg bg-surface-active flex items-center justify-center mb-4 group-hover:bg-canvas-elevated transition-colors">
      <svg class="w-5 h-5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
    </div>
    <h3 class="text-sm font-semibold text-text-primary mb-1"><%= t("admin_misc.maintenance.cards.pages_title") %></h3>
    <p class="text-body-sm"><%= t("admin_misc.maintenance.cards.pages_description") %></p>
  <% end %>

  <%= link_to admin_maintenance_constants_path(current_customer.id), class: "group card p-6 hover:shadow-md transition-all" do %>
    <div class="w-10 h-10 rounded-lg bg-surface-active flex items-center justify-center mb-4 group-hover:bg-canvas-elevated transition-colors">
      <svg class="w-5 h-5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
      </svg>
    </div>
    <h3 class="text-sm font-semibold text-text-primary mb-1"><%= t("admin_misc.maintenance.cards.constants_title") %></h3>
    <p class="text-body-sm"><%= t("admin_misc.maintenance.cards.constants_description") %></p>
  <% end %>

  <%= link_to admin_maintenance_modules_path(current_customer.id), class: "group card p-6 hover:shadow-md transition-all" do %>
    <div class="w-10 h-10 rounded-lg bg-surface-active flex items-center justify-center mb-4 group-hover:bg-canvas-elevated transition-colors">
      <svg class="w-5 h-5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
      </svg>
    </div>
    <h3 class="text-sm font-semibold text-text-primary mb-1"><%= t("admin_misc.maintenance.cards.modules_title") %></h3>
    <p class="text-body-sm"><%= t("admin_misc.maintenance.cards.modules_description") %></p>
  <% end %>

  <%= link_to admin_maintenance_customer_profile_path(current_customer.id), class: "group card p-6 hover:shadow-md transition-all" do %>
    <div class="w-10 h-10 rounded-lg bg-surface-active flex items-center justify-center mb-4 group-hover:bg-canvas-elevated transition-colors">
      <svg class="w-5 h-5 text-text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
      </svg>
    </div>
    <h3 class="text-sm font-semibold text-text-primary mb-1"><%= t("admin_misc.maintenance.cards.customer_profile_title") %></h3>
    <p class="text-body-sm"><%= t("admin_misc.maintenance.cards.customer_profile_description") %></p>
  <% end %>
</div>
<% end %>
