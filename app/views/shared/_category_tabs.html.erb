<%# Shared grouped category navigation for template selection.
    Local variables:
      controller_name - Stimulus controller name (e.g. "template-selector", "template-applier")
      category_counts - Hash of category => count
%>
<div class="mb-4" data-<%= controller_name %>-target="categoryTabs">
  <%# "All" tab as a prominent top-level toggle %>
  <div class="flex items-center gap-2 mb-3">
    <button type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-indigo-100 text-indigo-700 ring-1 ring-indigo-200"
            data-action="click-><%= controller_name %>#filterCategory"
            data-category="all"
            data-total-count="<%= category_counts['all'] || 0 %>"
            data-<%= controller_name %>-target="categoryTab">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="<%= PageLayoutTemplates.categories['all'][:icon] %>" />
      </svg>
      <%= t("auth.shared.category_tabs.all_templates") %>
      <span class="text-[10px] opacity-75 bg-indigo-200/50 px-1.5 py-0.5 rounded-full" data-count-badge><%= category_counts['all'] || 0 %></span>
    </button>
  </div>

  <%# Grouped categories %>
  <div class="space-y-1" data-<%= controller_name %>-target="categoryGroups">
    <% PageLayoutTemplates.category_groups.each do |group| %>
      <div class="border border-gray-200 rounded-lg overflow-hidden" data-category-group="<%= group[:key] %>">
        <%# Group header - clickable to expand/collapse %>
        <button type="button"
                class="w-full flex items-center justify-between px-3 py-2 bg-gray-50 hover:bg-gray-100 transition-colors text-left"
                data-action="click-><%= controller_name %>#toggleGroup"
                data-group-key="<%= group[:key] %>">
          <span class="inline-flex items-center gap-2 text-xs font-semibold text-gray-700">
            <svg class="w-3.5 h-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="<%= group[:icon] %>" />
            </svg>
            <%= PageLayoutTemplates.category_group_label(group) %>
            <% group_total = group[:categories].sum { |c| category_counts[c] || 0 } %>
            <span class="text-[10px] font-normal text-gray-400"><%= group_total %></span>
          </span>
          <svg class="w-3.5 h-3.5 text-gray-400 transition-transform" data-group-chevron="<%= group[:key] %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <%# Category pills inside group - collapsed by default %>
        <div class="hidden px-3 py-2 bg-white flex flex-wrap gap-1.5" data-group-content="<%= group[:key] %>">
          <% group[:categories].each do |cat_key| %>
            <% cat = PageLayoutTemplates.categories[cat_key] %>
            <% next unless cat %>
            <button type="button"
                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium transition-all bg-gray-100 text-gray-600 hover:bg-gray-200"
                    data-action="click-><%= controller_name %>#filterCategory"
                    data-category="<%= cat_key %>"
                    data-total-count="<%= category_counts[cat_key] || 0 %>"
                    data-<%= controller_name %>-target="categoryTab">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= cat[:icon] %>" />
              </svg>
              <%= PageLayoutTemplates.category_label(cat_key) %>
              <span class="text-[10px] opacity-75" data-count-badge><%= category_counts[cat_key] || 0 %></span>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
