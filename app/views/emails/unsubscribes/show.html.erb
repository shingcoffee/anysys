<div class="px-4">
<div class="w-full max-w-md mx-auto bg-white p-6 sm:p-8 rounded-lg shadow">
  <h1 class="text-2xl font-semibold text-gray-900 mb-2"><%= t("public_views.unsubscribes.show.heading") %></h1>
  <p class="text-gray-700 mb-6"><%= t("public_views.unsubscribes.show.body_html", email: @email) %></p>

  <%= form_with url: "/unsubscribe/#{params[:token]}", method: :post do |f| %>
    <%= f.submit t("public_views.unsubscribes.show.submit"), class: "w-full px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 cursor-pointer" %>
  <% end %>
</div>
</div>
