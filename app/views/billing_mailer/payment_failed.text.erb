<% amount = Billing::CurrencyResolver.format(@invoice.total_cents, @invoice.currency) %>
<%= t("billing_mailer.payment_failed.title") %>

<%= t("billing_mailer.payment_failed.intro") %>

<%= t("billing_mailer.payment_failed.label_amount_due") %>: <%= amount %>
<%= t("billing_mailer.payment_failed.label_invoice_number") %>: <%= @invoice.number %>
<%= t("billing_mailer.payment_failed.label_attempt") %>: <%= @invoice.attempt_count %>
<%= t("billing_mailer.payment_failed.label_next_attempt") %>: <%= format_mail_datetime(@invoice.next_attempt_at) || t("common.labels.em_dash") %>

<%= t("billing_mailer.payment_failed.outro") %>

<%= t("billing_mailer.shell.footer") %>
