<% amount = Billing::CurrencyResolver.format(@invoice.total_cents, @invoice.currency) %>
<%= t("billing_mailer.invoice_issued.title") %>

<%= t("billing_mailer.invoice_issued.intro") %>

<%= t("billing_mailer.invoice_issued.label_amount_due") %>: <%= amount %>
<%= t("billing_mailer.invoice_issued.label_invoice_number") %>: <%= @invoice.number %>
<%= t("billing_mailer.invoice_issued.label_plan") %>: <%= @plan.name %>
<%= t("billing_mailer.invoice_issued.label_period") %>: <%= format_mail_period(@invoice.period_start, @invoice.period_end) %>
<%= t("billing_mailer.invoice_issued.label_due_date") %>: <%= format_mail_date(@invoice.due_at) %>

<%= t("billing_mailer.invoice_issued.outro") %>

<%= t("billing_mailer.shell.footer") %>
