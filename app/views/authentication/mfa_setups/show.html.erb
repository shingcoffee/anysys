<%= render Member::AuthShellComponent.new(
      customer: current_customer,
      title:    t("auth.mfa_setups.show.shell_title"),
      subtitle: t("auth.mfa_setups.show.shell_subtitle")
    ) do %>

  <div class="mb-8">
    <h2 class="text-subtitle mb-1"><%= t("auth.mfa_setups.show.heading") %></h2>
    <p class="text-body-sm"><%= t("auth.mfa_setups.show.subheading") %></p>
  </div>

  <ol class="space-y-6">
    <li class="flex gap-4">
      <span class="flex-none h-9 w-9 rounded-full bg-member-accent-subtle text-member-accent-ink ring-1 ring-member-accent-muted/60 flex items-center justify-center text-sm font-semibold">1</span>
      <div class="flex-1 min-w-0 space-y-3">
        <div>
          <h3 class="text-sm font-semibold text-text-primary"><%= t("auth.mfa_setups.show.step1_title") %></h3>
          <p class="mt-0.5 text-xs text-text-tertiary"><%= t("auth.mfa_setups.show.step1_hint") %></p>
        </div>

        <% if @qr_code %>
          <div class="flex justify-center">
            <div class="bg-white p-6 rounded-2xl ring-1 ring-member-border-warm shadow-[var(--shadow-member-card)] max-w-full">
              <div class="max-w-full h-auto [&>svg]:max-w-full [&>svg]:h-auto"><%= @qr_code.html_safe %></div>
            </div>
          </div>
        <% end %>

        <div>
          <p class="text-xs text-text-tertiary mb-1.5"><%= t("auth.mfa_setups.show.manual_key_prompt_html") %></p>
          <code class="inline-flex items-center gap-2 font-mono text-sm tracking-[0.08em] bg-member-paper px-3 py-2 rounded-md ring-1 ring-member-border-warm text-text-primary select-all">
            <%= current_user.otp_secret %>
          </code>
        </div>
      </div>
    </li>

    <li class="flex gap-4">
      <span class="flex-none h-9 w-9 rounded-full bg-member-accent-subtle text-member-accent-ink ring-1 ring-member-accent-muted/60 flex items-center justify-center text-sm font-semibold">2</span>
      <div class="flex-1 min-w-0 space-y-3">
        <div>
          <h3 class="text-sm font-semibold text-text-primary"><%= t("auth.mfa_setups.show.step2_title") %></h3>
          <p class="mt-0.5 text-xs text-text-tertiary"><%= t("auth.mfa_setups.show.step2_hint") %></p>
        </div>

        <%= form_tag mfa_setup_path(current_customer_id), method: :post, class: "space-y-4", data: { turbo: false } do %>
          <div>
            <label for="otp_code" class="form-label form-label-required"><%= t("auth.common.verification_code") %></label>
            <input type="text" name="otp_code" id="otp_code"
                   autofocus autocomplete="one-time-code" inputmode="numeric"
                   pattern="[0-9]*" maxlength="6"
                   placeholder="<%= t("auth.common.otp_placeholder") %>"
                   class="input-otp">
          </div>

          <button type="submit" class="btn-member w-full justify-center">
            <%= t("auth.mfa_setups.show.submit") %>
          </button>
        <% end %>
      </div>
    </li>
  </ol>
<% end %>
