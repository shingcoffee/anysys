<%= render Member::AuthShellComponent.new(
      customer: current_customer,
      title:    t("auth.mfa_sessions.show.shell_title"),
      subtitle: t("auth.mfa_sessions.show.shell_subtitle")
    ) do %>

  <div class="mb-8">
    <h2 class="text-subtitle mb-1"><%= t("auth.mfa_sessions.show.heading") %></h2>
    <p class="text-body-sm"><%= t("auth.mfa_sessions.show.subheading") %></p>
  </div>

  <%= form_tag mfa_session_path(current_customer_id), method: :post, class: "space-y-5", data: { turbo: false } do %>
    <div>
      <label for="otp_code" class="form-label form-label-required"><%= t("auth.common.verification_code") %></label>
      <input type="text" name="otp_code" id="otp_code"
             autofocus autocomplete="one-time-code" inputmode="numeric"
             pattern="[0-9]*" maxlength="6"
             placeholder="<%= t("auth.common.otp_placeholder") %>"
             class="input-otp">
    </div>

    <label class="flex items-center gap-2 text-body-sm select-none cursor-pointer">
      <input type="checkbox" name="trust_device" value="1"
             class="h-4 w-4 rounded border-member-border-warm text-member-accent focus:ring-member-accent">
      <span><%= t("auth.mfa_sessions.show.trust_device") %></span>
    </label>

    <button type="submit" class="btn-member w-full justify-center">
      <%= t("auth.mfa_sessions.show.verify") %>
    </button>
  <% end %>

  <div class="mt-6 pt-5 border-t border-member-border-warm space-y-2 text-center text-sm">
    <%= link_to t("auth.mfa_sessions.show.lost_authenticator"), new_mfa_recovery_path(current_customer_id),
          class: "block font-medium text-member-accent-text hover:underline" if current_user.member? %>
    <%= link_to t("auth.mfa_sessions.show.sign_out"), destroy_user_session_path,
          data: { turbo_method: :delete },
          class: "block text-text-tertiary hover:text-text-primary" %>
  </div>
<% end %>
