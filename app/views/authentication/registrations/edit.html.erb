<%= render Member::AuthShellComponent.new(
      customer: current_customer,
      title:    t("auth.registrations.edit.shell_title"),
      subtitle: t("auth.registrations.edit.shell_subtitle")
    ) do %>

  <div class="mb-8">
    <h2 class="text-subtitle mb-1"><%= t("auth.registrations.edit.heading") %></h2>
    <p class="text-body-sm"><%= t("auth.registrations.edit.subheading_html") %></p>
  </div>

  <%= form_for(resource, as: resource_name,
        url: user_registration_path,
        html: { method: :put, class: "space-y-5" }) do |f| %>

    <% if resource.errors.any? %>
      <div class="rounded-xl bg-danger-subtle ring-1 ring-danger/20 p-3.5">
        <ul class="text-sm text-danger list-disc pl-5 space-y-1">
          <% resource.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :first_name, class: "form-label form-label-required" %>
        <%= f.text_field :first_name, autocomplete: "given-name", class: "input-member" %>
      </div>
      <div>
        <%= f.label :last_name, class: "form-label form-label-required" %>
        <%= f.text_field :last_name, autocomplete: "family-name", class: "input-member" %>
      </div>
    </div>

    <div>
      <%= f.label :email, class: "form-label form-label-required" %>
      <%= f.email_field :email, autocomplete: "email", class: "input-member" %>
    </div>

    <div id="change-password" class="pt-5 border-t border-member-border-warm space-y-4 scroll-mt-24">
      <div>
        <h3 class="text-sm font-semibold text-text-primary"><%= t("auth.registrations.edit.change_password") %></h3>
        <p class="mt-0.5 text-xs text-text-tertiary"><%= t("auth.registrations.edit.change_password_hint") %></p>
      </div>

      <div>
        <%= f.label :password, t("auth.common.new_password"), class: "form-label" %>
        <%= f.password_field :password, autocomplete: "new-password",
              placeholder: t("auth.common.min_chars_placeholder", count: @minimum_password_length || 8),
              class: "input-member" %>
      </div>

      <div>
        <%= f.label :password_confirmation, t("auth.common.confirm_password"), class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-member" %>
      </div>
    </div>

    <% if resource.password_set? %>
      <div class="pt-5 border-t border-member-border-warm space-y-2">
        <%= f.label :current_password, class: "form-label form-label-required" %>
        <p class="text-xs text-text-tertiary"><%= t("auth.registrations.edit.current_password_hint") %></p>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "input-member" %>
      </div>
    <% else %>
      <p class="text-xs text-text-tertiary"><%= t("auth.registrations.edit.set_password_hint") %></p>
    <% end %>

    <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between pt-3 gap-3">
      <%= link_to t("common.actions.cancel"), Authentication::LandingPath.for(resource),
            class: "btn btn-ghost justify-center" %>
      <%= f.submit t("auth.registrations.edit.submit"), class: "btn-member justify-center" %>
    </div>
  <% end %>
<% end %>
