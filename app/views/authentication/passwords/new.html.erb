<%= render Member::AuthShellComponent.new(
      customer: current_customer,
      title:    t("auth.passwords.new.shell_title"),
      subtitle: t("auth.passwords.new.shell_subtitle")
    ) do %>

  <div class="mb-8">
    <h2 class="text-subtitle mb-1"><%= t("auth.passwords.new.heading") %></h2>
    <p class="text-body-sm"><%= t("auth.passwords.new.subheading") %></p>
  </div>

  <%= form_for(resource, as: resource_name,
        url: user_password_path,
        html: { class: "space-y-5" }) do |f| %>

    <% if resource.errors.any? %>
      <div class="rounded-lg bg-danger-subtle border border-danger/20 p-3">
        <p class="text-sm text-danger"><%= resource.errors.full_messages.first %></p>
      </div>
    <% end %>

    <div>
      <%= f.label :email, class: "form-label form-label-required" %>
      <%= f.email_field :email, autocomplete: "email", placeholder: t("auth.sessions.email_placeholder"), class: "input-member" %>
    </div>

    <%= f.submit t("auth.common.send_reset_link"), class: "btn-member w-full justify-center" %>
  <% end %>

  <p class="mt-6 text-center text-sm text-text-tertiary">
    <%= t("auth.common.remembered_it") %>
    <%= link_to t("auth.common.back_to_sign_in"), new_user_session_path,
          class: "font-medium text-member-accent-text hover:underline" %>
  </p>
<% end %>
