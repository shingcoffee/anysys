<div class="mb-8 rounded-md bg-warning-subtle px-3.5 py-3 ring-1 ring-warning/20">
  <h3 class="text-sm font-semibold text-text-primary"><%= t("auth.unconfirmed.title") %></h3>
  <p class="mt-1 text-sm leading-relaxed text-text-secondary">
    <%= t("auth.unconfirmed.sent_html", email: unconfirmed_email) %>
  </p>

  <%= form_with url: user_confirmation_path,
                method: :post, local: true, class: "mt-3" do |f| %>
    <%= hidden_field_tag "user[email]", unconfirmed_email %>
    <%= f.submit t("auth.unconfirmed.resend"), class: "btn-member-secondary min-h-9" %>
  <% end %>
</div>
