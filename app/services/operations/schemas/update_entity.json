  "examples": [
    {
      "updates": [
        {
          "entity": "Student",
          "expected_version": 7,
          "changes": [
            {
              "op": "add_attribute",
              "attribute": {
                "name": "Phone",
                "html_type": "tel"
              },
              "position": {
                "after": "email"
              }
            },
            {
              "op": "update_attribute",
              "slug": "email",
              "set": {
                "access": {
                  "visible_to": {
                    "public": false
                  }
                }
              }
            },
            {
              "op": "remove_attribute",
              "slug": "fax"
            }
          ]
        }
      ]
    },
    {
      "updates": [
        {
          "entity": "Course",
          "changes": [
            {
              "op": "set_details",
              "display_label": "Training course",
              "description": "A scheduled class."
            },
            {
              "op": "set_settings",
              "icon": "custom",
              "color": "#4f46e5"
            },
            {
              "op": "add_group",
              "group": {
                "key": "schedule",
                "name": "Schedule",
                "icon": "calendar",
                "color": "amber"
              }
            },
            {
              "op": "update_group",
              "key": "basics",
              "set": {
                "name": "Overview"
              }
            },
            {
              "op": "reorder_groups",
              "order": [
                "schedule",
                "basics"
              ]
            },
            {
              "op": "move_attribute",
              "slug": "title",
              "to_group": "schedule",
              "position": {
                "before": "level"
              }
            },
            {
              "op": "add_association",
              "association": {
                "related_entity": "Student",
                "display_field": "email"
              }
            },
            {
              "op": "update_association",
              "related_entity": "Student",
              "set": {
                "display_field_label": "Student email"
              }
            },
            {
              "op": "add_bridge_attribute",
              "related_entity": "Student",
              "attribute": {
                "name": "Seat",
                "html_type": "number"
              }
            },
            {
              "op": "update_bridge_attribute",
              "related_entity": "Student",
              "slug": "seat",
              "set": {}
            },
            {
              "op": "remove_bridge_attribute",
              "related_entity": "Student",
              "slug": "seat"
            },
            {
              "op": "remove_association",
              "related_entity": "Student"
            },
            {
              "op": "remove_group",
              "key": "schedule",
              "move_attributes_to": "basics"
            }
          ]
        }
      ]
    }
