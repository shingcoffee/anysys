{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anysys.local/schemas/action_catalog.schema.json",
  "title": "Flowchart action catalog",
  "description": "Locale-rendered step-action catalog exported by CodeGenerators::ActionCatalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["digest", "locale", "categories", "actions"],
  "properties": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the locale-independent catalog payload."
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "description": "I18n locale used for labels, help, and option text."
    },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "category", "label", "description", "icon", "color",
        "singleUse", "privileged", "fields", "capabilities"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": ["string", "null"] },
        "color": { "type": ["string", "null"] },
        "singleUse": { "type": "boolean" },
        "privileged": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "role", "control", "label", "help", "placeholder", "default",
        "required", "group", "options", "min", "max", "visibleWhen",
        "requiredWhen", "variablePicker", "source", "itemRole", "keyRole",
        "valueRole", "multiline", "maxLength"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": [
            "input", "output", "expression", "literal", "template", "enum",
            "flag", "integer", "decimal", "list", "mapping", "conditions",
            "entity_attribute", "reference", "localized_text"
          ]
        },
        "control": {
          "type": "string",
          "enum": [
            "text", "code", "textarea", "select", "toggle", "number", "list",
            "mapping", "conditions", "attribute_picker", "reference_picker",
            "localized_text"
          ]
        },
        "label": { "type": ["string", "null"] },
        "help": { "type": ["string", "null"] },
        "placeholder": { "type": ["string", "null"] },
        "default": {},
        "required": { "type": "boolean" },
        "group": { "type": "string", "enum": ["main", "advanced"] },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": ["string", "number", "boolean"] },
              "label": { "type": "string" }
            }
          }
        },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "visibleWhen": { "type": ["object", "null"] },
        "requiredWhen": { "type": ["object", "null"] },
        "variablePicker": { "type": "boolean" },
        "source": { "type": ["string", "null"] },
        "itemRole": { "type": ["string", "null"] },
        "keyRole": { "type": ["string", "null"] },
        "valueRole": { "type": ["string", "null"] },
        "multiline": { "type": "boolean" },
        "maxLength": { "type": ["integer", "null"] }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transportRetry", "timeouts", "circuitBreaker"],
      "properties": {
        "transportRetry": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["idempotentWhen", "orPresent", "maxAttempts"],
          "properties": {
            "idempotentWhen": { "type": "object" },
            "orPresent": { "type": ["string", "null"] },
            "maxAttempts": { "type": "integer", "minimum": 1 }
          }
        },
        "timeouts": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["open", "read", "cap"],
          "properties": {
            "open": { "type": "integer" },
            "read": { "type": "integer" },
            "cap": { "type": "integer" }
          }
        },
        "circuitBreaker": { "type": "boolean" }
      }
    }
  }
}
